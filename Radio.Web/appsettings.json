{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=MVCDB;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "DatabaseBackup": {
    "Enabled": false,
    "IntervalHours": 24,
    "RetentionDays": 30,
    "CloudSync": false,
    "LocalBackupFolder": "backups"
  },
  "Seq": {
    "ServerUrl": "http://localhost:5341",
    "ApiKey": "",
    "SlowQueryThresholdMs": 100
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "DataProtection": {
    "KeyRingPath": "keys",
    "ApplicationName": "Radio.BroadcastWorkflow"
  },
  "Authentication": {
    "Cookie": {
      "ExpireTimeHours": 8,
      "SlidingExpiration": true
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://localhost:5000" },
      "Https": { "Url": "https://localhost:5001" }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
