@model List<SocialMediaPlatformDto>
@{ ViewData["Title"] = "منصات النشر"; }

<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-2xl font-bold text-ink mb-1 flex items-center gap-2">
            <span class="material-symbols-rounded text-primary">share</span>
            منصات النشر
        </h1>
        <p class="text-ink-muted text-sm">إدارة منصات السوشيال ميديا</p>
    </div>
    @if (User.HasPermission(AppPermissions.StaffManage))
    {
        <a href="/SocialPlatforms/Create" class="btn-primary"><span class="material-symbols-rounded">add</span> منصة جديدة</a>
    }
</div>

<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
    @if (!Model.Any())
    {
        <div class="col-span-full empty-state p-12 bg-surface rounded-xl border border-border">
            <span class="material-symbols-rounded empty-icon">share</span>
            <h3 class="font-bold text-ink text-lg mb-2">لا منصات</h3>
            <a href="/SocialPlatforms/Create" class="btn-primary"><span class="material-symbols-rounded">add</span> منصة جديدة</a>
        </div>
    }
    else
    {
        @foreach (var p in Model)
        {
            <div class="bg-surface rounded-xl border border-border p-5 flex items-center gap-3">
                <div class="w-12 h-12 rounded-full bg-blue-50 text-primary flex items-center justify-center">
                    <span class="material-symbols-rounded">@GetPlatformIcon(p.Name)</span>
                </div>
                <div class="flex-1">
                    <div class="font-bold text-ink">@p.Name</div>
                </div>
                @if (User.HasPermission(AppPermissions.StaffManage))
                {
                    <a href="/SocialPlatforms/Edit/@p.SocialMediaPlatformId" class="icon-btn icon-btn-primary"><span class="material-symbols-rounded">edit</span></a>
                    <form method="post" action="/SocialPlatforms/Delete/@p.SocialMediaPlatformId" data-confirm="هل أنت متأكد من حذف منصة «@p.Name»؟">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="icon-btn icon-btn-danger"><span class="material-symbols-rounded">delete</span></button>
                    </form>
                }
            </div>
        }
    }
</div>

@functions {
    string GetPlatformIcon(string name) => name.ToLowerInvariant() switch
    {
        "facebook" => "groups",
        "twitter" or "x" => "alternate_email",
        "youtube" => "smart_display",
        "instagram" => "photo_camera",
        "tiktok" => "music_note",
        _ => "share"
    };
}
