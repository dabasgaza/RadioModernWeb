@model List<SocialMediaPlatformDto>
@{
    ViewData["Title"] = "منصات النشر";
    ViewData["HeaderIcon"] = "share";
    ViewData["HeaderDescription"] = "إدارة منصات السوشيال ميديا المستخدمة في عمليات النشر الرقمي";
    ViewBag.EntityName = "منصات النشر";

    if (User.HasPermission(AppPermissions.StaffManage))
    {
        ViewData["HeaderActions"] = "<a href='/SocialPlatforms/Create' class='btn btn-primary rounded-xl gap-2'><span class='material-symbols-rounded text-lg'>add</span>منصة جديدة</a>";
    }
}

<partial name="_PageHeader" />

@if (!Model.Any())
{
    ViewBag.EmptyIcon = "share";
    ViewBag.EmptyTitle = "لا منصات";
    ViewBag.EmptyDesc = "لم تتم إضافة أي منصات نشر بعد.";
    ViewBag.EmptyActionUrl = User.HasPermission(AppPermissions.StaffManage) ? "/SocialPlatforms/Create" : null;
    ViewBag.EmptyActionText = "إضافة منصة جديدة";
    ViewBag.EmptyActionIcon = "add";
    <partial name="_EmptyState" />
}
else
{
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        @foreach (var p in Model)
        {
            <div class="card flex items-center gap-3 p-4">
                <div class="w-12 h-12 rounded-full flex items-center justify-center shrink-0 bg-primary-subtle text-primary">
                    <span class="material-symbols-rounded">@GetPlatformIcon(p.Name)</span>
                </div>
                <div class="flex-1 min-w-0">
                    <div class="font-bold text-text">@p.Name</div>
                </div>
                @if (User.HasPermission(AppPermissions.StaffManage))
                {
                    <div class="flex items-center gap-1 whitespace-nowrap">
                        <a href="/SocialPlatforms/Edit/@p.SocialMediaPlatformId" class="btn btn-ghost btn-icon btn-sm text-primary" title="تعديل" aria-label="تعديل">
                            <span class="material-symbols-rounded text-xl leading-none">edit</span>
                        </a>
                        <form method="post" action="/SocialPlatforms/Delete/@p.SocialMediaPlatformId" class="inline" data-confirm="هل أنت متأكد من حذف منصة «@p.Name»؟">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-ghost btn-icon btn-sm text-danger" title="حذف" aria-label="حذف">
                                <span class="material-symbols-rounded text-xl leading-none">delete</span>
                            </button>
                        </form>
                    </div>
                }
            </div>
        }
    </div>
}

@functions {
    string GetPlatformIcon(string name) => name.ToLowerInvariant() switch
    {
        "facebook" => "groups",
        "twitter" or "x" => "alternate_email",
        "youtube" => "smart_display",
        "instagram" => "photo_camera",
        "tiktok" => "music_note",
        _ => "share"
    };
}
