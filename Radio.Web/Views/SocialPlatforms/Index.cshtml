@model List<SocialMediaPlatformDto>
@{
    ViewData["Title"] = "منصات النشر";
    ViewData["HeaderIcon"] = "share";
    ViewData["HeaderDescription"] = "إدارة منصات السوشيال ميديا المستخدمة في عمليات النشر الرقمي";
    ViewBag.EntityName = "منصات النشر";

    if (User.HasPermission(AppPermissions.StaffManage))
    {
        ViewData["HeaderActions"] = "<a href='/SocialPlatforms/Create' class='btn btn-primary rounded-xl gap-2'><span class='material-symbols-rounded text-lg'>add</span>منصة جديدة</a>";
    }
}

<partial name="_PageHeader" />

@if (!Model.Any())
{
    <partial name="_EmptyState" model='new { Icon = "share", Title = "لا منصات", Description = "لم تتم إضافة أي منصات نشر بعد.", ActionUrl = User.HasPermission(AppPermissions.StaffManage) ? "/SocialPlatforms/Create" : null, ActionText = "إضافة منصة جديدة", ActionIcon = "add" }' />
}
else
{
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        @foreach (var p in Model)
        {
            <div class="rounded-2xl border flex items-center gap-3 p-4" style="background: var(--color-surface); border-color: var(--color-border)">
                <div class="w-12 h-12 rounded-full flex items-center justify-center shrink-0" style="background: color-mix(in srgb, var(--color-primary) 10%, transparent); color: var(--color-primary)">
                    <span class="material-symbols-rounded">@GetPlatformIcon(p.Name)</span>
                </div>
                <div class="flex-1 min-w-0">
                    <div class="font-bold" style="color: var(--color-text)">@p.Name</div>
                </div>
                @if (User.HasPermission(AppPermissions.StaffManage))
                {
                    <div class="flex items-center gap-1 whitespace-nowrap">
                        <a href="/SocialPlatforms/Edit/@p.SocialMediaPlatformId" class="inline-flex items-center justify-center w-9 h-9 rounded-xl transition-all" title="تعديل" aria-label="تعديل" style="color: var(--color-primary)"><span class="material-symbols-rounded text-xl leading-none">edit</span></a>
                        <form method="post" action="/SocialPlatforms/Delete/@p.SocialMediaPlatformId" class="inline" data-confirm="هل أنت متأكد من حذف منصة «@p.Name»؟">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="inline-flex items-center justify-center w-9 h-9 rounded-xl transition-all" title="حذف" aria-label="حذف" style="color: var(--color-error)"><span class="material-symbols-rounded text-xl leading-none">delete</span></button>
                        </form>
                    </div>
                }
            </div>
        }
    </div>
}

@functions {
    string GetPlatformIcon(string name) => name.ToLowerInvariant() switch
    {
        "facebook" => "groups",
        "twitter" or "x" => "alternate_email",
        "youtube" => "smart_display",
        "instagram" => "photo_camera",
        "tiktok" => "music_note",
        _ => "share"
    };
}
