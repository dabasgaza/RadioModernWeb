@model SocialMediaPlatformDto
@{
    ViewData["Title"] = Model.SocialMediaPlatformId == 0 ? "منصة جديدة" : "تعديل منصة";
    var isEdit = Model.SocialMediaPlatformId != 0;
}

<div class="page-header">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 relative z-10">
        <div>
            <nav class="breadcrumb">
                <span class="material-symbols-rounded">home</span>
                <a href="/">الرئيسية</a>
                <span class="material-symbols-rounded">chevron_left</span>
                <a href="/SocialPlatforms">منصات النشر</a>
                <span class="material-symbols-rounded">chevron_left</span>
                <span>@(isEdit ? "تعديل منصة" : "منصة جديدة")</span>
            </nav>
            <h1>
                <span class="material-symbols-rounded text-primary">@(isEdit ? "edit" : "add")</span>
                @(isEdit ? "تعديل منصة" : "منصة جديدة")
            </h1>
            <p>إدخال وتحديث بيانات منصة النشر الرقمي والتكاملات المرتبطة بها</p>
        </div>
        <div class="flex items-center gap-2">
            <a href="/SocialPlatforms" class="btn-secondary">
                <span class="material-symbols-rounded">arrow_forward</span>
                الرجوع للمنصات
            </a>
        </div>
    </div>
</div>

<form method="post" action="@(isEdit ? $"/SocialPlatforms/Edit/{Model.SocialMediaPlatformId}" : "/SocialPlatforms/Create")" class="max-w-2xl">
    @Html.AntiForgeryToken()
    @if (isEdit) { <input type="hidden" name="SocialMediaPlatformId" value="@Model.SocialMediaPlatformId" /> }
    @if (ViewContext.ModelState.ErrorCount > 0)
    {
        <div asp-validation-summary="All" class="bg-red-50 border border-red-200 text-danger rounded-xl p-4 mb-6 font-semibold text-sm"></div>
    }

    <div class="card-premium">
        <div class="card-header">
            <div class="flex items-center gap-2">
                <span class="material-symbols-rounded text-primary">share</span>
                <h3 class="font-bold text-ink text-base">بيانات المنصة</h3>
            </div>
        </div>
        <div class="card-body space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="form-label">اسم المنصة *</label>
                    <div class="input-wrapper">
                        <span class="material-symbols-rounded input-icon">badge</span>
                        <input type="text" name="Name" value="@Model.Name" class="form-input" required placeholder="مثال: YouTube" />
                    </div>
                </div>
                <div>
                    <label class="form-label">أيقونة (Material Icon)</label>
                    <div class="input-wrapper">
                        <span class="material-symbols-rounded input-icon">image</span>
                        <input type="text" name="Icon" value="@Model.Icon" class="form-input" placeholder="مثل: smart_display" />
                    </div>
                </div>
            </div>
            <div>
                <label class="form-label">الرابط الأساسي (Base URL)</label>
                <div class="input-wrapper">
                    <span class="material-symbols-rounded input-icon">link</span>
                    <input type="url" name="BaseUrl" value="@Model.BaseUrl" class="form-input" dir="ltr" placeholder="https://www.youtube.com/watch?v=" />
                </div>
                <p class="text-xs text-ink-muted mt-1">يُستخدم كبادئة عند إدخال رابط النشر — المستخدم يضيف فقط الـ ID أو username</p>
            </div>
        </div>
    </div>

    <div class="flex items-center justify-end gap-2 mt-6">
        <a href="/SocialPlatforms" class="btn-secondary">
            <span class="material-symbols-rounded">cancel</span>
            إلغاء
        </a>
        <button type="submit" class="btn-primary">
            <span class="material-symbols-rounded">save</span>
            حفظ البيانات
        </button>
    </div>
</form>
