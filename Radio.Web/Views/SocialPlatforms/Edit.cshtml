@model SocialMediaPlatformDto
@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = Model.SocialMediaPlatformId == 0 ? "منصة جديدة" : "تعديل منصة";
    var isEdit = Model.SocialMediaPlatformId != 0;
    ViewBag.IsEdit = isEdit;
    ViewBag.Icon = isEdit ? "edit" : "add";
    ViewBag.Title = isEdit ? "تعديل بيانات المنصة" : "إضافة منصة جديدة";
    ViewBag.Description = "إدخال وتحديث بيانات منصة النشر الرقمي والتكاملات المرتبطة بها";
    ViewBag.EntityName = "منصات النشر";
    ViewBag.EntityUrl = "/SocialPlatforms";
    ViewBag.BackUrl = "/SocialPlatforms";
    ViewBag.BackText = "الرجوع للمنصات";
}

<partial name="_PageHeader" />

<form method="post" action="@(isEdit ? $"/SocialPlatforms/Edit/{Model.SocialMediaPlatformId}" : "/SocialPlatforms/Create")" class="max-w-2xl">
    @Html.AntiForgeryToken()
    @if (isEdit) { <input type="hidden" name="SocialMediaPlatformId" value="@Model.SocialMediaPlatformId" /> }

    @if (ViewContext.ModelState.ErrorCount > 0)
    {
        <div asp-validation-summary="All" class="rounded-xl p-4 mb-6 font-semibold text-sm bg-danger-subtle text-danger border border-danger-subtle"></div>
    }

    <div class="bg-surface border border-border rounded-2xl p-6" style="border-color:var(--color-border)">
        @{
            ViewBag.SectionIcon = "share"; ViewBag.SectionTitle = "بيانات المنصة";
        }
        <partial name="_SectionHeader" />

        <div class="space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                @{
                    ViewBag.FieldLabel = "اسم المنصة"; ViewBag.FieldName = "Name";
                    ViewBag.FieldIcon = "badge"; ViewBag.FieldValue = Model.Name;
                    ViewBag.FieldRequired = true; ViewBag.FieldPlaceholder = "مثال: YouTube";
                }
                <partial name="_FormField" />

                @{
                    ViewBag.FieldLabel = "أيقونة (Material Icon)"; ViewBag.FieldName = "Icon";
                    ViewBag.FieldIcon = "image"; ViewBag.FieldValue = Model.Icon;
                    ViewBag.FieldPlaceholder = "مثل: smart_display";
                }
                <partial name="_FormField" />
            </div>

            <div>
                @{
                    ViewBag.FieldLabel = "الرابط الأساسي (Base URL)"; ViewBag.FieldName = "BaseUrl";
                    ViewBag.FieldIcon = "link"; ViewBag.FieldValue = Model.BaseUrl;
                    ViewBag.FieldType = "url"; ViewBag.FieldDir = "ltr";
                    ViewBag.FieldPlaceholder = "https://www.youtube.com/watch?v=";
                }
                <partial name="_FormField" />
                <p class="text-xs mt-1 text-text-muted">يُستخدم كبادئة عند إدخال رابط النشر — المستخدم يضيف فقط الـ ID أو username</p>
            </div>
        </div>
    </div>

    <div class="flex items-center justify-end gap-2 mt-6">
        <a href="/SocialPlatforms" class="btn btn-ghost rounded-xl gap-2">
            <span class="material-symbols-rounded">cancel</span>إلغاء
        </a>
        <button type="submit" class="btn btn-primary rounded-xl gap-2">
            <span class="material-symbols-rounded">save</span>حفظ البيانات
        </button>
    </div>
</form>
