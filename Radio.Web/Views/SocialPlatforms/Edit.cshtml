@model SocialMediaPlatformDto
@{
    ViewData["Title"] = Model.SocialMediaPlatformId == 0 ? "منصة جديدة" : "تعديل منصة";
    var isEdit = Model.SocialMediaPlatformId != 0;
    ViewBag.IsEdit = isEdit;
    ViewBag.Icon = isEdit ? "edit" : "add";
    ViewBag.Title = isEdit ? "تعديل بيانات المنصة" : "إضافة منصة جديدة";
    ViewBag.Description = "إدخال وتحديث بيانات منصة النشر الرقمي والتكاملات المرتبطة بها";
    ViewBag.EntityName = "منصات النشر";
    ViewBag.EntityUrl = "/SocialPlatforms";
    ViewBag.BackUrl = "/SocialPlatforms";
    ViewBag.BackText = "الرجوع للمنصات";
}

<partial name="_PageHeader" />

<form method="post" action="@(isEdit ? $"/SocialPlatforms/Edit/{Model.SocialMediaPlatformId}" : "/SocialPlatforms/Create")" class="max-w-2xl">
    @Html.AntiForgeryToken()
    @if (isEdit) { <input type="hidden" name="SocialMediaPlatformId" value="@Model.SocialMediaPlatformId" /> }

    @if (ViewContext.ModelState.ErrorCount > 0)
    {
        <div asp-validation-summary="All" class="rounded-xl p-4 mb-6 font-semibold text-sm"
             style="background: color-mix(in srgb, var(--color-error) 10%, transparent); border: 1px solid color-mix(in srgb, var(--color-error) 20%, transparent); color: var(--color-error)"></div>
    }

    <div class="rounded-2xl border" style="background: var(--color-surface); border-color: var(--color-border)">
        <div class="p-6 space-y-4">
            <div class="flex items-center gap-2.5">
                <span class="material-symbols-rounded" style="color: var(--color-primary)">share</span>
                <h3 class="font-bold" style="color: var(--color-text)">بيانات المنصة</h3>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="text-sm font-medium mb-1.5 block" style="color: var(--color-text-secondary)">اسم المنصة <span style="color: var(--color-error)">*</span></label>
                    <div class="relative">
                        <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-lg" style="color: var(--color-text-tertiary)">badge</span>
                        <input type="text" name="Name" value="@Model.Name" required
                               class="w-full rounded-xl py-2.5 pr-10 pl-3 text-sm font-medium focus:outline-none focus:ring-2 transition-all"
                               style="background: var(--color-bg-alt); border: 1px solid var(--color-border); color: var(--color-text); --tw-ring-color: var(--color-primary)"
                               placeholder="مثال: YouTube" />
                    </div>
                </div>
                <div>
                    <label class="text-sm font-medium mb-1.5 block" style="color: var(--color-text-secondary)">أيقونة (Material Icon)</label>
                    <div class="relative">
                        <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-lg" style="color: var(--color-text-tertiary)">image</span>
                        <input type="text" name="Icon" value="@Model.Icon"
                               class="w-full rounded-xl py-2.5 pr-10 pl-3 text-sm font-medium focus:outline-none focus:ring-2 transition-all"
                               style="background: var(--color-bg-alt); border: 1px solid var(--color-border); color: var(--color-text); --tw-ring-color: var(--color-primary)"
                               placeholder="مثل: smart_display" />
                    </div>
                </div>
            </div>
            <div>
                <label class="text-sm font-medium mb-1.5 block" style="color: var(--color-text-secondary)">الرابط الأساسي (Base URL)</label>
                <div class="relative">
                    <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-lg" style="color: var(--color-text-tertiary)">link</span>
                    <input type="url" name="BaseUrl" value="@Model.BaseUrl"
                           class="w-full rounded-xl py-2.5 pr-10 pl-3 text-sm font-medium focus:outline-none focus:ring-2 transition-all"
                           style="background: var(--color-bg-alt); border: 1px solid var(--color-border); color: var(--color-text); --tw-ring-color: var(--color-primary)"
                           dir="ltr" placeholder="https://www.youtube.com/watch?v=" />
                </div>
                <p class="text-xs mt-1" style="color: var(--color-text-tertiary)">يُستخدم كبادئة عند إدخال رابط النشر — المستخدم يضيف فقط الـ ID أو username</p>
            </div>
        </div>
    </div>

    <div class="flex items-center justify-end gap-2 mt-6">
        <a href="/SocialPlatforms" class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-xl font-bold text-sm transition-all"
           style="color: var(--color-text-secondary)">
            <span class="material-symbols-rounded text-lg">cancel</span>
            إلغاء
        </a>
        <button type="submit" class="inline-flex items-center gap-1.5 px-6 py-2.5 rounded-xl font-bold text-sm shadow-sm transition-all"
                style="background: var(--color-primary); color: white">
            <span class="material-symbols-rounded text-lg">save</span>
            حفظ البيانات
        </button>
    </div>
</form>
