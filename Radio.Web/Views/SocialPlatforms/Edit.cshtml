@model SocialMediaPlatformDto
@{
    ViewData["Title"] = Model.SocialMediaPlatformId == 0 ? "منصة جديدة" : "تعديل منصة";
    var isEdit = Model.SocialMediaPlatformId != 0;
    ViewBag.IsEdit = isEdit;
    ViewBag.Icon = isEdit ? "edit" : "add";
    ViewBag.Title = isEdit ? "تعديل بيانات المنصة" : "إضافة منصة جديدة";
    ViewBag.Description = "إدخال وتحديث بيانات منصة النشر الرقمي والتكاملات المرتبطة بها";
    ViewBag.EntityName = "منصات النشر";
    ViewBag.EntityUrl = "/SocialPlatforms";
    ViewBag.BackUrl = "/SocialPlatforms";
    ViewBag.BackText = "الرجوع للمنصات";
}

<partial name="_CreateEditHeader" />

<form method="post" action="@(isEdit ? $"/SocialPlatforms/Edit/{Model.SocialMediaPlatformId}" : "/SocialPlatforms/Create")" class="max-w-2xl">
    @Html.AntiForgeryToken()
    @if (isEdit) { <input type="hidden" name="SocialMediaPlatformId" value="@Model.SocialMediaPlatformId" /> }

    @if (ViewContext.ModelState.ErrorCount > 0)
    {
        <div asp-validation-summary="All" class="bg-error/10 border border-error/20 text-error rounded-xl p-4 mb-6 font-semibold text-sm"></div>
    }

    <div class="wf-card">
        <div class="card-body space-y-4">
            <div class="flex items-center gap-2">
                <span class="material-symbols-rounded text-primary">share</span>
                <h3 class="font-bold text-base-content text-base">بيانات المنصة</h3>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="label">اسم المنصة *</label>
                    <div class="relative">
                        <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-base-content/40 pointer-events-none text-lg">badge</span>
                        <input type="text" name="Name" value="@Model.Name" class="input input-bordered w-full pr-10" required placeholder="مثال: YouTube" />
                    </div>
                </div>
                <div>
                    <label class="label">أيقونة (Material Icon)</label>
                    <div class="relative">
                        <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-base-content/40 pointer-events-none text-lg">image</span>
                        <input type="text" name="Icon" value="@Model.Icon" class="input input-bordered w-full pr-10" placeholder="مثل: smart_display" />
                    </div>
                </div>
            </div>
            <div>
                <label class="label">الرابط الأساسي (Base URL)</label>
                    <div class="relative">
                        <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-base-content/40 pointer-events-none text-lg">link</span>
                        <input type="url" name="BaseUrl" value="@Model.BaseUrl" class="input input-bordered w-full pr-10" dir="ltr" placeholder="https://www.youtube.com/watch?v=" />
                </div>
                <p class="text-xs text-base-content/60 mt-1">يُستخدم كبادئة عند إدخال رابط النشر — المستخدم يضيف فقط الـ ID أو username</p>
            </div>
        </div>
    </div>

    <div class="flex items-center justify-end gap-2 mt-6">
        <a href="/SocialPlatforms" class="btn btn-ghost">
            <span class="material-symbols-rounded">cancel</span>
            إلغاء
        </a>
        <button type="submit" class="btn btn-primary">
            <span class="material-symbols-rounded">save</span>
            حفظ البيانات
        </button>
    </div>
</form>
