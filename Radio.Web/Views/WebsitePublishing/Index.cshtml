@model List<PublishingRecordDto>
@{
    ViewData["Title"] = "نشر الموقع";
    var todayCount = Model.Count(r => r.RecordDate.Date == DateTime.UtcNow.Date);
    var thisMonth = Model.Count(r => r.RecordDate.Year == DateTime.UtcNow.Year && r.RecordDate.Month == DateTime.UtcNow.Month);
}

<div class="page-header">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 relative z-10">
        <div>
            <nav class="breadcrumb">
                <span class="material-symbols-rounded">home</span>
                <a href="/">الرئيسية</a>
                <span class="material-symbols-rounded">chevron_left</span>
                <span>نشر الموقع</span>
            </nav>
            <h1>
                <span class="material-symbols-rounded text-primary">public</span>
                نشر الموقع
            </h1>
            <p>إدارة عمليات نشر الحلقات على الموقع الرسمي للإذاعة</p>
        </div>
        <div class="flex items-center gap-2">
            @if (User.HasPermission(AppPermissions.EpisodeWebPublish))
            {
                <a href="/Episodes" class="btn-primary">
                    <span class="material-symbols-rounded">add</span>
                    نشر حلقة
                </a>
            }
        </div>
    </div>
</div>

<!-- Stats -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
    <div class="stat-card-premium text-accent">
        <div class="flex items-center justify-between">
            <div>
                <div class="text-2xl font-black text-ink">@Model.Count</div>
                <div class="text-xs font-bold text-ink-muted mt-1">إجمالي النشر</div>
            </div>
            <div class="w-12 h-12 rounded-xl bg-accent/10 text-accent flex items-center justify-center">
                <span class="material-symbols-rounded">language</span>
            </div>
        </div>
    </div>
    <div class="stat-card-premium text-success">
        <div class="flex items-center justify-between">
            <div>
                <div class="text-2xl font-black text-ink">@todayCount</div>
                <div class="text-xs font-bold text-ink-muted mt-1">نشر اليوم</div>
            </div>
            <div class="w-12 h-12 rounded-xl bg-success/10 text-success flex items-center justify-center">
                <span class="material-symbols-rounded">today</span>
            </div>
        </div>
    </div>
    <div class="stat-card-premium text-primary">
        <div class="flex items-center justify-between">
            <div>
                <div class="text-2xl font-black text-ink">@thisMonth</div>
                <div class="text-xs font-bold text-ink-muted mt-1">نشر هذا الشهر</div>
            </div>
            <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center">
                <span class="material-symbols-rounded">date_range</span>
            </div>
        </div>
    </div>
</div>

<!-- Records Table -->
<div class="table-premium">
    @if (!Model.Any())
    {
        <div class="empty-state p-12">
            <span class="material-symbols-rounded empty-icon">public</span>
            <h3 class="font-bold text-ink text-lg mb-2">لا توجد سجلات نشر موقع</h3>
            <p class="text-ink-muted text-sm mb-4">لم يتم نشر أي حلقات على الموقع بعد.</p>
            @if (User.HasPermission(AppPermissions.EpisodeWebPublish))
            {
                <a href="/Episodes" class="btn-primary">
                    <span class="material-symbols-rounded">add</span>
                    نشر حلقة
                </a>
            }
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr>
                        <th class="px-5 py-3 text-right font-semibold">الحلقة</th>
                        <th class="px-5 py-3 text-right font-semibold">البرنامج</th>
                        <th class="px-5 py-3 text-right font-semibold">العنوان</th>
                        <th class="px-5 py-3 text-right font-semibold">نوع الوسائط</th>
                        <th class="px-5 py-3 text-right font-semibold">بواسطة</th>
                        <th class="px-5 py-3 text-right font-semibold">التاريخ</th>
                        @if (User.HasPermission(AppPermissions.EpisodeWebPublish))
                        {
                            <th class="px-5 py-3 text-center font-semibold">إجراءات</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td class="px-5 py-3">
                                <a href="/Episodes/Details/@r.EpisodeId" class="text-primary font-semibold hover:underline" target="_blank">
                                    @(r.EpisodeName ?? "—")
                                </a>
                                <div class="text-xs text-ink-muted">@r.ProgramName</div>
                            </td>
                            <td class="px-5 py-3 text-ink-muted">@r.ProgramName</td>
                            <td class="px-5 py-3 text-ink-muted max-w-xs truncate">@r.Summary</td>
                            <td class="px-5 py-3">
                                <span class="badge badge-info">@GetMediaTypeText(r.Summary)</span>
                            </td>
                            <td class="px-5 py-3 text-ink-muted">@r.RecordedBy</td>
                            <td class="px-5 py-3 text-ink-muted whitespace-nowrap" dir="ltr">
                                <span class="text-ink">@r.RecordDate.ToString("yyyy-MM-dd")</span>
                                <span class="text-ink-soft">@r.RecordDate.ToString("HH:mm")</span>
                            </td>
                            @if (User.HasPermission(AppPermissions.EpisodeWebPublish))
                            {
                                <td class="px-5 py-3">
                                    <div class="flex items-center justify-center gap-1">
                                        <a href="/WebsitePublishing/Edit/@r.RecordId" class="icon-btn icon-btn-primary" title="تعديل">
                                            <span class="material-symbols-rounded">edit</span>
                                        </a>
                                        <button type="button" class="icon-btn icon-btn-danger" title="حذف"
                                                onclick="confirmDelete(@r.RecordId, '@(r.EpisodeName ?? "سجل")')">
                                            <span class="material-symbols-rounded">delete</span>
                                        </button>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Delete Modal -->
<div id="deleteModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4">
    <div class="bg-surface rounded-xl shadow-xl max-w-sm w-full p-6">
        <div class="text-center">
            <div class="w-16 h-16 bg-red-50 rounded-full flex items-center justify-center mx-auto mb-4">
                <span class="material-symbols-rounded text-danger text-3xl">delete_forever</span>
            </div>
            <h3 class="text-lg font-bold text-ink mb-2">حذف سجل نشر الموقع</h3>
            <p class="text-ink-muted text-sm mb-6" id="deleteMessage">هل أنت متأكد من حذف هذا السجل؟</p>
            <form id="deleteForm" method="post" action="">
                @Html.AntiForgeryToken()
                <div class="flex gap-2 justify-center">
                    <button type="button" class="btn-secondary" onclick="closeDeleteModal()">إلغاء</button>
                    <button type="submit" class="btn-danger">
                        <span class="material-symbols-rounded">delete</span>
                        حذف
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id, name) {
            document.getElementById('deleteMessage').textContent = 'هل أنت متأكد من حذف سجل نشر الموقع للحلقة "' + name + '"؟';
            document.getElementById('deleteForm').action = '/WebsitePublishing/Delete/' + id;
            document.getElementById('deleteModal').classList.remove('hidden');
            document.getElementById('deleteModal').classList.add('flex');
        }
        function closeDeleteModal() {
            document.getElementById('deleteModal').classList.add('hidden');
            document.getElementById('deleteModal').classList.remove('flex');
        }
        document.addEventListener('click', function (e) {
            if (e.target.classList.contains('bg-black/50')) closeDeleteModal();
        });
    </script>
}

@functions {
    string GetMediaTypeText(string? summary)
    {
        if (string.IsNullOrEmpty(summary)) return "—";
        if (summary.Contains("صوت")) return "صوت";
        if (summary.Contains("فيديو")) return "فيديو";
        return "صوت";
    }
}
