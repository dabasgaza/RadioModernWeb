@model List<PublishingRecordDto>
@{
    ViewData["Title"] = "نشر الموقع";
    ViewData["HeaderIcon"] = "public";
    ViewData["HeaderDescription"] = "إدارة عمليات نشر الحلقات على الموقع الرسمي للإذاعة";
    ViewBag.EntityName = "نشر الموقع";
    var todayCount = Model.Count(r => r.RecordDate.Date == DateTime.UtcNow.Date);
    var thisMonth = Model.Count(r => r.RecordDate.Year == DateTime.UtcNow.Year && r.RecordDate.Month == DateTime.UtcNow.Month);

    if (User.HasPermission(AppPermissions.EpisodeWebPublish))
    {
        ViewData["HeaderActions"] = "<a href='/Episodes' class='btn btn-primary rounded-xl gap-2'><span class='material-symbols-rounded text-lg'>add_circle</span>نشر حلقة</a>";
    }
}

<partial name="_PageHeader" />

<!-- KPI Cards -->
<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
    <div class="rounded-2xl border border-sys-outline-variant bg-sys-surface-bright p-5">
        <div class="flex items-center gap-2.5">
            <span class="material-symbols-rounded text-sys-info">language</span>
            <span class="text-2xl font-black tabular-nums text-sys-info">@Model.Count</span>
        </div>
        <span class="text-sm text-sys-on-surface-variant">إجمالي النشر</span>
    </div>
    <div class="rounded-2xl border border-sys-outline-variant bg-sys-surface-bright p-5">
        <div class="flex items-center gap-2.5">
            <span class="material-symbols-rounded text-sys-success">today</span>
            <span class="text-2xl font-black tabular-nums text-sys-success">@todayCount</span>
        </div>
        <span class="text-sm text-sys-on-surface-variant">نشر اليوم</span>
    </div>
    <div class="rounded-2xl border border-sys-outline-variant bg-sys-surface-bright p-5">
        <div class="flex items-center gap-2.5">
            <span class="material-symbols-rounded text-sys-primary">date_range</span>
            <span class="text-2xl font-black tabular-nums text-sys-primary">@thisMonth</span>
        </div>
        <span class="text-sm text-sys-on-surface-variant">نشر هذا الشهر</span>
    </div>
</div>

<!-- Records -->
@if (!Model.Any())
{
    <partial name="_EmptyState" model='new { Icon = "public", Title = "لا توجد سجلات نشر موقع", Description = "لم يتم نشر أي حلقات على الموقع بعد.", ActionUrl = User.HasPermission(AppPermissions.EpisodeWebPublish) ? "/Episodes" : null, ActionText = "نشر حلقة", ActionIcon = "add" }' />
}
else
{
    <div class="rounded-2xl border border-sys-outline-variant bg-sys-surface-bright overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="bg-sys-surface-container-low border-b border-sys-outline-variant">
                        <th class="px-6 py-4 text-right font-bold text-xs uppercase tracking-wider text-sys-on-surface-variant">الحلقة</th>
                        <th class="px-6 py-4 text-right font-bold text-xs uppercase tracking-wider text-sys-on-surface-variant">البرنامج</th>
                        <th class="px-6 py-4 text-right font-bold text-xs uppercase tracking-wider text-sys-on-surface-variant">العنوان</th>
                        <th class="px-6 py-4 text-right font-bold text-xs uppercase tracking-wider text-sys-on-surface-variant">نوع الوسائط</th>
                        <th class="px-6 py-4 text-right font-bold text-xs uppercase tracking-wider text-sys-on-surface-variant">بواسطة</th>
                        <th class="px-6 py-4 text-right font-bold text-xs uppercase tracking-wider text-sys-on-surface-variant">التاريخ</th>
                        @if (User.HasPermission(AppPermissions.EpisodeWebPublish))
                        {
                            <th class="px-6 py-4 text-center font-bold text-xs uppercase tracking-wider text-sys-on-surface-variant">إجراءات</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr class="transition-colors duration-200 border-b border-sys-outline-variant/60 hover:bg-sys-surface-container-low/50">
                            <td class="px-6 py-4">
                                <a href="/Episodes/Details/@r.EpisodeId" class="font-semibold hover:underline text-sys-primary" target="_blank">
                                    @(r.EpisodeName ?? "—")
                                </a>
                                <div class="text-xs mt-0.5 text-sys-outline">@r.ProgramName</div>
                            </td>
                            <td class="px-6 py-4 text-sys-on-surface-variant">@r.ProgramName</td>
                            <td class="px-6 py-4 max-w-xs truncate text-sys-on-surface-variant">@r.Summary</td>
                            <td class="px-6 py-4">
                                <span class="inline-flex items-center justify-center font-bold text-xs rounded-lg px-3 py-1.5 bg-sys-info-container text-sys-on-info-container">
                                    @GetMediaTypeText(r.Summary)
                                </span>
                            </td>
                            <td class="px-6 py-4 font-semibold text-sys-on-surface">@r.RecordedBy</td>
                            <td class="px-6 py-4 whitespace-nowrap" dir="ltr">
                                <span class="text-sys-on-surface-variant">@r.RecordDate.ToString("yyyy-MM-dd")</span>
                                <span class="text-sys-outline">@r.RecordDate.ToString("HH:mm")</span>
                            </td>
                            @if (User.HasPermission(AppPermissions.EpisodeWebPublish))
                            {
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center justify-center gap-1">
                                        <a href="/WebsitePublishing/Edit/@r.RecordId" class="inline-flex items-center justify-center w-9 h-9 rounded-xl transition-all text-sys-primary hover:bg-sys-primary-container/20"
                                           title="تعديل" aria-label="تعديل">
                                            <span class="material-symbols-rounded text-xl leading-none">edit</span>
                                        </a>
                                        <button type="button" class="inline-flex items-center justify-center w-9 h-9 rounded-xl transition-all text-sys-error hover:bg-sys-error-container/20"
                                                title="حذف" aria-label="حذف"
                                                onclick="confirmDelete(@r.RecordId, '@(r.EpisodeName ?? "سجل")')">
                                            <span class="material-symbols-rounded text-xl leading-none">delete</span>
                                        </button>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Delete Modal -->
<dialog id="deleteModal" class="p-0 bg-transparent border-0" style="max-width: 24rem;">
    <div class="rounded-2xl border w-full p-6 shadow-2xl" style="background: var(--color-surface); border-color: var(--color-border)">
        <div class="text-center">
            <div class="w-14 h-14 rounded-full flex items-center justify-center mx-auto mb-4" style="background: color-mix(in srgb, var(--color-error) 10%, transparent); color: var(--color-error)">
                <span class="material-symbols-rounded text-3xl">delete_forever</span>
            </div>
            <h3 class="text-base font-bold mb-2" style="color: var(--color-text)">حذف سجل نشر الموقع</h3>
            <p class="text-sm mb-5" id="deleteMessage" style="color: var(--color-text-secondary)">هل أنت متأكد من حذف هذا السجل؟</p>
            <form id="deleteForm" method="post" action="">
                @Html.AntiForgeryToken()
                <div class="flex gap-2 justify-center">
                    <button type="button" class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-bold rounded-xl transition-all"
                            style="color: var(--color-text-secondary)" onclick="closeDeleteModal()">إلغاء</button>
                    <button type="submit" class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-bold rounded-xl shadow-md transition-all"
                            style="background: var(--color-error); color: white">
                        <span class="material-symbols-rounded text-lg">delete</span>
                        حذف
                    </button>
                </div>
            </form>
        </div>
    </div>
</dialog>

@section Scripts {
    <script>
        function confirmDelete(id, name) {
            document.getElementById('deleteMessage').textContent = 'هل أنت متأكد من حذف سجل نشر الموقع للحلقة "' + name + '"؟';
            document.getElementById('deleteForm').action = '/WebsitePublishing/Delete/' + id;
            document.getElementById('deleteModal').showModal();
        }
        function closeDeleteModal() {
            document.getElementById('deleteModal').close();
        }
    </script>
}

@functions {
    string GetMediaTypeText(string? summary)
    {
        if (string.IsNullOrEmpty(summary)) return "—";
        if (summary.Contains("صوت")) return "صوت";
        if (summary.Contains("فيديو")) return "فيديو";
        return "صوت";
    }
}
