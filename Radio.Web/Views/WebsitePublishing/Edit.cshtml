@model WebsitePublishEditViewModel
@{
    ViewData["Title"] = "تعديل سجل نشر الموقع";
    var log = Model.Log;
    var episode = Model.Episode;
    ViewBag.IsEdit = true;
    ViewBag.Icon = "public";
    ViewBag.Title = "تعديل سجل نشر الموقع";
    ViewBag.Description = "تحديث وتعديل تفاصيل نشر الحلقة على الموقع الرسمي للإذاعة";
    ViewBag.EntityName = "نشر الموقع";
    ViewBag.EntityUrl = "/WebsitePublishing";
    ViewBag.BackUrl = "/WebsitePublishing";
    ViewBag.BackText = "الرجوع للنشر";
}

<partial name="_PageHeader" />

@if (log == null)
{
    <div class="rounded-xl p-4 font-semibold text-sm"
         style="background: color-mix(in srgb, var(--color-error) 10%, transparent); border: 1px solid color-mix(in srgb, var(--color-error) 20%, transparent); color: var(--color-error)">
        سجل النشر غير موجود.
    </div>
}
else
{

<!-- Episode Info -->
<div class="rounded-2xl border mb-4" style="background: var(--color-surface); border-color: var(--color-border)">
    <div class="p-5">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-full flex items-center justify-center shrink-0"
                     style="background: color-mix(in srgb, var(--color-primary) 10%, transparent); color: var(--color-primary)">
                    <span class="material-symbols-rounded">podcasts</span>
                </div>
                <div>
                    <h3 class="text-lg font-bold" style="color: var(--color-text)">@(episode?.EpisodeName ?? "—")</h3>
                    <p class="text-sm" style="color: var(--color-text-secondary)">@(episode?.ProgramName ?? "")</p>
                </div>
            </div>
            <a href="/Episodes/Details/@log.EpisodeId" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-sm font-bold transition-all" target="_blank"
               style="color: var(--color-text-secondary)">
                <span class="material-symbols-rounded">open_in_new</span>
                عرض الحلقة
            </a>
        </div>
    </div>
</div>

<form method="post" action="/WebsitePublishing/Edit/@log.Id">
    @Html.AntiForgeryToken()

    <div class="rounded-2xl border mb-4" style="background: var(--color-surface); border-color: var(--color-border)">
        <div class="p-5 space-y-4">
            <div class="flex items-center gap-2">
                <span class="material-symbols-rounded" style="color: var(--color-primary)">article</span>
                <h3 class="font-bold" style="color: var(--color-text)">تفاصيل النشر</h3>
            </div>
            <div>
                <label class="text-sm font-medium mb-1.5 block" style="color: var(--color-text-secondary)">عنوان النشر *</label>
                <div class="relative">
                    <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-lg" style="color: var(--color-text-tertiary)">title</span>
                    <input type="text" name="title"
                           class="w-full rounded-xl py-2.5 pr-10 pl-3 text-sm font-medium focus:outline-none focus:ring-2 transition-all"
                           style="background: var(--color-bg-alt); border: 1px solid var(--color-border); color: var(--color-text); --tw-ring-color: var(--color-primary)"
                           placeholder="عنوان الحلقة على الموقع" required value="@log.Title" />
                </div>
            </div>
            <div>
                <label class="text-sm font-medium mb-1.5 block" style="color: var(--color-text-secondary)">نوع الوسائط *</label>
                <div class="relative">
                    <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-lg" style="color: var(--color-text-tertiary)">category</span>
                    <select name="mediaType" required
                            class="w-full rounded-xl py-2.5 pr-10 pl-3 text-sm font-medium focus:outline-none focus:ring-2 transition-all"
                            style="background: var(--color-bg-alt); border: 1px solid var(--color-border); color: var(--color-text); --tw-ring-color: var(--color-primary)">
                        <option value="Audio" selected="@(log.MediaType == "Audio")">صوت</option>
                        <option value="Video" selected="@(log.MediaType == "Video")">فيديو</option>
                        <option value="Both" selected="@(log.MediaType == "Both")">صوت وفيديو</option>
                    </select>
                </div>
            </div>
            <div>
                <label class="text-sm font-medium mb-1.5 block" style="color: var(--color-text-secondary)">ملاحظات النشر</label>
                <div class="relative">
                    <span class="material-symbols-rounded absolute right-3 pointer-events-none text-lg"
                          style="top: 1rem; transform: none; color: var(--color-text-tertiary)">notes</span>
                    <textarea name="notes" rows="4"
                              class="w-full rounded-xl py-2.5 pr-10 pl-3 text-sm font-medium focus:outline-none focus:ring-2 transition-all"
                              style="background: var(--color-bg-alt); border: 1px solid var(--color-border); color: var(--color-text); --tw-ring-color: var(--color-primary)"
                              placeholder="أي ملاحظات إضافية حول النشر…">@log.Notes</textarea>
                </div>
            </div>
            <div class="text-xs" style="color: var(--color-text-tertiary)">
                تاريخ النشر: <span dir="ltr" style="color: var(--color-text-secondary)">@log.PublishedAt.ToString("yyyy-MM-dd HH:mm")</span>
            </div>
        </div>
    </div>

    <div class="flex items-center justify-end gap-2">
        <a href="/WebsitePublishing" class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-xl font-bold text-sm transition-all"
           style="color: var(--color-text-secondary)">
            <span class="material-symbols-rounded text-lg">cancel</span>
            إلغاء
        </a>
        <button type="submit" class="inline-flex items-center gap-1.5 px-6 py-2.5 rounded-xl font-bold text-sm shadow-sm transition-all"
                style="background: var(--color-primary); color: white">
            <span class="material-symbols-rounded text-lg">save</span>
            حفظ التعديلات
        </button>
    </div>
</form>

<!-- All Publishing Records for this Episode -->
<div class="rounded-2xl border mt-8" style="background: var(--color-surface); border-color: var(--color-border)">
    <div class="p-5">
        <div class="flex items-center gap-2 mb-4">
            <span class="material-symbols-rounded" style="color: var(--color-primary)">history</span>
            <h3 class="font-bold" style="color: var(--color-text)">كافة سجلات النشر والإنتاج الخاصة بهذه الحلقة (@(Model.EpisodePublishingRecords?.Count ?? 0))</h3>
        </div>
        @if (Model.EpisodePublishingRecords == null || !Model.EpisodePublishingRecords.Any())
        {
            <p class="text-sm" style="color: var(--color-text-secondary)">لا توجد سجلات أخرى لهذه الحلقة.</p>
        }
        else
        {
            <div class="rounded-2xl border overflow-hidden" style="border-color: var(--color-border)">
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead>
                            <tr style="background: var(--color-bg-alt)">
                                <th class="px-6 py-4 text-right font-bold text-xs uppercase tracking-wider" style="color: var(--color-text-secondary)">النوع</th>
                                <th class="px-6 py-4 text-right font-bold text-xs uppercase tracking-wider" style="color: var(--color-text-secondary)">التفاصيل / الملخص</th>
                                <th class="px-6 py-4 text-right font-bold text-xs uppercase tracking-wider" style="color: var(--color-text-secondary)">بواسطة</th>
                                <th class="px-6 py-4 text-right font-bold text-xs uppercase tracking-wider" style="color: var(--color-text-secondary)">التاريخ والتوقيت</th>
                                <th class="px-6 py-4 text-center font-bold text-xs uppercase tracking-wider" style="color: var(--color-text-secondary)">الإجراء</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.EpisodePublishingRecords)
                            {
                                <tr class="transition-colors duration-200" style="border-bottom: 1px solid color-mix(in srgb, var(--color-border) 40%, transparent)">
                                    <td class="px-6 py-4">
                                        <span class="inline-flex items-center justify-center font-bold text-xs rounded-lg px-3 py-1.5"
                                              style="background: color-mix(in srgb, @r.RecordColor 15%, transparent); color: @r.RecordColor">
                                            @GetRecordTypeName(r.RecordType)
                                        </span>
                                    </td>
                                    <td class="px-6 py-4" style="color: var(--color-text-secondary)">@r.Summary</td>
                                    <td class="px-6 py-4 font-medium" style="color: var(--color-text-secondary)">@(r.RecordedBy ?? "تلقائي")</td>
                                    <td class="px-6 py-4 text-xs" dir="ltr" style="color: var(--color-text-tertiary)">@r.RecordDate.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="px-6 py-4 text-center">
                                        @if (r.RecordType == "SocialMedia")
                                        {
                                            <a href="/Publishing/Edit/@r.RecordId" class="inline-flex items-center gap-1 font-bold hover:underline"
                                               style="color: var(--color-primary)">
                                                <span class="material-symbols-rounded" style="font-size: 14px;">edit</span> تعديل
                                            </a>
                                        }
                                        else if (r.RecordType == "Website")
                                        {
                                            <a href="/WebsitePublishing/Edit/@r.RecordId" class="inline-flex items-center gap-1 font-bold hover:underline"
                                               style="color: var(--color-primary)">
                                                <span class="material-symbols-rounded" style="font-size: 14px;">edit</span> تعديل
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-xs" style="color: var(--color-text-tertiary)">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>
}

@functions {
    string GetRecordTypeName(string t) => t switch
    {
        "Execution" => "سجل الإنتاج",
        "SocialMedia" => "نشر رقمي",
        "Website" => "نشر موقع",
        _ => t
    };
}
