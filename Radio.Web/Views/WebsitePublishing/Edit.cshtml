@model WebsitePublishEditViewModel
@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = "تعديل سجل نشر الموقع";
    var log = Model.Log;
    var episode = Model.Episode;
    ViewBag.IsEdit = true;
    ViewBag.Icon = "public";
    ViewBag.Title = "تعديل سجل نشر الموقع";
    ViewBag.Description = "تحديث وتعديل تفاصيل نشر الحلقة على الموقع الرسمي للإذاعة";
    ViewBag.EntityName = "نشر الموقع";
    ViewBag.EntityUrl = "/WebsitePublishing";
    ViewBag.BackUrl = "/WebsitePublishing";
    ViewBag.BackText = "الرجوع للنشر";
}

<partial name="_PageHeader" />

@if (log == null)
{
    <div class="rounded-xl p-4 font-semibold text-sm bg-danger-subtle text-danger border border-danger-subtle">
        سجل النشر غير موجود.
    </div>
}
else
{
    <div class="rounded-2xl border border-border bg-surface mb-4">
        <div class="p-5">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 rounded-full flex items-center justify-center shrink-0 bg-primary-subtle text-primary">
                        <span class="material-symbols-rounded">podcasts</span>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-text">@(episode?.EpisodeName ?? "—")</h3>
                        <p class="text-sm text-text-secondary">@(episode?.ProgramName ?? "")</p>
                    </div>
                </div>
                <a href="/Episodes/Details/@log.EpisodeId" class="btn btn-ghost rounded-xl gap-2 text-text-secondary" target="_blank">
                    <span class="material-symbols-rounded">open_in_new</span>عرض الحلقة
                </a>
            </div>
        </div>
    </div>

    <form method="post" action="/WebsitePublishing/Edit/@log.Id">
        @Html.AntiForgeryToken()

        <div class="card p-5">
            @{
                ViewBag.SectionIcon = "article"; ViewBag.SectionTitle = "تفاصيل النشر";
            }
            <partial name="_SectionHeader" />

            <div class="space-y-4">
                @{
                    ViewBag.FieldLabel = "عنوان النشر"; ViewBag.FieldName = "title";
                    ViewBag.FieldIcon = "title"; ViewBag.FieldValue = log.Title;
                    ViewBag.FieldRequired = true; ViewBag.FieldPlaceholder = "عنوان الحلقة على الموقع";
                }
                <partial name="_FormField" />

                @{
                    ViewBag.FieldLabel = "نوع الوسائط"; ViewBag.FieldName = "mediaType";
                    ViewBag.FieldIcon = "category"; ViewBag.FieldType = "select"; ViewBag.FieldRequired = true;
                    ViewBag.FieldOptions = new List<SelectListItem>
                    {
                        new() { Value = "Audio", Text = "صوت", Selected = log.MediaType == "Audio" },
                        new() { Value = "Video", Text = "فيديو", Selected = log.MediaType == "Video" },
                        new() { Value = "Both", Text = "صوت وفيديو", Selected = log.MediaType == "Both" },
                    };
                }
                <partial name="_FormField" />

                @{
                    ViewBag.FieldLabel = "ملاحظات النشر"; ViewBag.FieldName = "notes";
                    ViewBag.FieldIcon = "notes"; ViewBag.FieldValue = log.Notes;
                    ViewBag.FieldType = "textarea"; ViewBag.FieldPlaceholder = "أي ملاحظات إضافية حول النشر…";
                }
                <partial name="_FormField" />

                <div class="text-xs text-text-muted">
                    تاريخ النشر: <span dir="ltr" class="text-text-secondary">@log.PublishedAt.ToString("yyyy-MM-dd HH:mm")</span>
                </div>
            </div>
        </div>

        <div class="flex items-center justify-end gap-2 mt-6">
            <a href="/WebsitePublishing" class="btn btn-ghost rounded-xl gap-2">
                <span class="material-symbols-rounded">cancel</span>إلغاء
            </a>
            <button type="submit" class="btn btn-primary rounded-xl gap-2">
                <span class="material-symbols-rounded">save</span>حفظ التعديلات
            </button>
        </div>
    </form>

    <div class="rounded-2xl border border-border bg-surface mt-8">
        <div class="p-5">
            @{
                ViewBag.SectionIcon = "history"; ViewBag.SectionTitle = $"كافة سجلات النشر والإنتاج الخاصة بهذه الحلقة ({Model.EpisodePublishingRecords?.Count ?? 0})";
            }
            <partial name="_SectionHeader" />

            @if (Model.EpisodePublishingRecords == null || !Model.EpisodePublishingRecords.Any())
            {
                <p class="text-sm text-text-secondary">لا توجد سجلات أخرى لهذه الحلقة.</p>
            }
            else
            {
                <div class="rounded-2xl border border-border overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm">
                            <thead>
                                <tr class="bg-bg-hover">
                                    <th class="px-6 py-4 text-right font-bold text-xs uppercase text-text-secondary">النوع</th>
                                    <th class="px-6 py-4 text-right font-bold text-xs uppercase text-text-secondary">التفاصيل / الملخص</th>
                                    <th class="px-6 py-4 text-right font-bold text-xs uppercase text-text-secondary hidden md:table-cell">بواسطة</th>
                                    <th class="px-6 py-4 text-right font-bold text-xs uppercase text-text-secondary hidden md:table-cell">التاريخ والتوقيت</th>
                                    <th class="px-6 py-4 text-center font-bold text-xs uppercase text-text-secondary">الإجراء</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.EpisodePublishingRecords)
                                {
                                    <tr class="transition-colors duration-200 border-b border-border">
                                        <td class="px-6 py-4">
                                            <span class="inline-flex font-bold text-xs rounded-lg px-3 py-1.5" style="background:color-mix(in srgb, @r.RecordColor 15%, transparent); color:@r.RecordColor">
                                                @GetRecordTypeName(r.RecordType)
                                            </span>
                                        </td>
                                        <td class="px-6 py-4 text-text-secondary">@r.Summary</td>
                                        <td class="px-6 py-4 font-medium text-text-secondary hidden md:table-cell">@(r.RecordedBy ?? "تلقائي")</td>
                                        <td class="px-6 py-4 text-xs text-text-muted hidden md:table-cell" dir="ltr">@r.RecordDate.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td class="px-6 py-4 text-center">
                                            @if (r.RecordType == "SocialMedia")
                                            {
                                                <a href="/Publishing/Edit/@r.RecordId" class="inline-flex items-center gap-1 font-bold text-primary hover:underline">
                                                    <span class="material-symbols-rounded text-sm">edit</span> تعديل
                                                </a>
                                            }
                                            else if (r.RecordType == "Website")
                                            {
                                                <a href="/WebsitePublishing/Edit/@r.RecordId" class="inline-flex items-center gap-1 font-bold text-primary hover:underline">
                                                    <span class="material-symbols-rounded text-sm">edit</span> تعديل
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-xs text-text-muted">—</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
}

@functions {
    string GetRecordTypeName(string t) => t switch
    {
        "Execution" => "سجل الإنتاج",
        "SocialMedia" => "نشر رقمي",
        "Website" => "نشر موقع",
        _ => t
    };
}
