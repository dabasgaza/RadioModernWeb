@model WebsitePublishEditViewModel
@{
    ViewData["Title"] = "تعديل سجل نشر الموقع";
    var log = Model.Log;
    var episode = Model.Episode;
    ViewBag.IsEdit = true;
    ViewBag.Icon = "public";
    ViewBag.Title = "تعديل سجل نشر الموقع";
    ViewBag.Description = "تحديث وتعديل تفاصيل نشر الحلقة على الموقع الرسمي للإذاعة";
    ViewBag.EntityName = "نشر الموقع";
    ViewBag.EntityUrl = "/WebsitePublishing";
    ViewBag.BackUrl = "/WebsitePublishing";
    ViewBag.BackText = "الرجوع للنشر";
}

<partial name="_CreateEditHeader" />

@if (log == null)
{
    <div class="bg-red-50 border border-red-200 text-danger rounded-lg p-4">سجل النشر غير موجود.</div>
}
else
{

<!-- Episode Info -->
<div class="card-premium mb-4">
    <div class="card-body">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-blue-50 flex items-center justify-center shrink-0">
                    <span class="material-symbols-rounded text-primary">podcasts</span>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-ink">@(episode?.EpisodeName ?? "—")</h3>
                    <p class="text-sm text-ink-muted">@(episode?.ProgramName ?? "")</p>
                </div>
            </div>
            <a href="/Episodes/Details/@log.EpisodeId" class="btn-secondary text-sm" target="_blank">
                <span class="material-symbols-rounded">open_in_new</span>
                عرض الحلقة
            </a>
        </div>
    </div>
</div>

<form method="post" action="/WebsitePublishing/Edit/@log.Id">
    @Html.AntiForgeryToken()

    <div class="card-premium mb-4">
        <div class="card-header">
            <div class="flex items-center gap-2">
                <span class="material-symbols-rounded text-primary">article</span>
                <h3 class="font-bold text-ink text-base">تفاصيل النشر</h3>
            </div>
        </div>
        <div class="card-body space-y-4">
            <div>
                <label class="form-label">عنوان النشر *</label>
                <div class="input-wrapper">
                    <span class="material-symbols-rounded input-icon">title</span>
                    <input type="text" name="title" class="form-input" placeholder="عنوان الحلقة على الموقع" required value="@log.Title" />
                </div>
            </div>
            <div>
                <label class="form-label">نوع الوسائط *</label>
                <div class="input-wrapper">
                    <span class="material-symbols-rounded input-icon">category</span>
                    <select name="mediaType" class="form-input" required>
                        <option value="Audio" selected="@(log.MediaType == "Audio")">صوت</option>
                        <option value="Video" selected="@(log.MediaType == "Video")">فيديو</option>
                        <option value="Both" selected="@(log.MediaType == "Both")">صوت وفيديو</option>
                    </select>
                </div>
            </div>
            <div>
                <label class="form-label">ملاحظات النشر</label>
                <div class="input-wrapper">
                    <span class="material-symbols-rounded input-icon" style="top:1rem;transform:none">notes</span>
                    <textarea name="notes" rows="4" class="form-input" placeholder="أي ملاحظات إضافية حول النشر…">@log.Notes</textarea>
                </div>
            </div>
            <div class="text-xs text-ink-muted">
                تاريخ النشر: <span class="text-ink" dir="ltr">@log.PublishedAt.ToString("yyyy-MM-dd HH:mm")</span>
            </div>
        </div>
    </div>

    <div class="flex items-center justify-end gap-2">
        <a href="/WebsitePublishing" class="btn-secondary">
            <span class="material-symbols-rounded">cancel</span>
            إلغاء
        </a>
        <button type="submit" class="btn-primary">
            <span class="material-symbols-rounded">save</span>
            حفظ التعديلات
        </button>
    </div>
</form>

<!-- All Publishing Records for this Episode -->
<div class="card-premium mt-8 shadow-sm">
    <div class="card-header bg-surface-3">
        <div class="flex items-center gap-2">
            <span class="material-symbols-rounded text-primary">history</span>
            <h3 class="font-bold text-ink text-base">كافة سجلات النشر والإنتاج الخاصة بهذه الحلقة (@(Model.EpisodePublishingRecords?.Count ?? 0))</h3>
        </div>
    </div>
    <div class="card-body">
        @if (Model.EpisodePublishingRecords == null || !Model.EpisodePublishingRecords.Any())
        {
            <p class="text-sm text-ink-muted">لا توجد سجلات أخرى لهذه الحلقة.</p>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="text-ink-muted border-b border-border text-right text-xs">
                            <th class="pb-3 font-bold">النوع</th>
                            <th class="pb-3 font-bold">التفاصيل / الملخص</th>
                            <th class="pb-3 font-bold">بواسطة</th>
                            <th class="pb-3 font-bold">التاريخ والتوقيت</th>
                            <th class="pb-3 font-bold text-center">الإجراء</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border">
                        @foreach (var r in Model.EpisodePublishingRecords)
                        {
                            <tr class="hover:bg-surface-2 transition duration-200">
                                <td class="py-3">
                                    <span class="badge font-bold text-xs" style="background-color: @(r.RecordColor)15; color: @r.RecordColor">
                                        @GetRecordTypeName(r.RecordType)
                                    </span>
                                </td>
                                <td class="py-3 text-ink-muted">@r.Summary</td>
                                <td class="py-3 text-ink-muted font-medium">@(r.RecordedBy ?? "تلقائي")</td>
                                <td class="py-3 text-ink-soft text-xs" dir="ltr">@r.RecordDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="py-3 text-center">
                                    @if (r.RecordType == "SocialMedia")
                                    {
                                        <a href="/Publishing/Edit/@r.RecordId" class="text-primary font-bold hover:underline inline-flex items-center gap-1"><span class="material-symbols-rounded" style="font-size: 14px;">edit</span> تعديل</a>
                                    }
                                    else if (r.RecordType == "Website")
                                    {
                                        <a href="/WebsitePublishing/Edit/@r.RecordId" class="text-primary font-bold hover:underline inline-flex items-center gap-1"><span class="material-symbols-rounded" style="font-size: 14px;">edit</span> تعديل</a>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-ink-soft">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
}

@functions {
    string GetRecordTypeName(string t) => t switch
    {
        "Execution" => "سجل الإنتاج",
        "SocialMedia" => "نشر رقمي",
        "Website" => "نشر موقع",
        _ => t
    };
}
