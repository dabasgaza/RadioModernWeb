@model DataAccess.DTOs.ActiveEpisodeDto
@{
    ViewData["Title"] = "نشر على الموقع";
    var episode = Model;
}

<div class="page-header">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 relative z-10">
        <div>
            <nav class="breadcrumb">
                <span class="material-symbols-rounded">home</span>
                <a href="/">الرئيسية</a>
                <span class="material-symbols-rounded">chevron_left</span>
                <a href="/WebsitePublishing">نشر الموقع</a>
                <span class="material-symbols-rounded">chevron_left</span>
                <span>نشر جديد</span>
            </nav>
            <h1>
                <span class="material-symbols-rounded text-primary">public</span>
                نشر حلقة على الموقع
            </h1>
            <p>نشر حلقة إذاعية على الموقع الرسمي للإذاعة مع إرفاق الوسائط والتفاصيل</p>
        </div>
        <div class="flex items-center gap-2">
            <a href="/WebsitePublishing" class="btn-secondary">
                <span class="material-symbols-rounded">arrow_forward</span>
                الرجوع للنشر
            </a>
        </div>
    </div>
</div>

@if (episode == null)
{
    <div class="bg-red-50 border border-red-200 text-danger rounded-lg p-4">الحلقة غير موجودة.</div>
}
else
{

<!-- Episode Info -->
<div class="card-premium mb-4">
    <div class="card-body">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-blue-50 flex items-center justify-center shrink-0">
                    <span class="material-symbols-rounded text-primary">podcasts</span>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-ink">@episode.EpisodeName</h3>
                    <p class="text-sm text-ink-muted">@episode.ProgramName</p>
                </div>
            </div>
            <a href="/Episodes/Details/@episode.EpisodeId" class="btn-secondary text-sm" target="_blank">
                <span class="material-symbols-rounded">open_in_new</span>
                عرض التفاصيل
            </a>
        </div>
        @if (episode.GuestItems.Any())
        {
            <div class="mt-3 pt-3 border-t border-border flex flex-wrap gap-1.5">
                <span class="text-xs text-ink-muted font-semibold">الضيوف: </span>
                @foreach (var g in episode.GuestItems)
                {
                    <span class="badge badge-info">@g.Name</span>
                }
            </div>
        }
    </div>
</div>

<form method="post" action="/WebsitePublishing/Publish/@episode.EpisodeId">
    @Html.AntiForgeryToken()

    <div class="card-premium mb-4">
        <div class="card-header">
            <div class="flex items-center gap-2">
                <span class="material-symbols-rounded text-primary">article</span>
                <h3 class="font-bold text-ink text-base">تفاصيل النشر</h3>
            </div>
        </div>
        <div class="card-body space-y-4">
            <div>
                <label class="form-label">عنوان النشر *</label>
                <div class="input-wrapper">
                    <span class="material-symbols-rounded input-icon">title</span>
                    <input type="text" name="title" class="form-input" placeholder="عنوان الحلقة على الموقع" required value="@episode.EpisodeName" />
                </div>
            </div>
            <div>
                <label class="form-label">نوع الوسائط *</label>
                <div class="input-wrapper">
                    <span class="material-symbols-rounded input-icon">category</span>
                    <select name="mediaType" class="form-input" required>
                        <option value="1">صوت</option>
                        <option value="2">فيديو</option>
                        <option value="3">صوت وفيديو</option>
                    </select>
                </div>
            </div>
            <div>
                <label class="form-label">ملاحظات النشر</label>
                <textarea name="notes" rows="4" class="form-input" placeholder="أي ملاحظات إضافية حول النشر…"></textarea>
            </div>
        </div>
    </div>

    <div class="flex items-center justify-end gap-2">
        <a href="/WebsitePublishing" class="btn-secondary">
            <span class="material-symbols-rounded">cancel</span>
            إلغاء
        </a>
        <button type="submit" class="btn-primary">
            <span class="material-symbols-rounded">publish</span>
            نشر على الموقع
        </button>
    </div>
</form>
}
