@model DataAccess.DTOs.ActiveEpisodeDto
@{
    ViewData["Title"] = "نشر حلقة على الموقع";
    ViewData["HeaderIcon"] = "public";
    ViewData["HeaderDescription"] = "نشر حلقة إذاعية على الموقع الرسمي للإذاعة مع إرفاق الوسائط والتفاصيل";
    ViewBag.EntityName = "نشر البوابة الرقمية";
    ViewBag.EntityUrl = "/WebsitePublishing";
    ViewBag.BackUrl = "/WebsitePublishing";
    ViewBag.BackText = "الرجوع للنشر";
    var episode = Model;
}

<partial name="_PageHeader" />

@if (episode == null)
{
    <div class="rounded-xl p-4 font-semibold text-sm bg-danger-subtle border border-danger/20 text-danger">الحلقة غير موجودة.</div>
}
else
{

<!-- Episode Info -->
<div class="rounded-2xl border border-border bg-surface mb-4">
    <div class="p-5">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-full flex items-center justify-center shrink-0 bg-primary-subtle text-primary">
                    <span class="material-symbols-rounded">podcasts</span>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-text">@episode.EpisodeName</h3>
                    <p class="text-sm text-text-secondary">@episode.ProgramName</p>
                </div>
            </div>
            <a href="/Episodes/Details/@episode.EpisodeId" class="btn btn-ghost btn-sm gap-1.5" target="_blank">
                <span class="material-symbols-rounded">open_in_new</span>
                عرض التفاصيل
            </a>
        </div>
        @if (episode.GuestItems.Any())
        {
            <div class="mt-3 pt-3 border-t border-border flex flex-wrap gap-1.5">
                <span class="text-xs font-semibold text-text-muted">الضيوف: </span>
                @foreach (var g in episode.GuestItems)
                {
                    <span class="inline-flex items-center px-2.5 py-0.5 text-xs font-bold rounded-full bg-info-subtle text-info">@g.Name</span>
                }
            </div>
        }
    </div>
</div>

<form method="post" action="/WebsitePublishing/Publish/@episode.EpisodeId">
    @Html.AntiForgeryToken()

    <div class="rounded-2xl border border-border bg-surface mb-4">
        <div class="p-5 space-y-4">
            @{
                ViewBag.SectionIcon = "article"; ViewBag.SectionTitle = "تفاصيل النشر";
            }
            <partial name="_SectionHeader" />
            <div>
                <label class="text-sm font-medium mb-1.5 block text-text-secondary">عنوان النشر *</label>
                <div class="relative">
                    <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-lg text-text-muted">title</span>
                    <input type="text" name="title"
                           class="input pr-10"
                           placeholder="عنوان الحلقة على الموقع" required value="@episode.EpisodeName" />
                </div>
            </div>
            <div>
                <label class="text-sm font-medium mb-1.5 block text-text-secondary">نوع الوسائط *</label>
                <div class="relative">
                    <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-lg text-text-muted">category</span>
                    <select name="mediaType" required class="input pr-10">
                        <option value="1">صوت</option>
                        <option value="2">فيديو</option>
                        <option value="3">صوت وفيديو</option>
                    </select>
                </div>
            </div>
            <div>
                <label class="text-sm font-medium mb-1.5 block text-text-secondary">ملاحظات النشر</label>
                <textarea name="notes" rows="4" class="input"
                          placeholder="أي ملاحظات إضافية حول النشر…"></textarea>
            </div>
        </div>
    </div>

    <div class="flex items-center justify-end gap-2">
        <a href="/WebsitePublishing" class="btn btn-ghost gap-1.5">
            <span class="material-symbols-rounded text-lg">cancel</span>
            إلغاء
        </a>
        <button type="submit" class="btn btn-primary gap-1.5">
            <span class="material-symbols-rounded">publish</span>
            نشر على الموقع
        </button>
    </div>
</form>
}
