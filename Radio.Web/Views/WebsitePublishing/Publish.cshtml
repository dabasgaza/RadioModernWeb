@model DataAccess.DTOs.ActiveEpisodeDto
@{
    ViewData["Title"] = "نشر على الموقع";
    var episode = Model;
}

<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
    <div>
        <div class="breadcrumbs text-sm text-base-content/60">
            <ul>
                <li><a href="/" class="inline-flex items-center gap-1"><span class="material-symbols-rounded text-lg">home</span>الرئيسية</a></li>
                <li><a href="/WebsitePublishing" class="inline-flex items-center gap-1"><span class="material-symbols-rounded text-lg">public</span>نشر الموقع</a></li>
                <li><span class="inline-flex items-center gap-1"><span class="material-symbols-rounded text-lg">add</span>نشر جديد</span></li>
            </ul>
        </div>
        <h1 class="text-2xl font-extrabold text-base-content mt-1 flex items-center gap-2">
            <span class="material-symbols-rounded text-primary">public</span>
            نشر حلقة على الموقع
        </h1>
        <p class="text-sm text-base-content/60 mt-0.5">نشر حلقة إذاعية على الموقع الرسمي للإذاعة مع إرفاق الوسائط والتفاصيل</p>
    </div>
    <div class="flex items-center gap-2">
        <a href="/WebsitePublishing" class="btn btn-ghost">
            <span class="material-symbols-rounded">arrow_forward</span>
            الرجوع للنشر
        </a>
    </div>
</div>

@if (episode == null)
{
    <div class="bg-error/10 border border-error/20 text-error rounded-lg p-4">الحلقة غير موجودة.</div>
}
else
{

<!-- Episode Info -->
<div class="wf-card mb-4">
    <div class="card-body">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center shrink-0">
                    <span class="material-symbols-rounded text-primary">podcasts</span>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-base-content">@episode.EpisodeName</h3>
                    <p class="text-sm text-base-content/60">@episode.ProgramName</p>
                </div>
            </div>
            <a href="/Episodes/Details/@episode.EpisodeId" class="btn btn-ghost text-sm" target="_blank">
                <span class="material-symbols-rounded">open_in_new</span>
                عرض التفاصيل
            </a>
        </div>
        @if (episode.GuestItems.Any())
        {
            <div class="mt-3 pt-3 border-t border-base-200 flex flex-wrap gap-1.5">
                <span class="text-xs text-base-content/60 font-semibold">الضيوف: </span>
                @foreach (var g in episode.GuestItems)
                {
                    <span class="badge badge-info">@g.Name</span>
                }
            </div>
        }
    </div>
</div>

<form method="post" action="/WebsitePublishing/Publish/@episode.EpisodeId">
    @Html.AntiForgeryToken()

    <div class="wf-card mb-4">
        <div class="card-body space-y-4">
            <div class="flex items-center gap-2">
                <span class="material-symbols-rounded text-primary">article</span>
                <h3 class="font-bold text-base-content text-base">تفاصيل النشر</h3>
            </div>
            <div>
                <label class="label">عنوان النشر *</label>
                <div class="relative">
                    <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-base-content/40 pointer-events-none text-lg">title</span>
                    <input type="text" name="title" class="input input-bordered w-full pr-10" placeholder="عنوان الحلقة على الموقع" required value="@episode.EpisodeName" />
                </div>
            </div>
            <div>
                <label class="label">نوع الوسائط *</label>
                <div class="relative">
                    <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-base-content/40 pointer-events-none text-lg">category</span>
                    <select name="mediaType" class="select select-bordered w-full pr-10" required>
                        <option value="1">صوت</option>
                        <option value="2">فيديو</option>
                        <option value="3">صوت وفيديو</option>
                    </select>
                </div>
            </div>
            <div>
                <label class="label">ملاحظات النشر</label>
                <textarea name="notes" rows="4" class="textarea textarea-bordered" placeholder="أي ملاحظات إضافية حول النشر…"></textarea>
            </div>
        </div>
    </div>

    <div class="flex items-center justify-end gap-2">
        <a href="/WebsitePublishing" class="btn btn-ghost">
            <span class="material-symbols-rounded">cancel</span>
            إلغاء
        </a>
        <button type="submit" class="btn btn-primary">
            <span class="material-symbols-rounded">publish</span>
            نشر على الموقع
        </button>
    </div>
</form>
}
