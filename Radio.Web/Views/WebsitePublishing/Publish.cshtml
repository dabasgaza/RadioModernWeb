@model DataAccess.DTOs.ActiveEpisodeDto
@{
    ViewData["Title"] = "نشر على الموقع";
    var episode = Model;
}

<div class="mb-6">
    <nav class="text-sm text-ink-muted mb-2">
        <a href="/WebsitePublishing" class="hover:text-primary">نشر الموقع</a>
        <span class="mx-1">/</span>
        <span class="text-ink">نشر جديد</span>
    </nav>
    <h1 class="text-2xl font-bold text-ink flex items-center gap-2">
        <span class="material-symbols-rounded text-primary">public</span>
        نشر حلقة على الموقع
    </h1>
</div>

@if (episode == null)
{
    <div class="bg-red-50 border border-red-200 text-danger rounded-lg p-4">الحلقة غير موجودة.</div>
    return;
}

<!-- Episode Info -->
<div class="bg-surface rounded-xl border border-border p-5 mb-4">
    <div class="flex items-center justify-between">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-full bg-blue-50 flex items-center justify-center">
                <span class="material-symbols-rounded text-primary">podcasts</span>
            </div>
            <div>
                <h3 class="text-lg font-bold text-ink">@episode.EpisodeName</h3>
                <p class="text-sm text-ink-muted">@episode.ProgramName</p>
            </div>
        </div>
        <a href="/Episodes/Details/@episode.EpisodeId" class="btn-secondary text-sm" target="_blank">
            <span class="material-symbols-rounded">open_in_new</span>
            عرض التفاصيل
        </a>
    </div>
    @if (episode.GuestItems.Any())
    {
        <div class="mt-3 pt-3 border-t border-border">
            <span class="text-xs text-ink-muted">الضيوف: </span>
            @foreach (var g in episode.GuestItems)
            {
                <span class="badge badge-info ml-1">@g.Name</span>
            }
        </div>
    }
</div>

<form method="post" action="/WebsitePublishing/Publish/@episode.EpisodeId">
    @Html.AntiForgeryToken()

    <div class="bg-surface rounded-xl border border-border mb-4">
        <div class="p-5 border-b border-border">
            <h3 class="font-bold text-ink flex items-center gap-2">
                <span class="material-symbols-rounded text-primary">article</span>
                تفاصيل النشر
            </h3>
        </div>
        <div class="p-5 space-y-4">
            <div>
                <label class="form-label">عنوان النشر *</label>
                <input type="text" name="title" class="form-input" placeholder="عنوان الحلقة على الموقع" required
                       value="@episode.EpisodeName" />
            </div>
            <div>
                <label class="form-label">نوع الوسائط *</label>
                <select name="mediaType" class="form-input" required>
                    <option value="1">صوت</option>
                    <option value="2">فيديو</option>
                    <option value="3">صوت وفيديو</option>
                </select>
            </div>
            <div>
                <label class="form-label">ملاحظات النشر</label>
                <textarea name="notes" rows="4" class="form-input" placeholder="أي ملاحظات إضافية حول النشر…"></textarea>
            </div>
        </div>
    </div>

    <div class="flex items-center justify-end gap-2">
        <a href="/WebsitePublishing" class="btn-secondary">
            <span class="material-symbols-rounded">cancel</span>
            إلغاء
        </a>
        <button type="submit" class="btn-primary">
            <span class="material-symbols-rounded">publish</span>
            نشر على الموقع
        </button>
    </div>
</form>
