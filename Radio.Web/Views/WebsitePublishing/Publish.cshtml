@model DataAccess.DTOs.ActiveEpisodeDto
@{
    ViewData["Title"] = "نشر حلقة على الموقع";
    ViewData["HeaderIcon"] = "public";
    ViewData["HeaderDescription"] = "نشر حلقة إذاعية على الموقع الرسمي للإذاعة مع إرفاق الوسائط والتفاصيل";
    ViewBag.EntityName = "نشر البوابة الرقمية";
    ViewBag.EntityUrl = "/WebsitePublishing";
    ViewBag.BackUrl = "/WebsitePublishing";
    ViewBag.BackText = "الرجوع للنشر";
    var episode = Model;
}

<partial name="_PageHeader" />

<partial name="_PageHeader" />

@if (episode == null)
{
    <div class="rounded-xl p-4 font-semibold text-sm bg-sys-error-container border border-sys-error/20 text-sys-error">الحلقة غير موجودة.</div>
}
else
{

<!-- Episode Info -->
<div class="rounded-2xl border border-sys-outline-variant bg-sys-surface-bright mb-4">
    <div class="p-5">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-full flex items-center justify-center shrink-0 bg-sys-primary-container text-sys-on-primary-container">
                    <span class="material-symbols-rounded">podcasts</span>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-sys-on-surface">@episode.EpisodeName</h3>
                    <p class="text-sm text-sys-on-surface-variant">@episode.ProgramName</p>
                </div>
            </div>
            <a href="/Episodes/Details/@episode.EpisodeId" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-sm font-bold transition-all text-sys-on-surface-variant hover:bg-sys-surface-container-high" target="_blank">
                <span class="material-symbols-rounded">open_in_new</span>
                عرض التفاصيل
            </a>
        </div>
        @if (episode.GuestItems.Any())
        {
            <div class="mt-3 pt-3 border-t border-sys-outline-variant flex flex-wrap gap-1.5">
                <span class="text-xs font-semibold text-sys-outline">الضيوف: </span>
                @foreach (var g in episode.GuestItems)
                {
                    <span class="inline-flex items-center px-2.5 py-0.5 text-xs font-bold rounded-full bg-sys-info-container text-sys-on-info-container">@g.Name</span>
                }
            </div>
        }
    </div>
</div>

<form method="post" action="/WebsitePublishing/Publish/@episode.EpisodeId">
    @Html.AntiForgeryToken()

    <div class="rounded-2xl border border-sys-outline-variant bg-sys-surface-bright mb-4">
        <div class="p-5 space-y-4">
            <div class="flex items-center gap-2">
                <span class="material-symbols-rounded text-sys-primary">article</span>
                <h3 class="font-bold text-sys-on-surface">تفاصيل النشر</h3>
            </div>
            <div>
                <label class="text-sm font-medium mb-1.5 block text-sys-on-surface-variant">عنوان النشر *</label>
                <div class="relative">
                    <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-lg text-sys-outline">title</span>
                    <input type="text" name="title"
                           class="w-full rounded-xl py-2.5 pr-10 pl-3 text-sm font-medium bg-sys-surface-container-low border border-sys-outline-variant text-sys-on-surface focus:outline-none focus:ring-2 focus:ring-sys-primary/20 focus:border-sys-primary transition-all"
                           placeholder="عنوان الحلقة على الموقع" required value="@episode.EpisodeName" />
                </div>
            </div>
            <div>
                <label class="text-sm font-medium mb-1.5 block text-sys-on-surface-variant">نوع الوسائط *</label>
                <div class="relative">
                    <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-lg text-sys-outline">category</span>
                    <select name="mediaType" required
                            class="w-full rounded-xl py-2.5 pr-10 pl-3 text-sm font-medium bg-sys-surface-container-low border border-sys-outline-variant text-sys-on-surface focus:outline-none focus:ring-2 focus:ring-sys-primary/20 focus:border-sys-primary transition-all">
                        <option value="1">صوت</option>
                        <option value="2">فيديو</option>
                        <option value="3">صوت وفيديو</option>
                    </select>
                </div>
            </div>
            <div>
                <label class="text-sm font-medium mb-1.5 block text-sys-on-surface-variant">ملاحظات النشر</label>
                <textarea name="notes" rows="4"
                          class="w-full rounded-xl py-2.5 pr-10 pl-3 text-sm font-medium bg-sys-surface-container-low border border-sys-outline-variant text-sys-on-surface focus:outline-none focus:ring-2 focus:ring-sys-primary/20 focus:border-sys-primary transition-all"
                          placeholder="أي ملاحظات إضافية حول النشر…"></textarea>
            </div>
        </div>
    </div>

    <div class="flex items-center justify-end gap-2">
        <a href="/WebsitePublishing" class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-xl font-bold text-sm transition-all text-sys-on-surface-variant hover:bg-sys-surface-container-high">
            <span class="material-symbols-rounded text-lg">cancel</span>
            إلغاء
        </a>
        <button type="submit" class="inline-flex items-center gap-1.5 px-6 py-2.5 rounded-xl font-bold text-sm shadow-md transition-all bg-sys-primary text-sys-on-primary hover:bg-sys-primary-container">
            <span class="material-symbols-rounded">publish</span>
            نشر على الموقع
        </button>
    </div>
</form>
}
