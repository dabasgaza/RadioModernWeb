@model DiagnosticsViewModel
@{
    ViewData["Title"] = "تشخيص النظام";
    ViewData["HeaderIcon"] = "monitor_heart";
    ViewData["HeaderDescription"] = "مراقبة مؤشرات الأداء، الأخطاء، الاستعلامات البطيئة ومطالعة سجل النظام الفرعي";
}

<partial name="_PageHeader" />

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <div class="card p-5">
        <div class="flex items-center justify-between">
            <div>
                <div class="text-2xl font-black text-text">@Model.Summary.TotalLogs</div>
                <div class="text-xs font-bold mt-1 text-text-muted">إجمالي السجلات</div>
            </div>
            <div class="w-12 h-12 rounded-xl flex items-center justify-center bg-primary-subtle text-primary">
                <span class="material-symbols-rounded">list_alt</span>
            </div>
        </div>
    </div>

    <div class="card p-5">
        <div class="flex items-center justify-between">
            <div>
                <div class="text-2xl font-black text-text">@Model.Summary.TotalErrors</div>
                <div class="text-xs font-bold mt-1 text-text-muted">إجمالي الأخطاء</div>
            </div>
            <div class="w-12 h-12 rounded-xl flex items-center justify-center bg-danger-subtle text-danger">
                <span class="material-symbols-rounded">error</span>
            </div>
        </div>
    </div>

    <div class="card p-5">
        <div class="flex items-center justify-between">
            <div>
                <div class="text-2xl font-black text-text">@Model.Summary.TotalWarnings</div>
                <div class="text-xs font-bold mt-1 text-text-muted">التحذيرات</div>
            </div>
            <div class="w-12 h-12 rounded-xl flex items-center justify-center bg-warning-subtle text-warning">
                <span class="material-symbols-rounded">warning</span>
            </div>
        </div>
    </div>

    <div class="card p-5">
        <div class="flex items-center justify-between">
            <div>
                <div class="text-2xl font-black text-text">@Model.Summary.SlowQueriesCount</div>
                <div class="text-xs font-bold mt-1 text-text-muted">استعلامات بطيئة</div>
            </div>
            <div class="w-12 h-12 rounded-xl flex items-center justify-center bg-accent-subtle text-accent">
                <span class="material-symbols-rounded">speed</span>
            </div>
        </div>
    </div>
</div>

<div class="card overflow-hidden">
    <div class="p-5 border-b border-border flex items-center justify-between bg-surface">
        <h3 class="font-bold flex items-center gap-2 text-text">
            <span class="material-symbols-rounded text-primary">analytics</span>
            أحدث 100 سجل مراقبة للعمليات والأخطاء
        </h3>
    </div>
    <div class="overflow-x-auto">
    <table class="w-full text-sm">
        <thead>
            <tr class="bg-surface-hover border-b border-border">
                <th class="text-right font-semibold px-6 py-3.5 text-text">طابع الوقت</th>
                <th class="text-right font-semibold px-6 py-3.5 text-text">المستوى</th>
                <th class="text-right font-semibold px-6 py-3.5 text-text">الرسالة</th>
                <th class="text-right font-semibold px-6 py-3.5 text-text">السياق / المصدر</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var log in Model.Logs)
            {
                <tr class="border-t border-border hover:bg-surface-hover/50 transition-colors">
                    <td class="px-6 py-4 text-xs font-semibold text-text-muted">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td class="px-6 py-4">
                        <span class="inline-flex items-center px-2.5 py-0.5 text-xs font-bold rounded-full"
                              style="background: color-mix(in srgb, @GetLevelColor(log.Level) 10%, transparent); color: @GetLevelColor(log.Level)">
                            @log.Level
                        </span>
                    </td>
                    <td class="px-6 py-4 font-medium text-xs text-text-secondary">@log.Message</td>
                    <td class="px-6 py-4 text-xs max-w-xs truncate text-text-muted" title="@log.SourceContext">@log.SourceContext</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
</div>

@{ string GetLevelColor(string level) => level switch
    {
        "Error" or "Fatal" => "var(--color-error)",
        "Warning" => "var(--color-warning)",
        "Information" => "var(--color-info)",
        _ => "var(--color-text-muted)"
    }; }