@model DiagnosticsViewModel
@{ ViewData["Title"] = "تشخيص النظام"; }

<div class="page-header">
    <div class="relative z-10">
        <nav class="breadcrumb">
            <a href="/">الرئيسية</a>
            <span class="material-icons">chevron_left</span>
            <span>تشخيص النظام</span>
        </nav>
        <h1>
            <span class="material-icons">monitor_heart</span>
            تشخيص النظام
        </h1>
        <p>مؤشرات الأداء والسجلات</p>
    </div>
</div>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
    <div class="stat-card-premium" style="color: var(--color-primary);">
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-xl bg-primary/10 flex items-center justify-center">
                <span class="material-icons text-3xl" style="color: var(--color-primary);">list_alt</span>
            </div>
            <div>
                <div class="text-2xl font-black text-ink">@Model.Summary.TotalLogs</div>
                <div class="text-xs font-semibold text-ink-muted">إجمالي السجلات</div>
            </div>
        </div>
    </div>
    <div class="stat-card-premium" style="color: var(--color-danger);">
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-xl bg-red-50 flex items-center justify-center">
                <span class="material-icons text-3xl" style="color: var(--color-danger);">error</span>
            </div>
            <div>
                <div class="text-2xl font-black text-ink">@Model.Summary.TotalErrors</div>
                <div class="text-xs font-semibold text-ink-muted">إجمالي الأخطاء</div>
            </div>
        </div>
    </div>
    <div class="stat-card-premium" style="color: var(--color-warning);">
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-xl bg-amber-50 flex items-center justify-center">
                <span class="material-icons text-3xl" style="color: var(--color-warning);">warning</span>
            </div>
            <div>
                <div class="text-2xl font-black text-ink">@Model.Summary.TotalWarnings</div>
                <div class="text-xs font-semibold text-ink-muted">تحذيرات</div>
            </div>
        </div>
    </div>
    <div class="stat-card-premium" style="color: var(--color-warning);">
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-xl bg-orange-50 flex items-center justify-center">
                <span class="material-icons text-3xl" style="color: var(--color-warning);">speed</span>
            </div>
            <div>
                <div class="text-2xl font-black text-ink">@Model.Summary.SlowQueriesCount</div>
                <div class="text-xs font-semibold text-ink-muted">استعلامات بطيئة</div>
            </div>
        </div>
    </div>
</div>

<div class="table-premium">
    <div class="card-header">
        <h3 class="font-bold text-ink">آخر 100 سجل</h3>
    </div>
    <div class="overflow-x-auto">
        <table>
            <thead>
                <tr>
                    <th>الوقت</th>
                    <th>المستوى</th>
                    <th>الرسالة</th>
                    <th>المصدر</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model.Logs)
                {
                    <tr class="hover:bg-surface-2 transition duration-200">
                        <td class="text-ink-muted text-xs">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td><span class="badge-premium @GetLevelBadgeClass(log.Level)">@log.Level</span></td>
                        <td class="text-ink-muted">@log.Message</td>
                        <td class="text-ink-muted text-xs">@log.SourceContext</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@functions {
    string GetLevelBadgeClass(string level) => level switch
    {
        "Error" or "Fatal" => "bg-red-50 text-red-700 border-red-200",
        "Warning" => "bg-amber-50 text-amber-700 border-amber-200",
        "Information" => "bg-blue-50 text-blue-700 border-blue-200",
        _ => "bg-gray-50 text-gray-700 border-gray-200"
    };
}
