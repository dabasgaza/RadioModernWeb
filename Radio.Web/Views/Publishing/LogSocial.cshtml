@model SocialPublishingViewModel
@{
    ViewData["Title"] = "تسجيل نشر رقمي";
    ViewData["HeaderIcon"] = "share";
    ViewData["HeaderDescription"] = "تسجيل عملية نشر حلقة على منصات السوشيال ميديا مع إرفاق الروابط والتفاصيل";
    ViewBag.EntityName = "سجل النشر الموحد";
    ViewBag.EntityUrl = "/Publishing";
    ViewBag.BackUrl = "/Publishing";
    ViewBag.BackText = "الرجوع للسجل الموحد";
    var episode = Model.Episode;
}

<partial name="_PageHeader" />

@if (episode == null)
{
    <div class="rounded-xl p-4 font-semibold text-sm bg-danger-subtle text-danger border border-danger/20">الحلقة غير موجودة.</div>
    return;
}

<!-- Episode Info Header -->
<div class="card p-6 mb-6 relative overflow-hidden" style="background: linear-gradient(135deg, color-mix(in srgb, var(--color-primary) 5%, transparent), color-mix(in srgb, var(--color-accent) 5%, transparent));">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 relative z-10">
        <div class="flex items-start gap-4">
            <div class="p-3 rounded-2xl flex items-center justify-center bg-primary-subtle text-primary">
                <span class="material-symbols-rounded text-3xl" aria-hidden="true">radio</span>
            </div>
            <div>
                <span class="meta-pill bg-primary-subtle text-primary inline-block mb-1.5">الحلقة الحالية</span>
                <h3 class="text-xl font-black text-text">@episode.EpisodeName</h3>
                <p class="text-sm flex items-center gap-1.5 mt-0.5 text-text-secondary">
                    <span class="material-symbols-rounded text-sm text-text-muted" aria-hidden="true">folder</span>
                    البرنامج: @episode.ProgramName
                </p>
            </div>
        </div>
        <a href="/Episodes/Details/@episode.EpisodeId" class="btn btn-ghost rounded-xl font-bold text-sm gap-2 border border-primary text-primary" target="_blank">
            <span class="material-symbols-rounded" aria-hidden="true">open_in_new</span>
            تفاصيل الحلقة الكاملة
        </a>
    </div>
</div>

<form method="post" action="/Publishing/LogSocial/@episode.EpisodeId" class="space-y-6">
    @Html.AntiForgeryToken()

    <div id="guests-container" class="space-y-6">
        @if (Model.EpisodeGuests.Any())
        {
            @for (int i = 0; i < Model.EpisodeGuests.Count; i++)
            {
                var guest = Model.EpisodeGuests[i];
                <div class="card p-6 guest-card relative overflow-hidden transition-all duration-300" data-index="@i">
                    <!-- Guest Card Header -->
                    <div class="flex items-center gap-3 mb-6 pb-4 border-b border-border">
                        <div class="p-2.5 rounded-xl flex items-center justify-center bg-primary-subtle text-primary">
                            <span class="material-symbols-rounded" aria-hidden="true">person</span>
                        </div>
                        <div>
                            <h3 class="font-bold text-lg flex items-center gap-2 text-text">
                                @guest.FullName
                            </h3>
                            @if (!string.IsNullOrWhiteSpace(guest.Topic))
                            {
                                <p class="text-xs mt-0.5 text-text-secondary">الموضوع: @guest.Topic</p>
                            }
                        </div>
                    </div>

                    <input type="hidden" name="GuestLogs[@i].EpisodeGuestId" value="@guest.EpisodeGuestId" />

                    <!-- Form Inputs Row -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
                        <div>
                            <label class="text-xs font-bold mb-1.5 block text-text-secondary" for="ClipTitle_@i">عنوان المقطع المنشور</label>
                            <div class="relative">
                                <span class="material-symbols-rounded absolute right-4 top-1/2 -translate-y-1/2 text-sm text-text-muted" aria-hidden="true">title</span>
                                <input type="text" id="ClipTitle_@i" name="GuestLogs[@i].ClipTitle"
                                       class="input pr-12" placeholder="عنوان المقطع المنشور للضيف" />
                            </div>
                        </div>

                        <div>
                            <label class="text-xs font-bold mb-1.5 block text-text-secondary" for="DurationMinutes_@i">المدة (بالدقائق)</label>
                            <div class="relative">
                                <span class="material-symbols-rounded absolute right-4 top-1/2 -translate-y-1/2 text-sm text-text-muted" aria-hidden="true">hourglass_empty</span>
                                <input type="number" id="DurationMinutes_@i" name="GuestLogs[@i].DurationMinutes"
                                       class="input pr-12" placeholder="مدة المقطع" min="1" />
                            </div>
                        </div>

                        <div>
                            <label class="text-xs font-bold mb-1.5 block text-text-secondary" for="MediaType_@i">نوع الوسائط</label>
                            <div class="relative">
                                <span class="material-symbols-rounded absolute right-4 top-1/2 -translate-y-1/2 text-sm text-text-muted" aria-hidden="true">video_library</span>
                                <select id="MediaType_@i" name="GuestLogs[@i].MediaType" class="input pr-12">
                                    <option value="1">صوت</option>
                                    <option value="2">فيديو</option>
                                    <option value="3">صوت وفيديو</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Platforms Section -->
                    <div class="mt-6 pt-6 pb-2 border-t border-border">
                        <div class="flex items-center justify-between mb-4">
                            <h4 class="font-bold text-sm flex items-center gap-2 text-text">
                                <span class="material-symbols-rounded text-base text-primary" aria-hidden="true">link</span>
                                روابط ومنصات النشر للمقطع
                            </h4>
                            <button type="button" class="btn btn-ghost rounded-xl text-xs font-bold gap-1.5 border border-primary text-primary" onclick="addPlatform(@i)">
                                <span class="material-symbols-rounded text-sm" aria-hidden="true">add</span>
                                إضافة رابط منصة
                            </button>
                        </div>

                        <div class="platforms-container space-y-3" id="platforms-@i">
                            <div class="platform-row grid grid-cols-1 sm:grid-cols-12 gap-3 items-center p-4 rounded-2xl transition-all bg-bg-hover border border-border">
                                <div class="sm:col-span-4">
                                    <div class="relative">
                                        <span class="material-symbols-rounded absolute right-4 top-1/2 -translate-y-1/2 text-sm text-text-muted" aria-hidden="true">social_leaderboard</span>
                                        <select name="GuestLogs[@i].Platforms[0].PlatformId"
                                                class="input pr-12" aria-label="منصة النشر">
                                            <option value="">— اختر المنصة —</option>
                                            @foreach (var p in Model.Platforms)
                                            {
                                                <option value="@p.SocialMediaPlatformId">@p.Name</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="sm:col-span-7">
                                    <div class="relative">
                                        <span class="material-symbols-rounded absolute right-4 top-1/2 -translate-y-1/2 text-sm text-text-muted" aria-hidden="true">link</span>
                                        <input type="url" name="GuestLogs[@i].Platforms[0].Url"
                                               class="input pr-12" placeholder="رابط النشر (مثال: https://...)" dir="ltr" aria-label="رابط النشر" />
                                    </div>
                                </div>
                                <div class="sm:col-span-1 flex justify-end">
                                    <button type="button" class="btn btn-ghost btn-square text-danger" onclick="this.closest('.platform-row').remove()" title="حذف الرابط" aria-label="حذف الرابط">
                                        <span class="material-symbols-rounded text-lg" aria-hidden="true">delete</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="card border text-center py-12">
                <span class="material-symbols-rounded text-5xl mb-2 text-text-muted" aria-hidden="true">people</span>
                <p class="font-semibold text-text-secondary">لا يوجد ضيوف مسجلين في هذه الحلقة.</p>
            </div>
        }
    </div>

    <div class="flex items-center justify-end gap-3 mt-6">
        <a href="/Publishing" class="btn btn-ghost rounded-xl gap-1.5">
            <span class="material-symbols-rounded" aria-hidden="true">cancel</span>
            إلغاء
        </a>
        @if (Model.EpisodeGuests.Any())
        {
            <button type="submit" class="btn btn-primary rounded-xl gap-2 shadow-sm">
                <span class="material-symbols-rounded" aria-hidden="true">publish</span>
                تسجيل النشر
            </button>
        }
    </div>
</form>

@section Scripts {
    <script>
        const platformBaseUrls = @Html.Raw(Json.Serialize(Model.Platforms.ToDictionary(p => p.SocialMediaPlatformId.ToString(), p => p.BaseUrl ?? "")));

        let platformCounters = {};
        document.querySelectorAll('.guest-card').forEach(function (card) {
            const idx = card.dataset.index;
            platformCounters[idx] = 1;
        });

        document.getElementById('guests-container').addEventListener('change', function(e) {
            if (e.target.matches('select[name*=".PlatformId"]')) {
                const row = e.target.closest('.platform-row');
                if (!row) return;
                const urlInput = row.querySelector('input[type="url"]');
                const baseUrl = platformBaseUrls[e.target.value] || '';
                if (baseUrl && !urlInput.value) {
                    urlInput.value = baseUrl;
                }
            }
        });

        function addPlatform(guestIdx) {
            const container = document.getElementById('platforms-' + guestIdx);
            const count = platformCounters[guestIdx] || container.querySelectorAll('.platform-row').length;
            const html = `
                <div class="platform-row grid grid-cols-1 sm:grid-cols-12 gap-3 items-center p-4 rounded-2xl transition-all mt-3 bg-bg-hover border border-border">
                    <div class="sm:col-span-4">
                        <div class="relative">
                            <span class="material-symbols-rounded absolute right-4 top-1/2 -translate-y-1/2 text-sm text-text-muted" aria-hidden="true">social_leaderboard</span>
                            <select name="GuestLogs[${guestIdx}].Platforms[${count}].PlatformId"
                                    class="input pr-12" aria-label="منصة النشر">
                                <option value="">— اختر المنصة —</option>
                                @foreach (var p in Model.Platforms)
                                {
                                    <option value="@p.SocialMediaPlatformId">@p.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="sm:col-span-7">
                        <div class="relative">
                            <span class="material-symbols-rounded absolute right-4 top-1/2 -translate-y-1/2 text-sm text-text-muted" aria-hidden="true">link</span>
                            <input type="url" name="GuestLogs[${guestIdx}].Platforms[${count}].Url"
                                   class="input pr-12" placeholder="رابط النشر (مثال: https://...)" dir="ltr" aria-label="رابط النشر" />
                        </div>
                    </div>
                    <div class="sm:col-span-1 flex justify-end">
                        <button type="button" class="btn btn-ghost btn-square text-danger" onclick="this.closest('.platform-row').remove()" title="حذف الرابط" aria-label="حذف الرابط">
                            <span class="material-symbols-rounded text-lg" aria-hidden="true">delete</span>
                        </button>
                    </div>
                </div>`;
            container.insertAdjacentHTML('beforeend', html);
            platformCounters[guestIdx] = count + 1;
        }
    </script>
}
