@model SocialPublishingViewModel
@{
    ViewData["Title"] = "تسجيل نشر رقمي";
    var episode = Model.Episode;
}

<div class="mb-6">
    <nav class="text-sm text-ink-muted mb-2">
        <a href="/Publishing" class="hover:text-primary">النشر الرقمي</a>
        <span class="mx-1">/</span>
        <span class="text-ink">تسجيل نشر</span>
    </nav>
    <h1 class="text-2xl font-bold text-ink flex items-center gap-2">
        <span class="material-symbols-rounded text-primary">share</span>
        تسجيل نشر رقمي
    </h1>
</div>

@if (episode == null)
{
    <div class="bg-red-50 border border-red-200 text-danger rounded-lg p-4">الحلقة غير موجودة.</div>
    return;
}

<!-- Episode Info -->
<div class="bg-surface rounded-xl border border-border p-5 mb-4">
    <div class="flex items-center justify-between">
        <div>
            <h3 class="text-lg font-bold text-ink">@episode.EpisodeName</h3>
            <p class="text-sm text-ink-muted">@episode.ProgramName</p>
        </div>
        <a href="/Episodes/Details/@episode.EpisodeId" class="btn-secondary text-sm" target="_blank">
            <span class="material-symbols-rounded">open_in_new</span>
            عرض الحلقة
        </a>
    </div>
</div>

<form method="post" action="/Publishing/LogSocial/@episode.EpisodeId">
    @Html.AntiForgeryToken()

    <div id="guests-container">
        @if (Model.EpisodeGuests.Any())
        {
            @for (int i = 0; i < Model.EpisodeGuests.Count; i++)
            {
                var guest = Model.EpisodeGuests[i];
                <div class="bg-surface rounded-xl border border-border mb-4 guest-card" data-index="@i">
                    <div class="p-5 border-b border-border bg-surface-3 rounded-t-xl">
                        <h3 class="font-bold text-ink flex items-center gap-2">
                            <span class="material-symbols-rounded text-primary">person</span>
                            @guest.FullName
                            @if (!string.IsNullOrWhiteSpace(guest.Topic))
                            {
                                <span class="text-sm text-ink-muted font-normal">— @guest.Topic</span>
                            }
                        </h3>
                    </div>
                    <div class="p-5 space-y-4">
                        <input type="hidden" name="GuestLogs[@i].EpisodeGuestId" value="@guest.EpisodeGuestId" />

                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <div>
                                <label class="form-label">عنوان المقطع</label>
                                <input type="text" name="GuestLogs[@i].ClipTitle" class="form-input" placeholder="عنوان المقطع المنشور" />
                            </div>
                            <div>
                                <label class="form-label">المدة (دقيقة)</label>
                                <input type="number" name="GuestLogs[@i].DurationMinutes" class="form-input" placeholder="مدة المقطع بالدقائق" min="1" />
                            </div>
                            <div>
                                <label class="form-label">نوع الوسائط</label>
                                <select name="GuestLogs[@i].MediaType" class="form-input">
                                    <option value="1">صوت</option>
                                    <option value="2">فيديو</option>
                                    <option value="3">صوت وفيديو</option>
                                </select>
                            </div>
                        </div>

                        <!-- Platforms -->
                        <div>
                            <label class="form-label">منصات النشر</label>
                            <div class="platforms-container space-y-2" id="platforms-@i">
                                <div class="platform-row flex gap-2 items-start">
                                    <select name="GuestLogs[@i].Platforms[0].PlatformId" class="form-input flex-1">
                                        <option value="">— اختر المنصة —</option>
                                        @foreach (var p in Model.Platforms)
                                        {
                                            <option value="@p.SocialMediaPlatformId">@p.Name</option>
                                        }
                                    </select>
                                    <input type="url" name="GuestLogs[@i].Platforms[0].Url" class="form-input flex-[2]" placeholder="رابط النشر" dir="ltr" />
                                    <button type="button" class="icon-btn icon-btn-success add-platform-btn" onclick="addPlatform(@i)" title="إضافة منصة">
                                        <span class="material-symbols-rounded">add</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="bg-surface rounded-xl border border-border p-8 text-center">
                <span class="material-symbols-rounded text-ink-soft text-4xl mb-2">people</span>
                <p class="text-ink-muted">لا يوجد ضيوف في هذه الحلقة.</p>
            </div>
        }
    </div>

    <div class="flex items-center justify-end gap-2">
        <a href="/Publishing" class="btn-secondary">
            <span class="material-symbols-rounded">cancel</span>
            إلغاء
        </a>
        @if (Model.EpisodeGuests.Any())
        {
            <button type="submit" class="btn-primary">
                <span class="material-symbols-rounded">publish</span>
                تسجيل النشر
            </button>
        }
    </div>
</form>

@section Scripts {
    <script>
        const platformBaseUrls = @Html.Raw(Json.Serialize(Model.Platforms.ToDictionary(p => p.SocialMediaPlatformId.ToString(), p => p.BaseUrl ?? "")));

        let platformCounters = {};
        document.querySelectorAll('.guest-card').forEach(function (card) {
            const idx = card.dataset.index;
            platformCounters[idx] = 1;
        });

        document.getElementById('guests-container').addEventListener('change', function(e) {
            if (e.target.matches('select[name*=".PlatformId"]')) {
                const row = e.target.closest('.platform-row');
                if (!row) return;
                const urlInput = row.querySelector('input[type="url"]');
                const baseUrl = platformBaseUrls[e.target.value] || '';
                if (baseUrl && !urlInput.value) {
                    urlInput.value = baseUrl;
                }
            }
        });

        function addPlatform(guestIdx) {
            const container = document.getElementById('platforms-' + guestIdx);
            const count = platformCounters[guestIdx] || container.querySelectorAll('.platform-row').length;
            const html = `
                <div class="platform-row flex gap-2 items-start">
                    <select name="GuestLogs[${guestIdx}].Platforms[${count}].PlatformId" class="form-input flex-1">
                        <option value="">— اختر المنصة —</option>
                        @foreach (var p in Model.Platforms)
                        {
                            <option value="@p.SocialMediaPlatformId">@p.Name</option>
                        }
                    </select>
                    <input type="url" name="GuestLogs[${guestIdx}].Platforms[${count}].Url" class="form-input flex-[2]" placeholder="رابط النشر" dir="ltr" />
                    <button type="button" class="icon-btn icon-btn-danger" onclick="this.closest('.platform-row').remove()">
                        <span class="material-symbols-rounded">close</span>
                    </button>
                </div>`;
            container.insertAdjacentHTML('beforeend', html);
            platformCounters[guestIdx] = count + 1;
        }
    </script>
}
