@model SocialPublishingViewModel
@{
    ViewData["Title"] = "تسجيل نشر رقمي";
    ViewData["HeaderIcon"] = "share";
    ViewData["HeaderDescription"] = "تسجيل عملية نشر حلقة على منصات السوشيال ميديا مع إرفاق الروابط والتفاصيل";
    ViewBag.EntityName = "سجل النشر الموحد";
    ViewBag.EntityUrl = "/Publishing";
    ViewBag.BackUrl = "/Publishing";
    ViewBag.BackText = "الرجوع للسجل الموحد";
    var episode = Model.Episode;
}

<partial name="_PageHeader" />

@if (episode == null)
{
    <div class="rounded-xl p-4 font-semibold text-sm"
         style="background: color-mix(in srgb, var(--color-error) 10%, transparent); border: 1px solid color-mix(in srgb, var(--color-error) 20%, transparent); color: var(--color-error)">الحلقة غير موجودة.</div>
    return;
}

<!-- Episode Info Header -->
<div class="rounded-2xl border p-6 mb-6 relative overflow-hidden" style="background: linear-gradient(135deg, color-mix(in srgb, var(--color-primary) 5%, transparent), color-mix(in srgb, var(--color-accent) 5%, transparent)); border-color: color-mix(in srgb, var(--color-primary) 20%, transparent)">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 relative z-10">
        <div class="flex items-start gap-4">
            <div class="p-3 rounded-2xl flex items-center justify-center" style="background: color-mix(in srgb, var(--color-primary) 10%, transparent); color: var(--color-primary)">
                <span class="material-symbols-rounded text-3xl">radio</span>
            </div>
            <div>
                <span class="text-xs font-bold px-2.5 py-0.5 rounded-full inline-block mb-1.5"
                      style="background: color-mix(in srgb, var(--color-primary) 10%, transparent); color: var(--color-primary)">الحلقة الحالية</span>
                <h3 class="text-xl font-black" style="color: var(--color-text)">@episode.EpisodeName</h3>
                <p class="text-sm flex items-center gap-1.5 mt-0.5" style="color: var(--color-text-secondary)">
                    <span class="material-symbols-rounded text-sm" style="color: var(--color-text-muted)">folder</span>
                    البرنامج: @episode.ProgramName
                </p>
            </div>
        </div>
        <a href="/Episodes/Details/@episode.EpisodeId" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl font-bold text-sm transition-all" target="_blank"
           style="border: 1px solid var(--color-primary); color: var(--color-primary)">
            <span class="material-symbols-rounded">open_in_new</span>
            تفاصيل الحلقة الكاملة
        </a>
    </div>
</div>

<form method="post" action="/Publishing/LogSocial/@episode.EpisodeId" class="space-y-6">
    @Html.AntiForgeryToken()

    <div id="guests-container" class="space-y-6">
        @if (Model.EpisodeGuests.Any())
        {
            @for (int i = 0; i < Model.EpisodeGuests.Count; i++)
            {
                var guest = Model.EpisodeGuests[i];
                <div class="rounded-2xl border p-6 guest-card relative overflow-hidden group transition-all duration-300" data-index="@i" style="background: var(--color-surface); border-color: var(--color-border)">
                    <!-- Guest Card Header -->
                    <div class="flex items-center gap-3 mb-6 pb-4" style="border-bottom: 1px solid var(--color-border)">
                        <div class="p-2.5 rounded-xl flex items-center justify-center" style="background: color-mix(in srgb, var(--color-primary) 10%, transparent); color: var(--color-primary)">
                            <span class="material-symbols-rounded">person</span>
                        </div>
                        <div>
                            <h3 class="font-bold text-lg flex items-center gap-2" style="color: var(--color-text)">
                                @guest.FullName
                            </h3>
                            @if (!string.IsNullOrWhiteSpace(guest.Topic))
                            {
                                <p class="text-xs mt-0.5" style="color: var(--color-text-secondary)">الموضوع: @guest.Topic</p>
                            }
                        </div>
                    </div>

                    <input type="hidden" name="GuestLogs[@i].EpisodeGuestId" value="@guest.EpisodeGuestId" />

                    <!-- Form Inputs Row -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
                        <div>
                            <label class="text-xs font-bold mb-1.5 block" style="color: var(--color-text-secondary)">عنوان المقطع المنشور</label>
                            <div class="relative">
                                <span class="material-symbols-rounded absolute right-4 top-1/2 -translate-y-1/2 text-sm" style="color: var(--color-text-muted)">title</span>
                                <input type="text" name="GuestLogs[@i].ClipTitle"
                                       class="w-full rounded-xl py-2.5 pr-12 pl-3 text-sm font-medium focus:outline-none focus:ring-2 transition-all"
                                       style="background: var(--color-bg-alt); border: 1px solid var(--color-border); color: var(--color-text); --tw-ring-color: var(--color-primary)"
                                       placeholder="عنوان المقطع المنشور للضيف" />
                            </div>
                        </div>

                        <div>
                            <label class="text-xs font-bold mb-1.5 block" style="color: var(--color-text-secondary)">المدة (بالدقائق)</label>
                            <div class="relative">
                                <span class="material-symbols-rounded absolute right-4 top-1/2 -translate-y-1/2 text-sm" style="color: var(--color-text-muted)">hourglass_empty</span>
                                <input type="number" name="GuestLogs[@i].DurationMinutes"
                                       class="w-full rounded-xl py-2.5 pr-12 pl-3 text-sm font-medium focus:outline-none focus:ring-2 transition-all"
                                       style="background: var(--color-bg-alt); border: 1px solid var(--color-border); color: var(--color-text); --tw-ring-color: var(--color-primary)"
                                       placeholder="مدة المقطع" min="1" />
                            </div>
                        </div>

                        <div>
                            <label class="text-xs font-bold mb-1.5 block" style="color: var(--color-text-secondary)">نوع الوسائط</label>
                            <div class="relative">
                                <span class="material-symbols-rounded absolute right-4 top-1/2 -translate-y-1/2 text-sm" style="color: var(--color-text-muted)">video_library</span>
                                <select name="GuestLogs[@i].MediaType"
                                        class="w-full rounded-xl py-2.5 pr-12 pl-3 text-sm font-medium focus:outline-none focus:ring-2 transition-all"
                                        style="background: var(--color-bg-alt); border: 1px solid var(--color-border); color: var(--color-text); --tw-ring-color: var(--color-primary)">
                                    <option value="1">صوت</option>
                                    <option value="2">فيديو</option>
                                    <option value="3">صوت وفيديو</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Platforms Section -->
                    <div class="mt-6 pt-6 pb-2" style="border-top: 1px solid var(--color-border)">
                        <div class="flex items-center justify-between mb-4">
                            <h4 class="font-bold text-sm flex items-center gap-2" style="color: var(--color-text)">
                                <span class="material-symbols-rounded text-base" style="color: var(--color-primary)">link</span>
                                روابط ومنصات النشر للمقطع
                            </h4>
                            <button type="button" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold transition-all" style="border: 1px solid var(--color-primary); color: var(--color-primary)" onclick="addPlatform(@i)">
                                <span class="material-symbols-rounded text-sm">add</span>
                                إضافة رابط منصة
                            </button>
                        </div>
                        
                        <div class="platforms-container space-y-3" id="platforms-@i">
                            <div class="platform-row grid grid-cols-1 sm:grid-cols-12 gap-3 items-center p-4 rounded-2xl transition-all" style="background: var(--color-bg-alt); border: 1px solid var(--color-border)">
                                <div class="sm:col-span-4">
                                    <div class="relative">
                                        <span class="material-symbols-rounded absolute right-4 top-1/2 -translate-y-1/2 text-sm" style="color: var(--color-text-muted)">social_leaderboard</span>
                                        <select name="GuestLogs[@i].Platforms[0].PlatformId"
                                                class="w-full rounded-xl py-2.5 pr-12 pl-3 text-sm font-medium focus:outline-none focus:ring-2 transition-all"
                                                style="background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-text); --tw-ring-color: var(--color-primary)">
                                            <option value="">— اختر المنصة —</option>
                                            @foreach (var p in Model.Platforms)
                                            {
                                                <option value="@p.SocialMediaPlatformId">@p.Name</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="sm:col-span-7">
                                    <div class="relative">
                                        <span class="material-symbols-rounded absolute right-4 top-1/2 -translate-y-1/2 text-sm" style="color: var(--color-text-muted)">link</span>
                                        <input type="url" name="GuestLogs[@i].Platforms[0].Url"
                                               class="w-full rounded-xl py-2.5 pr-12 pl-3 text-sm font-medium focus:outline-none focus:ring-2 transition-all"
                                               style="background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-text); --tw-ring-color: var(--color-primary)"
                                               placeholder="رابط النشر (مثال: https://...)" dir="ltr" />
                                    </div>
                                </div>
                                <div class="sm:col-span-1 flex justify-end">
                                    <button type="button" class="inline-flex items-center justify-center w-9 h-9 rounded-lg transition-all" style="color: var(--color-error)" onclick="this.closest('.platform-row').remove()" title="حذف الرابط">
                                        <span class="material-symbols-rounded text-lg">delete</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="rounded-2xl border text-center py-12" style="background: var(--color-surface); border-color: var(--color-border)">
                <span class="material-symbols-rounded text-5xl mb-2" style="color: var(--color-text-muted)">people</span>
                <p class="font-semibold" style="color: var(--color-text-secondary)">لا يوجد ضيوف مسجلين في هذه الحلقة.</p>
            </div>
        }
    </div>

    <div class="flex items-center justify-end gap-3 mt-6">
        <a href="/Publishing" class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-xl font-bold text-sm transition-all"
           style="color: var(--color-text-secondary)">
            <span class="material-symbols-rounded">cancel</span>
            إلغاء
        </a>
        @if (Model.EpisodeGuests.Any())
        {
            <button type="submit" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl font-bold text-sm shadow-sm transition-all"
                    style="background: var(--color-primary); color: white">
                <span class="material-symbols-rounded">publish</span>
                تسجيل النشر
            </button>
        }
    </div>
</form>

@section Scripts {
    <script>
        const platformBaseUrls = @Html.Raw(Json.Serialize(Model.Platforms.ToDictionary(p => p.SocialMediaPlatformId.ToString(), p => p.BaseUrl ?? "")));

        let platformCounters = {};
        document.querySelectorAll('.guest-card').forEach(function (card) {
            const idx = card.dataset.index;
            platformCounters[idx] = 1;
        });

        document.getElementById('guests-container').addEventListener('change', function(e) {
            if (e.target.matches('select[name*=".PlatformId"]')) {
                const row = e.target.closest('.platform-row');
                if (!row) return;
                const urlInput = row.querySelector('input[type="url"]');
                const baseUrl = platformBaseUrls[e.target.value] || '';
                if (baseUrl && !urlInput.value) {
                    urlInput.value = baseUrl;
                }
            }
        });

        function addPlatform(guestIdx) {
            const container = document.getElementById('platforms-' + guestIdx);
            const count = platformCounters[guestIdx] || container.querySelectorAll('.platform-row').length;
            const html = `
                <div class="platform-row grid grid-cols-1 sm:grid-cols-12 gap-3 items-center p-4 rounded-2xl transition-all mt-3" style="background: var(--color-bg-alt); border: 1px solid var(--color-border)">
                    <div class="sm:col-span-4">
                        <div class="relative">
                            <span class="material-symbols-rounded absolute right-4 top-1/2 -translate-y-1/2 text-sm" style="color: var(--color-text-muted)">social_leaderboard</span>
                            <select name="GuestLogs[${guestIdx}].Platforms[${count}].PlatformId"
                                    class="w-full rounded-xl py-2.5 pr-12 pl-3 text-sm font-medium focus:outline-none focus:ring-2 transition-all"
                                    style="background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-text); --tw-ring-color: var(--color-primary)">
                                <option value="">— اختر المنصة —</option>
                                @foreach (var p in Model.Platforms)
                                {
                                    <option value="@p.SocialMediaPlatformId">@p.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="sm:col-span-7">
                        <div class="relative">
                            <span class="material-symbols-rounded absolute right-4 top-1/2 -translate-y-1/2 text-sm" style="color: var(--color-text-muted)">link</span>
                            <input type="url" name="GuestLogs[${guestIdx}].Platforms[${count}].Url"
                                   class="w-full rounded-xl py-2.5 pr-12 pl-3 text-sm font-medium focus:outline-none focus:ring-2 transition-all"
                                   style="background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-text); --tw-ring-color: var(--color-primary)"
                                   placeholder="رابط النشر (مثال: https://...)" dir="ltr" />
                        </div>
                    </div>
                    <div class="sm:col-span-1 flex justify-end">
                        <button type="button" class="inline-flex items-center justify-center w-9 h-9 rounded-lg transition-all" style="color: var(--color-error)" onclick="this.closest('.platform-row').remove()" title="حذف الرابط">
                            <span class="material-symbols-rounded text-lg">delete</span>
                        </button>
                    </div>
                </div>`;
            container.insertAdjacentHTML('beforeend', html);
            platformCounters[guestIdx] = count + 1;
        }
    </script>
}
