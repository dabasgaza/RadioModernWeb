@model SocialPublishingEditViewModel
@{
    ViewData["Title"] = "تعديل سجل النشر الرقمي";
    var log = Model.Log;
    var episode = Model.Episode;
    ViewBag.IsEdit = true;
    ViewBag.Icon = "share";
    ViewBag.Title = "تعديل سجل النشر الرقمي";
    ViewBag.Description = "تحديث وتعديل تفاصيل النشر على منصات السوشيال ميديا والروابط المرتبطة";
    ViewBag.EntityName = "سجل النشر الموحد";
    ViewBag.EntityUrl = "/Publishing";
    ViewBag.BackUrl = "/Publishing";
    ViewBag.BackText = "الرجوع للسجل الموحد";
}

<partial name="_CreateEditHeader" />

@if (log == null)
{
    <div class="bg-error/10 border border-error/20 text-error rounded-lg p-4">سجل النشر غير موجود.</div>
    return;
}

<!-- Episode Info -->
<div class="wf-card mb-4">
    <div class="card-body">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-4">
                <div class="w-11 h-11 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
                    <span class="material-symbols-rounded text-primary">podcasts</span>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-base-content">@(episode?.EpisodeName ?? "—")</h3>
                    <p class="text-sm text-base-content/60">@(episode?.ProgramName ?? "")</p>
                </div>
            </div>
            <a href="/Episodes/Details/@log.EpisodeId" class="btn btn-ghost text-sm" target="_blank">
                <span class="material-symbols-rounded">open_in_new</span>
                عرض الحلقة
            </a>
        </div>
    </div>
</div>

<form method="post" action="/Publishing/Edit/@log.LogId">
    @Html.AntiForgeryToken()

    <div id="guests-container">
        @if (Model.GuestLogs.Any())
        {
            @for (int i = 0; i < Model.GuestLogs.Count; i++)
            {
                var item = Model.GuestLogs[i];
                <div class="wf-card mb-4 guest-card" data-index="@i">
                    <div class="px-5 py-3 bg-base-200 rounded-t-box border-b border-base-200">
                        <h3 class="font-bold text-base-content flex items-center gap-2">
                            <span class="material-symbols-rounded text-primary">person</span>
                            @item.GuestName
                        </h3>
                    </div>
                    <div class="card-body space-y-4">
                        <input type="hidden" name="GuestLogs[@i].LogId" value="@item.LogId" />
                        <input type="hidden" name="GuestLogs[@i].EpisodeGuestId" value="@item.EpisodeGuestId" />
                        <input type="hidden" name="GuestLogs[@i].EpisodeId" value="@item.EpisodeId" />

                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <div>
                                <label class="label">عنوان المقطع</label>
                                <div class="relative">
                                    <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-base-content/40 pointer-events-none text-lg">title</span>
                                    <input type="text" name="GuestLogs[@i].ClipTitle" value="@item.ClipTitle" class="input input-bordered w-full pr-10" placeholder="عنوان المقطع المنشور" />
                                </div>
                            </div>
                            <div>
                                <label class="label">المدة (دقيقة)</label>
                                <div class="relative">
                                    <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-base-content/40 pointer-events-none text-lg">timer</span>
                                    <input type="number" name="GuestLogs[@i].DurationMinutes" value="@item.DurationMinutes" class="input input-bordered w-full pr-10" placeholder="مدة المقطع بالدقائق" min="1" />
                                </div>
                            </div>
                            <div>
                                <label class="label">نوع الوسائط</label>
                                <div class="relative">
                                    <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-base-content/40 pointer-events-none text-lg">category</span>
                                    <select name="GuestLogs[@i].MediaType" class="select select-bordered w-full pr-10">
                                        <option value="1" selected="@(item.MediaType == MediaType.Audio)">صوت</option>
                                        <option value="2" selected="@(item.MediaType == MediaType.Video)">فيديو</option>
                                        <option value="3" selected="@(item.MediaType == MediaType.Both)">صوت وفيديو</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Platforms -->
                        <div>
                            <label class="label">منصات النشر</label>
                            <div class="platforms-container space-y-2" id="platforms-@i">
                                @if (item.Platforms.Any())
                                {
                                    @for (int j = 0; j < item.Platforms.Count; j++)
                                    {
                                        var pf = item.Platforms[j];
                                        <div class="platform-row flex gap-2 items-start">
                                            <select name="GuestLogs[@i].Platforms[@j].PlatformId" class="select select-bordered flex-1">
                                                <option value="">— اختر المنصة —</option>
                                                @foreach (var p in Model.Platforms)
                                                {
                                                    <option value="@p.SocialMediaPlatformId" selected="@(pf.PlatformId == p.SocialMediaPlatformId)">@p.Name</option>
                                                }
                                            </select>
                                            <input type="url" name="GuestLogs[@i].Platforms[@j].Url" value="@pf.Url" class="input input-bordered flex-[2]" placeholder="رابط النشر" dir="ltr" />
                                            <button type="button" class="btn btn-ghost btn-square btn-sm text-error" onclick="this.closest('.platform-row').remove()" title="حذف المنصة">
                                                <span class="material-symbols-rounded">close</span>
                                            </button>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="platform-row flex gap-2 items-start">
                                        <select name="GuestLogs[@i].Platforms[0].PlatformId" class="select select-bordered flex-1">
                                            <option value="">— اختر المنصة —</option>
                                            @foreach (var p in Model.Platforms)
                                            {
                                                <option value="@p.SocialMediaPlatformId">@p.Name</option>
                                            }
                                        </select>
                                        <input type="url" name="GuestLogs[@i].Platforms[0].Url" class="input input-bordered flex-[2]" placeholder="رابط النشر" dir="ltr" />
                                        <button type="button" class="btn btn-ghost btn-square btn-sm text-success add-platform-btn" onclick="addPlatform(@i)" title="إضافة منصة">
                                            <span class="material-symbols-rounded">add</span>
                                        </button>
                                    </div>
                                }
                            </div>
                            <button type="button" class="btn btn-ghost text-sm mt-2" onclick="addPlatform(@i)">
                                <span class="material-symbols-rounded">add</span>
                                إضافة منصة
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="wf-card p-8 text-center">
                <span class="material-symbols-rounded text-base-content/40 text-4xl mb-2">people</span>
                <p class="text-base-content/60">لا يوجد سجلات نشر لهذه الحلقة.</p>
            </div>
        }
    </div>

    <div class="flex items-center justify-end gap-2">
        <a href="/Publishing" class="btn btn-ghost">
            <span class="material-symbols-rounded">cancel</span>
            إلغاء
        </a>
        @if (Model.GuestLogs.Any())
        {
            <button type="submit" class="btn btn-primary">
                <span class="material-symbols-rounded">save</span>
                حفظ التعديلات
            </button>
        }
    </div>
</form>

<!-- All Publishing Records for this Episode -->
<div class="wf-card mt-8">
    <div class="card-body">
        <div class="flex items-center gap-2 mb-4">
            <span class="material-symbols-rounded text-primary">history</span>
            <h3 class="font-bold text-base-content text-base">كافة سجلات النشر والإنتاج الخاصة بهذه الحلقة (@(Model.EpisodePublishingRecords?.Count ?? 0))</h3>
        </div>
        @if (Model.EpisodePublishingRecords == null || !Model.EpisodePublishingRecords.Any())
        {
            <p class="text-sm text-base-content/60">لا توجد سجلات أخرى لهذه الحلقة.</p>
        }
        else
        {
            <div class="wf-card overflow-hidden">
                <div class="overflow-x-auto">
                <table class="table table-zebra w-full text-sm">
                    <thead>
                        <tr class="text-base-content/60 border-b border-base-200 text-right text-xs">
                            <th class="pb-3 font-bold">النوع</th>
                            <th class="pb-3 font-bold">التفاصيل / الملخص</th>
                            <th class="pb-3 font-bold">بواسطة</th>
                            <th class="pb-3 font-bold">التاريخ والتوقيت</th>
                            <th class="pb-3 font-bold text-center">الإجراء</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-base-200">
                        @foreach (var r in Model.EpisodePublishingRecords)
                        {
                            <tr class="hover:bg-base-200 transition duration-200">
                                <td class="py-3">
                                    <span class="badge font-bold text-xs" style="background-color: @(r.RecordColor)15; color: @r.RecordColor">
                                        @GetRecordTypeName(r.RecordType)
                                    </span>
                                </td>
                                <td class="py-3 text-base-content/60">@r.Summary</td>
                                <td class="py-3 text-base-content/60 font-medium">@(r.RecordedBy ?? "تلقائي")</td>
                                <td class="py-3 text-base-content/40 text-xs" dir="ltr">@r.RecordDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="py-3 text-center">
                                    @if (r.RecordType == "SocialMedia")
                                    {
                                        <a href="/Publishing/Edit/@r.RecordId" class="text-primary font-bold hover:underline inline-flex items-center gap-1"><span class="material-symbols-rounded" style="font-size: 14px;">edit</span> تعديل</a>
                                    }
                                    else if (r.RecordType == "Website")
                                    {
                                        <a href="/WebsitePublishing/Edit/@r.RecordId" class="text-primary font-bold hover:underline inline-flex items-center gap-1"><span class="material-symbols-rounded" style="font-size: 14px;">edit</span> تعديل</a>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-base-content/40">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            </div>
        }
    </div>
</div>

@functions {
    string GetRecordTypeName(string t) => t switch
    {
        "Execution" => "سجل الإنتاج",
        "SocialMedia" => "نشر رقمي",
        "Website" => "نشر موقع",
        _ => t
    };
}

@section Scripts {
    <script>
        const platformBaseUrls = @Html.Raw(Json.Serialize(Model.Platforms.ToDictionary(p => p.SocialMediaPlatformId.ToString(), p => p.BaseUrl ?? "")));

        let platformCounters = {};
        document.querySelectorAll('.guest-card').forEach(function(card) {
            const idx = card.dataset.index;
            platformCounters[idx] = card.querySelectorAll('.platform-row').length;
        });

        document.getElementById('guests-container').addEventListener('change', function(e) {
            if (e.target.matches('select[name*=".PlatformId"]')) {
                const row = e.target.closest('.platform-row');
                if (!row) return;
                const urlInput = row.querySelector('input[type="url"]');
                const baseUrl = platformBaseUrls[e.target.value] || '';
                if (baseUrl && !urlInput.value) {
                    urlInput.value = baseUrl;
                }
            }
        });

        function addPlatform(guestIdx) {
            const container = document.getElementById('platforms-' + guestIdx);
            const count = platformCounters[guestIdx] || container.querySelectorAll('.platform-row').length;
            const html = `
                <div class="platform-row flex gap-2 items-start">
                    <select name="GuestLogs[${guestIdx}].Platforms[${count}].PlatformId" class="select select-bordered flex-1">
                        <option value="">— اختر المنصة —</option>
                        @foreach (var p in Model.Platforms)
                        {
                            <option value="@p.SocialMediaPlatformId">@p.Name</option>
                        }
                    </select>
                    <input type="url" name="GuestLogs[${guestIdx}].Platforms[${count}].Url" class="input input-bordered flex-[2]" placeholder="رابط النشر" dir="ltr" />
                    <button type="button" class="btn btn-ghost btn-square btn-sm text-error" onclick="this.closest('.platform-row').remove()">
                        <span class="material-symbols-rounded">close</span>
                    </button>
                </div>`;
            container.insertAdjacentHTML('beforeend', html);
            platformCounters[guestIdx] = count + 1;
        }
    </script>
}
