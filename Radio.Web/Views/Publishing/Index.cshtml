@model List<PublishingRecordDto>
@using Radio.Web.ViewModels
@{
    ViewData["Title"] = "سجل النشر والتوزيع الموحد";
    ViewData["HeaderIcon"] = "hub";
    ViewData["HeaderDescription"] = "متابعة وإدارة عمليات الإنتاج والنشر الرقمي على وسائل التواصل الاجتماعي والموقع الرسمي";
    ViewBag.EntityName = "سجل النشر";
    var socialCount = Model.Count(r => r.RecordType == "SocialMedia");
    var websiteCount = Model.Count(r => r.RecordType == "Website");
    var executionCount = Model.Count(r => r.RecordType == "Execution");
    var todayCount = Model.Count(r => r.RecordDate.Date == DateTime.UtcNow.Date);
    var programs = ViewBag.Programs as List<ProgramDto> ?? new();

    var kpiItems = new List<KpiItem>
    {
        new() { Label = "سجلات الإنتاج", Value = executionCount.ToString(), Icon = "check_circle", Subtitle = "منفذة ومسجلة" },
        new() { Label = "النشر الرقمي", Value = socialCount.ToString(), Icon = "rss_feed", Subtitle = "وسائل التواصل الاجتماعي" },
        new() { Label = "الموقع الرسمي", Value = websiteCount.ToString(), Icon = "public", Subtitle = "نشر على البوابة" },
        new() { Label = "نشاط اليوم", Value = todayCount.ToString(), Icon = "today", Subtitle = "سجلات منشورة اليوم" }
    };
    ViewBag.KpiItems = kpiItems;
}

<div class="max-w-7xl mx-auto space-y-6">
    <partial name="_PageHeader" />
    <partial name="_KpiCards" />

    <!-- Filters Section -->
    <div class="card p-5">
        <form method="get" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div>
                <label class="text-xs font-semibold text-text-secondary mb-1.5 block">البحث باسم الحلقة</label>
                <div class="relative">
                    <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-text-muted pointer-events-none text-base" aria-hidden="true">search</span>
                    <input type="text" name="search" value="@ViewBag.Search" placeholder="بحث باسم الحلقة..."
                           class="input pr-10" />
                </div>
            </div>
            <div>
                <label class="text-xs font-semibold text-text-secondary mb-1.5 block">حسب منصة النشر</label>
                <select name="type" class="input" onchange="this.form.submit()">
                    <option value="">كل منصات وأنواع النشر</option>
                    <option value="Execution" selected="@(ViewBag.TypeFilter == "Execution")">سجلات الإنتاج</option>
                    <option value="SocialMedia" selected="@(ViewBag.TypeFilter == "SocialMedia")">سجلات التواصل الاجتماعي</option>
                    <option value="Website" selected="@(ViewBag.TypeFilter == "Website")">سجلات الموقع الرسمي</option>
                </select>
            </div>
            <div>
                <label class="text-xs font-semibold text-text-secondary mb-1.5 block">فلترة حسب البرنامج</label>
                <select name="programId" class="input" onchange="this.form.submit()">
                    <option value="">كل البرامج</option>
                    @foreach (var prog in programs)
                    {
                        <option value="@prog.ProgramId" selected="@(ViewBag.ProgramFilter == prog.ProgramId)">@prog.ProgramName</option>
                    }
                </select>
            </div>
            <div class="flex gap-2 items-end">
                <button type="submit" class="btn btn-primary flex-1 gap-1.5">
                    <span class="material-symbols-rounded text-base" aria-hidden="true">filter_alt</span>
                    <span>تصفية</span>
                </button>
                <a href="/Publishing" class="btn btn-ghost btn-square" title="إعادة تهيئة" aria-label="إعادة تهيئة التصفية">
                    <span class="material-symbols-rounded text-base" aria-hidden="true">restart_alt</span>
                </a>
            </div>
        </form>
    </div>

    <!-- Records Grid Container -->
    @if (!Model.Any())
    {
        ViewBag.EmptyIcon = "folder_off";
        ViewBag.EmptyTitle = "لا توجد سجلات نشر مطابقة";
        ViewBag.EmptyDesc = "لم نتمكن من العثور على أية نتائج تطابق محددات البحث الحالية";
        <partial name="_EmptyState" />
    }
    else
    {
        <div class="card overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-xs text-right" aria-label="سجل النشر والتوزيع الموحد">
                    <thead>
                        <tr class="bg-bg border-b border-border text-text-muted font-bold uppercase tracking-wider">
                            <th scope="col" class="px-6 py-4">المنصة</th>
                            <th scope="col" class="px-6 py-4">معلومات الحلقة</th>
                            <th scope="col" class="px-6 py-4 hidden lg:table-cell">تفاصيل النشر</th>
                            <th scope="col" class="px-6 py-4 hidden md:table-cell">المسؤول</th>
                            <th scope="col" class="px-6 py-4 hidden md:table-cell">التوقيت</th>
                            <th scope="col" class="px-6 py-4 text-center">الخيارات</th>
                        </tr>
                    </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr class="transition-colors duration-200 border-b border-border-light">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="flex items-center gap-3">
                                    <div class="p-1.5 rounded-lg flex items-center justify-center" style="background-color: @r.RecordColor; color: white">
                                        <span class="material-symbols-rounded text-lg" aria-hidden="true">@GetRecordIcon(r.RecordType)</span>
                                    </div>
                                    <span class="meta-pill" style="background: color-mix(in srgb, @r.RecordColor 15%, transparent); color: @r.RecordColor">
                                        @GetRecordTypeName(r.RecordType)
                                    </span>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <a href="/Episodes/Details/@r.EpisodeId" class="font-semibold text-sm text-primary hover:underline transition-colors" target="_blank">
                                    @(r.EpisodeName ?? "حلقة غير معنونة")
                                </a>
                                <span class="text-xs mt-0.5 block text-text-muted">@r.ProgramName</span>
                            </td>
                            <td class="px-6 py-4 hidden lg:table-cell">
                                <div class="text-sm max-w-sm line-clamp-2 text-text-secondary">@r.Summary</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap hidden md:table-cell">
                                <div class="flex items-center gap-2">
                                    <div class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0 font-bold text-xs bg-primary-subtle text-primary">
                                        @(string.IsNullOrEmpty(r.RecordedBy) ? "ت" : r.RecordedBy.Substring(0, 1).ToUpper())
                                    </div>
                                    <div class="text-right">
                                        <div class="text-sm font-semibold text-text">@(r.RecordedBy ?? "مستخدم تلقائي")</div>
                                        <div class="text-[10px] text-text-muted">@GetRoleName(r.RecordType)</div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap hidden md:table-cell">
                                <div class="flex flex-col text-xs">
                                    <span class="font-semibold text-text">@r.RecordDate.ToString("yyyy-MM-dd")</span>
                                    <span class="text-text-muted">@r.RecordDate.ToString("hh:mm tt")</span>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="flex items-center justify-center gap-1">
                                    @if (r.RecordType == "SocialMedia" && User.HasPermission(AppPermissions.SocialPublishingPublish))
                                    {
                                        <a href="/Publishing/Edit/@r.RecordId" class="btn btn-ghost btn-square btn-sm text-primary" title="تعديل" aria-label="تعديل سجل النشر الرقمي">
                                            <span class="material-symbols-rounded text-xl leading-none" aria-hidden="true">edit</span>
                                        </a>
                                        <button type="button" class="btn btn-ghost btn-square btn-sm text-danger" title="حذف" aria-label="حذف سجل النشر الرقمي"
                                                onclick="confirmDelete(@r.RecordId, '@(r.EpisodeName ?? "سجل")')">
                                            <span class="material-symbols-rounded text-xl leading-none" aria-hidden="true">delete</span>
                                        </button>
                                    }
                                    @if (r.RecordType == "Website" && User.HasPermission(AppPermissions.WebsitePublishingPublish))
                                    {
                                        <a href="/WebsitePublishing/Edit/@r.RecordId" class="btn btn-ghost btn-square btn-sm text-primary" title="تعديل" aria-label="تعديل سجل نشر الموقع">
                                            <span class="material-symbols-rounded text-xl leading-none" aria-hidden="true">edit</span>
                                        </a>
                                        <button type="button" class="btn btn-ghost btn-square btn-sm text-danger" title="حذف" aria-label="حذف سجل نشر الموقع"
                                                onclick="confirmWebsiteDelete(@r.RecordId, '@(r.EpisodeName ?? "سجل")')">
                                            <span class="material-symbols-rounded text-xl leading-none" aria-hidden="true">delete</span>
                                        </button>
                                    }
                                    @if (r.RecordType == "Execution" && (User.HasPermission(AppPermissions.ExecutionExecute) || User.HasPermission(AppPermissions.ExecutionEdit)))
                                    {
                                        <a href="/ExecutionLogs/Edit/@r.RecordId" class="btn btn-ghost btn-square btn-sm text-primary" title="تعديل سجل التنفيذ" aria-label="تعديل سجل التنفيذ">
                                            <span class="material-symbols-rounded text-xl leading-none" aria-hidden="true">edit</span>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    }
</div>

@{
    ViewBag.DeleteModalId = "deleteModal";
    ViewBag.DeleteModalTitle = "حذف سجل النشر الرقمي";
    ViewBag.DeleteModalMessage = "هل أنت متأكد من حذف هذا السجل؟";
}
<partial name="_DeleteConfirmModal" />

@{
    ViewBag.DeleteModalId = "deleteWebsiteModal";
    ViewBag.DeleteModalTitle = "حذف سجل نشر الموقع";
    ViewBag.DeleteModalMessage = "هل أنت متأكد من حذف هذا السجل؟";
}
<partial name="_DeleteConfirmModal" />

@section Scripts {
    <script>
        function confirmDelete(id, name) {
            document.getElementById('deleteModalMessage').textContent = 'هل أنت متأكد من حذف سجل النشر الرقمي للحلقة "' + name + '"؟';
            document.getElementById('deleteModalForm').action = '/Publishing/Delete/' + id;
            document.getElementById('deleteModal').showModal();
        }
        function confirmWebsiteDelete(id, name) {
            document.getElementById('deleteWebsiteModalMessage').textContent = 'هل أنت متأكد من حذف سجل نشر الموقع للحلقة "' + name + '"؟';
            document.getElementById('deleteWebsiteModalForm').action = '/WebsitePublishing/Delete/' + id;
            document.getElementById('deleteWebsiteModal').showModal();
        }
    </script>
}

@{ string GetRecordTypeName(string t) => t switch
    {
        "Execution" => "سجل الإنتاج",
        "SocialMedia" => "نشر رقمي",
        "Website" => "نشر موقع",
        _ => t
    };

    string GetRecordIcon(string t) => t switch
    {
        "Execution" => "play_circle",
        "SocialMedia" => "share",
        "Website" => "public",
        _ => "assignment"
    };

    string GetRoleName(string t) => t switch
    {
        "Execution" => "مسؤول التنفيذ",
        "SocialMedia" => "مسؤول النشر الرقمي",
        "Website" => "مسؤول نشر الموقع",
        _ => "مسؤول النظام"
    }; }
