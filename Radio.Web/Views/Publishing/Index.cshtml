@model List<PublishingRecordDto>
@{
    ViewData["Title"] = "سجل النشر الموحد";
    var socialCount = Model.Count(r => r.RecordType == "SocialMedia");
    var websiteCount = Model.Count(r => r.RecordType == "Website");
    var executionCount = Model.Count(r => r.RecordType == "Execution");
    var todayCount = Model.Count(r => r.RecordDate.Date == DateTime.UtcNow.Date);
    var programs = ViewBag.Programs as List<ProgramDto> ?? new();
}

<div class="page-header">
    <div class="relative z-10">
        <nav class="breadcrumb">
            <a href="/">الرئيسية</a>
            <span class="material-icons">chevron_left</span>
            <span>سجل النشر الموحد</span>
        </nav>
        <h1>
            <span class="material-icons p-1.5 bg-primary/10 rounded-lg">share</span>
            سجل النشر الموحد
        </h1>
        <p>شاشة متكاملة لمتابعة وإدارة كافة عمليات الإنتاج والنشر الرقمي والموقع الرسمي</p>
    </div>
</div>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <div class="stat-card-premium" style="color: var(--color-success);">
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-xl bg-emerald-50 flex items-center justify-center shrink-0">
                <span class="material-icons text-3xl" style="color: var(--color-success);">check_circle</span>
            </div>
            <div>
                <span class="block text-2xl font-black text-ink">@executionCount</span>
                <span class="block text-xs font-semibold text-ink-muted">سجلات الإنتاج</span>
            </div>
        </div>
    </div>
    <div class="stat-card-premium" style="color: var(--color-primary);">
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-xl bg-blue-50 flex items-center justify-center shrink-0">
                <span class="material-icons text-3xl" style="color: var(--color-primary);">rss_feed</span>
            </div>
            <div>
                <span class="block text-2xl font-black text-ink">@socialCount</span>
                <span class="block text-xs font-semibold text-ink-muted">النشر الرقمي</span>
            </div>
        </div>
    </div>
    <div class="stat-card-premium" style="color: var(--color-accent);">
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-xl bg-indigo-50 flex items-center justify-center shrink-0">
                <span class="material-icons text-3xl" style="color: var(--color-accent);">public</span>
            </div>
            <div>
                <span class="block text-2xl font-black text-ink">@websiteCount</span>
                <span class="block text-xs font-semibold text-ink-muted">نشر الموقع الرسمي</span>
            </div>
        </div>
    </div>
    <div class="stat-card-premium" style="color: var(--color-warning);">
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-xl bg-amber-50 flex items-center justify-center shrink-0">
                <span class="material-icons text-3xl" style="color: var(--color-warning);">today</span>
            </div>
            <div>
                <span class="block text-2xl font-black text-ink">@todayCount</span>
                <span class="block text-xs font-semibold text-ink-muted">عمليات اليوم</span>
            </div>
        </div>
    </div>
</div>

<div class="card-premium mb-6">
    <div class="card-body">
        <form method="get" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div>
                <label class="form-label">البحث العام</label>
                <div class="relative">
                    <span class="material-icons absolute right-3 top-2.5 text-ink-soft">search</span>
                    <input type="text" name="search" value="@ViewBag.Search" placeholder="بحث باسم الحلقة…" class="form-input pr-10 w-full" />
                </div>
            </div>
            <div>
                <label class="form-label">حسب منصة النشر</label>
                <select name="type" class="form-input w-full" onchange="this.form.submit()">
                    <option value="">كل الأنواع</option>
                    <option value="Execution" selected="@(ViewBag.TypeFilter == "Execution")">سجلات الإنتاج</option>
                    <option value="SocialMedia" selected="@(ViewBag.TypeFilter == "SocialMedia")">النشر الرقمي</option>
                    <option value="Website" selected="@(ViewBag.TypeFilter == "Website")">نشر الموقع</option>
                </select>
            </div>
            <div>
                <label class="form-label">البرنامج</label>
                <select name="programId" class="form-input w-full" onchange="this.form.submit()">
                    <option value="">كل البرامج</option>
                    @foreach (var prog in programs)
                    {
                        <option value="@prog.ProgramId" selected="@(ViewBag.ProgramFilter == prog.ProgramId)">@prog.ProgramName</option>
                    }
                </select>
            </div>
            <div class="flex gap-2 items-end">
                <button type="submit" class="btn-primary flex-1">
                    <span class="material-icons text-sm">filter_alt</span>
                    تطبيق
                </button>
                <a href="/Publishing" class="btn-secondary px-4 justify-center" title="إعادة تعيين">
                    <span class="material-icons">restart_alt</span>
                </a>
            </div>
        </form>
    </div>
</div>

<div class="table-premium">
    @if (!Model.Any())
    {
        <div class="empty-state py-16 px-6 text-center">
            <div class="w-20 h-20 bg-ink-soft/5 rounded-full flex items-center justify-center mx-auto mb-4 text-ink-muted">
                <span class="material-icons text-5xl">folder_off</span>
            </div>
            <h3 class="font-bold text-ink text-xl mb-2">لا توجد سجلات مطابقة</h3>
            <p class="text-ink-muted text-sm max-w-sm mx-auto">لم يتم العثور على نتائج تطابق خيارات التصفية الحالية.</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table>
                <thead>
                    <tr>
                        <th>المنصة</th>
                        <th>الحلقة</th>
                        <th>التفاصيل</th>
                        <th>المسؤول</th>
                        <th>التوقيت</th>
                        <th class="text-center">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr class="hover:bg-surface-2 transition duration-200">
                            <td>
                                <div class="flex items-center gap-2">
                                    <div class="p-1.5 rounded-lg text-white flex items-center justify-center" style="background-color: @r.RecordColor">
                                        <span class="material-icons text-lg">@GetRecordIcon(r.RecordType)</span>
                                    </div>
                                    <span class="badge-premium font-bold" style="background-color: @(r.RecordColor)15; color: @r.RecordColor; border-color: @(r.RecordColor)30">
                                        @GetRecordTypeName(r.RecordType)
                                    </span>
                                </div>
                            </td>
                            <td>
                                <a href="/Episodes/Details/@r.EpisodeId" class="text-primary font-bold hover:underline block text-sm transition" target="_blank">
                                    @(r.EpisodeName ?? "حلقة غير معنونة")
                                </a>
                                <span class="text-xs font-medium text-ink-muted mt-0.5 inline-block bg-ink-soft/5 px-2 py-0.5 rounded">@r.ProgramName</span>
                            </td>
                            <td>
                                <div class="text-ink font-medium max-w-sm truncate">@r.Summary</div>
                            </td>
                            <td>
                                <div class="flex items-center gap-2">
                                    <div class="w-8 h-8 rounded-full bg-primary/10 text-primary font-bold text-xs flex items-center justify-center">
                                        @(string.IsNullOrEmpty(r.RecordedBy) ? "?" : r.RecordedBy.Substring(0, 1).ToUpper())
                                    </div>
                                    <span class="text-ink font-semibold">@(r.RecordedBy ?? "تلقائي")</span>
                                </div>
                            </td>
                            <td class="text-ink-muted whitespace-nowrap">
                                <div class="flex flex-col text-xs" dir="ltr">
                                    <span class="font-bold text-ink text-right">@r.RecordDate.ToString("yyyy-MM-dd")</span>
                                    <span class="text-ink-soft text-right mt-0.5">@r.RecordDate.ToString("HH:mm")</span>
                                </div>
                            </td>
                            <td>
                                <div class="flex items-center justify-center gap-1">
                                    @if (r.RecordType == "SocialMedia" && User.HasPermission(AppPermissions.EpisodePublish))
                                    {
                                        <a href="/Publishing/Edit/@r.RecordId" class="icon-btn bg-blue-50 text-blue-600 hover:bg-blue-100 p-2 rounded-lg transition" title="تعديل">
                                            <span class="material-icons text-sm">edit</span>
                                        </a>
                                        <button type="button" class="icon-btn bg-red-50 text-red-600 hover:bg-red-100 p-2 rounded-lg transition" title="حذف"
                                                onclick="confirmDelete(@r.RecordId, '@(r.EpisodeName ?? "سجل")')">
                                            <span class="material-icons text-sm">delete</span>
                                        </button>
                                    }
                                    @if (r.RecordType == "Website" && User.HasPermission(AppPermissions.EpisodeWebPublish))
                                    {
                                        <a href="/WebsitePublishing/Edit/@r.RecordId" class="icon-btn bg-blue-50 text-blue-600 hover:bg-blue-100 p-2 rounded-lg transition" title="تعديل">
                                            <span class="material-icons text-sm">edit</span>
                                        </a>
                                        <button type="button" class="icon-btn bg-red-50 text-red-600 hover:bg-red-100 p-2 rounded-lg transition" title="حذف"
                                                onclick="confirmWebsiteDelete(@r.RecordId, '@(r.EpisodeName ?? "سجل")')">
                                            <span class="material-icons text-sm">delete</span>
                                        </button>
                                    }
                                    @if (r.RecordType == "Execution")
                                    {
                                        <span class="text-xs text-ink-soft italic">غير قابل للتعديل</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div id="deleteModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/55 backdrop-blur-sm p-4">
    <div class="bg-surface rounded-2xl shadow-2xl max-w-sm w-full p-6 border border-border/80">
        <div class="text-center">
            <div class="w-16 h-16 bg-red-50 text-danger rounded-full flex items-center justify-center mx-auto mb-4">
                <span class="material-icons text-3xl">delete_forever</span>
            </div>
            <h3 class="text-lg font-bold text-ink mb-2">حذف سجل النشر الرقمي</h3>
            <p class="text-ink-muted text-sm mb-6" id="deleteMessage">هل أنت متأكد من حذف هذا السجل؟</p>
            <form id="deleteForm" method="post" action="">
                @Html.AntiForgeryToken()
                <div class="flex gap-2 justify-center">
                    <button type="button" class="btn-secondary px-5" onclick="closeDeleteModal()">إلغاء</button>
                    <button type="submit" class="btn-danger px-5">
                        <span class="material-icons">delete</span>
                        نعم، احذف
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div id="deleteWebsiteModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/55 backdrop-blur-sm p-4">
    <div class="bg-surface rounded-2xl shadow-2xl max-w-sm w-full p-6 border border-border/80">
        <div class="text-center">
            <div class="w-16 h-16 bg-red-50 text-danger rounded-full flex items-center justify-center mx-auto mb-4">
                <span class="material-icons text-3xl">delete_forever</span>
            </div>
            <h3 class="text-lg font-bold text-ink mb-2">حذف سجل نشر الموقع</h3>
            <p class="text-ink-muted text-sm mb-6" id="deleteWebsiteMessage">هل أنت متأكد من حذف هذا السجل؟</p>
            <form id="deleteWebsiteForm" method="post" action="">
                @Html.AntiForgeryToken()
                <div class="flex gap-2 justify-center">
                    <button type="button" class="btn-secondary px-5" onclick="closeWebsiteDeleteModal()">إلغاء</button>
                    <button type="submit" class="btn-danger px-5">
                        <span class="material-icons">delete</span>
                        نعم، احذف
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id, name) {
            document.getElementById('deleteMessage').textContent = 'هل أنت متأكد من حذف سجل النشر الرقمي للحلقة "' + name + '"؟';
            document.getElementById('deleteForm').action = '/Publishing/Delete/' + id;
            document.getElementById('deleteModal').classList.remove('hidden');
            document.getElementById('deleteModal').classList.add('flex');
        }
        function closeDeleteModal() {
            document.getElementById('deleteModal').classList.add('hidden');
            document.getElementById('deleteModal').classList.remove('flex');
        }
        function confirmWebsiteDelete(id, name) {
            document.getElementById('deleteWebsiteMessage').textContent = 'هل أنت متأكد من حذف سجل نشر الموقع للحلقة "' + name + '"؟';
            document.getElementById('deleteWebsiteForm').action = '/WebsitePublishing/Delete/' + id;
            document.getElementById('deleteWebsiteModal').classList.remove('hidden');
            document.getElementById('deleteWebsiteModal').classList.add('flex');
        }
        function closeWebsiteDeleteModal() {
            document.getElementById('deleteWebsiteModal').classList.add('hidden');
            document.getElementById('deleteWebsiteModal').classList.remove('flex');
        }
        document.addEventListener('click', function (e) {
            if (e.target.classList.contains('bg-black/55')) {
                closeDeleteModal();
                closeWebsiteDeleteModal();
            }
        });
    </script>
}

@functions {
    string GetRecordTypeName(string t) => t switch
    {
        "Execution" => "سجل الإنتاج",
        "SocialMedia" => "نشر رقمي",
        "Website" => "نشر موقع",
        _ => t
    };

    string GetRecordIcon(string t) => t switch
    {
        "Execution" => "play_circle_outline",
        "SocialMedia" => "share",
        "Website" => "public",
        _ => "clipboard"
    };
}
