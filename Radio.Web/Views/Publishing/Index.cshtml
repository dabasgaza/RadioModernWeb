    @{
        ViewBag.DeleteModalId = "deleteModal";
        ViewBag.DeleteModalTitle = "حذف سجل النشر الرقمي";
        ViewBag.DeleteModalMessage = "هل أنت متأكد من حذف هذا السجل؟";
    }
    <partial name="_DeleteConfirmModal" />

    @{
        ViewBag.DeleteModalId = "deleteWebsiteModal";
        ViewBag.DeleteModalTitle = "حذف سجل نشر الموقع";
        ViewBag.DeleteModalMessage = "هل أنت متأكد من حذف هذا السجل؟";
    }
    <partial name="_DeleteConfirmModal" />
</div>

@section Scripts {
    <script>
        (function () {
            // ── Existing delete helpers (preserved) ──
            window.confirmDelete = function (id, name) {
                document.getElementById('deleteModalMessage').textContent = 'هل أنت متأكد من حذف سجل النشر الرقمي للحلقة "' + name + '"؟';
                document.getElementById('deleteModalForm').action = '/Publishing/Delete/' + id;
                document.getElementById('deleteModal').showModal();
            };
            window.confirmWebsiteDelete = function (id, name) {
                document.getElementById('deleteWebsiteModalMessage').textContent = 'هل أنت متأكد من حذف سجل نشر الموقع للحلقة "' + name + '"؟';
                document.getElementById('deleteWebsiteModalForm').action = '/WebsitePublishing/Delete/' + id;
                document.getElementById('deleteWebsiteModal').showModal();
            };

            // ── Publishing Operations Center engine ──
            var cards = Array.prototype.slice.call(document.querySelectorAll('#poCards .po-card'));
            if (!cards.length) {
                document.getElementById('poEmpty') && document.getElementById('poEmpty').classList.remove('hidden');
                return;
            }

            var searchInput = document.getElementById('poSearchInput');
            var fromInput = document.getElementById('poDateFrom');
            var toInput = document.getElementById('poDateTo');
            var statusSel = document.getElementById('poStatus');
            var sortSel = document.getElementById('poSort');
            var countEl = document.getElementById('poCount');
            var rangeEl = document.getElementById('poRange');
            var emptyEl = document.getElementById('poEmpty');
            var pager = document.getElementById('poPager');
            var pagerBtns = document.getElementById('poPagerBtns');
            var skel = document.getElementById('poSkel');
            var cardsWrap = document.getElementById('poCards');
            var PAGE_SIZE = 12;
            var page = 1;
            var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            function isVisible(card) {
                var q = searchInput.value.trim().toLowerCase();
                if (q && card.dataset.search.indexOf(q) === -1) return false;
                var st = statusSel.value;
                if (st !== 'all' && card.dataset.status !== st) return false;
                var d = new Date(card.dataset.date);
                if (fromInput.value && d < new Date(fromInput.value + 'T00:00:00')) return false;
                if (toInput.value && d > new Date(toInput.value + 'T23:59:59')) return false;
                return true;
            }

            function filtered() {
                var list = cards.filter(isVisible);
                var dir = sortSel.value === 'oldest' ? 1 : -1;
                list.sort(function (a, b) {
                    return dir * (new Date(a.dataset.date) - new Date(b.dataset.date));
                });
                return list;
            }

            function pageWindow(total) {
                if (total <= 7) {
                    var all = [];
                    for (var i = 1; i <= total; i++) all.push(i);
                    return all;
                }
                var win = [1];
                if (page > 4) win.push('…');
                for (var p = Math.max(2, page - 1); p <= Math.min(total - 1, page + 1); p++) win.push(p);
                if (page < total - 3) win.push('…');
                win.push(total);
                return win;
            }

            function buildPager(totalPages) {
                pager.hidden = totalPages <= 1;
                pagerBtns.innerHTML = '';
                if (totalPages <= 1) return;

                var prev = document.createElement('button');
                prev.type = 'button';
                prev.className = 'pagination-nav' + (page <= 1 ? ' disabled' : '');
                prev.setAttribute('aria-label', 'السابق');
                prev.innerHTML = '<span class="material-symbols-rounded">chevron_right</span>';
                prev.disabled = page <= 1;
                prev.addEventListener('click', function () { if (page > 1) { page--; render(); } });
                pagerBtns.appendChild(prev);

                pageWindow(totalPages).forEach(function (p) {
                    if (p === '…') {
                        var ell = document.createElement('span');
                        ell.className = 'pagination-ellipsis';
                        ell.textContent = '…';
                        pagerBtns.appendChild(ell);
                        return;
                    }
                    var btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'pagination-page' + (p === page ? ' active' : '');
                    btn.textContent = p;
                    btn.setAttribute('aria-label', 'صفحة ' + p);
                    if (p === page) btn.setAttribute('aria-current', 'page');
                    btn.addEventListener('click', function () { page = p; render(); });
                    pagerBtns.appendChild(btn);
                });

                var next = document.createElement('button');
                next.type = 'button';
                next.className = 'pagination-nav' + (page >= totalPages ? ' disabled' : '');
                next.setAttribute('aria-label', 'التالي');
                next.innerHTML = '<span class="material-symbols-rounded">chevron_left</span>';
                next.disabled = page >= totalPages;
                next.addEventListener('click', function () { if (page < totalPages) { page++; render(); } });
                pagerBtns.appendChild(next);
            }

            function render() {
                var list = filtered();
                var totalPages = Math.max(1, Math.ceil(list.length / PAGE_SIZE));
                if (page > totalPages) page = totalPages;
                var start = (page - 1) * PAGE_SIZE;
                var slice = list.slice(start, start + PAGE_SIZE);
                var inSlice = {};
                slice.forEach(function (c) { inSlice[c.dataset.id] = true; });

                cards.forEach(function (c) {
                    var show = !!inSlice[c.dataset.id];
                    c.classList.toggle('hidden', !show);
                    if (show) {
                        c.classList.remove('po-card-enter');
                        if (!reduceMotion) { void c.offsetWidth; c.classList.add('po-card-enter'); }
                    }
                });

                countEl.textContent = list.length + (list.length === 1 ? ' سجل' : ' سجل');
                if (rangeEl) rangeEl.textContent = slice.length ? ('عرض ' + (start + 1) + '–' + (start + slice.length) + ' من ' + list.length) : '';
                if (emptyEl) emptyEl.classList.toggle('hidden', list.length > 0);
                buildPager(totalPages);
            }

            // Events
            searchInput.addEventListener('input', function () { page = 1; render(); });
            [fromInput, toInput, statusSel, sortSel].forEach(function (el) {
                el.addEventListener('change', function () { page = 1; render(); });
            });

            // Copy link buttons
            document.querySelectorAll('.po-copy').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var url = window.location.origin + btn.dataset.copy;
                    function done() {
                        btn.classList.add('po-copy-done');
                        var icon = btn.querySelector('.material-symbols-rounded');
                        var prev = icon.textContent;
                        icon.textContent = 'check';
                        btn.setAttribute('title', 'تم نسخ الرابط');
                        setTimeout(function () {
                            btn.classList.remove('po-copy-done');
                            icon.textContent = prev;
                            btn.setAttribute('title', 'نسخ رابط الحلقة');
                        }, 1600);
                    }
                    if (navigator.clipboard && navigator.clipboard.writeText) {
                        navigator.clipboard.writeText(url).then(done).catch(function () { fallbackCopy(url); done(); });
                    } else { fallbackCopy(url); done(); }
                    function fallbackCopy(text) {
                        var ta = document.createElement('textarea');
                        ta.value = text;
                        ta.style.position = 'fixed';
                        ta.style.opacity = '0';
                        document.body.appendChild(ta);
                        ta.select();
                        try { document.execCommand('copy'); } catch (e) { }
                        document.body.removeChild(ta);
                    }
                });
            });

            // Animated counters
            document.querySelectorAll('.po-metric-num[data-count]').forEach(function (el) {
                var target = parseInt(el.dataset.count, 10) || 0;
                if (reduceMotion || target === 0) { el.textContent = target; return; }
                var startTime = null;
                var duration = 800;
                function step(ts) {
                    if (!startTime) startTime = ts;
                    var p = Math.min(1, (ts - startTime) / duration);
                    var eased = 1 - Math.pow(1 - p, 3);
                    el.textContent = Math.round(target * eased);
                    if (p < 1) requestAnimationFrame(step);
                }
                requestAnimationFrame(step);
            });

            // Skeleton intro
            if (skel && cardsWrap) {
                skel.classList.remove('hidden');
                cardsWrap.classList.add('po-cards-loading');
                setTimeout(function () {
                    skel.classList.add('hidden');
                    cardsWrap.classList.remove('po-cards-loading');
                }, reduceMotion ? 0 : 420);
            }

            render();
        })();
    </script>
}

@{
    string GetRecordTypeName(string t) => t switch
    {
        "Execution" => "سجل الإنتاج",
        "SocialMedia" => "نشر رقمي",
        "Website" => "نشر موقع",
        _ => t
    };

    string GetRecordIcon(string t) => t switch
    {
        "Execution" => "play_circle",
        "SocialMedia" => "share",
        "Website" => "public",
        _ => "assignment"
    };

    string GetRoleName(string t) => t switch
    {
        "Execution" => "مسؤول التنفيذ",
        "SocialMedia" => "مسؤول النشر الرقمي",
        "Website" => "مسؤول نشر الموقع",
        _ => "مسؤول النظام"
    };

    string RecordTypeClass(string t) => t switch
    {
        "Execution" => "exec",
        "SocialMedia" => "social",
        "Website" => "web",
        _ => "web"
    };

    string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "ن";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2) return $"{parts[0][0]}{parts[1][0]}";
        return name.Substring(0, 1);
    }

    string Rel(DateTime d)
    {
        if (d > now)
        {
            var f = d - now;
            if (f < TimeSpan.FromHours(1)) return $"خلال {Math.Max(1, (int)f.TotalMinutes)} دقيقة";
            if (f < TimeSpan.FromDays(1)) return $"خلال {Math.Max(1, (int)f.TotalHours)} ساعة";
            return $"خلال {(int)f.TotalDays} يوم";
        }
        var diff = now - d;
        if (diff < TimeSpan.FromMinutes(1)) return "الآن";
        if (diff < TimeSpan.FromHours(1)) return $"منذ {Math.Max(1, (int)diff.TotalMinutes)} دقيقة";
        if (diff < TimeSpan.FromHours(24)) return $"منذ {Math.Max(1, (int)diff.TotalHours)} ساعة";
        if (diff < TimeSpan.FromDays(2)) return "أمس";
        if (diff < TimeSpan.FromDays(30)) return $"منذ {(int)diff.TotalDays} يوم";
        return d.ToString("yyyy-MM-dd");
    }

    int GrowthToday(Func<PublishingRecordDto, bool> pred)
    {
        var t = Model.Count(r => pred(r) && r.RecordDate.Date == today);
        var y = Model.Count(r => pred(r) && r.RecordDate.Date == yesterday);
        return y == 0 ? (t > 0 ? 100 : 0) : (int)Math.Round((t - y) * 100.0 / y);
    }
}
