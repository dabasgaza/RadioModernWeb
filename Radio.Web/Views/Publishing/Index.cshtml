@model List<PublishingRecordDto>
@{
    ViewData["Title"] = "سجل النشر الموحد";
    var socialCount = Model.Count(r => r.RecordType == "SocialMedia");
    var websiteCount = Model.Count(r => r.RecordType == "Website");
    var executionCount = Model.Count(r => r.RecordType == "Execution");
    var todayCount = Model.Count(r => r.RecordDate.Date == DateTime.UtcNow.Date);
    var programs = ViewBag.Programs as List<ProgramDto> ?? new();
}

<div class="page-header">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 relative z-10">
        <div>
            <nav class="breadcrumb">
                <span class="material-symbols-rounded">home</span>
                <a href="/">الرئيسية</a>
                <span class="material-symbols-rounded">chevron_left</span>
                <span>سجل النشر الموحد</span>
            </nav>
            <h1>
                <span class="material-symbols-rounded text-primary p-1 bg-primary/10 rounded-lg">share</span>
                سجل النشر الموحد
            </h1>
            <p>شاشة ذكية وعصرية لمتابعة وإدارة كافة عمليات الإنتاج والنشر الرقمي والموقع الرسمي</p>
        </div>
    </div>
</div>

<!-- Stats Dashboard -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <div class="stat-card relative overflow-hidden group hover:shadow-lg transition-all duration-300 bg-surface border border-border rounded-2xl p-6">
        <div class="absolute top-0 right-0 w-24 h-24 bg-green-500/5 rounded-bl-full transition-all duration-500 group-hover:scale-110"></div>
        <div class="flex items-center gap-5">
            <div class="stat-icon bg-emerald-50 text-emerald-600 p-4 rounded-xl flex items-center justify-center">
                <span class="material-symbols-rounded text-3xl">check_circle</span>
            </div>
            <div>
                <span class="block text-2xl font-black text-ink mb-0.5">@executionCount</span>
                <span class="block text-xs font-semibold text-ink-muted uppercase tracking-wider">سجلات الإنتاج (التنفيذ)</span>
            </div>
        </div>
    </div>
    <div class="stat-card relative overflow-hidden group hover:shadow-lg transition-all duration-300 bg-surface border border-border rounded-2xl p-6">
        <div class="absolute top-0 right-0 w-24 h-24 bg-blue-500/5 rounded-bl-full transition-all duration-500 group-hover:scale-110"></div>
        <div class="flex items-center gap-5">
            <div class="stat-icon bg-blue-50 text-blue-600 p-4 rounded-xl flex items-center justify-center">
                <span class="material-symbols-rounded text-3xl">rss_feed</span>
            </div>
            <div>
                <span class="block text-2xl font-black text-ink mb-0.5">@socialCount</span>
                <span class="block text-xs font-semibold text-ink-muted uppercase tracking-wider">النشر الرقمي (السوشال)</span>
            </div>
        </div>
    </div>
    <div class="stat-card relative overflow-hidden group hover:shadow-lg transition-all duration-300 bg-surface border border-border rounded-2xl p-6">
        <div class="absolute top-0 right-0 w-24 h-24 bg-indigo-500/5 rounded-bl-full transition-all duration-500 group-hover:scale-110"></div>
        <div class="flex items-center gap-5">
            <div class="stat-icon bg-indigo-50 text-indigo-600 p-4 rounded-xl flex items-center justify-center">
                <span class="material-symbols-rounded text-3xl">public</span>
            </div>
            <div>
                <span class="block text-2xl font-black text-ink mb-0.5">@websiteCount</span>
                <span class="block text-xs font-semibold text-ink-muted uppercase tracking-wider">النشر على الموقع الرسمي</span>
            </div>
        </div>
    </div>
    <div class="stat-card relative overflow-hidden group hover:shadow-lg transition-all duration-300 bg-surface border border-border rounded-2xl p-6">
        <div class="absolute top-0 right-0 w-24 h-24 bg-amber-500/5 rounded-bl-full transition-all duration-500 group-hover:scale-110"></div>
        <div class="flex items-center gap-5">
            <div class="stat-icon bg-amber-50 text-amber-600 p-4 rounded-xl flex items-center justify-center">
                <span class="material-symbols-rounded text-3xl">today</span>
            </div>
            <div>
                <span class="block text-2xl font-black text-ink mb-0.5">@todayCount</span>
                <span class="block text-xs font-semibold text-ink-muted uppercase tracking-wider">العمليات المسجلة اليوم</span>
            </div>
        </div>
    </div>
</div>

<!-- Modern Filter Panel -->
<div class="filter-premium">
    <form method="get" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div>
            <label class="form-label">البحث العام</label>
            <div class="relative">
                <span class="material-symbols-rounded absolute right-3 top-2.5 text-ink-soft">search</span>
                <input type="text" name="search" value="@ViewBag.Search" placeholder="بحث باسم الحلقة أو ملخص التفاصيل..." class="form-input pr-10 w-full" />
            </div>
        </div>
        <div>
            <label class="form-label">حسب منصة النشر</label>
            <select name="type" class="form-input w-full" onchange="this.form.submit()">
                <option value="">كل منصات وأنواع النشر</option>
                <option value="Execution" selected="@(ViewBag.TypeFilter == "Execution")">سجلات الإنتاج (التنفيذ)</option>
                <option value="SocialMedia" selected="@(ViewBag.TypeFilter == "SocialMedia")">سجلات التواصل الاجتماعي (الرقمي)</option>
                <option value="Website" selected="@(ViewBag.TypeFilter == "Website")">سجلات الموقع الرسمي</option>
            </select>
        </div>
        <div>
            <label class="form-label">فلترة حسب البرنامج</label>
            <select name="programId" class="form-input w-full" onchange="this.form.submit()">
                <option value="">كل البرامج الإذاعية</option>
                @foreach (var prog in programs)
                {
                    <option value="@prog.ProgramId" selected="@(ViewBag.ProgramFilter == prog.ProgramId)">@prog.ProgramName</option>
                }
            </select>
        </div>
        <div class="flex gap-2 items-end">
            <button type="submit" class="btn-primary flex-1 py-2.5 justify-center shadow-md shadow-primary/10">
                <span class="material-symbols-rounded text-sm">filter_alt</span>
                تطبيق التصفية
            </button>
            <a href="/Publishing" class="btn-secondary py-2.5 px-4 justify-center" title="إعادة تهيئة">
                <span class="material-symbols-rounded">restart_alt</span>
            </a>
        </div>
    </form>
</div>

<!-- Records Display -->
<div class="table-premium">
    @if (!Model.Any())
    {
        <div class="empty-state py-16 px-6 text-center">
            <div class="w-20 h-20 bg-ink-soft/5 rounded-full flex items-center justify-center mx-auto mb-4 text-ink-muted">
                <span class="material-symbols-rounded text-5xl">folder_off</span>
            </div>
            <h3 class="font-bold text-ink text-xl mb-2">لا توجد سجلات نشر مطابقة</h3>
            <p class="text-ink-muted text-sm max-w-sm mx-auto">لم يتم العثور على أي نتائج تطابق خيارات التصفية الحالية. يرجى تجربة خيارات أخرى.</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="bg-surface-3 border-b border-border text-ink-muted uppercase tracking-wider text-xs">
                        <th class="px-6 py-4 text-right font-bold">المنصة / النوع</th>
                        <th class="px-6 py-4 text-right font-bold">معلومات الحلقة</th>
                        <th class="px-6 py-4 text-right font-bold">تفاصيل النشر والمحتوى</th>
                        <th class="px-6 py-4 text-right font-bold">المسؤول</th>
                        <th class="px-6 py-4 text-right font-bold">التوقيت والتاريخ</th>
                        <th class="px-6 py-4 text-center font-bold">الخيارات</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border">
                    @foreach (var r in Model)
                    {
                        <tr class="hover:bg-surface-2 transition duration-200">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="flex items-center gap-2">
                                    <div class="p-1.5 rounded-lg text-white flex items-center justify-center" style="background-color: @r.RecordColor">
                                        <span class="material-symbols-rounded text-lg">@GetRecordIcon(r.RecordType)</span>
                                    </div>
                                    <span class="badge font-bold" style="background-color: @(r.RecordColor)15; color: @r.RecordColor">
                                        @GetRecordTypeName(r.RecordType)
                                    </span>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <a href="/Episodes/Details/@r.EpisodeId" class="text-primary font-bold hover:text-primary-hover hover:underline block text-sm transition" target="_blank">
                                    @(r.EpisodeName ?? "حلقة غير معنونة")
                                </a>
                                <span class="text-xs font-medium text-ink-muted mt-1 inline-block bg-ink-soft/5 px-2 py-0.5 rounded">
                                    @r.ProgramName
                                </span>
                            </td>
                            <td class="px-6 py-4">
                                <div class="text-ink font-medium max-w-sm line-clamp-2">
                                    @r.Summary
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="flex items-center gap-2">
                                    <div class="w-8 h-8 rounded-full bg-primary/10 text-primary font-bold text-xs flex items-center justify-center">
                                        @(string.IsNullOrEmpty(r.RecordedBy) ? "?" : r.RecordedBy.Substring(0, 1).ToUpper())
                                    </div>
                                    <span class="text-ink font-semibold">@(r.RecordedBy ?? "مستخدم تلقائي")</span>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-ink-muted">
                                <div class="flex flex-col text-xs" dir="ltr">
                                    <span class="font-bold text-ink text-right">@r.RecordDate.ToString("yyyy-MM-dd")</span>
                                    <span class="text-ink-soft text-right mt-0.5">@r.RecordDate.ToString("hh:mm tt")</span>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="flex items-center justify-center gap-1.5">
                                    @if (r.RecordType == "SocialMedia" && User.HasPermission(AppPermissions.EpisodePublish))
                                    {
                                        <a href="/Publishing/Edit/@r.RecordId" class="icon-btn bg-blue-50 text-blue-600 hover:bg-blue-100 p-2 rounded-lg transition" title="تعديل">
                                            <span class="material-symbols-rounded text-sm">edit</span>
                                        </a>
                                        <button type="button" class="icon-btn bg-red-50 text-red-600 hover:bg-red-100 p-2 rounded-lg transition" title="حذف"
                                                onclick="confirmDelete(@r.RecordId, '@(r.EpisodeName ?? "سجل")')">
                                            <span class="material-symbols-rounded text-sm">delete</span>
                                        </button>
                                    }
                                    @if (r.RecordType == "Website" && User.HasPermission(AppPermissions.EpisodeWebPublish))
                                    {
                                        <a href="/WebsitePublishing/Edit/@r.RecordId" class="icon-btn bg-blue-50 text-blue-600 hover:bg-blue-100 p-2 rounded-lg transition" title="تعديل">
                                            <span class="material-symbols-rounded text-sm">edit</span>
                                        </a>
                                        <button type="button" class="icon-btn bg-red-50 text-red-600 hover:bg-red-100 p-2 rounded-lg transition" title="حذف"
                                                onclick="confirmWebsiteDelete(@r.RecordId, '@(r.EpisodeName ?? "سجل")')">
                                            <span class="material-symbols-rounded text-sm">delete</span>
                                        </button>
                                    }
                                    @if (r.RecordType == "Execution" && (User.HasPermission(AppPermissions.ExecutionExecute) || User.HasPermission(AppPermissions.ExecutionEdit)))
                                    {
                                        <a href="/ExecutionLogs/Edit/@r.RecordId" class="icon-btn bg-emerald-50 text-emerald-600 hover:bg-emerald-100 p-2 rounded-lg transition" title="تعديل سجل التنفيذ">
                                            <span class="material-symbols-rounded text-sm">edit</span>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Delete Social Modal -->
<div id="deleteModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/55 backdrop-blur-sm p-4 transition-all duration-300">
    <div class="bg-surface rounded-2xl shadow-2xl max-w-sm w-full p-6 border border-border scale-95 transition-all">
        <div class="text-center">
            <div class="w-16 h-16 bg-red-50 text-danger rounded-full flex items-center justify-center mx-auto mb-4">
                <span class="material-symbols-rounded text-3xl">delete_forever</span>
            </div>
            <h3 class="text-lg font-bold text-ink mb-2">حذف سجل النشر الرقمي</h3>
            <p class="text-ink-muted text-sm mb-6" id="deleteMessage">هل أنت متأكد من حذف هذا السجل؟</p>
            <form id="deleteForm" method="post" action="">
                @Html.AntiForgeryToken()
                <div class="flex gap-2 justify-center">
                    <button type="button" class="btn-secondary px-5" onclick="closeDeleteModal()">إلغاء</button>
                    <button type="submit" class="btn-danger px-5">
                        <span class="material-symbols-rounded">delete</span>
                        نعم، احذف
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Website Modal -->
<div id="deleteWebsiteModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/55 backdrop-blur-sm p-4 transition-all duration-300">
    <div class="bg-surface rounded-2xl shadow-2xl max-w-sm w-full p-6 border border-border scale-95 transition-all">
        <div class="text-center">
            <div class="w-16 h-16 bg-red-50 text-danger rounded-full flex items-center justify-center mx-auto mb-4">
                <span class="material-symbols-rounded text-3xl">delete_forever</span>
            </div>
            <h3 class="text-lg font-bold text-ink mb-2">حذف سجل نشر الموقع</h3>
            <p class="text-ink-muted text-sm mb-6" id="deleteWebsiteMessage">هل أنت متأكد من حذف هذا السجل؟</p>
            <form id="deleteWebsiteForm" method="post" action="">
                @Html.AntiForgeryToken()
                <div class="flex gap-2 justify-center">
                    <button type="button" class="btn-secondary px-5" onclick="closeWebsiteDeleteModal()">إلغاء</button>
                    <button type="submit" class="btn-danger px-5">
                        <span class="material-symbols-rounded">delete</span>
                        نعم، احذف
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id, name) {
            document.getElementById('deleteMessage').textContent = 'هل أنت متأكد من حذف سجل النشر الرقمي للحلقة "' + name + '"؟';
            document.getElementById('deleteForm').action = '/Publishing/Delete/' + id;
            document.getElementById('deleteModal').classList.remove('hidden');
            document.getElementById('deleteModal').classList.add('flex');
        }
        function closeDeleteModal() {
            document.getElementById('deleteModal').classList.add('hidden');
            document.getElementById('deleteModal').classList.remove('flex');
        }
        function confirmWebsiteDelete(id, name) {
            document.getElementById('deleteWebsiteMessage').textContent = 'هل أنت متأكد من حذف سجل نشر الموقع للحلقة "' + name + '"؟';
            document.getElementById('deleteWebsiteForm').action = '/WebsitePublishing/Delete/' + id;
            document.getElementById('deleteWebsiteModal').classList.remove('hidden');
            document.getElementById('deleteWebsiteModal').classList.add('flex');
        }
        function closeWebsiteDeleteModal() {
            document.getElementById('deleteWebsiteModal').classList.add('hidden');
            document.getElementById('deleteWebsiteModal').classList.remove('flex');
        }
        document.addEventListener('click', function (e) {
            if (e.target.classList.contains('bg-black/55')) {
                closeDeleteModal();
                closeWebsiteDeleteModal();
            }
        });
    </script>
}

@functions {
    string GetRecordTypeName(string t) => t switch
    {
        "Execution" => "سجل الإنتاج",
        "SocialMedia" => "نشر رقمي",
        "Website" => "نشر موقع",
        _ => t
    };

    string GetRecordIcon(string t) => t switch
    {
        "Execution" => "play_circle",
        "SocialMedia" => "share",
        "Website" => "public",
        _ => "assignment"
    };
}
