@model List<PublishingRecordDto>
@using Radio.Web.ViewModels
@{
    ViewData["Title"] = "سجل النشر والتوزيع الموحد";
    ViewData["HeaderIcon"] = "hub";
    ViewData["HeaderDescription"] = "مركز عمليات النشر — متابعة عمليات الإنتاج والنشر الرقمي على وسائل التواصل الاجتماعي والموقع الرسمي";
    ViewBag.EntityName = "سجل النشر";
    var programs = ViewBag.Programs as List<ProgramDto> ?? new();

    var now = DateTime.UtcNow;
    var today = now.Date;
    var yesterday = today.AddDays(-1);

    var socialCount = Model.Count(r => r.RecordType == "SocialMedia");
    var websiteCount = Model.Count(r => r.RecordType == "Website");
    var executionCount = Model.Count(r => r.RecordType == "Execution");
    var todayCount = Model.Count(r => r.RecordDate.Date == today);
    var pendingCount = Model.Count(r => r.RecordDate > now);

    var feed = Model.OrderByDescending(r => r.RecordDate).Take(8).ToList();
    var tlToday = Model.Where(r => r.RecordDate.Date == today).OrderByDescending(r => r.RecordDate).ToList();
    var tlYesterday = Model.Where(r => r.RecordDate.Date == yesterday).OrderByDescending(r => r.RecordDate).ToList();
    var tlEarlier = Model.Where(r => r.RecordDate.Date < yesterday).OrderByDescending(r => r.RecordDate).Take(6).ToList();
    var syncTime = now.ToLocalTime().ToString("HH:mm:ss");
}

<div class="max-w-7xl mx-auto space-y-6">
    <partial name="_PageHeader" />

    <!-- ═══ HERO BAND — عمليات النشر ═══ -->
    <section class="po-hero" aria-label="ملخص عمليات النشر">
        <div class="po-hero-inner">
            <span class="po-live">
                <span class="po-live-dot" aria-hidden="true"></span>
                مباشر
            </span>
            <span class="po-hero-chip" title="وقت تحميل الصفحة">
                <span class="material-symbols-rounded" aria-hidden="true">sync</span>
                آخر مزامنة @syncTime
            </span>
            <span class="po-hero-chip">
                <span class="material-symbols-rounded" aria-hidden="true">inventory_2</span>
                إجمالي السجلات @Model.Count
            </span>
            <span class="po-hero-chip">
                <span class="material-symbols-rounded" aria-hidden="true">event</span>
                @today.ToString("yyyy-MM-dd")
            </span>
        </div>
        <div class="po-hero-actions">
            <a href="/Publishing?type=Execution" class="po-preset" title="تصفية حسب سجلات الإنتاج">
                <span class="material-symbols-rounded" aria-hidden="true">play_circle</span>
                سجلات الإنتاج
            </a>
            <a href="/Publishing?type=SocialMedia" class="po-preset" title="تصفية حسب النشر الرقمي">
                <span class="material-symbols-rounded" aria-hidden="true">share</span>
                النشر الرقمي
            </a>
            <a href="/Publishing?type=Website" class="po-preset" title="تصفية حسب نشر الموقع">
                <span class="material-symbols-rounded" aria-hidden="true">public</span>
                نشر الموقع
            </a>
            <a href="/Publishing" class="btn btn-ghost btn-icon" title="تحديث البيانات" aria-label="تحديث البيانات">
                <span class="material-symbols-rounded">refresh</span>
            </a>
        </div>
    </section>

    <!-- ═══ METRICS — مؤشرات النشر ═══ -->
    <section class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-5 gap-4" aria-label="مؤشرات النشر">
        <div class="po-metric po-metric-exec">
            <div class="po-metric-top">
                <div class="po-metric-icon"><span class="material-symbols-rounded" aria-hidden="true">check_circle</span></div>
                <span class="po-growth @(GrowthToday(r => r.RecordType == "Execution") > 0 ? "is-up" : GrowthToday(r => r.RecordType == "Execution") < 0 ? "is-down" : "is-flat")" title="مقارنة بعدد سجلات الإنتاج أمس">
                    <span class="material-symbols-rounded" aria-hidden="true">@(GrowthToday(r => r.RecordType == "Execution") >= 0 ? "trending_up" : "trending_down")</span>
                    @Math.Abs(GrowthToday(r => r.RecordType == "Execution"))%
                </span>
            </div>
            <p class="po-metric-num" data-count="@executionCount">@executionCount</p>
            <p class="po-metric-label">سجلات الإنتاج</p>
            <p class="po-metric-sub">منفذة ومسجلة</p>
        </div>

        <div class="po-metric po-metric-social">
            <div class="po-metric-top">
                <div class="po-metric-icon"><span class="material-symbols-rounded" aria-hidden="true">share</span></div>
                <span class="po-growth @(GrowthToday(r => r.RecordType == "SocialMedia") > 0 ? "is-up" : GrowthToday(r => r.RecordType == "SocialMedia") < 0 ? "is-down" : "is-flat")" title="مقارنة بعدد عمليات النشر الرقمي أمس">
                    <span class="material-symbols-rounded" aria-hidden="true">@(GrowthToday(r => r.RecordType == "SocialMedia") >= 0 ? "trending_up" : "trending_down")</span>
                    @Math.Abs(GrowthToday(r => r.RecordType == "SocialMedia"))%
                </span>
            </div>
            <p class="po-metric-num" data-count="@socialCount">@socialCount</p>
            <p class="po-metric-label">النشر الرقمي</p>
            <p class="po-metric-sub">وسائل التواصل الاجتماعي</p>
        </div>

        <div class="po-metric po-metric-web">
            <div class="po-metric-top">
                <div class="po-metric-icon"><span class="material-symbols-rounded" aria-hidden="true">public</span></div>
                <span class="po-growth @(GrowthToday(r => r.RecordType == "Website") > 0 ? "is-up" : GrowthToday(r => r.RecordType == "Website") < 0 ? "is-down" : "is-flat")" title="مقارنة بعدد عمليات نشر الموقع أمس">
                    <span class="material-symbols-rounded" aria-hidden="true">@(GrowthToday(r => r.RecordType == "Website") >= 0 ? "trending_up" : "trending_down")</span>
                    @Math.Abs(GrowthToday(r => r.RecordType == "Website"))%
                </span>
            </div>
            <p class="po-metric-num" data-count="@websiteCount">@websiteCount</p>
            <p class="po-metric-label">نشر الموقع الرسمي</p>
            <p class="po-metric-sub">نشر على البوابة</p>
        </div>

        <div class="po-metric po-metric-pending">
            <div class="po-metric-top">
                <div class="po-metric-icon"><span class="material-symbols-rounded" aria-hidden="true">schedule</span></div>
                <span class="po-growth is-flat" title="مواعيد نشر مجدولة في المستقبل">
                    <span class="material-symbols-rounded" aria-hidden="true">more_time</span>
                    @pendingCount
                </span>
            </div>
            <p class="po-metric-num" data-count="@pendingCount">@pendingCount</p>
            <p class="po-metric-label">قيد الانتظار</p>
            <p class="po-metric-sub">مواعيد نشر قادمة</p>
        </div>

        <div class="po-metric po-metric-today">
            <div class="po-metric-top">
                <div class="po-metric-icon"><span class="material-symbols-rounded" aria-hidden="true">today</span></div>
                <span class="po-growth @(GrowthToday(_ => true) > 0 ? "is-up" : GrowthToday(_ => true) < 0 ? "is-down" : "is-flat")" title="مقارنة بنشاط أمس">
                    <span class="material-symbols-rounded" aria-hidden="true">@(GrowthToday(_ => true) >= 0 ? "trending_up" : "trending_down")</span>
                    @Math.Abs(GrowthToday(_ => true))%
                </span>
            </div>
            <p class="po-metric-num" data-count="@todayCount">@todayCount</p>
            <p class="po-metric-label">نشاط اليوم</p>
            <p class="po-metric-sub">سجلات منشورة اليوم</p>
        </div>
    </section>

    <!-- ═══ STICKY FILTER TOOLBAR ═══ -->
    <div class="po-toolbar" role="search" aria-label="تصفية السجلات">
        <form method="get" class="po-toolbar-form" id="poFilterForm">
            <div class="relative">
                <input type="text" name="search" id="poSearchInput" value="@ViewBag.Search"
                       placeholder="بحث فوري: حلقة / برنامج / منصة / مستخدم"
                       class="input w-full pl-10" aria-label="بحث فوري"
                       autocomplete="off" />
                <span class="material-symbols-rounded absolute left-3 top-1/2 -translate-y-1/2 text-text-muted pointer-events-none" aria-hidden="true">search</span>
            </div>

            <select name="programId" class="input" onchange="this.form.submit()" aria-label="تصفية حسب البرنامج">
                <option value="">كل البرامج</option>
                @foreach (var prog in programs)
                {
                    <option value="@prog.ProgramId" selected="@(ViewBag.ProgramFilter == prog.ProgramId)">@prog.ProgramName</option>
                }
            </select>

            <select name="type" class="input" onchange="this.form.submit()" aria-label="تصفية حسب نوع السجل">
                <option value="">كل المنصات</option>
                <option value="Execution" selected="@(ViewBag.TypeFilter == "Execution")">سجل الإنتاج</option>
                <option value="SocialMedia" selected="@(ViewBag.TypeFilter == "SocialMedia")">نشر رقمي</option>
                <option value="Website" selected="@(ViewBag.TypeFilter == "Website")">نشر موقع</option>
            </select>

            <button type="submit" class="btn btn-primary">
                <span class="material-symbols-rounded text-lg" aria-hidden="true">filter_alt</span>
                تطبيق
            </button>
            <a href="/Publishing" class="btn btn-ghost" title="إعادة تهيئة جميع الفلاتر">إعادة</a>
        </form>

        <div class="po-toolbar-row2">
            <div class="flex items-center gap-2">
                <span class="material-symbols-rounded text-text-muted" aria-hidden="true">date_range</span>
                <input type="date" id="poDateFrom" class="input" aria-label="من تاريخ" title="تصفية من تاريخ" />
            </div>
            <div class="flex items-center gap-2">
                <span class="material-symbols-rounded text-text-muted" aria-hidden="true">event_busy</span>
                <input type="date" id="poDateTo" class="input" aria-label="إلى تاريخ" title="تصفية إلى تاريخ" />
            </div>
            <select id="poStatus" class="input" aria-label="تصفية حسب الحالة">
                <option value="all">كل الحالات</option>
                <option value="published">منشور</option>
                <option value="pending">قيد الانتظار</option>
            </select>
            <select id="poSort" class="input" aria-label="ترتيب السجلات">
                <option value="newest">الأحدث أولاً</option>
                <option value="oldest">الأقدم أولاً</option>
            </select>
        </div>
    </div>

    <!-- ═══ MAIN GRID ═══ -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">

        <!-- ═══ LEFT — PUBLISHING CARDS ═══ -->
        <div class="lg:col-span-2 space-y-4">
            <div class="flex items-center justify-between gap-3 flex-wrap">
                <h2 class="text-title-lg font-bold flex items-center gap-2 text-text">
                    <span class="material-symbols-rounded text-primary" aria-hidden="true">view_agenda</span>
                    سجلات النشر
                    <span class="badge badge-primary" id="poCount" role="status" aria-live="polite">@Model.Count سجل</span>
                </h2>
                <p class="text-caption text-text-muted" id="poRange" aria-live="polite"></p>
            </div>

            <!-- Skeletons (JS-driven intro, no-JS safe) -->
            <div id="poSkel" class="po-skel-wrap hidden" aria-hidden="true">
                <div class="po-skel-card">
                    <div class="flex items-center gap-4">
                        <div class="po-skel-line" style="width:2.75rem;height:2.75rem;border-radius:1rem"></div>
                        <div class="flex-1 space-y-2">
                            <div class="po-skel-line" style="width:45%"></div>
                            <div class="po-skel-line" style="width:70%"></div>
                        </div>
                    </div>
                    <div class="po-skel-line mt-4" style="width:90%"></div>
                    <div class="po-skel-line mt-2" style="width:55%"></div>
                </div>
                <div class="po-skel-card">
                    <div class="flex items-center gap-4">
                        <div class="po-skel-line" style="width:2.75rem;height:2.75rem;border-radius:1rem"></div>
                        <div class="flex-1 space-y-2">
                            <div class="po-skel-line" style="width:55%"></div>
                            <div class="po-skel-line" style="width:80%"></div>
                        </div>
                    </div>
                    <div class="po-skel-line mt-4" style="width:85%"></div>
                    <div class="po-skel-line mt-2" style="width:45%"></div>
                </div>
                <div class="po-skel-card">
                    <div class="flex items-center gap-4">
                        <div class="po-skel-line" style="width:2.75rem;height:2.75rem;border-radius:1rem"></div>
                        <div class="flex-1 space-y-2">
                            <div class="po-skel-line" style="width:40%"></div>
                            <div class="po-skel-line" style="width:65%"></div>
                        </div>
                    </div>
                    <div class="po-skel-line mt-4" style="width:75%"></div>
                    <div class="po-skel-line mt-2" style="width:50%"></div>
                </div>
            </div>

            <div id="poCards" class="space-y-4">
                @foreach (var r in Model)
                {
                    var isPending = r.RecordDate > now;
                    var haystack = $"{r.EpisodeName} {r.ProgramName} {r.Summary} {r.RecordedBy} {GetRecordTypeName(r.RecordType)}".ToLowerInvariant();

                    <article class="po-card card card-hover" data-id="@r.RecordId" data-type="@r.RecordType"
                             data-date="@r.RecordDate.ToString("o")" data-status="@(isPending ? "pending" : "published")"
                             data-search="@haystack">
                        <div class="po-card-head">
                            <div class="po-card-icon" style="background:@r.RecordColor" aria-hidden="true">
                                <span class="material-symbols-rounded">@GetRecordIcon(r.RecordType)</span>
                            </div>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <span class="po-type-chip">
                                        <span class="material-symbols-rounded" aria-hidden="true">@GetRecordIcon(r.RecordType)</span>
                                        @GetRecordTypeName(r.RecordType)
                                    </span>
                                    <span class="po-status @(isPending ? "is-pending" : "is-published")" role="status">
                                        <span class="material-symbols-rounded" aria-hidden="true">@(isPending ? "schedule" : "task_alt")</span>
                                        @(isPending ? "قيد الانتظار" : "منشور")
                                    </span>
                                </div>
                                <h3 class="text-title font-bold mt-2 text-text truncate">
                                    <a href="/Episodes/Details/@r.EpisodeId" class="hover:text-primary transition-colors duration-fast">@(r.EpisodeName ?? "حلقة غير معنونة")</a>
                                </h3>
                                <p class="text-caption text-text-muted mt-1 flex items-center gap-1">
                                    <span class="material-symbols-rounded text-sm" aria-hidden="true">radio</span>
                                    @(r.ProgramName ?? "بدون برنامج")
                                </p>
                            </div>
                            <div class="po-card-actions">
                                @if (r.RecordType == "SocialMedia" && User.HasPermission(AppPermissions.SocialPublishingPublish))
                                {
                                    <a href="/Publishing/Edit/@r.RecordId" class="btn btn-ghost btn-icon btn-sm" title="تعديل السجل" aria-label="تعديل السجل">
                                        <span class="material-symbols-rounded">edit</span>
                                    </a>
                                }
                                @if (r.RecordType == "Website" && User.HasPermission(AppPermissions.WebsitePublishingPublish))
                                {
                                    <a href="/WebsitePublishing/Edit/@r.RecordId" class="btn btn-ghost btn-icon btn-sm" title="تعديل السجل" aria-label="تعديل السجل">
                                        <span class="material-symbols-rounded">edit</span>
                                    </a>
                                }
                                @if (r.RecordType == "Execution" && (User.HasPermission(AppPermissions.ExecutionExecute) || User.HasPermission(AppPermissions.ExecutionEdit)))
                                {
                                    <a href="/ExecutionLogs/Edit/@r.RecordId" class="btn btn-ghost btn-icon btn-sm" title="تعديل سجل التنفيذ" aria-label="تعديل سجل التنفيذ">
                                        <span class="material-symbols-rounded">edit</span>
                                    </a>
                                }
                                <button type="button" class="btn btn-ghost btn-icon btn-sm po-copy" data-copy="/Episodes/Details/@r.EpisodeId" title="نسخ رابط الحلقة" aria-label="نسخ رابط الحلقة">
                                    <span class="material-symbols-rounded">content_copy</span>
                                </button>
                                <a href="/Episodes/Details/@r.EpisodeId" class="btn btn-ghost btn-icon btn-sm" title="فتح صفحة الحلقة" aria-label="فتح صفحة الحلقة">
                                    <span class="material-symbols-rounded">open_in_new</span>
                                </a>
                                @if (r.RecordType == "SocialMedia" && User.HasPermission(AppPermissions.SocialPublishingPublish))
                                {
                                    <button type="button" class="btn btn-ghost btn-icon btn-sm" title="حذف السجل" aria-label="حذف السجل"
                                            onclick="confirmDelete(@r.RecordId, '@(r.EpisodeName?.Replace("'", "") ?? "")')">
                                        <span class="material-symbols-rounded">delete</span>
                                    </button>
                                }
                                @if (r.RecordType == "Website" && User.HasPermission(AppPermissions.WebsitePublishingPublish))
                                {
                                    <button type="button" class="btn btn-ghost btn-icon btn-sm" title="حذف السجل" aria-label="حذف السجل"
                                            onclick="confirmWebsiteDelete(@r.RecordId, '@(r.EpisodeName?.Replace("'", "") ?? "")')">
                                        <span class="material-symbols-rounded">delete</span>
                                    </button>
                                }
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(r.Summary))
                        {
                            <p class="po-summary po-clamp-2">@r.Summary</p>
                        }

                        <div class="po-card-foot">
                            <div class="flex items-center gap-2 min-w-0">
                                <span class="po-avatar po-avatar-@(RecordTypeClass(r.RecordType))" aria-hidden="true">@Initials(r.RecordedBy)</span>
                                <span class="text-caption font-semibold text-text-secondary truncate">@(r.RecordedBy ?? "النظام")</span>
                            </div>
                            <div class="flex items-center gap-3 text-caption text-text-muted" dir="auto">
                                <span class="flex items-center gap-1">
                                    <span class="material-symbols-rounded text-sm" aria-hidden="true">schedule</span>
                                    <time datetime="@r.RecordDate.ToString("o")" title="@r.RecordDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")">@Rel(r.RecordDate)</time>
                                </span>
                                <span class="flex items-center gap-1">
                                    <span class="material-symbols-rounded text-sm" aria-hidden="true">calendar_month</span>
                                    @r.RecordDate.ToLocalTime().ToString("MM-dd HH:mm")
                                </span>
                            </div>
                        </div>
                    </article>
                }
            </div>

            <!-- Empty state (client-side) -->
            <div id="poEmpty" class="hidden">
                <div class="empty-state">
                    <div class="empty-state-icon">
                        <span class="material-symbols-rounded">hub</span>
                    </div>
                    <h3 class="empty-state-title">لا توجد سجلات مطابقة</h3>
                    <p class="empty-state-desc">جرّب تعديل نطاق التاريخ أو إعادة تعيين عوامل التصفية للعثور على السجلات.</p>
                    <div class="empty-state-actions">
                        <a href="/Publishing" class="btn btn-primary">
                            <span class="material-symbols-rounded text-lg" aria-hidden="true">refresh</span>
                            عرض كل السجلات
                        </a>
                    </div>
                </div>
            </div>

            <!-- Pagination (client-side, animated) -->
            <div id="poPager" class="pagination-bar" hidden>
                <div class="pagination-controls" id="poPagerBtns"></div>
            </div>
        </div>

        <!-- ═══ RIGHT — ACTIVITY FEED + TIMELINE ═══ -->
        <aside class="space-y-6 lg:sticky lg:top-24" aria-label="نشاط وجدول النشر">
            <!-- Activity Feed -->
            <section class="card p-5">
                <div class="flex items-center justify-between gap-3 mb-2">
                    <h2 class="text-title font-bold flex items-center gap-2 text-text">
                        <span class="material-symbols-rounded text-primary" aria-hidden="true">bolt</span>
                        آخر الأنشطة
                    </h2>
                    <span class="badge badge-info">@feed.Count</span>
                </div>
                <p class="text-caption text-text-muted mb-3">نشر، تنفيذ، وتحديثات على مدار السجل الموحد</p>
                <ol class="po-feed-list">
                    @foreach (var item in feed)
                    {
                        <li class="po-feed-item">
                            <span class="po-avatar po-avatar-@(RecordTypeClass(item.RecordType))" aria-hidden="true">@Initials(item.RecordedBy)</span>
                            <div class="min-w-0 flex-1">
                                <p class="text-body leading-snug text-text truncate">
                                    <span class="font-bold">@(item.RecordedBy ?? "النظام")</span>
                                    <span class="text-text-muted">@GetRecordTypeName(item.RecordType) ←</span>
                                    <a href="/Episodes/Details/@item.EpisodeId" class="text-primary font-semibold hover:underline">@(item.EpisodeName ?? "حلقة")</a>
                                </p>
                                <p class="text-caption text-text-muted mt-0.5">
                                    <time datetime="@item.RecordDate.ToString("o")" title="@item.RecordDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")">@Rel(item.RecordDate)</time>
                                </p>
                            </div>
                            <span class="po-dot" style="background:@item.RecordColor" aria-hidden="true"></span>
                        </li>
                    }
                </ol>
            </section>

            <!-- Publishing Timeline -->
            <section class="card p-5">
                <h2 class="text-title font-bold flex items-center gap-2 text-text mb-2">
                    <span class="material-symbols-rounded text-accent" aria-hidden="true">timeline</span>
                    الجدول الزمني للنشر
                </h2>
                <p class="text-caption text-text-muted mb-4">نشاط النشر مجمّعًا حسب اليوم</p>

                @if (!tlToday.Any() && !tlYesterday.Any() && !tlEarlier.Any())
                {
                    <p class="text-caption text-text-muted">لا توجد أنشطة مسجلة بعد.</p>
                }
                else
                {
                    <div class="po-tl">
                        @if (tlToday.Any())
                        {
                            <div class="po-tl-group">
                                <div class="po-tl-label">
                                    <span class="material-symbols-rounded" aria-hidden="true">today</span>
                                    اليوم — @tlToday.Count عملية
                                </div>
                                @foreach (var r in tlToday)
                                {
                                    <div class="po-tl-item">
                                        <span class="po-tl-node" style="background:@r.RecordColor" aria-hidden="true"></span>
                                        <div class="po-tl-body">
                                            <p class="po-tl-title truncate">
                                                <a href="/Episodes/Details/@r.EpisodeId" class="hover:text-primary transition-colors duration-fast">@(r.EpisodeName ?? "حلقة غير معنونة")</a>
                                            </p>
