@model PermissionMatrixViewModel
@{
    ViewData["Title"] = "مصفوفة الصلاحيات";
    var permissionsByModule = Model.Permissions.ToLookup(p => p.Module);
}

<div class="page-header">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 relative z-10">
        <div>
            <nav class="breadcrumb">
                <span class="material-symbols-rounded">home</span>
                <a href="/">الرئيسية</a>
                <span class="material-symbols-rounded">chevron_left</span>
                <span>الصلاحيات والأدوار</span>
            </nav>
            <h1>
                <span class="material-symbols-rounded">security</span>
                مصفوفة الصلاحيات
            </h1>
            <p>تخصيص وتعديل صلاحيات الوصول والعمليات لكل دور وظيفي في النظام</p>
        </div>
    </div>
</div>

<!-- Role Selection Card -->
<div class="filter-premium">
    <form method="get" class="grid grid-cols-1 md:grid-cols-4 gap-4 items-center">
        <div class="md:col-span-1 text-xs font-bold text-ink-muted uppercase tracking-wider">
            اختر الدور الوظيفي للتعديل:
        </div>
        <div class="md:col-span-3">
            <select name="roleId" class="form-input" onchange="this.form.submit()">
                @foreach (var r in Model.Roles)
                {
                    <option value="@r.RoleId" selected="@(Model.SelectedRoleId == r.RoleId)">@r.RoleName — @(r.RoleDescription ?? "لا يوجد وصف")</option>
                }
            </select>
        </div>
    </form>
</div>

@if (Model.SelectedRoleId > 0 && permissionsByModule.Any())
{
    <form method="post" action="/Permissions/Update">
        @Html.AntiForgeryToken()
        <input type="hidden" name="roleId" value="@Model.SelectedRoleId" />

        <div class="card-premium">
            <div class="card-header">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-rounded text-primary">admin_panel_settings</span>
                    <h3 class="font-bold text-ink text-base">صلاحيات الدور: <span class="text-primary font-black">@Model.SelectedRoleName</span></h3>
                </div>
                <div class="flex items-center gap-2">
                    <button type="button" class="btn-secondary py-1 px-3 text-xs flex items-center gap-1" onclick="document.querySelectorAll('input[name=selectedPermissionIds]').forEach(c => c.checked = true)">
                        <span class="material-symbols-rounded" style="font-size: 16px;">check_box</span>
                        تحديد الكل
                    </button>
                    <button type="button" class="btn-secondary py-1 px-3 text-xs flex items-center gap-1" onclick="document.querySelectorAll('input[name=selectedPermissionIds]').forEach(c => c.checked = false)">
                        <span class="material-symbols-rounded" style="font-size: 16px;">check_box_outline_blank</span>
                        إلغاء الكل
                    </button>
                </div>
            </div>
            
            <div class="card-body space-y-6">
                @foreach (var module in permissionsByModule)
                {
                    <div class="space-y-3">
                        <h4 class="font-bold text-ink text-xs mb-2 pb-2 border-b border-border/60 flex items-center gap-1.5">
                            <span class="w-1.5 h-3 bg-primary rounded-full"></span>
                            @module.Key
                        </h4>
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                            @foreach (var p in module)
                            {
                                <label class="flex items-center justify-between p-3.5 bg-surface-2 rounded-xl border border-border/60 hover:bg-primary/5 hover:border-primary/20 cursor-pointer transition-all duration-200">
                                    <span class="text-xs font-bold text-ink-muted">@p.DisplayName</span>
                                    <div class="relative inline-flex items-center">
                                        <input type="checkbox" name="selectedPermissionIds" value="@p.PermissionId" @(p.IsAssigned ? "checked" : "") class="sr-only peer" />
                                        <div class="w-11 h-6 bg-border peer-focus:outline-none rounded-full peer peer-checked:bg-primary transition-all duration-300
                                                    after:content-[''] after:absolute after:top-[2px] after:right-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:after:-translate-x-5"></div>
                                    </div>
                                </label>
                            }
                        </div>
                    </div>
                }
            </div>
            
            <div class="px-5 py-4 bg-surface-2 border-t border-border/60 flex justify-end">
                <button type="submit" class="btn-primary">
                    <span class="material-symbols-rounded">save</span>
                    حفظ صلاحيات الدور
                </button>
            </div>
        </div>
    </form>
}
