@model PermissionMatrixViewModel
@{
    ViewData["Title"] = "مصفوفة التحكم بالصلاحيات";
    var permissionsByModule = Model.Permissions.ToLookup(p => p.Module);
    ViewBag.IsEdit = true;
    ViewBag.Icon = "security";
    ViewBag.Title = "مصفوفة التحكم بالصلاحيات";
    ViewBag.Description = "تعيين وتخصيص صلاحيات العمليات والوصول لمختلف صفحات وأقسام النظام";
    ViewBag.EntityName = "الأدوار الوظيفية";
    ViewBag.EntityUrl = "/Roles";
    ViewBag.BackUrl = "/Roles";
    ViewBag.BackText = "الرجوع للأدوار";
}

<partial name="_PageHeader" />

<div class="rounded-xl p-6 mb-8" style="background: var(--color-bg-elevated); border: 1px solid var(--color-border); border-right: 4px solid var(--color-primary);">
    <form method="get" class="flex flex-col md:flex-row items-center gap-6">
        <div class="flex items-center gap-3 w-full md:w-auto shrink-0">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0"
                 style="background: var(--color-primary-light); color: var(--color-primary);">
                <span class="material-symbols-rounded text-lg">badge</span>
            </div>
            <span class="font-bold text-sm text-[var(--color-text)]">اختر الدور المراد تعديله:</span>
        </div>
        <div class="w-full">
            <select name="roleId" class="w-full rounded-xl py-3 px-4 font-bold focus:outline-none focus:ring-2 transition-all appearance-none"
                    style="background: var(--color-bg); border: 1px solid var(--color-border); color: var(--color-text); --tw-ring-color: var(--color-primary);" onchange="this.form.submit()">
                @foreach (var r in Model.Roles)
                {
                    <option value="@r.RoleId" selected="@(Model.SelectedRoleId == r.RoleId)">
                        @r.RoleName — @(r.RoleDescription ?? "لا يوجد وصف مخصص")
                    </option>
                }
            </select>
        </div>
    </form>
</div>

@if (Model.SelectedRoleId > 0)
{
    <form method="post" action="/Permissions/Update">
        @Html.AntiForgeryToken()
        <input type="hidden" name="roleId" value="@Model.SelectedRoleId" />

        <div class="rounded-xl overflow-hidden" style="background: var(--color-bg-elevated); border: 1px solid var(--color-border);">
            <div class="p-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4" style="background: var(--color-bg); border-bottom: 1px solid var(--color-border);">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0"
                         style="background: var(--color-primary-light); color: var(--color-primary);">
                        <span class="material-symbols-rounded text-lg">admin_panel_settings</span>
                    </div>
                    <div>
                        <div class="flex items-center gap-2 flex-wrap">
                            <h3 class="font-bold text-base text-[var(--color-text)]">تعديل صلاحيات الدور: <span class="text-[var(--color-primary)] font-black">@Model.SelectedRoleName</span></h3>
                            <span id="permissions-counter" class="py-1 px-3 text-xs rounded-full font-bold"
                                  style="background: var(--color-bg); color: var(--color-text-3);">جاري الحساب...</span>
                        </div>
                        <p class="text-xs mt-1 text-[var(--color-text-3)]">قم بتفعيل أو إلغاء تفعيل الصلاحيات ثم احفظ التعديلات لتطبق لحظياً</p>
                    </div>
                </div>

                <div class="flex items-center gap-2">
                    <button type="button" class="btn btn-ghost py-2 px-4 rounded-xl text-xs font-bold gap-1.5" onclick="toggleAllCheckboxes(true)">
                        <span class="material-symbols-rounded text-sm">check_box</span>
                        تحديد الكل
                    </button>
                    <button type="button" class="btn btn-ghost py-2 px-4 rounded-xl text-xs font-bold gap-1.5" onclick="toggleAllCheckboxes(false)">
                        <span class="material-symbols-rounded text-sm">check_box_outline_blank</span>
                        إلغاء الكل
                    </button>
                </div>
            </div>

            <div class="p-4" style="background: var(--color-bg); border-bottom: 1px solid var(--color-border);">
                <div class="relative w-full">
                    <span class="material-symbols-rounded absolute right-4 top-1/2 -translate-y-1/2 text-sm text-[var(--color-text-4)]">search</span>
                    <input type="text" id="permSearch" placeholder="بحث سريع في الصلاحيات المعروضة..."
                           class="w-full rounded-xl pr-11 pl-4 py-2 text-xs focus:outline-none transition-all"
                           style="background: var(--color-bg); border: 1px solid var(--color-border); color: var(--color-text);" />
                </div>
            </div>

            <div class="p-6 space-y-8" style="background: var(--color-bg-elevated);">
                @foreach (var module in permissionsByModule)
                {
                    <div class="module-section space-y-4" data-module="@module.Key.ToLower()">
                        <div class="flex items-center justify-between pb-2" style="border-bottom: 1px solid var(--color-border);">
                            <h4 class="font-bold text-sm flex items-center gap-2 text-[var(--color-text)]">
                                <span class="w-1.5 h-3.5 rounded-full" style="background: var(--color-primary);"></span>
                                @module.Key
                            </h4>
                            <div class="flex items-center gap-1">
                                <button type="button" class="text-xs font-bold px-2 py-1 rounded text-[var(--color-primary)] hover:bg-[var(--color-primary-light)] transition-all"
                                        onclick="toggleModuleCheckboxes('@module.Key', true)">
                                    تحديد القسم
                                </button>
                                <span class="text-[var(--color-border)] select-none">|</span>
                                <button type="button" class="text-xs font-bold px-2 py-1 rounded text-[var(--color-text-3)] hover:bg-[var(--color-bg-hover)] transition-all"
                                        onclick="toggleModuleCheckboxes('@module.Key', false)">
                                    إلغاء القسم
                                </button>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                            @foreach (var p in module)
                            {
                                <label class="perm-item flex items-center justify-between p-4 rounded-xl cursor-pointer transition-all duration-200 hover:shadow-sm"
                                       style="background: var(--color-bg-elevated); border: 1px solid var(--color-border);"
                                       data-text="@p.DisplayName.ToLower() @p.SystemName.ToLower()">
                                    <div class="flex flex-col gap-1 pr-2">
                                        <span class="text-xs font-bold text-[var(--color-text)]">@p.DisplayName</span>
                                        <span class="text-[9px] font-mono text-[var(--color-text-3)]">@p.SystemName</span>
                                    </div>
                                    <input type="checkbox" name="selectedPermissionIds" data-module-name="@module.Key" value="@p.PermissionId" @(p.IsAssigned ? "checked" : "") class="toggle toggle-primary" />
                                </label>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="px-6 py-5 flex justify-end" style="background: var(--color-bg); border-top: 1px solid var(--color-border);">
                <button type="submit" class="btn btn-primary py-3 px-6 rounded-2xl font-bold gap-2 shadow-lg transition-all duration-300">
                    <span class="material-symbols-rounded">save</span>
                    حفظ ومزامنة الصلاحيات فورياً
                </button>
            </div>
        </div>
    </form>
}

<script>
    function updatePermissionsCounter() {
        const checkboxes = document.querySelectorAll('input[name="selectedPermissionIds"]');
        const total = checkboxes.length;
        const checked = Array.from(checkboxes).filter(c => c.checked).length;
        const counter = document.getElementById('permissions-counter');
        if (counter) {
            counter.textContent = `تم تحديد ${checked} من أصل ${total} صلاحية`;
        }
    }

    function toggleAllCheckboxes(checked) {
        document.querySelectorAll('input[name=selectedPermissionIds]').forEach(c => {
            c.checked = checked;
        });
        updatePermissionsCounter();
    }

    function toggleModuleCheckboxes(moduleName, checked) {
        document.querySelectorAll(`input[data-module-name="${moduleName}"]`).forEach(c => {
            c.checked = checked;
        });
        updatePermissionsCounter();
    }

    document.addEventListener('DOMContentLoaded', function () {
        updatePermissionsCounter();

        document.querySelectorAll('input[name="selectedPermissionIds"]').forEach(c => {
            c.addEventListener('change', updatePermissionsCounter);
        });

        const searchInput = document.getElementById('permSearch');
        if (searchInput) {
            searchInput.addEventListener('input', function () {
                const query = this.value.toLowerCase().trim();
                const items = document.querySelectorAll('.perm-item');

                items.forEach(item => {
                    const text = item.getAttribute('data-text');
                    if (text.includes(query)) {
                        item.style.display = '';
                    } else {
                        item.style.display = 'none';
                    }
                });

                document.querySelectorAll('.module-section').forEach(section => {
                    const visibleItems = section.querySelectorAll('.perm-item:not([style*="display: none"])');
                    if (visibleItems.length === 0) {
                        section.style.display = 'none';
                    } else {
                        section.style.display = '';
                    }
                });
            });
        }
    });
</script>
