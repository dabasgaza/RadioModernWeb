@model PermissionMatrixViewModel
@{
    ViewData["Title"] = "مصفوفة التحكم بالصلاحيات";
    var permissionsByModule = Model.Permissions.ToLookup(p => p.Module);
    ViewBag.IsEdit = true;
    ViewBag.Icon = "security";
    ViewBag.Title = "مصفوفة التحكم بالصلاحيات";
    ViewBag.Description = "تعيين وتخصيص صلاحيات العمليات والوصول لمختلف صفحات وأقسام النظام";
    ViewBag.EntityName = "الأدوار الوظيفية";
    ViewBag.EntityUrl = "/Roles";
    ViewBag.BackUrl = "/Roles";
    ViewBag.BackText = "الرجوع للأدوار";
}

<partial name="_PageHeader" />

<div class="card p-6 mb-8">
    <form method="get" class="flex flex-col md:flex-row items-center gap-6">
        <div class="flex items-center gap-3 w-full md:w-auto shrink-0">
            <div class="w-10 h-10 rounded-xl bg-primary-subtle text-primary flex items-center justify-center shrink-0">
                <span class="material-symbols-rounded text-lg">badge</span>
            </div>
            <span class="font-bold text-sm text-text">اختر الدور المراد تعديله:</span>
        </div>
        <div class="w-full">
            <select name="roleId" class="w-full bg-surface border border-border rounded-xl py-3 px-4 font-bold text-text focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all appearance-none" onchange="this.form.submit()">
                @foreach (var r in Model.Roles)
                {
                    <option value="@r.RoleId" selected="@(Model.SelectedRoleId == r.RoleId)">
                        @r.RoleName — @(r.RoleDescription ?? "لا يوجد وصف مخصص")
                    </option>
                }
            </select>
        </div>
    </form>
</div>

@if (Model.SelectedRoleId > 0)
{
    <form method="post" action="/Permissions/Update">
        @Html.AntiForgeryToken()
        <input type="hidden" name="roleId" value="@Model.SelectedRoleId" />

        <div class="card overflow-hidden">
            <div class="p-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-border bg-surface">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-primary-subtle text-primary flex items-center justify-center shrink-0">
                        <span class="material-symbols-rounded text-lg">admin_panel_settings</span>
                    </div>
                    <div>
                        <div class="flex items-center gap-2 flex-wrap">
                            <h3 class="font-bold text-base text-text">تعديل صلاحيات الدور: <span class="text-primary font-black">@Model.SelectedRoleName</span></h3>
                            <span id="permissions-counter" class="badge badge-primary font-bold">جاري الحساب...</span>
                        </div>
                        <p class="text-xs mt-1 text-text-secondary">قم بتفعيل أو إلغاء تفعيل الصلاحيات ثم احفظ التعديلات لتطبق لحظياً</p>
                    </div>
                </div>

                <div class="flex items-center gap-2">
                    <button type="button" class="btn btn-ghost btn-sm gap-1.5" onclick="toggleAllCheckboxes(true)">
                        <span class="material-symbols-rounded text-sm">check_box</span>
                        تحديد الكل
                    </button>
                    <button type="button" class="btn btn-ghost btn-sm gap-1.5" onclick="toggleAllCheckboxes(false)">
                        <span class="material-symbols-rounded text-sm">check_box_outline_blank</span>
                        إلغاء الكل
                    </button>
                </div>
            </div>

            <div class="p-4 border-b border-border bg-bg">
                <div class="relative w-full">
                    <span class="material-symbols-rounded absolute right-4 top-1/2 -translate-y-1/2 text-sm text-text-muted">search</span>
                    <input type="text" id="permSearch" placeholder="بحث سريع في الصلاحيات المعروضة..."
                           class="w-full rounded-xl pr-11 pl-4 py-2.5 text-xs bg-surface border border-border text-text focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all" />
                </div>
            </div>

            <div class="p-6 space-y-8 bg-surface">
                @foreach (var module in permissionsByModule)
                {
                    <div class="module-section space-y-4" data-module="@module.Key.ToLower()">
                        <div class="flex items-center justify-between pb-2 border-b border-border">
                            <h4 class="font-bold text-sm flex items-center gap-2 text-text">
                                <span class="w-1.5 h-3.5 rounded-full bg-primary"></span>
                                @module.Key
                            </h4>
                            <div class="flex items-center gap-1">
                                <button type="button" class="btn btn-ghost btn-sm text-xs font-bold text-primary"
                                        onclick="toggleModuleCheckboxes('@module.Key', true)">
                                    تحديد القسم
                                </button>
                                <span class="text-border select-none">|</span>
                                <button type="button" class="btn btn-ghost btn-sm text-xs font-bold text-text-secondary"
                                        onclick="toggleModuleCheckboxes('@module.Key', false)">
                                    إلغاء القسم
                                </button>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                            @foreach (var p in module)
                            {
                                <label class="perm-item flex items-center justify-between p-4 rounded-xl cursor-pointer bg-bg border border-border hover:border-primary/50 transition-all duration-200"
                                       data-text="@p.DisplayName.ToLower() @p.SystemName.ToLower()">
                                    <div class="flex flex-col gap-1 pr-2">
                                        <span class="text-xs font-bold text-text">@p.DisplayName</span>
                                        <span class="text-[9px] font-mono text-text-secondary">@p.SystemName</span>
                                    </div>
                                    <input type="checkbox" name="selectedPermissionIds" data-module-name="@module.Key" value="@p.PermissionId" @(p.IsAssigned ? "checked" : "") class="toggle toggle-primary" />
                                </label>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="px-6 py-5 flex justify-end bg-surface-hover/50 border-t border-border">
                <button type="submit" class="btn btn-primary font-bold gap-2">
                    <span class="material-symbols-rounded">save</span>
                    حفظ ومزامنة الصلاحيات فورياً
                </button>
            </div>
        </div>
    </form>
}

<script>
    function updatePermissionsCounter() {
        const checkboxes = document.querySelectorAll('input[name="selectedPermissionIds"]');
        const total = checkboxes.length;
        const checked = Array.from(checkboxes).filter(c => c.checked).length;
        const counter = document.getElementById('permissions-counter');
        if (counter) {
            counter.textContent = `تم تحديد ${checked} من أصل ${total} صلاحية`;
        }
    }

    function toggleAllCheckboxes(checked) {
        document.querySelectorAll('input[name=selectedPermissionIds]').forEach(c => {
            c.checked = checked;
        });
        updatePermissionsCounter();
    }

    function toggleModuleCheckboxes(moduleName, checked) {
        document.querySelectorAll(`input[data-module-name="${moduleName}"]`).forEach(c => {
            c.checked = checked;
        });
        updatePermissionsCounter();
    }

    document.addEventListener('DOMContentLoaded', function () {
        updatePermissionsCounter();

        document.querySelectorAll('input[name="selectedPermissionIds"]').forEach(c => {
            c.addEventListener('change', updatePermissionsCounter);
        });

        const searchInput = document.getElementById('permSearch');
        if (searchInput) {
            searchInput.addEventListener('input', function () {
                const query = this.value.toLowerCase().trim();
                const items = document.querySelectorAll('.perm-item');

                items.forEach(item => {
                    const text = item.getAttribute('data-text');
                    if (text.includes(query)) {
                        item.style.display = '';
                    } else {
                        item.style.display = 'none';
                    }
                });

                document.querySelectorAll('.module-section').forEach(section => {
                    const visibleItems = section.querySelectorAll('.perm-item:not([style*="display: none"])');
                    if (visibleItems.length === 0) {
                        section.style.display = 'none';
                    } else {
                        section.style.display = '';
                    }
                });
            });
        }
    });
</script>
