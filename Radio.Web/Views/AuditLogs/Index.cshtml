@model PagedAuditLogResult
@{
    ViewData["Title"] = "سجل التدقيق";
    ViewData["HeaderIcon"] = "history";
    ViewData["HeaderDescription"] = "سجل كامل لجميع العمليات والتعديلات التي تمت في النظام";
    var tables = ViewBag.Tables as string[];
    var actions = ViewBag.Actions as string[];
}

<partial name="_PageHeader" />

<div class="card p-6 mb-6">
    <form method="get">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div>
                <label class="text-xs font-semibold mb-1.5 block text-text-secondary">الجدول</label>
                <select name="table" class="input">
                    <option value="">الكل</option>
                    @foreach (var t in tables ?? Array.Empty<string>())
                    {
                        <option value="@t" selected="@(ViewBag.SelectedTable == t)">@t</option>
                    }
                </select>
            </div>
            <div>
                <label class="text-xs font-semibold mb-1.5 block text-text-secondary">العملية</label>
                <select name="action" class="input">
                    <option value="">الكل</option>
                    @foreach (var a in actions ?? Array.Empty<string>())
                    {
                        <option value="@a" selected="@(ViewBag.SelectedAction == a)">@a</option>
                    }
                </select>
            </div>
            <div>
                <label class="text-xs font-semibold mb-1.5 block text-text-secondary">من تاريخ</label>
                <input type="text" name="fromDate" value="@ViewBag.FromDate"
                       class="input datepicker"
                       placeholder="اختر تاريخ البداية" />
            </div>
            <div>
                <label class="text-xs font-semibold mb-1.5 block text-text-secondary">إلى تاريخ</label>
                <input type="text" name="toDate" value="@ViewBag.ToDate"
                       class="input datepicker"
                       placeholder="اختر تاريخ النهاية" />
            </div>
            <div class="md:col-span-4 flex justify-end gap-2 mt-2">
                <button type="submit" class="btn btn-primary gap-2"><span class="material-symbols-rounded">search</span> تطبيق</button>
                <a href="/AuditLogs" class="btn btn-ghost gap-2"><span class="material-symbols-rounded">refresh</span> إعادة ضبط</a>
            </div>
        </div>
    </form>
</div>

@if (!Model.Items.Any())
{
    ViewBag.EmptyIcon = "history";
    ViewBag.EmptyTitle = "لا توجد سجلات تدقيق";
    ViewBag.EmptyDesc = "لم يتم العثور على أية سجلات مطابقة لمحددات البحث الحالية.";
    <partial name="_EmptyState" />
}
else
{
    <div class="card overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="text-xs font-semibold text-text-secondary bg-surface-hover border-b border-border">
                        <th class="text-right py-3 px-4">التاريخ</th>
                        <th class="text-right py-3 px-4">الجدول</th>
                        <th class="text-right py-3 px-4">العملية</th>
                        <th class="text-right py-3 px-4">المستخدم</th>
                        <th class="text-right py-3 px-4">السبب</th>
                        <th class="text-center py-3 px-4">تفاصيل</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border">
                    @foreach (var log in Model.Items)
                    {
                        <tr class="hover:bg-surface-hover/50 transition-colors">
                            <td class="py-3 px-4 whitespace-nowrap text-text-secondary font-mono text-xs" dir="ltr">@log.ChangedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="py-3 px-4"><span class="badge badge-primary">@log.TableName</span></td>
                            <td class="py-3 px-4">
                                <span class="badge badge-primary">@log.Action</span>
                            </td>
                            <td class="py-3 px-4 text-text-secondary">@log.UserFullName</td>
                            <td class="py-3 px-4 text-xs text-text-muted max-w-xs truncate" title="@log.Reason">@(log.Reason ?? "—")</td>
                            <td class="py-3 px-4 text-center">
                                <button class="btn btn-icon btn-sm btn-ghost text-primary" onclick="showDiff(@log.AuditLogId, '@log.Action')">
                                    <span class="material-symbols-rounded text-lg">visibility</span>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<dialog id="diffModal" class="modal backdrop:bg-black/50 p-0 bg-transparent">
    <div class="card p-6 max-w-3xl w-full mx-auto">
        <div class="flex items-center justify-between mb-4">
            <h3 class="font-bold text-text" id="diffTitle">تفاصيل التغيير</h3>
            <button type="button" class="btn btn-ghost btn-square btn-sm text-text-muted hover:text-text rounded-xl" onclick="document.getElementById('diffModal').close()">
                <span class="material-symbols-rounded">close</span>
            </button>
        </div>
        <div id="diffContent" class="space-y-4">
            <div>
                <h4 class="font-bold text-xs text-text-muted mb-1">القيم القديمة</h4>
                <pre id="diffOld" class="text-xs p-3 rounded-xl overflow-x-auto max-h-48 bg-bg text-text" dir="ltr"></pre>
            </div>
            <div>
                <h4 class="font-bold text-xs text-text-muted mb-1">القيم الجديدة</h4>
                <pre id="diffNew" class="text-xs p-3 rounded-xl overflow-x-auto max-h-48 bg-bg text-text" dir="ltr"></pre>
            </div>
        </div>
    </div>
</dialog>

<script>
    const auditData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Items.Select(l => new {
        id = l.AuditLogId,
        oldValues = l.OldValues,
        newValues = l.NewValues
    })));

    function showDiff(id, action) {
        const item = auditData.find(d => d.id === id);
        if (!item) return;
        document.getElementById('diffTitle').textContent = 'تفاصيل التغيير — ' + action;

        const oldEl = document.getElementById('diffOld');
        const newEl = document.getElementById('diffNew');

        try {
            const oldObj = item.oldValues ? JSON.parse(item.oldValues) : null;
            newEl.textContent = item.newValues ? JSON.stringify(JSON.parse(item.newValues), null, 2) : '(لا توجد قيم جديدة)';
            oldEl.textContent = oldObj ? JSON.stringify(oldObj, null, 2) : '(لا توجد قيم قديمة)';
        } catch {
            oldEl.textContent = item.oldValues || '(لا توجد قيم قديمة)';
            newEl.textContent = item.newValues || '(لا توجد قيم جديدة)';
        }

        document.getElementById('diffModal').showModal();
    }

    document.getElementById('diffModal')?.addEventListener('click', function (e) {
        var rect = this.getBoundingClientRect();
        if (e.clientX < rect.left || e.clientX > rect.right ||
            e.clientY < rect.top || e.clientY > rect.bottom) {
            this.close();
        }
    });
</script>