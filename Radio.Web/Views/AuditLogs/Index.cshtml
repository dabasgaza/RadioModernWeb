@model PagedAuditLogResult
@{
    ViewData["Title"] = "سجل التدقيق";
    var tables = ViewBag.Tables as string[];
    var actions = ViewBag.Actions as string[];
}

<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
    <div>
        <div class="breadcrumbs text-sm text-base-content/60">
            <ul>
                <li><a href="/" class="inline-flex items-center gap-1"><span class="material-symbols-rounded text-lg">home</span>الرئيسية</a></li>
                <li><span class="inline-flex items-center gap-1"><span class="material-symbols-rounded text-lg">history</span>سجل التدقيق</span></li>
            </ul>
        </div>
        <h1 class="text-2xl font-extrabold text-base-content mt-1 flex items-center gap-2">
            <span class="material-symbols-rounded text-primary">history</span>
            سجل التدقيق
        </h1>
        <p class="text-sm text-base-content/60 mt-0.5">سجل كامل لجميع العمليات والتعديلات التي تمت في النظام</p>
    </div>
</div>

<div class="wf-card mb-6">
    <div class="card-body">
        <form method="get">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-3">
                <div>
                    <label class="label"><span class="label-text">الجدول</span></label>
                    <select name="table" class="select select-bordered">
                        <option value="">الكل</option>
                        @foreach (var t in tables ?? Array.Empty<string>())
                        {
                            <option value="@t" selected="@(ViewBag.SelectedTable == t)">@t</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="label"><span class="label-text">العملية</span></label>
                    <select name="action" class="select select-bordered">
                        <option value="">الكل</option>
                        @foreach (var a in actions ?? Array.Empty<string>())
                        {
                            <option value="@a" selected="@(ViewBag.SelectedAction == a)">@a</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="label"><span class="label-text">من تاريخ</span></label>
                    <input type="text" name="fromDate" value="@ViewBag.FromDate" class="input input-bordered datepicker" placeholder="اختر تاريخ البداية" />
                </div>
                <div>
                    <label class="label"><span class="label-text">إلى تاريخ</span></label>
                    <input type="text" name="toDate" value="@ViewBag.ToDate" class="input input-bordered datepicker" placeholder="اختر تاريخ النهاية" />
                </div>
                <div class="md:col-span-4 flex justify-end gap-2">
                    <button type="submit" class="btn btn-primary"><span class="material-symbols-rounded">search</span> تطبيق</button>
                    <a href="/AuditLogs" class="btn btn-ghost"><span class="material-symbols-rounded">refresh</span> إعادة ضبط</a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="overflow-x-auto">
    @if (!Model.Items.Any())
    {
        <div class="wf-card"><div class="card-body text-center py-12">
            <span class="material-symbols-rounded text-4xl text-base-content/30 mb-2">history</span>
            <h3 class="font-bold text-ink text-lg mb-2">لا سجلات</h3>
            <p class="text-ink-muted text-sm">لا توجد عمليات مطابقة للبحث.</p>
        </div></div>
    }
    else
    {
        <div class="wf-card overflow-hidden">
            <div class="overflow-x-auto">
            <table class="table table-zebra w-full text-sm">
                <thead>
                    <tr>
                        <th class="text-right">التاريخ</th>
                        <th class="text-right">الجدول</th>
                        <th class="text-right">العملية</th>
                        <th class="text-right">المستخدم</th>
                        <th class="text-right">السبب</th>
                        <th class="text-right">تفاصيل</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model.Items)
                    {
                        <tr>
                            <td class="whitespace-nowrap" dir="ltr">@log.ChangedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td><span class="badge badge-ghost">@log.TableName</span></td>
                            <td>
                                <span class="badge @GetActionBadgeClass(log.Action)">@log.Action</span>
                            </td>
                            <td>@log.UserFullName</td>
                            <td class="text-xs max-w-xs truncate" title="@log.Reason">@(log.Reason ?? "—")</td>
                            <td>
                                <button class="btn btn-ghost btn-xs" onclick="showDiff(@log.AuditLogId, '@log.Action')">
                                    <span class="material-symbols-rounded text-sm">visibility</span>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        </div>
    }
</div>

<div id="diffModal" class="modal">
    <div class="modal-box max-w-3xl">
        <h3 class="font-bold text-lg mb-4" id="diffTitle">تفاصيل التغيير</h3>
        <div id="diffContent" class="space-y-4">
            <div>
                <h4 class="font-bold text-sm text-base-content/60 mb-1">القيم القديمة</h4>
                <pre id="diffOld" class="text-xs bg-base-200 p-3 rounded-box overflow-x-auto max-h-48" dir="ltr"></pre>
            </div>
            <div>
                <h4 class="font-bold text-sm text-base-content/60 mb-1">القيم الجديدة</h4>
                <pre id="diffNew" class="text-xs bg-base-200 p-3 rounded-box overflow-x-auto max-h-48" dir="ltr"></pre>
            </div>
        </div>
        <div class="modal-action"><button class="btn" onclick="document.getElementById('diffModal').close()">إغلاق</button></div>
    </div>
</div>

<script>
    const auditData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Items.Select(l => new {
        id = l.AuditLogId,
        oldValues = l.OldValues,
        newValues = l.NewValues
    })));

    function showDiff(id, action) {
        const item = auditData.find(d => d.id === id);
        if (!item) return;
        document.getElementById('diffTitle').textContent = 'تفاصيل التغيير — ' + action;

        const oldEl = document.getElementById('diffOld');
        const newEl = document.getElementById('diffNew');

        try {
            const oldObj = item.oldValues ? JSON.parse(item.oldValues) : null;
            newEl.textContent = item.newValues ? JSON.stringify(JSON.parse(item.newValues), null, 2) : '(لا توجد قيم جديدة)';
            oldEl.textContent = oldObj ? JSON.stringify(oldObj, null, 2) : '(لا توجد قيم قديمة)';
        } catch {
            oldEl.textContent = item.oldValues || '(لا توجد قيم قديمة)';
            newEl.textContent = item.newValues || '(لا توجد قيم جديدة)';
        }

        document.getElementById('diffModal').showModal();
    }
</script>

@functions {
    string GetActionBadgeClass(string action) => action switch
    {
        "ADDED" => "badge-success",
        "MODIFIED" => "badge-warning",
        "DELETED" or "SOFT_DELETED" => "badge-danger",
        _ => "badge-default"
    };
}
