@model PagedAuditLogResult
@{
    ViewData["Title"] = "سجل التدقيق";
    var tables = ViewBag.Tables as string[];
    var actions = ViewBag.Actions as string[];
}

<div class="page-header">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 relative z-10">
        <div>
            <nav class="breadcrumb">
                <span class="material-symbols-rounded">home</span>
                <a href="/">الرئيسية</a>
                <span class="material-symbols-rounded">chevron_left</span>
                <span>سجل التدقيق</span>
            </nav>
            <h1>
                <span class="material-symbols-rounded text-primary">history</span>
                سجل التدقيق
            </h1>
            <p>سجل كامل لجميع العمليات والتعديلات التي تمت في النظام</p>
        </div>
    </div>
</div>

<div class="filter-premium">
    <form method="get">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-3">
            <div>
                <label class="form-label">الجدول</label>
                <select name="table" class="form-input">
                    <option value="">الكل</option>
                    @foreach (var t in tables ?? Array.Empty<string>())
                    {
                        <option value="@t" selected="@(ViewBag.SelectedTable == t)">@t</option>
                    }
                </select>
            </div>
            <div>
                <label class="form-label">العملية</label>
                <select name="action" class="form-input">
                    <option value="">الكل</option>
                    @foreach (var a in actions ?? Array.Empty<string>())
                    {
                        <option value="@a" selected="@(ViewBag.SelectedAction == a)">@a</option>
                    }
                </select>
            </div>
            <div>
                <label class="form-label">من تاريخ</label>
                <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-input" />
            </div>
            <div>
                <label class="form-label">إلى تاريخ</label>
                <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-input" />
            </div>
            <div class="md:col-span-4 flex justify-end gap-2">
                <button type="submit" class="btn-primary"><span class="material-symbols-rounded">search</span> تطبيق</button>
                <a href="/AuditLogs" class="btn-secondary"><span class="material-symbols-rounded">refresh</span> إعادة ضبط</a>
            </div>
        </div>
    </form>
</div>

<div class="table-premium">
    @if (!Model.Items.Any())
    {
        <div class="empty-state p-12">
            <span class="material-symbols-rounded empty-icon">history</span>
            <h3 class="font-bold text-ink text-lg mb-2">لا سجلات</h3>
            <p class="text-ink-muted text-sm">لا توجد عمليات مطابقة للبحث.</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr>
                        <th class="px-5 py-3 text-right font-semibold">التاريخ</th>
                        <th class="px-5 py-3 text-right font-semibold">الجدول</th>
                        <th class="px-5 py-3 text-right font-semibold">العملية</th>
                        <th class="px-5 py-3 text-right font-semibold">المستخدم</th>
                        <th class="px-5 py-3 text-right font-semibold">السبب</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model.Items)
                    {
                        <tr>
                            <td class="px-5 py-3 text-ink-muted whitespace-nowrap" dir="ltr">@log.ChangedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="px-5 py-3"><span class="badge badge-default">@log.TableName</span></td>
                            <td class="px-5 py-3">
                                <span class="badge @GetActionBadgeClass(log.Action)">@log.Action</span>
                            </td>
                            <td class="px-5 py-3 text-ink-muted">@log.UserFullName</td>
                            <td class="px-5 py-3 text-ink-muted text-xs max-w-xs truncate" title="@log.Reason">@(log.Reason ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@functions {
    string GetActionBadgeClass(string action) => action switch
    {
        "ADDED" => "badge-success",
        "MODIFIED" => "badge-warning",
        "DELETED" or "SOFT_DELETED" => "badge-danger",
        _ => "badge-default"
    };
}
