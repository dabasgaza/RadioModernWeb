@model List<AuditLogDto>
@{
    ViewData["Title"] = "سجل التدقيق";
    var tables = ViewBag.Tables as string[];
    var actions = ViewBag.Actions as string[];
}

<div class="page-header">
    <div class="relative z-10">
        <nav class="breadcrumb">
            <a href="/">الرئيسية</a>
            <span class="material-icons">chevron_left</span>
            <span>سجل التدقيق</span>
        </nav>
        <h1>
            <span class="material-icons">history</span>
            سجل التدقيق
        </h1>
        <p>سجل كامل لجميع العمليات في النظام</p>
    </div>
</div>

<div class="card-premium mb-4 p-5">
    <form method="get" class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div>
            <label class="form-label">الجدول</label>
            <select name="table" class="form-input">
                <option value="">الكل</option>
                @foreach (var t in tables ?? Array.Empty<string>())
                {
                    <option value="@t" selected="@(ViewBag.SelectedTable == t)">@t</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label">العملية</label>
            <select name="action" class="form-input">
                <option value="">الكل</option>
                @foreach (var a in actions ?? Array.Empty<string>())
                {
                    <option value="@a" selected="@(ViewBag.SelectedAction == a)">@a</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label">من تاريخ</label>
            <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-input" />
        </div>
        <div>
            <label class="form-label">إلى تاريخ</label>
            <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-input" />
        </div>
        <div class="md:col-span-4 flex justify-end gap-2">
            <button type="submit" class="btn-primary"><span class="material-icons">search</span> تطبيق</button>
            <a href="/AuditLogs" class="btn-secondary"><span class="material-icons">refresh</span> إعادة ضبط</a>
        </div>
    </form>
</div>

<div class="table-premium">
    @if (!Model.Any())
    {
        <div class="empty-state p-12">
            <span class="material-icons empty-icon">history</span>
            <h3 class="font-bold text-ink text-lg mb-2">لا سجلات</h3>
            <p class="text-ink-muted text-sm">لا توجد عمليات مطابقة.</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table>
                <thead>
                    <tr>
                        <th>التاريخ</th>
                        <th>الجدول</th>
                        <th>العملية</th>
                        <th>المستخدم</th>
                        <th>السبب</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model)
                    {
                        <tr class="hover:bg-surface-2 transition duration-200">
                            <td class="text-ink-muted">@log.ChangedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td><span class="badge-premium bg-gray-50 text-gray-700 border-gray-200">@log.TableName</span></td>
                            <td><span class="badge-premium @GetActionBadgeClass(log.Action)">@log.Action</span></td>
                            <td class="text-ink-muted">@log.UserFullName</td>
                            <td class="text-ink-muted text-xs">@(log.Reason ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@functions {
    string GetActionBadgeClass(string action) => action switch
    {
        "ADDED" => "bg-emerald-50 text-emerald-700 border-emerald-200",
        "MODIFIED" => "bg-amber-50 text-amber-700 border-amber-200",
        "DELETED" or "SOFT_DELETED" => "bg-red-50 text-red-700 border-red-200",
        _ => "bg-gray-50 text-gray-700 border-gray-200"
    };
}
