@model PagedAuditLogResult
@{
    ViewData["Title"] = "سجل التدقيق";
    ViewData["HeaderIcon"] = "history";
    ViewData["HeaderDescription"] = "سجل كامل لجميع العمليات والتعديلات التي تمت في النظام";
    var tables = ViewBag.Tables as string[];
    var actions = ViewBag.Actions as string[];
}

<partial name="_PageHeader" />

<div class="rounded-xl p-6 mb-6" style="background: var(--color-bg-elevated); border: 1px solid var(--color-border);">
    <form method="get">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-3">
            <div>
                <label class="text-xs font-medium mb-1.5 block text-[var(--color-text-3)]">الجدول</label>
                <select name="table" class="w-full rounded-xl py-2.5 px-3 text-sm font-medium focus:outline-none focus:ring-2 transition-all appearance-none"
                        style="background: var(--color-bg); border: 1px solid var(--color-border); color: var(--color-text); --tw-ring-color: var(--color-primary);">
                    <option value="">الكل</option>
                    @foreach (var t in tables ?? Array.Empty<string>())
                    {
                        <option value="@t" selected="@(ViewBag.SelectedTable == t)">@t</option>
                    }
                </select>
            </div>
            <div>
                <label class="text-xs font-medium mb-1.5 block text-[var(--color-text-3)]">العملية</label>
                <select name="action" class="w-full rounded-xl py-2.5 px-3 text-sm font-medium focus:outline-none focus:ring-2 transition-all appearance-none"
                        style="background: var(--color-bg); border: 1px solid var(--color-border); color: var(--color-text); --tw-ring-color: var(--color-primary);">
                    <option value="">الكل</option>
                    @foreach (var a in actions ?? Array.Empty<string>())
                    {
                        <option value="@a" selected="@(ViewBag.SelectedAction == a)">@a</option>
                    }
                </select>
            </div>
            <div>
                <label class="text-xs font-medium mb-1.5 block text-[var(--color-text-3)]">من تاريخ</label>
                <input type="text" name="fromDate" value="@ViewBag.FromDate"
                       class="w-full rounded-xl py-2.5 px-3 text-sm font-medium focus:outline-none focus:ring-2 transition-all datepicker"
                       style="background: var(--color-bg); border: 1px solid var(--color-border); color: var(--color-text); --tw-ring-color: var(--color-primary);" placeholder="اختر تاريخ البداية" />
            </div>
            <div>
                <label class="text-xs font-medium mb-1.5 block text-[var(--color-text-3)]">إلى تاريخ</label>
                <input type="text" name="toDate" value="@ViewBag.ToDate"
                       class="w-full rounded-xl py-2.5 px-3 text-sm font-medium focus:outline-none focus:ring-2 transition-all datepicker"
                       style="background: var(--color-bg); border: 1px solid var(--color-border); color: var(--color-text); --tw-ring-color: var(--color-primary);" placeholder="اختر تاريخ النهاية" />
            </div>
            <div class="md:col-span-4 flex justify-end gap-2">
                <button type="submit" class="btn btn-primary rounded-xl gap-2"><span class="material-symbols-rounded">search</span> تطبيق</button>
                <a href="/AuditLogs" class="btn btn-ghost rounded-xl gap-2"><span class="material-symbols-rounded">refresh</span> إعادة ضبط</a>
            </div>
        </div>
    </form>
</div>

@if (!Model.Items.Any())
{
    <div class="rounded-xl p-12 text-center" style="background: var(--color-bg-elevated); border: 1px solid var(--color-border);">
        <span class="material-symbols-rounded text-4xl text-[var(--color-text-4)] mb-2 block">history</span>
        <h3 class="font-bold text-lg mb-2 text-[var(--color-text)]">لا سجلات</h3>
        <p class="text-sm text-[var(--color-text-3)]">لا توجد عمليات مطابقة للبحث.</p>
    </div>
}
else
{
    <div class="rounded-xl overflow-hidden" style="background: var(--color-bg-elevated); border: 1px solid var(--color-border);">
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="text-xs font-semibold text-[var(--color-text-4)]"
                        style="background: var(--color-bg); border-bottom: 1px solid var(--color-border);">
                        <th class="text-right py-3 px-4">التاريخ</th>
                        <th class="text-right py-3 px-4">الجدول</th>
                        <th class="text-right py-3 px-4">العملية</th>
                        <th class="text-right py-3 px-4">المستخدم</th>
                        <th class="text-right py-3 px-4">السبب</th>
                        <th class="text-center py-3 px-4">تفاصيل</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model.Items)
                    {
                        <tr class="transition-colors hover:bg-[var(--color-bg-hover)]" style="border-bottom: 1px solid var(--color-border);">
                            <td class="py-3 px-4 whitespace-nowrap text-[var(--color-text-2)]" dir="ltr">@log.ChangedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="py-3 px-4"><span class="text-[10px] font-bold px-2 py-0.5 rounded-lg" style="background: var(--color-bg); color: var(--color-text-3);">@log.TableName</span></td>
                            <td class="py-3 px-4">
                                <span class="text-[10px] font-bold px-2 py-0.5 rounded-lg" style="background: @GetActionBadgeColor(log.Action); color: @GetActionBadgeText(log.Action);">@log.Action</span>
                            </td>
                            <td class="py-3 px-4 text-[var(--color-text-3)]">@log.UserFullName</td>
                            <td class="py-3 px-4 text-xs text-[var(--color-text-4)] max-w-xs truncate" title="@log.Reason">@(log.Reason ?? "—")</td>
                            <td class="py-3 px-4 text-center">
                                <button class="btn btn-ghost btn-xs rounded-lg" onclick="showDiff(@log.AuditLogId, '@log.Action')">
                                    <span class="material-symbols-rounded text-sm">visibility</span>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<dialog id="diffModal" class="modal backdrop:bg-black/50 p-0 bg-transparent">
    <div class="rounded-xl p-6 max-w-3xl w-full mx-auto" style="background: var(--color-bg-elevated); border: 1px solid var(--color-border);">
        <div class="flex items-center justify-between mb-4">
            <h3 class="font-bold text-[var(--color-text)]" id="diffTitle">تفاصيل التغيير</h3>
            <button type="button" class="btn btn-ghost btn-square btn-sm text-[var(--color-text-4)] hover:text-[var(--color-text)] rounded-xl" onclick="document.getElementById('diffModal').close()">
                <span class="material-symbols-rounded">close</span>
            </button>
        </div>
        <div id="diffContent" class="space-y-4">
            <div>
                <h4 class="font-bold text-xs text-[var(--color-text-4)] mb-1">القيم القديمة</h4>
                <pre id="diffOld" class="text-xs p-3 rounded-xl overflow-x-auto max-h-48" style="background: var(--color-bg); color: var(--color-text);" dir="ltr"></pre>
            </div>
            <div>
                <h4 class="font-bold text-xs text-[var(--color-text-4)] mb-1">القيم الجديدة</h4>
                <pre id="diffNew" class="text-xs p-3 rounded-xl overflow-x-auto max-h-48" style="background: var(--color-bg); color: var(--color-text);" dir="ltr"></pre>
            </div>
        </div>
    </div>
</dialog>

<script>
    const auditData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Items.Select(l => new {
        id = l.AuditLogId,
        oldValues = l.OldValues,
        newValues = l.NewValues
    })));

    function showDiff(id, action) {
        const item = auditData.find(d => d.id === id);
        if (!item) return;
        document.getElementById('diffTitle').textContent = 'تفاصيل التغيير — ' + action;

        const oldEl = document.getElementById('diffOld');
        const newEl = document.getElementById('diffNew');

        try {
            const oldObj = item.oldValues ? JSON.parse(item.oldValues) : null;
            newEl.textContent = item.newValues ? JSON.stringify(JSON.parse(item.newValues), null, 2) : '(لا توجد قيم جديدة)';
            oldEl.textContent = oldObj ? JSON.stringify(oldObj, null, 2) : '(لا توجد قيم قديمة)';
        } catch {
            oldEl.textContent = item.oldValues || '(لا توجد قيم قديمة)';
            newEl.textContent = item.newValues || '(لا توجد قيم جديدة)';
        }

        document.getElementById('diffModal').showModal();
    }

    document.getElementById('diffModal')?.addEventListener('click', function (e) {
        var rect = this.getBoundingClientRect();
        if (e.clientX < rect.left || e.clientX > rect.right ||
            e.clientY < rect.top || e.clientY > rect.bottom) {
            this.close();
        }
    });
</script>

@functions {
    string GetActionBadgeColor(string action) => action switch
    {
        "ADDED" => "var(--color-success-light)",
        "MODIFIED" => "var(--color-warning-light)",
        "DELETED" or "SOFT_DELETED" => "var(--color-danger-light)",
        _ => "var(--color-bg)"
    };

    string GetActionBadgeText(string action) => action switch
    {
        "ADDED" => "var(--color-success)",
        "MODIFIED" => "var(--color-warning)",
        "DELETED" or "SOFT_DELETED" => "var(--color-danger)",
        _ => "var(--color-text-3)"
    };
}
