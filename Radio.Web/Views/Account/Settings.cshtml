@{
    ViewData["Title"] = "الإعدادات";
    ViewData["HeaderIcon"] = "settings";
    ViewData["HeaderDescription"] = "تخصيص تجربتك في النظام وإعدادات التفضيلات الشخصية";
}

<partial name="_PageHeader" />

<div class="card max-w-2xl">
    <div class="p-6">
        @{
            ViewBag.SectionIcon = "tune";
            ViewBag.SectionTitle = "التفضيلات";
            ViewBag.SectionSubtitle = "الإعدادات العامة والتخصيصات";
            ViewBag.SectionAction = null;
        }
        <partial name="_SectionHeader" />

        <div class="space-y-4">
            <div class="flex items-center justify-between">
                <div>
                    <div class="font-semibold text-text">الإشعارات</div>
                    <div class="text-caption text-text-muted">استقبال إشعارات لحظية للتغييرات</div>
                </div>
                <input type="checkbox" class="toggle" checked aria-label="تفعيل الإشعارات">
            </div>

            <div class="flex items-center justify-between pt-4 border-t border-border">
                <div>
                    <div class="font-semibold text-text">اللغة</div>
                    <div class="text-caption text-text-muted">لغة الواجهة</div>
                </div>
                <select class="input w-48" aria-label="اختيار اللغة">
                    <option value="ar-SA" selected>العربية</option>
                    <option value="en-US">English</option>
                </select>
            </div>
        </div>
    </div>
</div>
