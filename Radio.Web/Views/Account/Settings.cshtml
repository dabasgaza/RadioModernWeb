@{
    ViewData["Title"] = "الإعدادات";
}

<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
    <div>
        <div class="breadcrumbs text-sm text-base-content/60">
            <ul>
                <li><a href="/" class="inline-flex items-center gap-1"><span class="material-symbols-rounded text-lg">home</span>الرئيسية</a></li>
                <li><span class="inline-flex items-center gap-1"><span class="material-symbols-rounded text-lg">settings</span>الإعدادات</span></li>
            </ul>
        </div>
        <h1 class="text-2xl font-extrabold text-base-content mt-1 flex items-center gap-2">
            <span class="material-symbols-rounded text-primary">settings</span>
            الإعدادات
        </h1>
        <p class="text-sm text-base-content/60 mt-0.5">تخصيص تجربتك في النظام وإعدادات التفضيلات الشخصية</p>
    </div>
</div>

<div class="wf-card max-w-2xl">
    <div class="card-body space-y-4">
        <div class="flex items-center gap-2">
            <span class="material-symbols-rounded text-primary">tune</span>
            <h3 class="font-bold text-base-content text-base">التفضيلات</h3>
        </div>
        <div class="flex items-center justify-between">
            <div>
                <div class="font-semibold text-base-content">الإشعارات</div>
                <div class="text-sm text-base-content/60">استقبال إشعارات لحظية للتغييرات</div>
            </div>
            <input type="checkbox" class="toggle" checked>
        </div>

        <div class="flex items-center justify-between border-t border-base-200 pt-4">
            <div>
                <div class="font-semibold text-base-content">اللغة</div>
                <div class="text-sm text-base-content/60">لغة الواجهة</div>
            </div>
            <select class="select select-bordered w-48">
                <option value="ar-SA" selected>العربية</option>
                <option value="en-US">English</option>
            </select>
        </div>
    </div>
</div>
