@{
    ViewData["Title"] = "الملف الشخصي";
    ViewData["HeaderIcon"] = "person";
    ViewData["HeaderDescription"] = "إدارة بيانات حسابك الشخصي ومعلومات الاتصال";
}

<partial name="_PageHeader" />

<div class="card max-w-2xl">
    <div class="p-6">
        <div class="flex items-center gap-4 mb-6">
            <div class="w-20 h-20 rounded-full flex items-center justify-center text-3xl font-bold shrink-0 bg-primary text-primary-foreground">
                @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
            </div>
            <div>
                <h2 class="text-title font-bold text-text">@User.FindFirst("FullName")?.Value</h2>
                <p class="text-body text-text-secondary">@User.Identity?.Name</p>
                <span class="badge badge-info mt-1">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
            </div>
        </div>

        <div class="space-y-3 pt-4 border-t border-border">
            <div class="flex items-center justify-between py-2">
                <span class="text-text-secondary">البريد الإلكتروني</span>
                <span class="font-semibold text-text">@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</span>
            </div>
            <div class="flex items-center justify-between py-2 border-t border-border">
                <span class="text-text-secondary">رقم الهاتف</span>
                <span class="font-semibold text-text">@User.FindFirst("Phone")?.Value</span>
            </div>
            <div class="flex items-center justify-between py-2 border-t border-border">
                <span class="text-text-secondary">معرّف المستخدم</span>
                <span class="font-semibold text-text">@User.FindFirst("DomainUserId")?.Value</span>
            </div>
        </div>
    </div>
</div>
