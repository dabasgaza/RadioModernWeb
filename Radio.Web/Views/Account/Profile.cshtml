@{
    ViewData["Title"] = "الملف الشخصي";
}

<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
    <div>
        <div class="breadcrumbs text-sm text-base-content/60">
            <ul>
                <li><a href="/" class="inline-flex items-center gap-1"><span class="material-symbols-rounded text-lg">home</span>الرئيسية</a></li>
                <li><span class="inline-flex items-center gap-1"><span class="material-symbols-rounded text-lg">person</span>الملف الشخصي</span></li>
            </ul>
        </div>
        <h1 class="text-2xl font-extrabold text-base-content mt-1 flex items-center gap-2">
            <span class="material-symbols-rounded text-primary">person</span>
            الملف الشخصي
        </h1>
        <p class="text-sm text-base-content/60 mt-0.5">إدارة بيانات حسابك الشخصي ومعلومات الاتصال</p>
    </div>
</div>

<div class="wf-card max-w-2xl">
    <div class="card-body">
        <div class="flex items-center gap-4 mb-6">
            <div class="w-20 h-20 rounded-full bg-gradient-to-br from-primary to-secondary text-white flex items-center justify-center text-3xl font-bold shrink-0">
                @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
            </div>
            <div>
                <h2 class="text-xl font-bold text-base-content">@User.FindFirst("FullName")?.Value</h2>
                <p class="text-base-content/60 text-sm">@User.Identity?.Name</p>
                <span class="badge badge-info mt-1">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
            </div>
        </div>

        <div class="space-y-3 border-t border-base-200 pt-4">
            <div class="flex items-center justify-between py-2">
                <span class="text-base-content/60">البريد الإلكتروني</span>
                <span class="font-semibold text-base-content">@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</span>
            </div>
            <div class="flex items-center justify-between py-2 border-t border-base-200">
                <span class="text-base-content/60">رقم الهاتف</span>
                <span class="font-semibold text-base-content">@User.FindFirst("Phone")?.Value</span>
            </div>
            <div class="flex items-center justify-between py-2 border-t border-base-200">
                <span class="text-base-content/60">معرّف المستخدم</span>
                <span class="font-semibold text-base-content">@User.FindFirst("DomainUserId")?.Value</span>
            </div>
        </div>
    </div>
</div>
