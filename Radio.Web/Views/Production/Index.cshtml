@model ProductionBoardViewModel
@{
    ViewData["Title"] = "لوحة الإنتاج";
    ViewData["HeaderIcon"] = "view_column";
    ViewData["HeaderDescription"] = "عرض وإدارة الحلقات حسب حالة الإنتاج — اضغط على البطاقة للتفاصيل";
    var columnStyles = new Dictionary<string, string>
    {
        ["1"] = "planned",
        ["2"] = "executed",
        ["3"] = "published",
        ["4"] = "cancelled",
        ["5"] = "website-published"
    };
}

<partial name="_PageHeader" />

<div class="card p-5 mb-6">
    <div class="relative w-full">
        <span class="material-symbols-rounded absolute right-3.5 top-1/2 -translate-y-1/2 text-text-muted pointer-events-none">search</span>
        <input type="text" id="productionSearch" placeholder="بحث في جميع الحلقات..."
               class="w-full bg-surface border border-border rounded-xl py-2.5 pr-10 pl-3 text-sm text-text font-medium focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all" />
    </div>
</div>

<div class="overflow-x-auto pb-2">
    <div class="grid grid-cols-5 gap-4" style="min-width: 950px;" dir="ltr">
        @foreach (var col in Model.Columns)
        {
            var statusKey = col.Key;
            <div dir="rtl">
                <div class="card flex flex-col h-full overflow-hidden bg-bg">
                    <div class="flex items-center justify-between px-4 py-3 border-b border-border bg-surface text-text">
                        <h3 class="font-bold text-sm">@col.Value.Title</h3>
                        <span class="badge badge-primary">
                            @col.Value.Cards.Count
                        </span>
                    </div>
                    <div class="p-3 space-y-3 overflow-y-auto production-column" style="max-height: 68vh;">
                        @foreach (var card in col.Value.Cards)
                        {
                            <div class="card card-interactive p-3.5 cursor-pointer production-card"
                                 data-search="@card.EpisodeName @card.ProgramName @card.GuestNames"
                                 onclick="window.location='/Episodes/Details/@card.EpisodeId'">
                                <h4 class="font-bold text-sm text-text leading-snug line-clamp-2">@card.EpisodeName</h4>
                                <p class="text-caption text-text-secondary truncate flex items-center gap-1 mt-1.5">
                                    <span class="material-symbols-rounded text-xs text-primary">radio</span>
                                    @card.ProgramName
                                </p>
                                @if (!string.IsNullOrEmpty(card.GuestNames))
                                {
                                    <p class="text-caption text-text-muted truncate flex items-center gap-1 mt-1">
                                        <span class="material-symbols-rounded text-xs">person</span>
                                        @card.GuestNames
                                    </p>
                                }
                                <div class="flex items-center justify-between mt-3 pt-2 border-t border-border-light">
                                    <span class="text-caption text-text-muted flex items-center gap-1" dir="ltr">
                                        <span class="material-symbols-rounded text-xs">schedule</span>
                                        @(card.ScheduledTime?.ToString("yyyy-MM-dd HH:mm") ?? "—")
                                    </span>
                                    <span class="badge badge-primary text-[10px]">@card.StatusDisplay</span>
                                </div>
                            </div>
                        }
                        @if (!col.Value.Cards.Any())
                        {
                            <div class="text-center py-10 text-text-muted">
                                <span class="material-symbols-rounded text-3xl">inbox</span>
                                <p class="text-xs mt-1 font-medium">لا توجد حلقات</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const searchInput = document.getElementById('productionSearch');
        if (searchInput) {
            searchInput.addEventListener('input', function () {
                const query = this.value.toLowerCase().trim();
                document.querySelectorAll('.production-card').forEach(function (card) {
                    const text = card.getAttribute('data-search').toLowerCase();
                    card.style.display = text.includes(query) ? '' : 'none';
                });
            });
        }
    });
</script>
