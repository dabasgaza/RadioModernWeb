@model ProgramDto
@{
    ViewData["Title"] = Model.ProgramId == 0 ? "برنامج جديد" : "تعديل برنامج";
    var isEdit = Model.ProgramId != 0;
}

<div class="page-header">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 relative z-10">
        <div>
            <nav class="breadcrumb">
                <span class="material-symbols-rounded">home</span>
                <a href="/">الرئيسية</a>
                <span class="material-symbols-rounded">chevron_left</span>
                <a href="/Programs">البرامج الإذاعية</a>
                <span class="material-symbols-rounded">chevron_left</span>
                <span>@(isEdit ? "تعديل برنامج" : "برنامج جديد")</span>
            </nav>
            <h1>
                <span class="material-symbols-rounded">radio</span>
                @(isEdit ? "تعديل برنامج" : "برنامج جديد")
            </h1>
            <p>إدخال وتحديث البيانات الأساسية للبرنامج الإذاعي</p>
        </div>
        <div class="flex items-center gap-2">
            <a href="/Programs" class="btn-secondary">
                <span class="material-symbols-rounded">arrow_forward</span>
                الرجوع للبرامج
            </a>
        </div>
    </div>
</div>

<form method="post" action="@(isEdit ? $"/Programs/Edit/{Model.ProgramId}" : "/Programs/Create")" class="max-w-2xl">
    @Html.AntiForgeryToken()
    @if (isEdit) { <input type="hidden" name="ProgramId" value="@Model.ProgramId" /> }
    @if (ViewContext.ModelState.ErrorCount > 0)
    {
        <div asp-validation-summary="All" class="bg-red-50 border border-red-200 text-danger rounded-xl p-4 mb-6 font-semibold text-sm"></div>
    }

    <div class="card-premium">
        <div class="card-header">
            <div class="flex items-center gap-2">
                <span class="material-symbols-rounded text-primary">edit_note</span>
                <h3 class="font-bold text-ink text-base">بيانات البرنامج</h3>
            </div>
        </div>
        <div class="card-body space-y-4">
            <div>
                <label class="form-label">اسم البرنامج *</label>
                <input type="text" name="ProgramName" value="@Model.ProgramName" class="form-input" required placeholder="مثال: نبض الشارع" />
            </div>
            <div>
                <label class="form-label">الفئة</label>
                <input type="text" name="Category" value="@Model.Category" class="form-input" placeholder="مثال: سياسي، ثقافي، اجتماعي" />
            </div>
            <div>
                <label class="form-label">الوصف</label>
                <textarea name="ProgramDescription" rows="5" class="form-input" placeholder="أدخل ملخصاً أو تفاصيل موجزة عن البرنامج الإذاعي ومواعيد بثه المقترحة..."></textarea>
            </div>
        </div>
    </div>

    <div class="flex items-center justify-end gap-2 mt-6">
        <a href="/Programs" class="btn-secondary">
            <span class="material-symbols-rounded">cancel</span>
            إلغاء
        </a>
        <button type="submit" class="btn-primary">
            <span class="material-symbols-rounded">save</span>
            حفظ البيانات
        </button>
    </div>
</form>
