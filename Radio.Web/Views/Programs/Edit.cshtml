@model ProgramDto
@{
    ViewData["Title"] = Model.ProgramId == 0 ? "برنامج جديد" : "تعديل برنامج";
    var isEdit = Model.ProgramId != 0;
    ViewBag.IsEdit = isEdit;
    ViewBag.Icon = isEdit ? "edit" : "add";
    ViewBag.Title = isEdit ? "تعديل بيانات البرنامج" : "إضافة برنامج جديد";
    ViewBag.Description = "إدخال وتحديث البيانات الأساسية للبرنامج الإذاعي";
    ViewBag.EntityName = "البرامج الإذاعية";
    ViewBag.EntityUrl = "/Programs";
    ViewBag.BackUrl = "/Programs";
    ViewBag.BackText = "الرجوع للبرامج";
}

<partial name="_CreateEditHeader" />

<form method="post" action="@(isEdit ? $"/Programs/Edit/{Model.ProgramId}" : "/Programs/Create")" class="max-w-2xl">
    @Html.AntiForgeryToken()
    @if (isEdit) { <input type="hidden" name="ProgramId" value="@Model.ProgramId" /> }

    @if (ViewContext.ModelState.ErrorCount > 0)
    {
        <div asp-validation-summary="All" class="bg-danger/10 border border-danger/20 text-danger rounded-xl p-4 mb-6 font-semibold text-sm"></div>
    }

    <div class="card bg-base-100 shadow-md">
        <div class="card-body gap-6">
            <h3 class="card-title">
                <span class="material-symbols-rounded text-primary">radio</span>
                بيانات البرنامج
            </h3>
            <div class="space-y-4">
                <div>
                    <label class="label"><span class="label-text">اسم البرنامج <span class="text-error">*</span></span></label>
                    <label class="input input-bordered flex items-center gap-2">
                        <span class="material-symbols-rounded text-base-content/40">edit_note</span>
                        <input type="text" name="ProgramName" value="@Model.ProgramName" class="grow" required placeholder="مثال: نبض الشارع" />
                    </label>
                </div>
                <div>
                    <label class="label"><span class="label-text">الفئة</span></label>
                    <label class="input input-bordered flex items-center gap-2">
                        <span class="material-symbols-rounded text-base-content/40">category</span>
                        <input type="text" name="Category" value="@Model.Category" class="grow" placeholder="مثال: سياسي، ثقافي، اجتماعي" />
                    </label>
                </div>
                <div>
                    <label class="label"><span class="label-text">الوصف</span></label>
                    <textarea name="ProgramDescription" rows="5" class="textarea textarea-bordered w-full" placeholder="أدخل ملخصاً أو تفاصيل موجزة عن البرنامج الإذاعي ومواعيد بثه المقترحة...">@Model.ProgramDescription</textarea>
                </div>
            </div>
        </div>
    </div>

    <div class="flex items-center justify-end gap-2 mt-6">
        <a href="/Programs" class="btn btn-ghost">
            <span class="material-symbols-rounded">cancel</span>
            إلغاء
        </a>
        <button type="submit" class="btn btn-primary">
            <span class="material-symbols-rounded">save</span>
            حفظ البيانات
        </button>
    </div>
</form>
