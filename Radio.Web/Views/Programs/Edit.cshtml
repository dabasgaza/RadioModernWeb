@model ProgramDto
@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = Model.ProgramId == 0 ? "برنامج جديد" : "تعديل برنامج";
    var isEdit = Model.ProgramId != 0;
    ViewBag.IsEdit = isEdit;
    ViewBag.Icon = isEdit ? "edit" : "add";
    ViewBag.Title = isEdit ? "تعديل بيانات البرنامج" : "إضافة برنامج جديد";
    ViewBag.Description = "إدخال وتحديث البيانات الأساسية للبرنامج الإذاعي";
    ViewBag.EntityName = "البرامج الإذاعية";
    ViewBag.EntityUrl = "/Programs";
    ViewBag.BackUrl = "/Programs";
    ViewBag.BackText = "الرجوع للبرامج";
}

<partial name="_PageHeader" />

<form method="post" action="@(isEdit ? $"/Programs/Edit/{Model.ProgramId}" : "/Programs/Create")" class="max-w-2xl">
    @Html.AntiForgeryToken()
    @if (isEdit) { <input type="hidden" name="ProgramId" value="@Model.ProgramId" /> }

    @if (ViewContext.ModelState.ErrorCount > 0)
    {
        <div asp-validation-summary="All" class="rounded-xl p-4 mb-6 font-semibold text-sm bg-danger-subtle text-danger border border-danger-subtle"></div>
    }

    <div class="card p-6">
        @{
            ViewBag.SectionIcon = "radio";
            ViewBag.SectionTitle = "بيانات البرنامج";
        }
        <partial name="_SectionHeader" />

        <div class="space-y-4">
            @{
                ViewBag.FieldLabel = "اسم البرنامج"; ViewBag.FieldName = "ProgramName";
                ViewBag.FieldIcon = "edit_note"; ViewBag.FieldValue = Model.ProgramName;
                ViewBag.FieldRequired = true; ViewBag.FieldPlaceholder = "مثال: نبض الشارع";
            }
            <partial name="_FormField" />

            @{
                ViewBag.FieldLabel = "الفئة"; ViewBag.FieldName = "Category";
                ViewBag.FieldIcon = "category"; ViewBag.FieldValue = Model.Category;
                ViewBag.FieldPlaceholder = "مثال: سياسي، ثقافي، اجتماعي";
            }
            <partial name="_FormField" />

            @{
                ViewBag.FieldLabel = "الوصف"; ViewBag.FieldName = "ProgramDescription";
                ViewBag.FieldIcon = "description"; ViewBag.FieldValue = Model.ProgramDescription;
                ViewBag.FieldType = "textarea"; ViewBag.FieldRows = "5";
                ViewBag.FieldPlaceholder = "أدخل ملخصاً أو تفاصيل موجزة عن البرنامج الإذاعي ومواعيد بثه المقترحة...";
            }
            <partial name="_FormField" />
        </div>
    </div>

    <div class="flex items-center justify-end gap-2 mt-6">
        <a href="/Programs" class="btn btn-ghost rounded-xl gap-2">
            <span class="material-symbols-rounded" aria-hidden="true">cancel</span>إلغاء
        </a>
        <button type="submit" class="btn btn-primary rounded-xl gap-2">
            <span class="material-symbols-rounded" aria-hidden="true">save</span>حفظ البيانات
        </button>
    </div>
</form>
