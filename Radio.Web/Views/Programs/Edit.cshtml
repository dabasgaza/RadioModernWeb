@model ProgramDto
@{
    ViewData["Title"] = Model.ProgramId == 0 ? "برنامج جديد" : "تعديل برنامج";
    var isEdit = Model.ProgramId != 0;
    ViewBag.IsEdit = isEdit;
    ViewBag.Icon = isEdit ? "edit" : "add";
    ViewBag.Title = isEdit ? "تعديل بيانات البرنامج" : "إضافة برنامج جديد";
    ViewBag.Description = "إدخال وتحديث البيانات الأساسية للبرنامج الإذاعي";
    ViewBag.EntityName = "البرامج الإذاعية";
    ViewBag.EntityUrl = "/Programs";
    ViewBag.BackUrl = "/Programs";
    ViewBag.BackText = "الرجوع للبرامج";
}

<partial name="_CreateEditHeader" />

<form method="post" action="@(isEdit ? $"/Programs/Edit/{Model.ProgramId}" : "/Programs/Create")" class="max-w-2xl">
    @Html.AntiForgeryToken()
    @if (isEdit) { <input type="hidden" name="ProgramId" value="@Model.ProgramId" /> }

    @if (ViewContext.ModelState.ErrorCount > 0)
    {
        <div asp-validation-summary="All" class="bg-red-50 border border-red-200 text-danger rounded-xl p-4 mb-6 font-semibold text-sm"></div>
    }

    <div class="card-premium">
        <div class="card-header">
            <div class="flex items-center gap-2">
                <span class="material-symbols-rounded text-primary">radio</span>
                <h3 class="font-bold text-ink text-base">بيانات البرنامج</h3>
            </div>
        </div>
        <div class="card-body space-y-4">
            <div>
                <label class="form-label">اسم البرنامج *</label>
                <div class="input-wrapper">
                    <span class="material-symbols-rounded input-icon">edit_note</span>
                    <input type="text" name="ProgramName" value="@Model.ProgramName" class="form-input" required placeholder="مثال: نبض الشارع" />
                </div>
            </div>
            <div>
                <label class="form-label">الفئة</label>
                <div class="input-wrapper">
                    <span class="material-symbols-rounded input-icon">category</span>
                    <input type="text" name="Category" value="@Model.Category" class="form-input" placeholder="مثال: سياسي، ثقافي، اجتماعي" />
                </div>
            </div>
            <div>
                <label class="form-label">الوصف</label>
                <div class="input-wrapper">
                    <span class="material-symbols-rounded input-icon" style="top:1rem;transform:none">description</span>
                    <textarea name="ProgramDescription" rows="5" class="form-input" placeholder="أدخل ملخصاً أو تفاصيل موجزة عن البرنامج الإذاعي ومواعيد بثه المقترحة...">@Model.ProgramDescription</textarea>
                </div>
            </div>
        </div>
    </div>

    <div class="flex items-center justify-end gap-2 mt-6">
        <a href="/Programs" class="btn-secondary">
            <span class="material-symbols-rounded">cancel</span>
            إلغاء
        </a>
        <button type="submit" class="btn-primary">
            <span class="material-symbols-rounded">save</span>
            حفظ البيانات
        </button>
    </div>
</form>
