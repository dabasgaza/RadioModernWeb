@model List<ProgramViewModel>
@{
    ViewData["Title"] = "البرامج الإذاعية";
}

<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
    <div>
        <div class="breadcrumbs text-sm text-base-content/60">
            <ul>
                <li><a href="/" class="inline-flex items-center gap-1"><span class="material-symbols-rounded text-lg">home</span>الرئيسية</a></li>
                <li><span class="inline-flex items-center gap-1"><span class="material-symbols-rounded text-lg">radio</span>البرامج الإذاعية</span></li>
            </ul>
        </div>
        <h1 class="text-2xl font-extrabold text-base-content mt-1 flex items-center gap-2">
            <span class="material-symbols-rounded text-primary">radio</span>
            البرامج الإذاعية
        </h1>
        <p class="text-sm text-base-content/60 mt-0.5">إدارة البرامج الإذاعية ومتابعة إحصائياتها وتصنيفاتها</p>
    </div>
    @if (User.HasPermission(AppPermissions.ProgramManage))
    {
        <a href="/Programs/Create" class="btn btn-primary">
            <span class="material-symbols-rounded">add</span>
            برنامج جديد
        </a>
    }
</div>

<!-- Filters -->
<div class="wf-card mb-6">
    <div class="card-body">
        <form method="get" class="flex gap-3">
            <div class="relative flex-1">
                <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-base-content/40">search</span>
                <input type="text" name="search" value="@ViewBag.Search" placeholder="بحث باسم البرنامج أو الفئة…" class="input input-bordered w-full pr-10" />
            </div>
            <button type="submit" class="btn btn-primary">
                <span class="material-symbols-rounded">search</span>
                بحث
            </button>
            <a href="/Programs" class="btn btn-ghost" title="إعادة ضبط">
                <span class="material-symbols-rounded">refresh</span>
            </a>
        </form>
    </div>
</div>

<!-- Programs Grid -->
@if (!Model.Any())
{
    <div class="wf-card">
        <div class="card-body items-center text-center py-16">
            <span class="material-symbols-rounded text-6xl text-base-content/20 mb-4">radio</span>
            <h3 class="font-bold text-lg text-base-content mb-1">لا توجد برامج إذاعية</h3>
            <p class="text-sm text-base-content/60 mb-6">لم تتم إضافة أي برامج إذاعية بعد مطابقة للبحث.</p>
            @if (User.HasPermission(AppPermissions.ProgramManage))
            {
                <a href="/Programs/Create" class="btn btn-primary">
                    <span class="material-symbols-rounded">add</span>
                    إضافة برنامج جديد
                </a>
            }
        </div>
    </div>
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var item in Model)
        {
            var p = item.Program;
            <div class="wf-card group hover:shadow-lg transition-shadow duration-300">
                <div class="card-body gap-4">
                    <!-- Top Category & Icon -->
                    <div class="flex items-center justify-between">
                        <span class="badge @(p.Category == "سياسي" ? "badge-error" : p.Category == "ثقافي" ? "badge-accent" : p.Category == "اجتماعي" ? "badge-success" : "badge-info")">
                            @(p.Category ?? "عام")
                        </span>
                        <span class="material-symbols-rounded text-base-content/40 group-hover:text-primary transition-colors duration-300">radio</span>
                    </div>

                    <!-- Program Title & Description -->
                    <div class="space-y-1.5">
                        <h3 class="text-base font-extrabold text-base-content group-hover:text-primary transition-colors duration-300">
                            @p.ProgramName
                        </h3>
                        <p class="text-xs text-base-content/60 leading-relaxed line-clamp-3 min-h-[4.5rem]">
                            @(p.ProgramDescription ?? "لا يوجد وصف متوفر للبرنامج حالياً.")
                        </p>
                    </div>

                    <!-- Stat branding -->
                    <div class="pt-3 border-t border-base-300 flex items-center justify-between text-xs">
                        <span class="text-base-content/60 font-medium flex items-center gap-1">
                            <span class="material-symbols-rounded text-base-content/40" style="font-size: 16px;">podcasts</span>
                            الحلقات النشطة
                        </span>
                        <span class="font-black text-primary bg-primary/10 px-3 py-1 rounded-lg">
                            @item.EpisodeCount
                        </span>
                    </div>
                </div>

                <!-- Card Actions Footer -->
                @if (User.HasPermission(AppPermissions.ProgramManage))
                {
                    <div class="px-5 py-3 bg-base-200 border-t border-base-300 flex items-center justify-end gap-1.5">
                        <a href="/Programs/Edit/@p.ProgramId" class="btn btn-ghost btn-square btn-sm" title="تعديل" aria-label="تعديل">
                            <span class="material-symbols-rounded">edit</span>
                        </a>
                        <form method="post" action="/Programs/Delete/@p.ProgramId" class="inline" data-confirm="هل أنت متأكد من حذف البرنامج «@p.ProgramName»؟">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-ghost btn-square btn-sm text-error hover:bg-error/10" title="حذف" aria-label="حذف">
                                <span class="material-symbols-rounded">delete</span>
                            </button>
                        </form>
                    </div>
                }
            </div>
        }
    </div>
}
