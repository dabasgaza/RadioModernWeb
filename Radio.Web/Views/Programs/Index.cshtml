@model List<ProgramViewModel>
@using Radio.Web.ViewModels
@{
    ViewData["Title"] = "دليل البرامج الإذاعية والتلفزيونية";
    ViewData["HeaderIcon"] = "radio";
    ViewData["HeaderDescription"] = "دليل وإدارة الخطة البرامجية، التصنيفات، وسجلات الإنتاج الموحد";
    ViewBag.EntityName = "البرامج";
    var totalPrograms = Model.Count();
    var totalEpisodes = Model.Sum(x => x.EpisodeCount);
    var searchStr = ViewBag.Search as string;

    var kpiItems = new List<KpiItem>
    {
        new() { Label = "إجمالي البرامج", Value = totalPrograms.ToString(), Icon = "radio", Color = "var(--color-primary)", IconBg = "color-mix(in srgb, var(--color-primary) 10%, transparent)", IconColor = "var(--color-primary)", Subtitle = "برنامج نشط" },
        new() { Label = "إجمالي الحلقات المنفذة", Value = totalEpisodes.ToString(), Icon = "podcasts", Color = "var(--color-success)", IconBg = "color-mix(in srgb, var(--color-success) 10%, transparent)", IconColor = "var(--color-success)", Subtitle = "حلقة مسجلة وبث حي" },
        new() { Label = "متوسط الكثافة", Value = (totalPrograms > 0 ? (totalEpisodes / (double)totalPrograms).ToString("0.0") : "0"), Icon = "analytics", Color = "var(--color-info)", IconBg = "color-mix(in srgb, var(--color-info) 10%, transparent)", IconColor = "var(--color-info)", Subtitle = "حلقة لكل برنامج" }
    };
    ViewBag.KpiItems = kpiItems;
}

<div class="max-w-7xl mx-auto space-y-6">
    @{
        if (User.HasPermission(AppPermissions.ProgramsManage))
        {
            ViewData["HeaderActions"] = "<a href='/Programs/Create' class='inline-flex items-center gap-2 px-4 py-2.5 rounded-xl font-bold text-xs shadow-sm transition-all' style='background:var(--color-primary);color:white'><span class='material-symbols-rounded text-base'>add</span><span>إضافة برنامج جديد</span></a>";
        }
    }
    <partial name="_PageHeader" />
    <partial name="_KpiCards" />

    @{ ViewBag.SearchValue = searchStr; ViewBag.SearchPlaceholder = "ابحث باسم البرنامج الإذاعي، الكادر، أو التصنيف..."; ViewBag.SearchAction = "/Programs"; }
    <partial name="_SearchBar" />

    <!-- Programs Grid -->
    @if (!Model.Any())
    {
        <partial name="_EmptyState" model='new { Icon = "radio", Title = "لا توجد برامج إذاعية مطابقة", Description = "لم نتمكن من العثور على أية برامج تتوافق مع محددات البحث الحالية" }' />
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var item in Model)
            {
                var p = item.Program;
                <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm overflow-hidden group hover:border-blue-500/50 hover:shadow-xl transition-all duration-300 flex flex-col">
                    <div class="p-6 flex-1 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-4">
                                <span class="px-3 py-1 rounded-full text-[11px] font-bold bg-blue-50 dark:bg-blue-950/40 text-blue-600">
                                    @(p.Category ?? "برنامج عام")
                                </span>
                                <div class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 flex items-center justify-center group-hover:bg-blue-600 group-hover:text-white transition-colors duration-300">
                                    <span class="material-symbols-rounded text-xl">radio</span>
                                </div>
                            </div>

                            <h3 class="font-black text-base text-slate-900 dark:text-white mb-2 leading-snug group-hover:text-blue-600 transition-colors">
                                @p.ProgramName
                            </h3>

                            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed line-clamp-3 p-3 rounded-xl bg-slate-50 dark:bg-slate-800/40 border border-slate-100 dark:border-slate-800">
                                @(p.ProgramDescription ?? "لا يوجد وصف متوفر لهذا البرنامج الإذاعي حالياً.")
                            </p>
                        </div>
                    </div>

                    <div class="px-6 py-4 bg-slate-50/70 dark:bg-slate-900/60 border-t border-slate-100 dark:border-slate-800">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2 text-xs font-bold text-slate-600 dark:text-slate-300">
                                <span class="material-symbols-rounded text-base text-blue-600">podcasts</span>
                                <span>إجمالي الحلقات:</span>
                                <span class="px-2.5 py-0.5 rounded-lg bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 font-extrabold text-xs">@item.EpisodeCount</span>
                            </div>

                            @if (User.HasPermission(AppPermissions.ProgramsManage))
                            {
                                <div class="flex items-center gap-1">
                                    <a href="/Programs/Edit/@p.ProgramId" class="p-1.5 rounded-lg text-slate-400 hover:text-blue-600 hover:bg-white dark:hover:bg-slate-800 transition-colors" title="تعديل">
                                        <span class="material-symbols-rounded text-base">edit</span>
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

