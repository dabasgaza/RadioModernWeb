@model List<ProgramViewModel>
@{
    ViewData["Title"] = "البرامج الإذاعية";
}

<div class="page-header">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 relative z-10">
        <div>
            <nav class="breadcrumb">
                <span class="material-symbols-rounded">home</span>
                <a href="/">الرئيسية</a>
                <span class="material-symbols-rounded">chevron_left</span>
                <span>البرامج الإذاعية</span>
            </nav>
            <h1>
                <span class="material-symbols-rounded">radio</span>
                البرامج الإذاعية
            </h1>
            <p>إدارة البرامج الإذاعية ومتابعة إحصائياتها وتصنيفاتها</p>
        </div>
        <div class="flex items-center gap-2">
            @if (User.HasPermission(AppPermissions.ProgramManage))
            {
                <a href="/Programs/Create" class="btn-primary">
                    <span class="material-symbols-rounded">add</span>
                    برنامج جديد
                </a>
            }
        </div>
    </div>
</div>

<!-- Filters -->
<div class="filter-premium">
    <form method="get" class="flex gap-3">
        <div class="relative flex-1">
            <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-ink-soft">search</span>
            <input type="text" name="search" value="@ViewBag.Search" placeholder="بحث باسم البرنامج أو الفئة…" class="form-input pr-10" />
        </div>
        <button type="submit" class="btn-primary">
            <span class="material-symbols-rounded">search</span>
            بحث
        </button>
        <a href="/Programs" class="btn-secondary" title="إعادة ضبط">
            <span class="material-symbols-rounded">refresh</span>
        </a>
    </form>
</div>

<!-- Programs Grid -->
@if (!Model.Any())
{
    <div class="table-premium p-12 text-center">
        <div class="empty-state">
            <span class="material-symbols-rounded empty-icon">radio</span>
            <h3 class="font-bold text-ink text-lg mb-2">لا توجد برامج إذاعية</h3>
            <p class="text-ink-muted text-sm mb-4">لم تتم إضافة أي برامج إذاعية بعد مطابقة للبحث.</p>
            @if (User.HasPermission(AppPermissions.ProgramManage))
            {
                <a href="/Programs/Create" class="btn-primary">
                    <span class="material-symbols-rounded">add</span>
                    إضافة برنامج جديد
                </a>
            }
        </div>
    </div>
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var item in Model)
        {
            var p = item.Program;
            <div class="card-premium flex flex-col justify-between h-full group hover:shadow-lg transition-all duration-300">
                <div class="card-body flex-1 space-y-4">
                    <!-- Top Category & Icon -->
                    <div class="flex items-center justify-between">
                        <span class="badge @(p.Category == "سياسي" ? "badge-danger" : p.Category == "ثقافي" ? "badge-accent" : p.Category == "اجتماعي" ? "badge-success" : "badge-info") text-xs font-bold px-2.5 py-1 rounded-full">
                            @(p.Category ?? "عام")
                        </span>
                        <span class="material-symbols-rounded text-ink-soft group-hover:text-primary transition-colors duration-300">radio</span>
                    </div>

                    <!-- Program Title & Description -->
                    <div class="space-y-1.5">
                        <h3 class="text-base font-extrabold text-ink group-hover:text-primary transition-colors duration-300">
                            @p.ProgramName
                        </h3>
                        <p class="text-xs text-ink-muted leading-relaxed line-clamp-3 min-h-[4.5rem]">
                            @(p.ProgramDescription ?? "لا يوجد وصف متوفر للبرنامج حالياً.")
                        </p>
                    </div>

                    <!-- Stat branding -->
                    <div class="pt-3 border-t border-border/60 flex items-center justify-between text-xs">
                        <span class="text-ink-muted font-medium flex items-center gap-1">
                            <span class="material-symbols-rounded text-ink-soft" style="font-size: 16px;">podcasts</span>
                            الحلقات النشطة
                        </span>
                        <span class="font-black text-primary bg-primary/10 px-3 py-1 rounded-lg">
                            @item.EpisodeCount
                        </span>
                    </div>
                </div>

                <!-- Card Actions Footer -->
                @if (User.HasPermission(AppPermissions.ProgramManage))
                {
                    <div class="px-5 py-3 bg-surface-2 border-t border-border/60 flex items-center justify-end gap-1.5">
                        <a href="/Programs/Edit/@p.ProgramId" class="icon-btn icon-btn-primary" title="تعديل">
                            <span class="material-symbols-rounded">edit</span>
                        </a>
                        <form method="post" action="/Programs/Delete/@p.ProgramId" class="inline" data-confirm="هل أنت متأكد من حذف البرنامج «@p.ProgramName»؟">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="icon-btn icon-btn-danger" title="حذف">
                                <span class="material-symbols-rounded">delete</span>
                            </button>
                        </form>
                    </div>
                }
            </div>
        }
    </div>
}
