@model ExecutionLogDto
@{
    ViewData["Title"] = "تعديل سجل التنفيذ";
    ViewBag.IsEdit = true;
    ViewBag.Icon = "play_circle";
    ViewBag.Title = "تعديل سجل التنفيذ";
    ViewBag.Description = "تحديث بيانات المدة والملاحظات والمشاكل المتعلقة بتنفيذ الحلقة";
    ViewBag.EntityName = "سجلات التنفيذ";
    ViewBag.EntityUrl = "/ExecutionLogs";
    ViewBag.BackUrl = "/ExecutionLogs";
    ViewBag.BackText = "الرجوع للسجلات";
}

<partial name="_CreateEditHeader" />

<form method="post" action="/ExecutionLogs/Edit/@Model.ExecutionLogId" class="max-w-2xl mx-auto">
    @Html.AntiForgeryToken()
    <input type="hidden" name="ExecutionLogId" value="@Model.ExecutionLogId" />
    <input type="hidden" name="EpisodeId" value="@Model.EpisodeId" />
    <input type="hidden" name="ExecutedByUserId" value="@Model.ExecutedByUserId" />

    @if (ViewContext.ModelState.ErrorCount > 0)
    {
        <div asp-validation-summary="All" class="bg-error/10 border border-error/20 text-error rounded-xl p-4 mb-6 font-semibold text-sm"></div>
    }

    <div class="wf-card">
        <div class="card-body space-y-4">
            <div class="flex items-center gap-2">
                <span class="material-symbols-rounded text-success">play_circle</span>
                <h3 class="font-bold text-base-content text-base">تفاصيل التنفيذ</h3>
            </div>
            <div>
                <label class="label">مدة التنفيذ (بالدقائق)</label>
                <div class="relative">
                    <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-base-content/40 pointer-events-none text-lg">schedule</span>
                    <input type="number" name="DurationMinutes" value="@Model.DurationMinutes" min="1" max="720" class="input input-bordered w-full pr-10" placeholder="مثال: 60" />
                </div>
            </div>
            <div>
                <label class="label">ملاحظات التنفيذ</label>
                <div class="relative">
                    <span class="material-symbols-rounded absolute right-3 text-base-content/40 pointer-events-none text-lg" style="top:1rem;transform:none">notes</span>
                    <textarea name="ExecutionNotes" rows="4" class="textarea textarea-bordered w-full pr-10" placeholder="أي ملاحظات حول عملية التنفيذ…">@Model.ExecutionNotes</textarea>
                </div>
            </div>
            <div>
                <label class="label">المشاكل التي واجهت التنفيذ</label>
                <div class="relative">
                    <span class="material-symbols-rounded absolute right-3 text-base-content/40 pointer-events-none text-lg" style="top:1rem;transform:none">warning</span>
                    <textarea name="IssuesEncountered" rows="4" class="textarea textarea-bordered w-full pr-10" placeholder="أي مشاكل تقنية أو إدارية أثناء التنفيذ…">@Model.IssuesEncountered</textarea>
                </div>
            </div>
        </div>
    </div>

    <div class="flex items-center justify-end gap-2 mt-6">
        <a href="/ExecutionLogs" class="btn btn-ghost">
            <span class="material-symbols-rounded">arrow_forward</span>
            رجوع
        </a>
        <button type="submit" class="btn btn-primary">
            <span class="material-symbols-rounded">save</span>
            حفظ التعديلات
        </button>
    </div>
</form>
