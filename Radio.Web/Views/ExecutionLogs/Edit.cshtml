@model ExecutionLogDto
@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = "تعديل سجل التنفيذ";
    ViewBag.IsEdit = true;
    ViewBag.Icon = "play_circle";
    ViewBag.Title = "تعديل سجل التنفيذ";
    ViewBag.Description = "تحديث بيانات المدة والملاحظات والمشاكل المتعلقة بتنفيذ الحلقة";
    ViewBag.EntityName = "سجلات التنفيذ";
    ViewBag.EntityUrl = "/ExecutionLogs";
    ViewBag.BackUrl = "/ExecutionLogs";
    ViewBag.BackText = "الرجوع للسجلات";
}

<partial name="_PageHeader" />

<form method="post" action="/ExecutionLogs/Edit/@Model.ExecutionLogId" class="max-w-2xl">
    @Html.AntiForgeryToken()
    <input type="hidden" name="ExecutionLogId" value="@Model.ExecutionLogId" />
    <input type="hidden" name="EpisodeId" value="@Model.EpisodeId" />
    <input type="hidden" name="ExecutedByUserId" value="@Model.ExecutedByUserId" />

    @if (ViewContext.ModelState.ErrorCount > 0)
    {
        <div asp-validation-summary="All" class="rounded-xl p-4 mb-6 font-semibold text-sm bg-danger-subtle text-danger border border-danger-subtle"></div>
    }

    <div class="card p-6">
        @{
            ViewBag.SectionIcon = "play_circle"; ViewBag.SectionTitle = "تفاصيل التنفيذ";
        }
        <partial name="_SectionHeader" />

        <div class="space-y-4">
            @{
                ViewBag.FieldLabel = "مدة التنفيذ (بالدقائق)"; ViewBag.FieldName = "DurationMinutes";
                ViewBag.FieldIcon = "schedule"; ViewBag.FieldValue = Model.DurationMinutes.ToString();
                ViewBag.FieldType = "number"; ViewBag.FieldPlaceholder = "مثال: 60";
                ViewBag.FieldAttrs = "min=\"1\" max=\"720\"";
            }
            <partial name="_FormField" />

            @{
                ViewBag.FieldLabel = "ملاحظات التنفيذ"; ViewBag.FieldName = "ExecutionNotes";
                ViewBag.FieldIcon = "notes"; ViewBag.FieldValue = Model.ExecutionNotes;
                ViewBag.FieldType = "textarea"; ViewBag.FieldPlaceholder = "أي ملاحظات حول عملية التنفيذ…";
            }
            <partial name="_FormField" />

            @{
                ViewBag.FieldLabel = "المشاكل التي واجهت التنفيذ"; ViewBag.FieldName = "IssuesEncountered";
                ViewBag.FieldIcon = "warning"; ViewBag.FieldValue = Model.IssuesEncountered;
                ViewBag.FieldType = "textarea"; ViewBag.FieldPlaceholder = "أي مشاكل تقنية أو إدارية أثناء التنفيذ…";
            }
            <partial name="_FormField" />
        </div>
    </div>

    <div class="flex items-center justify-end gap-2 mt-6">
        <a href="/ExecutionLogs" class="btn btn-ghost rounded-xl gap-2">
            <span class="material-symbols-rounded">arrow_forward</span>رجوع
        </a>
        <button type="submit" class="btn btn-primary rounded-xl gap-2">
            <span class="material-symbols-rounded">save</span>حفظ التعديلات
        </button>
    </div>
</form>
