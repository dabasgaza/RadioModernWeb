@model List<PublishingRecordDto>
@using DataAccess.Common
@inject ICurrentUserService CurrentUser
@{
    ViewData["Title"] = "سجلات التنفيذ";
    ViewData["HeaderIcon"] = "play_circle";
    ViewData["HeaderDescription"] = "سجل عمليات تنفيذ الحلقات وجدولة البث";
    ViewBag.EntityName = "سجلات التنفيذ";
}

<partial name="_PageHeader" />

@if (!Model.Any())
{
    ViewBag.EmptyIcon = "play_circle";
    ViewBag.EmptyTitle = "لا سجلات تنفيذ";
    ViewBag.EmptyDesc = "لم يتم تسجيل أي عمليات تنفيذ للحلقات بعد.";
    <partial name="_EmptyState" />
}
else
{
    var canEdit = CurrentUser.HasPermission(AppPermissions.ExecutionExecute) || CurrentUser.HasPermission(AppPermissions.ExecutionEdit);
    <div class="card overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="text-xs font-semibold text-text-secondary bg-surface-hover border-b border-border">
                        <th class="px-6 py-4 text-right">الحلقة</th>
                        <th class="px-6 py-4 text-right">البرنامج</th>
                        <th class="px-6 py-4 text-right">الملخص</th>
                        <th class="px-6 py-4 text-right hidden md:table-cell">بواسطة</th>
                        <th class="px-6 py-4 text-right hidden md:table-cell">التاريخ</th>
                        @if (canEdit)
                        {
                            <th class="px-6 py-4 text-center">الإجراءات</th>
                        }
                    </tr>
                </thead>
                <tbody class="divide-y divide-border">
                    @foreach (var r in Model)
                    {
                        <tr class="hover:bg-surface-hover/50 transition-colors">
                            <td class="px-6 py-4">
                                <a href="/Episodes/Details/@r.EpisodeId" class="font-semibold inline-flex items-center gap-2 text-text hover:text-primary transition-colors" target="_blank">
                                    <span class="material-symbols-rounded text-lg text-text-muted">play_circle</span>
                                    <span>@(r.EpisodeName ?? "—")</span>
                                </a>
                            </td>
                            <td class="px-6 py-4 text-text-secondary">@r.ProgramName</td>
                            <td class="px-6 py-4 text-text-secondary">@r.Summary</td>
                            <td class="px-6 py-4 font-semibold text-text hidden md:table-cell">@r.RecordedBy</td>
                            <td class="px-6 py-4 whitespace-nowrap hidden md:table-cell text-text-secondary" dir="ltr">
                                @r.RecordDate.ToString("yyyy-MM-dd HH:mm")
                            </td>
                            @if (canEdit)
                            {
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center justify-center gap-1">
                                        <a href="/ExecutionLogs/Edit/@r.RecordId"
                                           class="btn btn-icon btn-sm btn-ghost text-primary" title="تعديل سجل التنفيذ" aria-label="تعديل سجل التنفيذ">
                                            <span class="material-symbols-rounded text-lg">edit</span>
                                        </a>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
