@model List<PublishingRecordDto>
@{ ViewData["Title"] = "سجلات التنفيذ"; }

<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-2xl font-bold text-ink mb-1 flex items-center gap-2">
            <span class="material-symbols-rounded text-primary">play_circle</span>
            سجلات التنفيذ
        </h1>
        <p class="text-ink-muted text-sm">سجل عمليات تنفيذ الحلقات</p>
    </div>
</div>

<div class="bg-surface rounded-xl border border-border">
    @if (!Model.Any())
    {
        <div class="empty-state p-12">
            <span class="material-symbols-rounded empty-icon">play_circle</span>
            <h3 class="font-bold text-ink text-lg mb-2">لا سجلات تنفيذ</h3>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="bg-surface-3 text-ink-muted">
                    <tr>
                        <th class="px-5 py-3 text-right font-semibold">الحلقة</th>
                        <th class="px-5 py-3 text-right font-semibold">البرنامج</th>
                        <th class="px-5 py-3 text-right font-semibold">الملخص</th>
                        <th class="px-5 py-3 text-right font-semibold">بواسطة</th>
                        <th class="px-5 py-3 text-right font-semibold">التاريخ</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border">
                    @foreach (var r in Model)
                    {
                        <tr class="hover:bg-surface-3">
                            <td class="px-5 py-3">
                                <a href="/Episodes/Details/@r.EpisodeId" class="text-primary font-semibold hover:underline">
                                    @(r.EpisodeName ?? "—")
                                </a>
                            </td>
                            <td class="px-5 py-3 text-ink-muted">@r.ProgramName</td>
                            <td class="px-5 py-3 text-ink-muted">@r.Summary</td>
                            <td class="px-5 py-3 text-ink-muted">@r.RecordedBy</td>
                            <td class="px-5 py-3 text-ink-muted">@r.RecordDate.ToString("yyyy-MM-dd HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
