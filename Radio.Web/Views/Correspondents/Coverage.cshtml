@model List<CorrespondentCoverageDto>
@{
    ViewData["Title"] = "تغطيات المراسل";
}

<div class="page-header">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 relative z-10">
        <div>
            <nav class="breadcrumb">
                <span class="material-symbols-rounded">home</span>
                <a href="/">الرئيسية</a>
                <span class="material-symbols-rounded">chevron_left</span>
                <a href="/Correspondents">المراسلون</a>
                <span class="material-symbols-rounded">chevron_left</span>
                <span>التغطيات</span>
            </nav>
            <h1>
                <span class="material-symbols-rounded text-primary">list_alt</span>
                تغطيات المراسل
            </h1>
            <p>جميع التغطيات الميدانية المسجلة لهذا المراسل</p>
        </div>
        <div class="flex items-center gap-2">
            <a href="/Correspondents" class="btn-secondary">
                <span class="material-symbols-rounded">arrow_forward</span>
                الرجوع للمراسلين
            </a>
        </div>
    </div>
</div>

<div class="table-premium">
    @if (!Model.Any())
    {
        <div class="empty-state p-12">
            <span class="material-symbols-rounded empty-icon">list_alt</span>
            <h3 class="font-bold text-ink text-lg mb-2">لا تغطيات</h3>
            <p class="text-ink-muted text-sm">لم تتم إضافة تغطيات لهذا المراسل بعد.</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr>
                        <th class="px-5 py-3 text-right font-semibold">الموضوع</th>
                        <th class="px-5 py-3 text-right font-semibold">الموقع</th>
                        <th class="px-5 py-3 text-right font-semibold">الضيف</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="px-5 py-3 font-semibold text-ink">@c.Topic</td>
                            <td class="px-5 py-3 text-ink-muted">@c.Location</td>
                            <td class="px-5 py-3 text-ink-muted">@c.GuestName</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
