@model List<CorrespondentCoverageDto>
@{
    ViewData["Title"] = "تغطيات المراسل";
    ViewData["HeaderIcon"] = "list_alt";
    ViewData["HeaderDescription"] = "جميع التغطيات الميدانية المسجلة لهذا المراسل";
    ViewBag.EntityName = "المراسلون";
    ViewBag.EntityUrl = "/Correspondents";
    ViewBag.BackUrl = "/Correspondents";
    ViewBag.BackText = "الرجوع للمراسلين";
}

<partial name="_PageHeader" />

@if (!Model.Any())
{
    <partial name="_EmptyState" model='new { Icon = "list_alt", Title = "لا تغطيات", Description = "لم تتم إضافة تغطيات لهذا المراسل بعد." }' />
}
else
{
    <div class="rounded-2xl border overflow-hidden" style="background: var(--color-surface); border-color: var(--color-border)">
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr style="background: var(--color-bg-alt)">
                        <th class="text-right font-semibold px-6 py-3.5" style="color: var(--color-text)">الموضوع</th>
                        <th class="text-right font-semibold px-6 py-3.5" style="color: var(--color-text)">الموقع</th>
                        <th class="text-right font-semibold px-6 py-3.5" style="color: var(--color-text)">الضيف</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr class="border-t transition-colors duration-200" style="border-color: var(--color-border)">
                            <td class="px-6 py-4 font-semibold" style="color: var(--color-text)">@c.Topic</td>
                            <td class="px-6 py-4" style="color: var(--color-text-secondary)">@c.Location</td>
                            <td class="px-6 py-4" style="color: var(--color-text-secondary)">@c.GuestName</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
