@model List<CorrespondentCoverageDto>
@{
    ViewData["Title"] = "تغطيات المراسل";
}

<div class="page-header">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 relative z-10">
        <div>
            <nav class="breadcrumb">
                <a href="/Correspondents">المراسلون</a>
                <span class="material-icons">chevron_left</span>
                <span>التغطيات</span>
            </nav>
            <h1>
                <span class="material-icons">list_alt</span>
                تغطيات المراسل
            </h1>
        </div>
        <a href="/Correspondents" class="btn-secondary">
            <span class="material-icons">arrow_back</span>
            رجوع
        </a>
    </div>
</div>

<div class="table-premium">
    @if (!Model.Any())
    {
        <div class="empty-state p-12">
            <span class="material-icons empty-icon">list_alt</span>
            <h3 class="font-bold text-ink text-lg mb-2">لا تغطيات</h3>
            <p class="text-ink-muted text-sm">لم تتم إضافة تغطيات لهذا المراسل بعد.</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table>
                <thead>
                    <tr>
                        <th>الموضوع</th>
                        <th>الموقع</th>
                        <th>الضيف</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr class="hover:bg-surface-2 transition duration-200">
                            <td class="font-bold text-ink">@c.Topic</td>
                            <td class="text-ink-muted">@c.Location</td>
                            <td class="text-ink-muted">@c.GuestName</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
