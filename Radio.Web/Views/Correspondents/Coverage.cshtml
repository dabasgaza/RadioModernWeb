@model List<CorrespondentCoverageDto>
@{
    ViewData["Title"] = "تغطيات المراسل";
}

<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
    <div>
        <div class="breadcrumbs text-sm text-base-content/60">
            <ul>
                <li><a href="/" class="inline-flex items-center gap-1"><span class="material-symbols-rounded text-lg">home</span>الرئيسية</a></li>
                <li><a href="/Correspondents" class="inline-flex items-center gap-1">المراسلون</a></li>
                <li><span class="inline-flex items-center gap-1"><span class="material-symbols-rounded text-lg">list_alt</span>التغطيات</span></li>
            </ul>
        </div>
        <h1 class="text-2xl font-extrabold text-base-content mt-1 flex items-center gap-2">
            <span class="material-symbols-rounded text-primary">list_alt</span>
            تغطيات المراسل
        </h1>
        <p class="text-sm text-base-content/60 mt-0.5">جميع التغطيات الميدانية المسجلة لهذا المراسل</p>
    </div>
    <div class="flex items-center gap-2">
        <a href="/Correspondents" class="btn btn-ghost">
            <span class="material-symbols-rounded">arrow_forward</span>
            الرجوع للمراسلين
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="wf-card"><div class="card-body text-center py-12">
        <span class="material-symbols-rounded text-4xl text-base-content/30 mb-2">list_alt</span>
        <h3 class="font-bold text-lg mb-2">لا تغطيات</h3>
        <p class="text-sm text-base-content/60">لم تتم إضافة تغطيات لهذا المراسل بعد.</p>
    </div></div>
}
else
{
    <div class="wf-card overflow-hidden">
        <div class="overflow-x-auto">
        <table class="table table-zebra w-full text-sm">
            <thead>
                <tr>
                    <th class="text-right font-semibold">الموضوع</th>
                    <th class="text-right font-semibold">الموقع</th>
                    <th class="text-right font-semibold">الضيف</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="font-semibold text-base-content">@c.Topic</td>
                        <td class="text-base-content/60">@c.Location</td>
                        <td class="text-base-content/60">@c.GuestName</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    </div>
}
