@model List<CorrespondentCoverageDto>
@{
    ViewData["Title"] = "تغطيات المراسل";
    ViewData["HeaderIcon"] = "list_alt";
    ViewData["HeaderDescription"] = "جميع التغطيات الميدانية المسجلة لهذا المراسل";
    ViewBag.EntityName = "المراسلون";
    ViewBag.EntityUrl = "/Correspondents";
    ViewBag.BackUrl = "/Correspondents";
    ViewBag.BackText = "الرجوع للمراسلين";
}

<partial name="_PageHeader" />

@if (!Model.Any())
{
    ViewBag.EmptyIcon = "list_alt";
    ViewBag.EmptyTitle = "لا تغطيات";
    ViewBag.EmptyDesc = "لم تتم إضافة تغطيات لهذا المراسل بعد.";
    <partial name="_EmptyState" />
}
else
{
    <div class="card overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="bg-bg-hover">
                        <th class="text-right font-semibold px-6 py-3.5 text-text">الموضوع</th>
                        <th class="text-right font-semibold px-6 py-3.5 text-text">الموقع</th>
                        <th class="text-right font-semibold px-6 py-3.5 text-text">الضيف</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr class="border-t border-border transition-colors duration-200">
                            <td class="px-6 py-4 font-semibold text-text">@c.Topic</td>
                            <td class="px-6 py-4 text-text-secondary">@c.Location</td>
                            <td class="px-6 py-4 text-text-secondary">@c.GuestName</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
