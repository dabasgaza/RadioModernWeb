@model List<CorrespondentDto>
@{
    ViewData["Title"] = "المراسلون";
}

<div class="page-header">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 relative z-10">
        <div>
            <nav class="breadcrumb">
                <span class="material-symbols-rounded">home</span>
                <a href="/">الرئيسية</a>
                <span class="material-symbols-rounded">chevron_left</span>
                <span>المراسلون</span>
            </nav>
            <h1>
                <span class="material-symbols-rounded">map</span>
                المراسلون
            </h1>
            <p>إدارة بيانات المراسلين وتفاصيل مواقع التغطية الميدانية المخصصة لهم</p>
        </div>
        <div class="flex items-center gap-2">
            @if (User.HasPermission(AppPermissions.CoordinationManage))
            {
                <a href="/Correspondents/Create" class="btn-primary">
                    <span class="material-symbols-rounded">add</span>
                    مراسل جديد
                </a>
            }
        </div>
    </div>
</div>

<!-- Filters -->
<div class="filter-premium">
    <form method="get" class="flex gap-3">
        <div class="relative flex-1">
            <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-ink-soft">search</span>
            <input type="text" name="search" value="@ViewBag.Search" placeholder="بحث باسم المراسل أو المواقع..." class="form-input pr-10" />
        </div>
        <button type="submit" class="btn-primary">
            <span class="material-symbols-rounded">search</span>
            بحث
        </button>
        <a href="/Correspondents" class="btn-secondary" title="إعادة ضبط">
            <span class="material-symbols-rounded">refresh</span>
        </a>
    </form>
</div>

<!-- Grid -->
@if (!Model.Any())
{
    <div class="table-premium p-12 text-center">
        <div class="empty-state">
            <span class="material-symbols-rounded empty-icon">map</span>
            <h3 class="font-bold text-ink text-lg mb-2">لا يوجد مراسلون</h3>
            <p class="text-ink-muted text-sm mb-4">لم يتم العثور على أي مراسلين تطابق البحث.</p>
            @if (User.HasPermission(AppPermissions.CoordinationManage))
            {
                <a href="/Correspondents/Create" class="btn-primary">
                    <span class="material-symbols-rounded">add</span>
                    إضافة مراسل جديد
                </a>
            }
        </div>
    </div>
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var c in Model)
        {
            <div class="card-premium flex flex-col justify-between h-full group hover:shadow-lg transition-all duration-300">
                <div class="card-body space-y-4">
                    <!-- Header -->
                    <div class="flex items-center gap-3">
                        <div class="w-12 h-12 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold text-base border border-primary/20 shrink-0">
                            <span class="material-symbols-rounded text-lg">my_location</span>
                        </div>
                        <div class="min-w-0">
                            <h3 class="font-bold text-ink truncate group-hover:text-primary transition-colors duration-300">@c.FullName</h3>
                            <p class="text-xs text-ink-soft truncate flex items-center gap-1">
                                <span class="material-symbols-rounded text-xs">phone</span>
                                @(c.PhoneNumber ?? "—")
                            </p>
                        </div>
                    </div>

                    <!-- Locations -->
                    <div class="space-y-2 pt-2 border-t border-border/60">
                        <div class="text-[10px] font-bold text-ink-soft uppercase tracking-wider">المواقع المخصصة</div>
                        <div class="flex flex-wrap gap-1.5 min-h-[3rem]">
                            @if (!string.IsNullOrWhiteSpace(c.AssignedLocations))
                            {
                                foreach (var loc in c.AssignedLocations.Split('،', ','))
                                {
                                    <span class="badge badge-info text-[10px] py-0.5 px-2 rounded-lg font-bold">@loc.Trim()</span>
                                }
                            }
                            else
                            {
                                <span class="text-xs text-ink-soft italic">لم يتم تعيين مواقع حالياً.</span>
                            }
                        </div>
                    </div>
                </div>

                <!-- Footer Actions -->
                <div class="px-5 py-3 bg-surface-2 border-t border-border/60 flex items-center justify-between">
                    <a href="/Correspondents/Coverage/@c.CorrespondentId" class="btn-secondary py-1 px-3 text-xs flex items-center gap-1">
                        <span class="material-symbols-rounded" style="font-size: 16px;">list_alt</span>
                        تغطيات المراسل
                    </a>
                    @if (User.HasPermission(AppPermissions.CoordinationManage))
                    {
                        <div class="flex items-center gap-1">
                            <a href="/Correspondents/Edit/@c.CorrespondentId" class="icon-btn icon-btn-primary" title="تعديل">
                                <span class="material-symbols-rounded">edit</span>
                            </a>
                            <form method="post" action="/Correspondents/Delete/@c.CorrespondentId" class="inline" data-confirm="هل أنت متأكد من حذف المراسل «@c.FullName»؟">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="icon-btn icon-btn-danger" title="حذف">
                                    <span class="material-symbols-rounded">delete</span>
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}
