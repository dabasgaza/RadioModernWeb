@model List<CorrespondentDto>
@{
    ViewData["Title"] = "المراسلون";
    ViewData["HeaderIcon"] = "map";
    ViewData["HeaderDescription"] = "إدارة بيانات المراسلين وتفاصيل مواقع التغطية الميدانية المخصصة لهم";
    ViewBag.EntityName = "المراسلون";

    if (User.HasPermission(AppPermissions.CoordinationManage))
    {
        ViewData["HeaderActions"] = "<a href='/Correspondents/Create' class='btn btn-primary gap-2'><span class='material-symbols-rounded'>add</span>مراسل جديد</a>";
    }
}

<partial name="_PageHeader" />

@{ ViewBag.SearchValue = ViewBag.Search; ViewBag.SearchPlaceholder = "بحث باسم المراسل أو المواقع..."; ViewBag.SearchAction = "/Correspondents"; }
<partial name="_SearchBar" />

@if (!Model.Any())
{
    ViewBag.EmptyIcon = "map";
    ViewBag.EmptyTitle = "لا يوجد مراسلون";
    ViewBag.EmptyDesc = "لم يتم العثور على أي مراسلين تطابق البحث.";
    ViewBag.EmptyActionUrl = User.HasPermission(AppPermissions.CoordinationManage) ? "/Correspondents/Create" : null;
    ViewBag.EmptyActionText = "إضافة مراسل جديد";
    ViewBag.EmptyActionIcon = "add";
    <partial name="_EmptyState" />
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var c in Model)
        {
            <div class="card card-interactive overflow-hidden flex flex-col h-full">
                <div class="p-5 space-y-4">
                    <div class="flex items-center gap-3">
                        <div class="w-12 h-12 rounded-full flex items-center justify-center shrink-0 bg-primary-subtle text-primary border border-border">
                            <span class="material-symbols-rounded text-lg">my_location</span>
                        </div>
                        <div class="min-w-0">
                            <h3 class="font-bold text-text truncate group-hover:text-primary transition-colors">@c.FullName</h3>
                            <p class="text-caption text-text-muted truncate flex items-center gap-1">
                                <span class="material-symbols-rounded text-xs">phone</span>
                                @(c.PhoneNumber ?? "—")
                            </p>
                        </div>
                    </div>

                    <div class="space-y-2 pt-2 border-t border-border">
                        <div class="text-micro font-bold text-text-muted">المواقع المخصصة</div>
                        <div class="flex flex-wrap gap-1.5 min-h-[2rem]">
                            @if (!string.IsNullOrWhiteSpace(c.AssignedLocations))
                            {
                                foreach (var loc in c.AssignedLocations.Split('،', ','))
                                {
                                    <span class="badge badge-info">@loc.Trim()</span>
                                }
                            }
                            else
                            {
                                <span class="text-caption text-text-muted italic">لم يتم تعيين مواقع حالياً.</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="px-5 py-3 flex items-center justify-between bg-bg border-t border-border mt-auto">
                    <a href="/Correspondents/Coverage/@c.CorrespondentId" class="btn btn-ghost btn-sm gap-1 text-text-secondary">
                        <span class="material-symbols-rounded text-sm">list_alt</span>
                        تغطيات المراسل
                    </a>
                    @if (User.HasPermission(AppPermissions.CoordinationManage))
                    {
                        <div class="flex items-center gap-1">
                            <a href="/Correspondents/Edit/@c.CorrespondentId" class="btn btn-icon btn-ghost text-primary" title="تعديل">
                                <span class="material-symbols-rounded text-lg">edit</span>
                            </a>
                            <form method="post" action="/Correspondents/Delete/@c.CorrespondentId" class="inline" data-confirm="هل أنت متأكد من حذف المراسل «@c.FullName»؟">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-icon btn-ghost text-danger" title="حذف">
                                    <span class="material-symbols-rounded text-lg">delete</span>
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}
