@model List<CorrespondentDto>
@{
    ViewData["Title"] = "المراسلون";
}

<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
    <div>
        <div class="breadcrumbs text-sm text-base-content/60">
            <ul>
                <li><a href="/" class="inline-flex items-center gap-1"><span class="material-symbols-rounded text-lg">home</span>الرئيسية</a></li>
                <li><span class="inline-flex items-center gap-1"><span class="material-symbols-rounded text-lg">map</span>المراسلون</span></li>
            </ul>
        </div>
        <h1 class="text-2xl font-extrabold text-base-content mt-1 flex items-center gap-2">
            <span class="material-symbols-rounded text-primary">map</span>
            المراسلون
        </h1>
        <p class="text-sm text-base-content/60 mt-0.5">إدارة بيانات المراسلين وتفاصيل مواقع التغطية الميدانية المخصصة لهم</p>
    </div>
    <div class="flex items-center gap-2">
        @if (User.HasPermission(AppPermissions.CoordinationManage))
        {
            <a href="/Correspondents/Create" class="btn btn-primary">
                <span class="material-symbols-rounded">add</span>
                مراسل جديد
            </a>
        }
    </div>
</div>

<div class="card bg-base-100 shadow-md mb-6">
    <div class="card-body">
        <form method="get" class="flex gap-3">
            <div class="relative flex-1">
                <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-base-content/40 pointer-events-none text-lg">search</span>
                <input type="text" name="search" value="@ViewBag.Search" placeholder="بحث باسم المراسل أو المواقع..." class="input input-bordered w-full pr-10" />
            </div>
            <button type="submit" class="btn btn-primary">
                <span class="material-symbols-rounded">search</span>
                بحث
            </button>
            <a href="/Correspondents" class="btn btn-ghost" title="إعادة ضبط">
                <span class="material-symbols-rounded">refresh</span>
            </a>
        </form>
    </div>
</div>

<!-- Grid -->
@if (!Model.Any())
{
    <div class="card bg-base-100 shadow-md"><div class="card-body text-center py-12">
        <span class="material-symbols-rounded text-4xl text-base-content/30 mb-2">map</span>
        <h3 class="font-bold text-lg mb-2">لا يوجد مراسلون</h3>
        <p class="text-sm text-base-content/60 mb-4">لم يتم العثور على أي مراسلين تطابق البحث.</p>
        @if (User.HasPermission(AppPermissions.CoordinationManage))
        {
            <a href="/Correspondents/Create" class="btn btn-primary">
                <span class="material-symbols-rounded">add</span>
                إضافة مراسل جديد
            </a>
        }
    </div></div>
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var c in Model)
        {
            <div class="card bg-base-100 shadow-md flex flex-col justify-between h-full group hover:shadow-lg transition-all duration-300">
                <div class="card-body space-y-4">
                    <!-- Header -->
                    <div class="flex items-center gap-3">
                        <div class="w-12 h-12 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold text-base border border-primary/20 shrink-0">
                            <span class="material-symbols-rounded text-lg">my_location</span>
                        </div>
                        <div class="min-w-0">
                            <h3 class="font-bold text-ink truncate group-hover:text-primary transition-colors duration-300">@c.FullName</h3>
                            <p class="text-xs text-ink-soft truncate flex items-center gap-1">
                                <span class="material-symbols-rounded text-xs">phone</span>
                                @(c.PhoneNumber ?? "—")
                            </p>
                        </div>
                    </div>

                    <!-- Locations -->
                    <div class="space-y-2 pt-2 border-t border-border/60">
                        <div class="text-[10px] font-bold text-ink-soft uppercase tracking-wider">المواقع المخصصة</div>
                        <div class="flex flex-wrap gap-1.5 min-h-[3rem]">
                            @if (!string.IsNullOrWhiteSpace(c.AssignedLocations))
                            {
                                foreach (var loc in c.AssignedLocations.Split('،', ','))
                                {
                                    <span class="badge badge-info text-[10px] py-0.5 px-2 rounded-lg font-bold">@loc.Trim()</span>
                                }
                            }
                            else
                            {
                                <span class="text-xs text-ink-soft italic">لم يتم تعيين مواقع حالياً.</span>
                            }
                        </div>
                    </div>
                </div>

                <!-- Footer Actions -->
                <div class="px-5 py-3 bg-surface-2 border-t border-border/60 flex items-center justify-between">
                    <a href="/Correspondents/Coverage/@c.CorrespondentId" class="btn btn-ghost py-1 px-3 text-xs flex items-center gap-1">
                        <span class="material-symbols-rounded" style="font-size: 16px;">list_alt</span>
                        تغطيات المراسل
                    </a>
                    @if (User.HasPermission(AppPermissions.CoordinationManage))
                    {
                        <div class="flex items-center gap-1">
                            <a href="/Correspondents/Edit/@c.CorrespondentId" class="inline-flex items-center justify-center w-9 h-9 rounded-lg border-0 bg-transparent transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-1 text-blue-600 hover:bg-blue-50 hover:text-blue-700 focus-visible:ring-blue-500 dark:hover:bg-blue-500/10" title="تعديل" aria-label="تعديل">
                                <span class="material-symbols-rounded text-xl leading-none">edit</span>
                            </a>
                            <form method="post" action="/Correspondents/Delete/@c.CorrespondentId" class="inline" data-confirm="هل أنت متأكد من حذف المراسل «@c.FullName»؟">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="inline-flex items-center justify-center w-9 h-9 rounded-lg border-0 bg-transparent transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-1 text-red-500 hover:bg-red-50 hover:text-red-700 focus-visible:ring-red-500 dark:hover:bg-red-500/10" title="حذف" aria-label="حذف">
                                    <span class="material-symbols-rounded text-xl leading-none">delete</span>
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}
