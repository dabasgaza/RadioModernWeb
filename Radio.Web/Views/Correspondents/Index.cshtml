@model List<CorrespondentDto>
@{
    ViewData["Title"] = "المراسلون";
    ViewData["HeaderIcon"] = "map";
    ViewData["HeaderDescription"] = "إدارة بيانات المراسلين وتفاصيل مواقع التغطية الميدانية المخصصة لهم";
    ViewBag.EntityName = "المراسلون";

    if (User.HasPermission(AppPermissions.CoordinationManage))
    {
        ViewData["HeaderActions"] = "<a href='/Correspondents/Create' class='btn btn-primary rounded-xl gap-2'><span class='material-symbols-rounded'>add</span>مراسل جديد</a>";
    }
}

<partial name="_PageHeader" />

@{ ViewBag.SearchValue = ViewBag.Search; ViewBag.SearchPlaceholder = "بحث باسم المراسل أو المواقع..."; ViewBag.SearchAction = "/Correspondents"; }
<partial name="_SearchBar" />

@if (!Model.Any())
{
    ViewBag.EmptyIcon = "map";
    ViewBag.EmptyTitle = "لا يوجد مراسلون";
    ViewBag.EmptyDesc = "لم يتم العثور على أي مراسلين تطابق البحث.";
    ViewBag.EmptyActionUrl = User.HasPermission(AppPermissions.CoordinationManage) ? "/Correspondents/Create" : null;
    ViewBag.EmptyActionText = "إضافة مراسل جديد";
    ViewBag.EmptyActionIcon = "add";
    <partial name="_EmptyState" />
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var c in Model)
        {
            <div class="rounded-xl overflow-hidden group transition-all duration-200 hover:shadow-lg flex flex-col justify-between h-full"
                 style="background: var(--color-bg-elevated); border: 1px solid var(--color-border);">
                <div class="p-5 space-y-4">
                    <div class="flex items-center gap-3">
                        <div class="w-12 h-12 rounded-full flex items-center justify-center shrink-0"
                             style="background: var(--color-primary-subtle); color: var(--color-primary); border: 1px solid var(--color-border);">
                            <span class="material-symbols-rounded text-lg">my_location</span>
                        </div>
                        <div class="min-w-0">
                            <h3 class="font-bold text-[var(--color-text)] truncate group-hover:text-[var(--color-primary)] transition-colors duration-300">@c.FullName</h3>
                            <p class="text-xs text-[var(--color-text-muted)] truncate flex items-center gap-1">
                                <span class="material-symbols-rounded text-xs">phone</span>
                                @(c.PhoneNumber ?? "—")
                            </p>
                        </div>
                    </div>

                    <div class="space-y-2 pt-2" style="border-top: 1px solid var(--color-border);">
                        <div class="text-[10px] font-bold text-[var(--color-text-muted)]">المواقع المخصصة</div>
                        <div class="flex flex-wrap gap-1.5 min-h-[2rem]">
                            @if (!string.IsNullOrWhiteSpace(c.AssignedLocations))
                            {
                                foreach (var loc in c.AssignedLocations.Split('،', ','))
                                {
                                    <span class="text-[10px] font-bold px-2 py-0.5 rounded-lg"
                                          style="background: var(--color-info-light); color: var(--color-info);">@loc.Trim()</span>
                                }
                            }
                            else
                            {
                                <span class="text-xs text-[var(--color-text-muted)] italic">لم يتم تعيين مواقع حالياً.</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="px-5 py-3 flex items-center justify-between" style="background: var(--color-bg); border-top: 1px solid var(--color-border);">
                    <a href="/Correspondents/Coverage/@c.CorrespondentId" class="btn btn-ghost py-1 px-3 text-xs flex items-center gap-1 text-[var(--color-text-secondary)]">
                        <span class="material-symbols-rounded" style="font-size: 16px;">list_alt</span>
                        تغطيات المراسل
                    </a>
                    @if (User.HasPermission(AppPermissions.CoordinationManage))
                    {
                        <div class="flex items-center gap-1">
                            <a href="/Correspondents/Edit/@c.CorrespondentId" class="inline-flex items-center justify-center w-9 h-9 rounded-lg text-[var(--color-primary)] hover:bg-[var(--color-primary-subtle)] transition-colors" title="تعديل">
                                <span class="material-symbols-rounded text-xl">edit</span>
                            </a>
                            <form method="post" action="/Correspondents/Delete/@c.CorrespondentId" class="inline" data-confirm="هل أنت متأكد من حذف المراسل «@c.FullName»؟">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="inline-flex items-center justify-center w-9 h-9 rounded-lg text-[var(--color-danger)] hover:bg-[var(--color-danger-light)] transition-colors" title="حذف">
                                    <span class="material-symbols-rounded text-xl">delete</span>
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}
