@model CorrespondentDto
@{
    ViewData["Title"] = Model.CorrespondentId == 0 ? "مراسل جديد" : "تعديل مراسل";
    var isEdit = Model.CorrespondentId != 0;
    ViewBag.IsEdit = isEdit;
    ViewBag.Icon = isEdit ? "edit" : "add";
    ViewBag.Title = isEdit ? "تعديل بيانات المراسل" : "إضافة مراسل جديد";
    ViewBag.Description = "إدخال وتحديث البيانات الأساسية وتفاصيل مواقع التغطية للمراسل الميداني";
    ViewBag.EntityName = "المراسلون";
    ViewBag.EntityUrl = "/Correspondents";
    ViewBag.BackUrl = "/Correspondents";
    ViewBag.BackText = "الرجوع للمراسلين";
}

<partial name="_PageHeader" />

<form method="post" action="@(isEdit ? $"/Correspondents/Edit/{Model.CorrespondentId}" : "/Correspondents/Create")" class="max-w-2xl">
    @Html.AntiForgeryToken()
    @if (isEdit) { <input type="hidden" name="CorrespondentId" value="@Model.CorrespondentId" /> }

    @if (ViewContext.ModelState.ErrorCount > 0)
    {
        <div asp-validation-summary="All" class="rounded-xl p-4 mb-6 font-semibold text-sm"
             style="background: color-mix(in srgb, var(--color-error) 10%, transparent); border: 1px solid color-mix(in srgb, var(--color-error) 20%, transparent); color: var(--color-error)"></div>
    }

    <div class="rounded-2xl border" style="background: var(--color-surface); border-color: var(--color-border)">
        <div class="p-6 space-y-4">
            <div class="flex items-center gap-2.5">
                <span class="material-symbols-rounded" style="color: var(--color-primary)">my_location</span>
                <h3 class="font-bold" style="color: var(--color-text)">بيانات المراسل</h3>
            </div>
            <div>
                <label class="text-sm font-medium mb-1.5 block" style="color: var(--color-text-secondary)">الاسم الكامل <span style="color: var(--color-error)">*</span></label>
                <div class="relative">
                    <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-lg" style="color: var(--color-text-tertiary)">person</span>
                    <input type="text" name="FullName" value="@Model.FullName" required
                           class="w-full rounded-xl py-2.5 pr-10 pl-3 text-sm font-medium focus:outline-none focus:ring-2 transition-all"
                           style="background: var(--color-bg-alt); border: 1px solid var(--color-border); color: var(--color-text); --tw-ring-color: var(--color-primary)"
                           placeholder="مثال: أحمد مصطفى" />
                </div>
            </div>
            <div>
                <label class="text-sm font-medium mb-1.5 block" style="color: var(--color-text-secondary)">رقم الهاتف <span style="color: var(--color-error)">*</span></label>
                <div class="relative">
                    <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-lg" style="color: var(--color-text-tertiary)">phone</span>
                    <input type="text" name="PhoneNumber" value="@Model.PhoneNumber" required
                           class="w-full rounded-xl py-2.5 pr-10 pl-3 text-sm font-medium focus:outline-none focus:ring-2 transition-all"
                           style="background: var(--color-bg-alt); border: 1px solid var(--color-border); color: var(--color-text); --tw-ring-color: var(--color-primary)"
                           placeholder="مثال: +966500000000" />
                </div>
            </div>
            <div>
                <label class="text-sm font-medium mb-1.5 block" style="color: var(--color-text-secondary)">المواقع المعيّنة (مفصولة بفاصلة)</label>
                <div class="relative">
                    <span class="material-symbols-rounded absolute right-3 pointer-events-none text-lg" style="color: var(--color-text-tertiary); top: 1rem;">location_on</span>
                    <textarea name="AssignedLocations" rows="3"
                              class="w-full rounded-xl py-2.5 pr-10 pl-3 text-sm font-medium focus:outline-none focus:ring-2 transition-all"
                              style="background: var(--color-bg-alt); border: 1px solid var(--color-border); color: var(--color-text); --tw-ring-color: var(--color-primary)"
                              placeholder="مثال: الرياض، جدة، الدمام">@Model.AssignedLocations</textarea>
                </div>
            </div>
        </div>
    </div>

    <div class="flex items-center justify-end gap-2 mt-6">
        <a href="/Correspondents" class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-xl font-bold text-sm transition-all"
           style="color: var(--color-text-secondary)">
            <span class="material-symbols-rounded text-lg">cancel</span>
            إلغاء
        </a>
        <button type="submit" class="inline-flex items-center gap-1.5 px-6 py-2.5 rounded-xl font-bold text-sm shadow-sm transition-all"
                style="background: var(--color-primary); color: white">
            <span class="material-symbols-rounded text-lg">save</span>
            حفظ البيانات
        </button>
    </div>
</form>
