@model CorrespondentDto
@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = Model.CorrespondentId == 0 ? "مراسل جديد" : "تعديل مراسل";
    var isEdit = Model.CorrespondentId != 0;
    ViewBag.IsEdit = isEdit;
    ViewBag.Icon = isEdit ? "edit" : "add";
    ViewBag.Title = isEdit ? "تعديل بيانات المراسل" : "إضافة مراسل جديد";
    ViewBag.Description = "إدخال وتحديث البيانات الأساسية وتفاصيل مواقع التغطية للمراسل الميداني";
    ViewBag.EntityName = "المراسلون";
    ViewBag.EntityUrl = "/Correspondents";
    ViewBag.BackUrl = "/Correspondents";
    ViewBag.BackText = "الرجوع للمراسلين";
}

<partial name="_PageHeader" />

<form method="post" action="@(isEdit ? $"/Correspondents/Edit/{Model.CorrespondentId}" : "/Correspondents/Create")" class="max-w-2xl">
    @Html.AntiForgeryToken()
    @if (isEdit) { <input type="hidden" name="CorrespondentId" value="@Model.CorrespondentId" /> }

    @if (ViewContext.ModelState.ErrorCount > 0)
    {
        <div asp-validation-summary="All" class="rounded-xl p-4 mb-6 font-semibold text-sm bg-danger-subtle text-danger border border-danger-subtle"></div>
    }

    <div class="bg-surface border border-border rounded-2xl p-6" style="border-color:var(--color-border)">
        @{
            ViewBag.SectionIcon = "my_location";
            ViewBag.SectionTitle = "بيانات المراسل";
        }
        <partial name="_SectionHeader" />

        <div class="space-y-4">
            @{
                ViewBag.FieldLabel = "الاسم الكامل"; ViewBag.FieldName = "FullName";
                ViewBag.FieldIcon = "person"; ViewBag.FieldValue = Model.FullName;
                ViewBag.FieldRequired = true; ViewBag.FieldPlaceholder = "مثال: أحمد مصطفى";
            }
            <partial name="_FormField" />

            @{
                ViewBag.FieldLabel = "رقم الهاتف"; ViewBag.FieldName = "PhoneNumber";
                ViewBag.FieldIcon = "phone"; ViewBag.FieldValue = Model.PhoneNumber;
                ViewBag.FieldRequired = true; ViewBag.FieldPlaceholder = "مثال: +966500000000";
            }
            <partial name="_FormField" />

            @{
                ViewBag.FieldLabel = "المواقع المعيّنة (مفصولة بفاصلة)"; ViewBag.FieldName = "AssignedLocations";
                ViewBag.FieldIcon = "location_on"; ViewBag.FieldValue = Model.AssignedLocations;
                ViewBag.FieldType = "textarea"; ViewBag.FieldRows = "3";
                ViewBag.FieldPlaceholder = "مثال: الرياض، جدة، الدمام";
            }
            <partial name="_FormField" />
        </div>
    </div>

    <div class="flex items-center justify-end gap-2 mt-6">
        <a href="/Correspondents" class="btn btn-ghost rounded-xl gap-2">
            <span class="material-symbols-rounded">cancel</span>إلغاء
        </a>
        <button type="submit" class="btn btn-primary rounded-xl gap-2">
            <span class="material-symbols-rounded">save</span>حفظ البيانات
        </button>
    </div>
</form>
