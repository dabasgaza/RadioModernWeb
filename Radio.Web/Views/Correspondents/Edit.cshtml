@model CorrespondentDto
@{
    ViewData["Title"] = Model.CorrespondentId == 0 ? "مراسل جديد" : "تعديل مراسل";
    var isEdit = Model.CorrespondentId != 0;
    ViewBag.IsEdit = isEdit;
    ViewBag.Icon = isEdit ? "edit" : "add";
    ViewBag.Title = isEdit ? "تعديل بيانات المراسل" : "إضافة مراسل جديد";
    ViewBag.Description = "إدخال وتحديث البيانات الأساسية وتفاصيل مواقع التغطية للمراسل الميداني";
    ViewBag.EntityName = "المراسلون";
    ViewBag.EntityUrl = "/Correspondents";
    ViewBag.BackUrl = "/Correspondents";
    ViewBag.BackText = "الرجوع للمراسلين";
}

<partial name="_CreateEditHeader" />

<form method="post" action="@(isEdit ? $"/Correspondents/Edit/{Model.CorrespondentId}" : "/Correspondents/Create")" class="max-w-2xl">
    @Html.AntiForgeryToken()
    @if (isEdit) { <input type="hidden" name="CorrespondentId" value="@Model.CorrespondentId" /> }

    @if (ViewContext.ModelState.ErrorCount > 0)
    {
        <div asp-validation-summary="All" class="bg-red-50 border border-red-200 text-danger rounded-xl p-4 mb-6 font-semibold text-sm"></div>
    }

    <div class="card-premium">
        <div class="card-header">
            <div class="flex items-center gap-2">
                <span class="material-symbols-rounded text-primary">my_location</span>
                <h3 class="font-bold text-ink text-base">بيانات المراسل</h3>
            </div>
        </div>
        <div class="card-body space-y-4">
            <div>
                <label class="form-label">الاسم الكامل *</label>
                <div class="input-wrapper">
                    <span class="material-symbols-rounded input-icon">person</span>
                    <input type="text" name="FullName" value="@Model.FullName" class="form-input" required placeholder="مثال: أحمد مصطفى" />
                </div>
            </div>
            <div>
                <label class="form-label">رقم الهاتف *</label>
                <div class="input-wrapper">
                    <span class="material-symbols-rounded input-icon">phone</span>
                    <input type="text" name="PhoneNumber" value="@Model.PhoneNumber" class="form-input" required placeholder="مثال: +966500000000" />
                </div>
            </div>
            <div>
                <label class="form-label">المواقع المعيّنة (مفصولة بفاصلة)</label>
                <div class="input-wrapper">
                    <span class="material-symbols-rounded input-icon" style="top:1rem;transform:none">location_on</span>
                    <textarea name="AssignedLocations" rows="3" class="form-input" placeholder="مثال: الرياض، جدة، الدمام">@Model.AssignedLocations</textarea>
                </div>
            </div>
        </div>
    </div>

    <div class="flex items-center justify-end gap-2 mt-6">
        <a href="/Correspondents" class="btn-secondary">
            <span class="material-symbols-rounded">cancel</span>
            إلغاء
        </a>
        <button type="submit" class="btn-primary">
            <span class="material-symbols-rounded">save</span>
            حفظ البيانات
        </button>
    </div>
</form>
