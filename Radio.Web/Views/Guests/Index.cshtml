@model List<GuestDto>
@{
    ViewData["Title"] = "الضيوف";
}

<div class="page-header">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 relative z-10">
        <div>
            <nav class="breadcrumb">
                <span class="material-symbols-rounded">home</span>
                <a href="/">الرئيسية</a>
                <span class="material-symbols-rounded">chevron_left</span>
                <span>الضيوف</span>
            </nav>
            <h1>
                <span class="material-symbols-rounded">people_alt</span>
                الضيوف
            </h1>
            <p>إدارة بيانات الضيوف المشاركين وتفاصيل الاتصال الخاصة بهم</p>
        </div>
        <div class="flex items-center gap-2">
            @if (User.HasPermission(AppPermissions.GuestManage))
            {
                <a href="/Guests/Create" class="btn-primary">
                    <span class="material-symbols-rounded">add</span>
                    ضيف جديد
                </a>
            }
        </div>
    </div>
</div>

<!-- Filters -->
<div class="filter-premium">
    <form method="get" class="flex gap-3">
        <div class="relative flex-1">
            <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-ink-soft">search</span>
            <input type="text" name="search" value="@ViewBag.Search" placeholder="بحث باسم الضيف أو الجهة..." class="form-input pr-10" />
        </div>
        <button type="submit" class="btn-primary">
            <span class="material-symbols-rounded">search</span>
            بحث
        </button>
        <a href="/Guests" class="btn-secondary" title="إعادة ضبط">
            <span class="material-symbols-rounded">refresh</span>
        </a>
    </form>
</div>

<!-- Guests Grid -->
@if (!Model.Any())
{
    <div class="table-premium p-12 text-center">
        <div class="empty-state">
            <span class="material-symbols-rounded empty-icon">people_alt</span>
            <h3 class="font-bold text-ink text-lg mb-2">لا يوجد ضيوف</h3>
            <p class="text-ink-muted text-sm mb-4">لم يتم العثور على أي ضيوف تطابق البحث.</p>
            @if (User.HasPermission(AppPermissions.GuestManage))
            {
                <a href="/Guests/Create" class="btn-primary">
                    <span class="material-symbols-rounded">add</span>
                    إضافة ضيف جديد
                </a>
            }
        </div>
    </div>
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var g in Model)
        {
            <div class="card-premium flex flex-col justify-between h-full group hover:shadow-lg transition-all duration-300">
                <div class="card-body space-y-4">
                    <!-- Profile Header / Avatar -->
                    <div class="flex items-center gap-3">
                        <div class="w-12 h-12 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold text-base border border-primary/20 shrink-0">
                            @(g.FullName.Length > 0 ? g.FullName[0].ToString().ToUpper() : "G")
                        </div>
                        <div class="min-w-0">
                            <h3 class="font-bold text-ink truncate group-hover:text-primary transition-colors duration-300">@g.FullName</h3>
                            <p class="text-xs text-ink-soft truncate">@(g.Organization ?? "مستقل / غير محدد")</p>
                        </div>
                    </div>

                    <!-- Contact Details -->
                    <div class="space-y-2 pt-2 border-t border-border/60 text-xs">
                        <div class="flex items-center gap-2 text-ink-muted">
                            <span class="material-symbols-rounded text-sm text-ink-soft">phone</span>
                            <span class="font-semibold">@(g.PhoneNumber ?? "—")</span>
                        </div>
                        <div class="flex items-center gap-2 text-ink-muted">
                            <span class="material-symbols-rounded text-sm text-ink-soft">email</span>
                            <span class="truncate">@(g.EmailAddress ?? "—")</span>
                        </div>
                    </div>
                </div>

                <!-- Footer Actions -->
                @if (User.HasPermission(AppPermissions.GuestManage))
                {
                    <div class="px-5 py-3 bg-surface-2 border-t border-border/60 flex items-center justify-end gap-1.5">
                        <a href="/Guests/Edit/@g.GuestId" class="icon-btn icon-btn-primary" title="تعديل">
                            <span class="material-symbols-rounded">edit</span>
                        </a>
                        <form method="post" action="/Guests/Delete/@g.GuestId" class="inline" data-confirm="هل أنت متأكد من حذف الضيف «@g.FullName»؟">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="icon-btn icon-btn-danger" title="حذف">
                                <span class="material-symbols-rounded">delete</span>
                            </button>
                        </form>
                    </div>
                }
            </div>
        }
    </div>
}
