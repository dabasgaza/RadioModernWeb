@model List<GuestDto>
@{
    ViewData["Title"] = "الضيوف";
}

<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
    <div>
        <div class="breadcrumbs text-sm text-base-content/60">
            <ul>
                <li><a href="/" class="inline-flex items-center gap-1"><span class="material-symbols-rounded text-lg">home</span>الرئيسية</a></li>
                <li><span class="inline-flex items-center gap-1"><span class="material-symbols-rounded text-lg">people_alt</span>الضيوف</span></li>
            </ul>
        </div>
        <h1 class="text-2xl font-extrabold text-base-content mt-1 flex items-center gap-2">
            <span class="material-symbols-rounded text-primary">people_alt</span>
            الضيوف
        </h1>
        <p class="text-sm text-base-content/60 mt-0.5">إدارة بيانات الضيوف المشاركين وتفاصيل الاتصال الخاصة بهم</p>
    </div>
    <div class="flex items-center gap-2">
        @if (User.HasPermission(AppPermissions.GuestManage))
        {
            <a href="/Guests/Create" class="btn btn-primary">
                <span class="material-symbols-rounded">add</span>
                ضيف جديد
            </a>
        }
    </div>
</div>

<!-- Filters -->
<div class="card bg-base-100 shadow-md mb-6">
    <div class="card-body">
        <form method="get" class="flex gap-3">
            <div class="relative flex-1">
                <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-base-content/40">search</span>
                <input type="text" name="search" value="@ViewBag.Search" placeholder="بحث باسم الضيف أو الجهة..." class="input input-bordered w-full pr-10" />
            </div>
            <button type="submit" class="btn btn-primary">
                <span class="material-symbols-rounded">search</span>
                بحث
            </button>
            <a href="/Guests" class="btn btn-ghost" title="إعادة ضبط">
                <span class="material-symbols-rounded">refresh</span>
            </a>
        </form>
    </div>
</div>

<!-- Guests Grid -->
@if (!Model.Any())
{
    <div class="card bg-base-100 shadow-md p-12">
    <div class="card-body text-center py-12">
            <span class="material-symbols-rounded text-4xl text-base-content/30 mb-2">people_alt</span>
            <h3 class="font-bold text-base-content text-lg mb-2">لا يوجد ضيوف</h3>
            <p class="text-base-content/60 text-sm mb-4">لم يتم العثور على أي ضيوف تطابق البحث.</p>
            @if (User.HasPermission(AppPermissions.GuestManage))
            {
                <a href="/Guests/Create" class="btn btn-primary">
                    <span class="material-symbols-rounded">add</span>
                    إضافة ضيف جديد
                </a>
            }
        </div>
    </div>
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var g in Model)
        {
            <div class="card bg-base-100 shadow-md flex flex-col justify-between h-full group hover:shadow-lg transition-all duration-300">
                <div class="card-body space-y-4">
                    <!-- Profile Header / Avatar -->
                    <div class="flex items-center gap-3">
                        <div class="w-12 h-12 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold text-base border border-primary/20 shrink-0">
                            @(g.FullName.Length > 0 ? g.FullName[0].ToString().ToUpper() : "G")
                        </div>
                        <div class="min-w-0">
                            <h3 class="font-bold text-base-content truncate group-hover:text-primary transition-colors duration-300">@g.FullName</h3>
                            <p class="text-xs text-base-content/40 truncate">@(g.Organization ?? "مستقل / غير محدد")</p>
                        </div>
                    </div>

                    <!-- Contact Details -->
                    <div class="space-y-2 pt-2 border-t border-base-200/60 text-xs">
                        <div class="flex items-center gap-2 text-base-content/60">
                            <span class="material-symbols-rounded text-sm text-base-content/40">phone</span>
                            <span class="font-semibold">@(g.PhoneNumber ?? "—")</span>
                        </div>
                        <div class="flex items-center gap-2 text-base-content/60">
                            <span class="material-symbols-rounded text-sm text-base-content/40">email</span>
                            <span class="truncate">@(g.EmailAddress ?? "—")</span>
                        </div>
                    </div>
                </div>

                <!-- Footer Actions -->
                @if (User.HasPermission(AppPermissions.GuestManage))
                {
                    <div class="px-5 py-3 bg-base-200 border-t border-base-200 flex items-center justify-end gap-1.5">
                        <a href="/Guests/Edit/@g.GuestId" class="btn btn-ghost btn-square btn-sm text-primary" title="تعديل" aria-label="تعديل">
                            <span class="material-symbols-rounded text-lg">edit</span>
                        </a>
                        <form method="post" action="/Guests/Delete/@g.GuestId" class="inline" data-confirm="هل أنت متأكد من حذف الضيف «@g.FullName»؟">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-ghost btn-square btn-sm text-error" title="حذف" aria-label="حذف">
                                <span class="material-symbols-rounded text-lg">delete</span>
                            </button>
                        </form>
                    </div>
                }
            </div>
        }
    </div>
}
