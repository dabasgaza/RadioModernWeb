@model GuestDto
@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = Model.GuestId == 0 ? "ضيف جديد" : "تعديل ضيف";
    var isEdit = Model.GuestId != 0;
    ViewBag.IsEdit = isEdit;
    ViewBag.Icon = isEdit ? "edit" : "add";
    ViewBag.Title = isEdit ? "تعديل بيانات الضيف" : "إضافة ضيف جديد";
    ViewBag.Description = "إدخال وتحديث البيانات الشخصية وتفاصيل الاتصال الخاصة بالضيف";
    ViewBag.EntityName = "الضيوف";
    ViewBag.EntityUrl = "/Guests";
    ViewBag.BackUrl = "/Guests";
    ViewBag.BackText = "الرجوع للضيوف";
}

<partial name="_PageHeader" />

<form method="post" action="@(isEdit ? $"/Guests/Edit/{Model.GuestId}" : "/Guests/Create")" class="max-w-2xl">
    @Html.AntiForgeryToken()
    @if (isEdit) { <input type="hidden" name="GuestId" value="@Model.GuestId" /> }

    @if (ViewContext.ModelState.ErrorCount > 0)
    {
        <div asp-validation-summary="All" class="rounded-xl p-4 mb-6 font-semibold text-sm bg-danger-subtle text-danger border border-danger-subtle"></div>
    }

    <div class="card p-6">
        @{
            ViewBag.SectionIcon = "person";
            ViewBag.SectionTitle = "الملف التعريفي للضيف";
        }
        <partial name="_SectionHeader" />

        <div class="space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                @{
                    ViewBag.FieldLabel = "الاسم الكامل"; ViewBag.FieldName = "FullName";
                    ViewBag.FieldIcon = "person"; ViewBag.FieldValue = Model.FullName;
                    ViewBag.FieldRequired = true; ViewBag.FieldPlaceholder = "مثال: د. محمد علي";
                }
                <partial name="_FormField" />

                @{
                    ViewBag.FieldLabel = "الجنس"; ViewBag.FieldName = "Gender";
                    ViewBag.FieldType = "select"; ViewBag.FieldIcon = "wc";
                    ViewBag.FieldOptions = new List<SelectListItem>
                    {
                        new() { Value = "", Text = "— اختر —", Selected = string.IsNullOrEmpty(Model.Gender) },
                        new() { Value = "ذكر", Text = "ذكر", Selected = Model.Gender == "ذكر" },
                        new() { Value = "أنثى", Text = "أنثى", Selected = Model.Gender == "أنثى" },
                    };
                }
                <partial name="_FormField" />
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                @{
                    ViewBag.FieldLabel = "الجهة / المؤسسة"; ViewBag.FieldName = "Organization";
                    ViewBag.FieldIcon = "business"; ViewBag.FieldValue = Model.Organization;
                    ViewBag.FieldPlaceholder = "مثال: وزارة الاقتصاد"; ViewBag.FieldType = "text";
                }
                <partial name="_FormField" />

                @{
                    ViewBag.FieldLabel = "رقم الهاتف"; ViewBag.FieldName = "PhoneNumber";
                    ViewBag.FieldIcon = "phone"; ViewBag.FieldValue = Model.PhoneNumber;
                    ViewBag.FieldPlaceholder = "مثال: +966500000000"; ViewBag.FieldType = "text";
                }
                <partial name="_FormField" />
            </div>

            @{
                ViewBag.FieldLabel = "البريد الإلكتروني"; ViewBag.FieldName = "EmailAddress";
                ViewBag.FieldIcon = "email"; ViewBag.FieldValue = Model.EmailAddress;
                ViewBag.FieldType = "email"; ViewBag.FieldPlaceholder = "مثال: guest@example.com";
            }
            <partial name="_FormField" />

            @{
                ViewBag.FieldLabel = "نبذة شخصية (Bio)"; ViewBag.FieldName = "Bio";
                ViewBag.FieldIcon = "info"; ViewBag.FieldValue = Model.Bio;
                ViewBag.FieldType = "textarea"; ViewBag.FieldPlaceholder = "أدخل نبذة مختصرة عن مؤهلات الضيف وخبراته المهنية...";
            }
            <partial name="_FormField" />
        </div>
    </div>

    <div class="flex items-center justify-end gap-2 mt-6">
        <a href="/Guests" class="btn btn-ghost rounded-xl gap-2">
            <span class="material-symbols-rounded">cancel</span>إلغاء
        </a>
        <button type="submit" class="btn btn-primary rounded-xl gap-2">
            <span class="material-symbols-rounded">save</span>حفظ البيانات
        </button>
    </div>
</form>
