@model GuestDto
@{
    ViewData["Title"] = Model.GuestId == 0 ? "ضيف جديد" : "تعديل ضيف";
    var isEdit = Model.GuestId != 0;
    ViewBag.IsEdit = isEdit;
    ViewBag.Icon = isEdit ? "edit" : "add";
    ViewBag.Title = isEdit ? "تعديل بيانات الضيف" : "إضافة ضيف جديد";
    ViewBag.Description = "إدخال وتحديث البيانات الشخصية وتفاصيل الاتصال الخاصة بالضيف";
    ViewBag.EntityName = "الضيوف";
    ViewBag.EntityUrl = "/Guests";
    ViewBag.BackUrl = "/Guests";
    ViewBag.BackText = "الرجوع للضيوف";
}

<partial name="_CreateEditHeader" />

<form method="post" action="@(isEdit ? $"/Guests/Edit/{Model.GuestId}" : "/Guests/Create")" class="max-w-2xl">
    @Html.AntiForgeryToken()
    @if (isEdit) { <input type="hidden" name="GuestId" value="@Model.GuestId" /> }

    @if (ViewContext.ModelState.ErrorCount > 0)
    {
        <div asp-validation-summary="All" class="bg-red-50 border border-red-200 text-danger rounded-xl p-4 mb-6 font-semibold text-sm"></div>
    }

    <div class="card-premium">
        <div class="card-header">
            <div class="flex items-center gap-2">
                <span class="material-symbols-rounded text-primary">person</span>
                <h3 class="font-bold text-ink text-base">الملف التعريفي للضيف</h3>
            </div>
        </div>
        <div class="card-body space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="form-label">الاسم الكامل *</label>
                    <div class="input-wrapper">
                        <span class="material-symbols-rounded input-icon">person</span>
                        <input type="text" name="FullName" value="@Model.FullName" class="form-input" required placeholder="مثال: د. محمد علي" />
                    </div>
                </div>
                <div>
                    <label class="form-label">الجنس</label>
                    <div class="input-wrapper">
                        <span class="material-symbols-rounded input-icon">wc</span>
                        <select name="Gender" class="form-input">
                            <option value="">— اختر —</option>
                            <option value="ذكر" selected="@(Model.Gender == "ذكر")">ذكر</option>
                            <option value="أنثى" selected="@(Model.Gender == "أنثى")">أنثى</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="form-label">الجهة / المؤسسة</label>
                    <div class="input-wrapper">
                        <span class="material-symbols-rounded input-icon">business</span>
                        <input type="text" name="Organization" value="@Model.Organization" class="form-input" placeholder="مثال: وزارة الاقتصاد" />
                    </div>
                </div>
                <div>
                    <label class="form-label">رقم الهاتف</label>
                    <div class="input-wrapper">
                        <span class="material-symbols-rounded input-icon">phone</span>
                        <input type="text" name="PhoneNumber" value="@Model.PhoneNumber" class="form-input" placeholder="مثال: +966500000000" />
                    </div>
                </div>
            </div>
            <div>
                <label class="form-label">البريد الإلكتروني</label>
                <div class="input-wrapper">
                    <span class="material-symbols-rounded input-icon">email</span>
                    <input type="email" name="EmailAddress" value="@Model.EmailAddress" class="form-input" placeholder="مثال: guest@example.com" />
                </div>
            </div>
            <div>
                <label class="form-label">نبذة شخصية (Bio)</label>
                <div class="input-wrapper">
                    <span class="material-symbols-rounded input-icon" style="top:1rem;transform:none">info</span>
                    <textarea name="Bio" rows="4" class="form-input" placeholder="أدخل نبذة مختصرة عن مؤهلات الضيف وخبراته المهنية...">@Model.Bio</textarea>
                </div>
            </div>
        </div>
    </div>

    <div class="flex items-center justify-end gap-2 mt-6">
        <a href="/Guests" class="btn-secondary">
            <span class="material-symbols-rounded">cancel</span>
            إلغاء
        </a>
        <button type="submit" class="btn-primary">
            <span class="material-symbols-rounded">save</span>
            حفظ البيانات
        </button>
    </div>
</form>
