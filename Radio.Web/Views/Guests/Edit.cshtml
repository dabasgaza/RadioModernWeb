@model GuestDto
@{
    ViewData["Title"] = Model.GuestId == 0 ? "ضيف جديد" : "تعديل ضيف";
    var isEdit = Model.GuestId != 0;
}

<div class="page-header">
    <div class="relative z-10">
        <nav class="breadcrumb">
            <a href="/Guests">الضيوف</a>
            <span class="material-icons">chevron_left</span>
            <span>@(isEdit ? "تعديل" : "جديد")</span>
        </nav>
        <h1>
            <span class="material-icons">@(isEdit ? "edit" : "add")</span>
            @(isEdit ? "تعديل ضيف" : "ضيف جديد")
        </h1>
    </div>
</div>

<form method="post" action="@(isEdit ? $"/Guests/Edit/{Model.GuestId}" : "/Guests/Create")" class="max-w-2xl">
    @Html.AntiForgeryToken()
    @if (isEdit) { <input type="hidden" name="GuestId" value="@Model.GuestId" /> }
    @if (ViewContext.ModelState.ErrorCount > 0)
    {
        <div asp-validation-summary="All" class="bg-red-50 border border-red-200 text-danger rounded-xl p-4 mb-4"></div>
    }

    <div class="card-premium p-5 space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="form-label">الاسم الكامل *</label>
                <input type="text" name="FullName" value="@Model.FullName" class="form-input" required />
            </div>
            <div>
                <label class="form-label">الجنس</label>
                <select name="Gender" class="form-input">
                    <option value="">— اختر —</option>
                    <option value="ذكر" selected="@(Model.Gender == "ذكر")">ذكر</option>
                    <option value="أنثى" selected="@(Model.Gender == "أنثى")">أنثى</option>
                </select>
            </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="form-label">الجهة</label>
                <input type="text" name="Organization" value="@Model.Organization" class="form-input" />
            </div>
            <div>
                <label class="form-label">رقم الهاتف</label>
                <input type="text" name="PhoneNumber" value="@Model.PhoneNumber" class="form-input" />
            </div>
        </div>
        <div>
            <label class="form-label">البريد الإلكتروني</label>
            <input type="email" name="EmailAddress" value="@Model.EmailAddress" class="form-input" />
        </div>
        <div>
            <label class="form-label">نبذة</label>
            <textarea name="Bio" rows="4" class="form-input">@Model.Bio</textarea>
        </div>
    </div>

    <div class="flex items-center justify-end gap-2 mt-4">
        <a href="/Guests" class="btn-secondary"><span class="material-icons">cancel</span> إلغاء</a>
        <button type="submit" class="btn-primary"><span class="material-icons">save</span> حفظ</button>
    </div>
</form>
