@model ReportsViewModel
@{
    ViewData["Title"] = "التقارير والإحصائيات";
    ViewData["HeaderIcon"] = "assessment";
    ViewData["HeaderDescription"] = "مؤشرات الأداء الرئيسية وتحليلات شاملة للبرامج والضيوف والحلقات";
    ViewBag.EntityName = "التقارير";

    ViewData["HeaderActions"] = "<div class='flex items-center gap-2'><a href='/Reports/ExportIndexExcel' class='btn btn-success btn-sm rounded-xl gap-2'><span class='material-symbols-rounded text-lg'>file_download</span>Excel</a><a href='/Reports/ExportIndexPdf' class='btn btn-danger btn-sm rounded-xl gap-2'><span class='material-symbols-rounded text-lg'>file_download</span>PDF</a><button onclick='window.print()' class='btn btn-ghost btn-sm rounded-xl no-print'><span class='material-symbols-rounded text-lg'>print</span></button></div>";
    var totalEpisodes = Model.StatusStats.Values.Sum();
}

<partial name="_PageHeader" />

@{
    var kpiItems = new List<KpiItem>
    {
        new() { Label = "إجمالي الحلقات", Value = totalEpisodes.ToString(), Icon = "podcasts", Color = "var(--color-primary)", IconBg = "color-mix(in srgb, var(--color-primary) 10%, transparent)", IconColor = "var(--color-primary)", Subtitle = "حلقة مسجلة وبث حي" },
        new() { Label = "البرامج النشطة", Value = Model.TopPrograms.Count.ToString(), Icon = "radio", Color = "var(--color-success)", IconBg = "color-mix(in srgb, var(--color-success) 10%, transparent)", IconColor = "var(--color-success)", Subtitle = "برامج قيد الإنتاج" },
        new() { Label = "حلقات ملغاة", Value = Model.CancelledEpisodes.Count.ToString(), Icon = "cancel", Color = "var(--color-danger)", IconBg = "color-mix(in srgb, var(--color-danger) 10%, transparent)", IconColor = "var(--color-danger)", Subtitle = "حلقات محذوفة/ملغاة" },
        new() { Label = "أبرز الضيوف", Value = Model.TopGuests.Count.ToString(), Icon = "people_alt", Color = "var(--color-accent)", IconBg = "color-mix(in srgb, var(--color-accent) 10%, transparent)", IconColor = "var(--color-accent)", Subtitle = "ضيوف الأكثر مشاركة" }
    };
    ViewBag.KpiItems = kpiItems;
}
<partial name="_KpiCards" />

<div class="card overflow-hidden mt-6">
    <div class="px-6 py-2 border-b border-border bg-surface">
        <div class="flex gap-2 overflow-x-auto" role="tablist">
            <button class="tab-btn active font-bold text-sm text-text" data-tab="overview">نظرة عامة</button>
            <button class="tab-btn font-bold text-sm text-text-secondary" data-tab="today">حلقات اليوم</button>
            <button class="tab-btn font-bold text-sm text-text-secondary" data-tab="programs">نشاط البرامج</button>
            <button class="tab-btn font-bold text-sm text-text-secondary" data-tab="guests">أبرز الضيوف</button>
            <button class="tab-btn font-bold text-sm text-text-secondary" data-tab="cancelled">الحلقات الملغاة</button>
        </div>
    </div>

    <div class="p-6">
        <div id="tab-overview" class="tab-panel">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <div>
                    <h3 class="font-bold text-sm mb-4 flex items-center gap-1.5 text-[var(--color-text)]">
                        <span class="w-1.5 h-3 rounded-full" style="background: var(--color-primary);"></span>
                        توزيع حالات الحلقات
                    </h3>
                    @if (Model.StatusStats.Any())
                    {
                        <div class="space-y-3">
                            @foreach (var s in Model.StatusStats)
                            {
                                var pct = totalEpisodes > 0 ? (s.Value * 100.0 / totalEpisodes) : 0;
                                var color = GetStatusColor(s.Key);
                                <div class="flex items-center gap-3">
                                    <span class="w-2 h-2 rounded-full shrink-0" style="background:@color"></span>
                                    <span class="text-xs font-bold text-[var(--color-text-secondary)] flex-1">@GetStatusDisplayName(s.Key)</span>
                                    <span class="text-sm font-bold text-[var(--color-text)]">@s.Value</span>
                                    <div class="w-24 h-1.5 rounded-full overflow-hidden" style="background: var(--color-bg);">
                                        <div class="h-full rounded-full transition-all duration-500" style="width:@(pct)%;background:@color"></div>
                                    </div>
                                    <span class="text-xs font-bold text-[var(--color-text-muted)] w-10 text-left" dir="ltr">@pct.ToString("F0")%</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="flex flex-col items-center py-12 text-[var(--color-text-secondary)]">
                            <span class="material-symbols-rounded text-4xl text-[var(--color-text-muted)] mb-2">bar_chart</span>
                            <h3 class="font-bold text-lg mb-2 text-[var(--color-text)]">لا توجد بيانات</h3>
                            <p class="text-sm">لا توجد بيانات إحصائية متاحة حالياً.</p>
                        </div>
                    }
                </div>
                <div>
                    <h3 class="font-bold text-sm mb-4 flex items-center gap-1.5 text-[var(--color-text)]">
                        <span class="w-1.5 h-3 rounded-full" style="background: var(--color-primary);"></span>
                        رسم بياني للتوزيع
                    </h3>
                    @if (Model.StatusStats.Any())
                    {
                        <div class="flex justify-center">
                            <div class="relative" style="width:260px;height:260px">
                                <canvas id="statusChart"></canvas>
                            </div>
                        </div>
                        <div class="flex flex-wrap justify-center gap-3 mt-4">
                            @foreach (var s in Model.StatusStats)
                            {
                                <span class="inline-flex items-center gap-1.5 text-xs font-bold text-[var(--color-text-secondary)]">
                                    <span class="w-2.5 h-2.5 rounded-full" style="background:@GetStatusColor(s.Key)"></span>
                                    @GetStatusDisplayName(s.Key)
                                </span>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div id="tab-today" class="tab-panel hidden">
            @if (Model.TodayEpisodes.Any())
            {
                <div class="overflow-x-auto" style="border: 1px solid var(--color-border); border-radius: 0.75rem;">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="text-xs font-semibold text-[var(--color-text-muted)]" style="background: var(--color-bg); border-bottom: 1px solid var(--color-border);">
                                <th class="text-right py-3 px-4">الحلقة</th>
                                <th class="text-right py-3 px-4">البرنامج</th>
                                <th class="text-right py-3 px-4">الضيوف</th>
                                <th class="text-right py-3 px-4">الموعد</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ep in Model.TodayEpisodes)
                            {
                                <tr class="transition-colors hover:bg-[var(--color-bg-hover)]" style="border-bottom: 1px solid var(--color-border);">
                                    <td class="py-3 px-4 font-bold"><a href="/Episodes/Details/@ep.EpisodeId" class="text-[var(--color-primary)] hover:underline">@ep.EpisodeName</a></td>
                                    <td class="py-3 px-4 text-[var(--color-text-secondary)]">@ep.ProgramName</td>
                                    <td class="py-3 px-4 text-[var(--color-text-secondary)]">@ep.GuestsDisplay</td>
                                    <td class="py-3 px-4 font-semibold text-[var(--color-text-secondary)] whitespace-nowrap" dir="ltr">@(ep.ScheduledExecutionTime?.ToString("HH:mm") ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="flex flex-col items-center py-12 text-[var(--color-text-secondary)]">
                    <span class="material-symbols-rounded text-4xl text-[var(--color-text-muted)] mb-2">event_busy</span>
                    <h3 class="font-bold text-lg mb-2 text-[var(--color-text)]">لا حلقات لليوم</h3>
                    <p class="text-sm">لم يتم جدولة أي حلقات لليوم.</p>
                </div>
            }
        </div>

        <div id="tab-programs" class="tab-panel hidden">
            @if (Model.TopPrograms.Any())
            {
                <div class="overflow-x-auto" style="border: 1px solid var(--color-border); border-radius: 0.75rem;">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="text-xs font-semibold text-[var(--color-text-muted)]" style="background: var(--color-bg); border-bottom: 1px solid var(--color-border);">
                                <th class="text-right py-3 px-4">البرنامج</th>
                                <th class="text-right py-3 px-4">الفئة</th>
                                <th class="text-right py-3 px-4">إجمالي الحلقات</th>
                                <th class="text-right py-3 px-4">الحلقات المنشورة</th>
                                <th class="text-right py-3 px-4">نسبة النشر</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.TopPrograms)
                            {
                                var pubPct = p.TotalEpisodes > 0 ? (p.PublishedEpisodes * 100.0 / p.TotalEpisodes) : 0;
                                <tr class="transition-colors hover:bg-[var(--color-bg-hover)]" style="border-bottom: 1px solid var(--color-border);">
                                    <td class="py-3 px-4 font-bold text-[var(--color-text)]">@p.ProgramName</td>
                                    <td class="py-3 px-4">
                                        <span class="text-[10px] font-bold px-2 py-0.5 rounded-lg" style="background: var(--color-info-light); color: var(--color-info);">@(p.Category ?? "عام")</span>
                                    </td>
                                    <td class="py-3 px-4 font-bold text-[var(--color-primary)]">@p.TotalEpisodes</td>
                                    <td class="py-3 px-4 font-bold text-[var(--color-success)]">@p.PublishedEpisodes</td>
                                    <td class="py-3 px-4">
                                        <div class="flex items-center gap-2">
                                            <div class="w-16 h-1.5 rounded-full overflow-hidden" style="background: var(--color-bg);">
                                                <div class="h-full rounded-full" style="background: var(--color-success); width:@(pubPct)%"></div>
                                            </div>
                                            <span class="text-xs font-bold text-[var(--color-text-muted)]">@pubPct.ToString("F0")%</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="flex flex-col items-center py-12 text-[var(--color-text-secondary)]">
                    <span class="material-symbols-rounded text-4xl text-[var(--color-text-muted)] mb-2">radio</span>
                    <h3 class="font-bold text-lg mb-2 text-[var(--color-text)]">لا توجد برامج</h3>
                    <p class="text-sm">لا توجد بيانات برامج حالياً.</p>
                </div>
            }
        </div>

        <div id="tab-guests" class="tab-panel hidden">
            @if (Model.TopGuests.Any())
            {
                <div class="overflow-x-auto" style="border: 1px solid var(--color-border); border-radius: 0.75rem;">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="text-xs font-semibold text-[var(--color-text-muted)]" style="background: var(--color-bg); border-bottom: 1px solid var(--color-border);">
                                <th class="text-right py-3 px-4">#</th>
                                <th class="text-right py-3 px-4">الاسم</th>
                                <th class="text-right py-3 px-4">الجهة</th>
                                <th class="text-right py-3 px-4">عدد الاستضافات</th>
                                <th class="text-right py-3 px-4">آخر ظهور</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var g in Model.TopGuests)
                            {
                                <tr class="transition-colors hover:bg-[var(--color-bg-hover)]" style="border-bottom: 1px solid var(--color-border);">
                                    <td class="py-3 px-4 font-bold text-[var(--color-text-muted)]">@g.Rank</td>
                                    <td class="py-3 px-4 font-bold text-[var(--color-text)]">@g.FullName</td>
                                    <td class="py-3 px-4 text-[var(--color-text-secondary)]">@(g.Organization ?? "—")</td>
                                    <td class="py-3 px-4">
                                        <span class="font-bold text-xs px-2 py-0.5 rounded-lg" style="background: var(--color-success-light); color: var(--color-success);">@g.AppearanceCount</span>
                                    </td>
                                    <td class="py-3 px-4 font-semibold text-[var(--color-text-secondary)] whitespace-nowrap" dir="ltr">@(g.LastAppearance?.ToString("yyyy-MM-dd") ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="flex flex-col items-center py-12 text-[var(--color-text-secondary)]">
                    <span class="material-symbols-rounded text-4xl text-[var(--color-text-muted)] mb-2">people_alt</span>
                    <h3 class="font-bold text-lg mb-2 text-[var(--color-text)]">لا يوجد ضيوف</h3>
                    <p class="text-sm">لا توجد بيانات استضافة ضيوف حالياً.</p>
                </div>
            }
        </div>

        <div id="tab-cancelled" class="tab-panel hidden">
            @if (Model.CancelledEpisodes.Any())
            {
                <div class="overflow-x-auto" style="border: 1px solid var(--color-border); border-radius: 0.75rem;">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="text-xs font-semibold text-[var(--color-text-muted)]" style="background: var(--color-bg); border-bottom: 1px solid var(--color-border);">
                                <th class="text-right py-3 px-4">الحلقة</th>
                                <th class="text-right py-3 px-4">البرنامج</th>
                                <th class="text-right py-3 px-4">موعد البث</th>
                                <th class="text-right py-3 px-4">سبب الإلغاء</th>
                                <th class="text-right py-3 px-4">بواسطة</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.CancelledEpisodes)
                            {
                                <tr class="transition-colors hover:bg-[var(--color-bg-hover)]" style="border-bottom: 1px solid var(--color-border);">
                                    <td class="py-3 px-4 font-bold">
                                        <span class="inline-flex items-center gap-1 text-xs font-bold px-2 py-0.5 rounded-lg" style="background: var(--color-danger-light); color: var(--color-danger);">
                                            <span class="material-symbols-rounded text-xs">cancel</span>
                                            @c.EpisodeName
                                        </span>
                                    </td>
                                    <td class="py-3 px-4 text-[var(--color-text-secondary)]">@c.ProgramName</td>
                                    <td class="py-3 px-4 font-semibold text-[var(--color-text-secondary)] whitespace-nowrap" dir="ltr">@(c.ScheduledExecutionTime?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                                    <td class="py-3 px-4 text-[var(--color-text-secondary)] max-w-xs truncate" title="@c.CancellationReason">@(c.CancellationReason ?? "—")</td>
                                    <td class="py-3 px-4 text-[var(--color-text-muted)]">@(c.CancelledBy ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="flex flex-col items-center py-12 text-[var(--color-text-secondary)]">
                    <span class="material-symbols-rounded text-4xl text-[var(--color-text-muted)] mb-2">check_circle</span>
                    <h3 class="font-bold text-lg mb-2 text-[var(--color-text)]">لا حلقات ملغاة</h3>
                    <p class="text-sm">لا توجد حلقات ملغاة في النظام.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('click', function (e) {
            var btn = e.target.closest('[data-tab]');
            if (!btn) return;
            var name = btn.getAttribute('data-tab');
            document.querySelectorAll('.tab-panel').forEach(function (p) { p.classList.add('hidden'); });
            document.querySelectorAll('.tab-btn').forEach(function (b) { b.classList.remove('active'); });
            document.getElementById('tab-' + name).classList.remove('hidden');
            btn.classList.add('active');
        });

        @if (Model.StatusStats.Any())
        {
            <text>
            document.addEventListener('DOMContentLoaded', function () {
                var ctx = document.getElementById('statusChart');
                if (!ctx) return;
                new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: [@Html.Raw(string.Join(", ", Model.StatusStats.Select(s => $"'{GetStatusDisplayName(s.Key)}'")))],
                        datasets: [{
                            data: [@string.Join(", ", Model.StatusStats.Select(s => s.Value))],
                            backgroundColor: [@Html.Raw(string.Join(", ", Model.StatusStats.Select(s => $"'{GetStatusColor(s.Key)}'")))],
                            borderWidth: 2,
                            borderColor: 'var(--color-bg-elevated)'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: true,
                        cutout: '70%',
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function (ctx) {
                                        var total = ctx.dataset.data.reduce((a, b) => a + b, 0);
                                        var pct = total > 0 ? (ctx.parsed * 100 / total).toFixed(1) : 0;
                                        return ctx.label + ': ' + ctx.parsed + ' (' + pct + '%)';
                                    }
                                }
                            }
                        }
                    }
                });
            });
            </text>
        }
    </script>
}

@functions {
    string GetStatusDisplayName(string s) => s switch
    {
        "Planned" => "مجدولة",
        "Executed" => "منفّذة",
        "Published" => "منشورة رقمياً",
        "WebsitePublished" => "منشورة على الموقع",
        "Cancelled" => "ملغاة",
        _ => s
    };

    string GetStatusColor(string s) => s switch
    {
        "Planned" => "var(--color-info)",
        "Executed" => "var(--color-success)",
        "Published" => "var(--color-primary)",
        "WebsitePublished" => "var(--color-accent)",
        "Cancelled" => "var(--color-danger)",
        _ => "var(--color-text-muted)"
    };
}
