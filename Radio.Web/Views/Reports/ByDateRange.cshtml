@model List<DateRangeEpisodeDto>
@{
    ViewData["Title"] = "حلقات حسب الفترة";
    ViewData["HeaderIcon"] = "date_range";
    ViewData["HeaderDescription"] = "عرض الحلقات المصفاة ضمن نطاق زمني محدد: من @ViewBag.From إلى @ViewBag.To";
    ViewBag.EntityName = "التقارير";
    ViewBag.EntityUrl = "/Reports";
    ViewBag.BackUrl = "/Reports";
    ViewBag.BackText = "الرجوع للتقارير";
    ViewData["HeaderActions"] = "<div class='flex items-center gap-2'><a href='/Reports/ExportDateRangeExcel?from=@ViewBag.From&to=@ViewBag.To' class='btn btn-success btn-sm rounded-xl gap-2'><span class='material-symbols-rounded text-lg'>file_download</span>Excel</a><a href='/Reports/ExportDateRangePdf?from=@ViewBag.From&to=@ViewBag.To' class='btn btn-danger btn-sm rounded-xl gap-2'><span class='material-symbols-rounded text-lg'>file_download</span>PDF</a><button onclick='window.print()' class='btn btn-ghost btn-sm rounded-xl no-print'><span class='material-symbols-rounded text-lg'>print</span></button></div>";
}

<partial name="_PageHeader" />

<div class="card mb-6">
    <div class="p-5">
        <form method="get" class="flex gap-3" role="search" aria-label="تصفية حسب النطاق الزمني">
            <div class="relative flex-1">
                <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-text-muted" aria-hidden="true">calendar_month</span>
                <input type="text" name="from" value="@ViewBag.From"
                       class="input pr-10 datepicker"
                       placeholder="من تاريخ" aria-label="من تاريخ" />
            </div>
            <div class="relative flex-1">
                <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-text-muted" aria-hidden="true">calendar_month</span>
                <input type="text" name="to" value="@ViewBag.To"
                       class="input pr-10 datepicker"
                       placeholder="إلى تاريخ" aria-label="إلى تاريخ" />
            </div>
            <button type="submit" class="btn btn-primary">
                <span class="material-symbols-rounded text-lg" aria-hidden="true">search</span>
                تطبيق
            </button>
            <a href="/Reports/ByDateRange" class="btn btn-ghost btn-icon" title="إعادة ضبط" aria-label="إعادة ضبط">
                <span class="material-symbols-rounded text-lg">refresh</span>
            </a>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    ViewBag.EmptyIcon = "date_range";
    ViewBag.EmptyTitle = "لا توجد حلقات في هذه الفترة";
    ViewBag.EmptyDesc = "لا توجد حلقات ضمن النطاق الزمني المحدد.";
    <partial name="_EmptyState" />
}
else
{
    <div class="card overflow-hidden">
        <div class="overflow-x-auto">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>الحلقة</th>
                        <th>البرنامج</th>
                        <th>الضيوف</th>
                        <th>الموعد</th>
                        <th>الحالة</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ep in Model)
                    {
                        <tr>
                            <td class="font-semibold text-text">@ep.EpisodeName</td>
                            <td class="text-text-secondary">@ep.ProgramName</td>
                            <td class="text-text-secondary">@ep.GuestsDisplay</td>
                            <td class="whitespace-nowrap text-text-secondary" dir="ltr">@(ep.ScheduledExecutionTime?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                            <td>@await Html.PartialAsync("_StatusBadge", new StatusBadgeViewModel { Type = "episode", Status = ep.StatusText.ToLower(), Label = ep.StatusText })</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
