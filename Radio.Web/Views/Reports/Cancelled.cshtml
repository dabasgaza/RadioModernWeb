@model List<CancelledEpisodeDto>
@{
    ViewData["Title"] = "الحلقات الملغاة";
    ViewData["HeaderIcon"] = "cancel";
    ViewData["HeaderDescription"] = "قائمة بكل الحلقات الملغاة وأسباب الإلغاء وتفاصيلها";
    ViewBag.EntityName = "التقارير";
    ViewBag.EntityUrl = "/Reports";
    ViewData["HeaderActions"] = "<div class='flex items-center gap-2'><a href='/Reports/ExportCancelledExcel' class='btn btn-success btn-sm rounded-xl gap-2'><span class='material-symbols-rounded text-lg'>file_download</span>Excel</a><a href='/Reports/ExportCancelledPdf' class='btn btn-danger btn-sm rounded-xl gap-2'><span class='material-symbols-rounded text-lg'>file_download</span>PDF</a><button onclick='window.print()' class='btn btn-ghost btn-sm rounded-xl no-print'><span class='material-symbols-rounded text-lg'>print</span></button></div>";
}

<partial name="_PageHeader" />

@if (!Model.Any())
{
    ViewBag.EmptyIcon = "cancel";
    ViewBag.EmptyTitle = "لا توجد حلقات ملغاة";
    ViewBag.EmptyDesc = "لم يتم إلغاء أي حلقات في الفترة المحددة.";
    <partial name="_EmptyState" />
}
else
{
    <div class="card overflow-hidden">
        <div class="overflow-x-auto">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>الحلقة</th>
                        <th>البرنامج</th>
                        <th>الموعد</th>
                        <th>السبب</th>
                        <th>بواسطة</th>
                        <th>تاريخ الإلغاء</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>
                                <span class="badge badge-danger">
                                    <span class="material-symbols-rounded text-xs" aria-hidden="true">cancel</span>
                                    @c.EpisodeName
                                </span>
                            </td>
                            <td class="text-text-secondary">@c.ProgramName</td>
                            <td class="text-text-secondary">@(c.ScheduledExecutionTime?.ToString("yyyy-MM-dd") ?? "—")</td>
                            <td class="text-text-secondary">@c.CancellationReason</td>
                            <td class="text-text-secondary">@(c.CancelledBy ?? "—")</td>
                            <td class="whitespace-nowrap text-text-secondary" dir="ltr">@c.CancelledAt.ToString("yyyy-MM-dd HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
