@model List<CancelledEpisodeDto>
@{
    ViewData["Title"] = "الحلقات الملغاة";
}

<div class="page-header">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 relative z-10">
        <div>
            <nav class="breadcrumb">
                <a href="/Reports">التقارير</a>
                <span class="material-icons">chevron_left</span>
                <span>الملغاة</span>
            </nav>
            <h1>
                <span class="material-icons text-danger">cancel</span>
                الحلقات الملغاة
            </h1>
            <p>قائمة بكل الحلقات الملغاة وأسبابها</p>
        </div>
        <a href="/Reports" class="btn-secondary">
            <span class="material-icons">arrow_back</span>
            رجوع
        </a>
    </div>
</div>

<div class="table-premium">
    @if (!Model.Any())
    {
        <div class="empty-state p-12">
            <div class="w-20 h-20 bg-green-50 rounded-full flex items-center justify-center mx-auto mb-4">
                <span class="material-icons text-success text-4xl">check_circle</span>
            </div>
            <h3 class="font-bold text-ink text-lg mb-2">لا حلقات ملغاة</h3>
            <p class="text-ink-muted text-sm">لم تُلغَ أي حلقات بعد. هذا مؤشر ممتاز!</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table>
                <thead>
                    <tr>
                        <th>الحلقة</th>
                        <th>البرنامج</th>
                        <th>الموعد</th>
                        <th>السبب</th>
                        <th>بواسطة</th>
                        <th>تاريخ الإلغاء</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr class="hover:bg-surface-2 transition duration-200">
                            <td class="font-bold text-ink">@c.EpisodeName</td>
                            <td class="text-ink-muted">@c.ProgramName</td>
                            <td class="text-ink-muted">@(c.ScheduledExecutionTime?.ToString("yyyy-MM-dd") ?? "—")</td>
                            <td class="text-ink-muted">@c.CancellationReason</td>
                            <td class="text-ink-muted">@(c.CancelledBy ?? "—")</td>
                            <td class="text-ink-muted">@c.CancelledAt.ToString("yyyy-MM-dd HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
