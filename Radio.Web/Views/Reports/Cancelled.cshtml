@model List<CancelledEpisodeDto>
@{
    ViewData["Title"] = "الحلقات الملغاة";
}

<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-2xl font-bold text-ink mb-1 flex items-center gap-2">
            <span class="material-symbols-rounded text-danger">cancel</span>
            الحلقات الملغاة
        </h1>
        <p class="text-ink-muted text-sm">قائمة بكل الحلقات الملغاة وأسبابها</p>
    </div>
    <a href="/Reports" class="btn-secondary"><span class="material-symbols-rounded">arrow_back</span> رجوع</a>
</div>

<div class="bg-surface rounded-xl border border-border">
    @if (!Model.Any())
    {
        <div class="empty-state p-12">
            <span class="material-symbols-rounded empty-icon" style="color: #10B981 !important; background: #D1FAE5;">check_circle</span>
            <h3 class="font-bold text-ink text-lg mb-2">لا حلقات ملغاة</h3>
            <p class="text-ink-muted text-sm">لم تُلغَ أي حلقات بعد. هذا مؤشر ممتاز!</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="bg-surface-3 text-ink-muted">
                    <tr>
                        <th class="px-5 py-3 text-right font-semibold">الحلقة</th>
                        <th class="px-5 py-3 text-right font-semibold">البرنامج</th>
                        <th class="px-5 py-3 text-right font-semibold">الموعد</th>
                        <th class="px-5 py-3 text-right font-semibold">السبب</th>
                        <th class="px-5 py-3 text-right font-semibold">بواسطة</th>
                        <th class="px-5 py-3 text-right font-semibold">تاريخ الإلغاء</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border">
                    @foreach (var c in Model)
                    {
                        <tr class="hover:bg-surface-3">
                            <td class="px-5 py-3 font-semibold text-ink">@c.EpisodeName</td>
                            <td class="px-5 py-3 text-ink-muted">@c.ProgramName</td>
                            <td class="px-5 py-3 text-ink-muted">@(c.ScheduledExecutionTime?.ToString("yyyy-MM-dd") ?? "—")</td>
                            <td class="px-5 py-3 text-ink-muted">@c.CancellationReason</td>
                            <td class="px-5 py-3 text-ink-muted">@(c.CancelledBy ?? "—")</td>
                            <td class="px-5 py-3 text-ink-muted">@c.CancelledAt.ToString("yyyy-MM-dd HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
