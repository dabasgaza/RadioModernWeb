@model SearchViewModel
@{
    ViewData["Title"] = "نتائج البحث";
    ViewData["HeaderIcon"] = "search";
    if (Model.TotalResults > 0)
    {
        ViewData["HeaderDescription"] = $"تم العثور على {Model.TotalResults} نتيجة لـ \"{Model.Query}\"";
    }
    else
    {
        ViewData["HeaderDescription"] = $"لا توجد نتائج لـ \"{Model.Query}\"";
    }
}

<partial name="_PageHeader" />

@{ ViewBag.SearchValue = Model.Query; ViewBag.SearchPlaceholder = "ابحث عن حلقات، برامج، ضيوف…"; ViewBag.SearchAction = "/Search"; }
<div class="mb-6">
    <partial name="_SearchBar" />
</div>

@if (Model.TotalResults == 0 && !string.IsNullOrWhiteSpace(Model.Query))
{
    ViewBag.EmptyIcon = "search_off";
    ViewBag.EmptyTitle = "لا توجد نتائج مطابقة";
    ViewBag.EmptyDesc = $"لم نعثر على أي نتائج تطابق البحث \"{Model.Query}\". حاول استخدام كلمات تفصيلية أخرى.";
    <partial name="_EmptyState" />
}
else
{
    @if (Model.Episodes.Any())
    {
        <div class="card p-6 mb-6">
            <h2 class="font-bold text-text flex items-center gap-2 mb-4 text-base">
                <span class="material-symbols-rounded text-primary">podcasts</span>
                الحلقات (@Model.Episodes.Count)
            </h2>
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="text-xs font-semibold text-text-secondary bg-surface-hover border-b border-border">
                            <th class="text-right py-3 px-4">الحلقة</th>
                            <th class="text-right py-3 px-4">البرنامج</th>
                            <th class="text-right py-3 px-4">الموعد</th>
                            <th class="text-right py-3 px-4">الحالة</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border">
                        @foreach (var e in Model.Episodes)
                        {
                            <tr class="hover:bg-surface-hover/50 transition-colors">
                                <td class="py-3 px-4 font-semibold"><a href="/Episodes/Details/@e.EpisodeId" class="text-primary hover:underline">@e.EpisodeName</a></td>
                                <td class="py-3 px-4 text-text-secondary">@(e.ProgramName ?? "—")</td>
                                <td class="py-3 px-4 text-text-secondary whitespace-nowrap" dir="ltr">@(e.ScheduledTime?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                                <td class="py-3 px-4">
                                    <span class="badge badge-primary">@e.StatusText</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (Model.Programs.Any())
    {
        <div class="card p-6 mb-6">
            <h2 class="font-bold text-text flex items-center gap-2 mb-4 text-base">
                <span class="material-symbols-rounded text-success">radio</span>
                البرامج (@Model.Programs.Count)
            </h2>
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="text-xs font-semibold text-text-secondary bg-surface-hover border-b border-border">
                            <th class="text-right py-3 px-4">البرنامج</th>
                            <th class="text-right py-3 px-4">الفئة</th>
                            <th class="text-right py-3 px-4">عدد الحلقات</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border">
                        @foreach (var p in Model.Programs)
                        {
                            <tr class="hover:bg-surface-hover/50 transition-colors">
                                <td class="py-3 px-4 font-semibold"><a href="/Programs/Index?search=@p.ProgramName" class="text-primary hover:underline">@p.ProgramName</a></td>
                                <td class="py-3 px-4">
                                    <span class="badge badge-primary">@(p.Category ?? "عام")</span>
                                </td>
                                <td class="py-3 px-4 text-text-secondary font-bold">@p.EpisodeCount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (Model.Guests.Any())
    {
        <div class="rounded-xl p-6 mb-4" style="background: var(--color-bg-elevated); border: 1px solid var(--color-border);">
            <h2 class="font-bold text-[var(--color-text)] flex items-center gap-2 mb-3 text-sm">
                <span class="material-symbols-rounded text-[var(--color-accent)]">people_alt</span>
                الضيوف (@Model.Guests.Count)
            </h2>
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="text-xs font-semibold text-[var(--color-text-muted)]" style="border-bottom: 1px solid var(--color-border); background: var(--color-bg);">
                            <th class="text-right py-2 px-3">الاسم</th>
                            <th class="text-right py-2 px-3">الجهة</th>
                            <th class="text-right py-2 px-3">الهاتف</th>
                            <th class="text-right py-2 px-3">البريد</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var g in Model.Guests)
                        {
                            <tr style="border-bottom: 1px solid var(--color-border);">
                                <td class="py-2 px-3 font-semibold"><a href="/Guests/Details/@g.GuestId" class="text-[var(--color-primary)] hover:underline">@g.FullName</a></td>
                                <td class="py-2 px-3 text-[var(--color-text-secondary)]">@(g.Organization ?? "—")</td>
                                <td class="py-2 px-3 text-[var(--color-text-secondary)]" dir="ltr">@(g.Phone ?? "—")</td>
                                <td class="py-2 px-3 text-[var(--color-text-secondary)]">@(g.Email ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}
