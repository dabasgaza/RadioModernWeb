@model EmployeeDto
@{
    ViewData["Title"] = Model.EmployeeId == 0 ? "موظف جديد" : "تعديل موظف";
    var isEdit = Model.EmployeeId != 0;
    var staffRoles = ViewBag.StaffRoles as List<StaffRoleDto>;
}

<div class="page-header">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 relative z-10">
        <div>
            <nav class="breadcrumb">
                <span class="material-symbols-rounded">home</span>
                <a href="/">الرئيسية</a>
                <span class="material-symbols-rounded">chevron_left</span>
                <a href="/Employees">الموظفون</a>
                <span class="material-symbols-rounded">chevron_left</span>
                <span>@(isEdit ? "تعديل موظف" : "موظف جديد")</span>
            </nav>
            <h1>
                <span class="material-symbols-rounded text-primary">@(isEdit ? "edit" : "add")</span>
                @(isEdit ? "تعديل موظف" : "موظف جديد")
            </h1>
            <p>إدخال وتحديث بيانات أعضاء طاقم العمل والمهام المرتبطة بهم</p>
        </div>
        <div class="flex items-center gap-2">
            <a href="/Employees" class="btn-secondary">
                <span class="material-symbols-rounded">arrow_forward</span>
                الرجوع للموظفين
            </a>
        </div>
    </div>
</div>

<form method="post" action="@(isEdit ? $"/Employees/Edit/{Model.EmployeeId}" : "/Employees/Create")" class="max-w-2xl">
    @Html.AntiForgeryToken()
    @if (isEdit) { <input type="hidden" name="EmployeeId" value="@Model.EmployeeId" /> }
    @if (ViewContext.ModelState.ErrorCount > 0)
    {
        <div asp-validation-summary="All" class="bg-red-50 border border-red-200 text-danger rounded-xl p-4 mb-6 font-semibold text-sm"></div>
    }

    <div class="card-premium">
        <div class="card-header">
            <div class="flex items-center gap-2">
                <span class="material-symbols-rounded text-primary">person</span>
                <h3 class="font-bold text-ink text-base">الملف التعريفي للموظف</h3>
            </div>
        </div>
        <div class="card-body space-y-4">
            <div>
                <label class="form-label">الاسم الكامل *</label>
                <div class="input-wrapper">
                    <span class="material-symbols-rounded input-icon">person</span>
                    <input type="text" name="FullName" value="@Model.FullName" class="form-input" required placeholder="مثال: أحمد محمد" />
                </div>
            </div>
            <div>
                <label class="form-label">الدور الوظيفي *</label>
                <div class="input-wrapper">
                    <span class="material-symbols-rounded input-icon">work</span>
                    <select name="StaffRoleId" class="form-input" required>
                        <option value="">— اختر —</option>
                        @foreach (var r in staffRoles ?? new())
                        {
                            <option value="@r.StaffRoleId" selected="@(Model.StaffRoleId == r.StaffRoleId)">@r.RoleName</option>
                        }
                    </select>
                </div>
            </div>
            <div>
                <label class="form-label">ملاحظات</label>
                <textarea name="Notes" rows="4" class="form-input" placeholder="ملاحظات إضافية حول مهام الموظف…">@Model.Notes</textarea>
            </div>
        </div>
    </div>

    <div class="flex items-center justify-end gap-2 mt-6">
        <a href="/Employees" class="btn-secondary">
            <span class="material-symbols-rounded">cancel</span>
            إلغاء
        </a>
        <button type="submit" class="btn-primary">
            <span class="material-symbols-rounded">save</span>
            حفظ البيانات
        </button>
    </div>
</form>
