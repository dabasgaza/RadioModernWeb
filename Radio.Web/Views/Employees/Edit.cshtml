@model EmployeeDto
@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = Model.EmployeeId == 0 ? "موظف جديد" : "تعديل موظف";
    var isEdit = Model.EmployeeId != 0;
    var staffRoles = ViewBag.StaffRoles as List<StaffRoleDto>;
    ViewBag.IsEdit = isEdit;
    ViewBag.Icon = isEdit ? "edit" : "add";
    ViewBag.Title = isEdit ? "تعديل بيانات الموظف" : "إضافة موظف جديد";
    ViewBag.Description = "إدخال وتحديث بيانات أعضاء طاقم العمل والمهام المرتبطة بهم";
    ViewBag.EntityName = "الموظفون";
    ViewBag.EntityUrl = "/Employees";
    ViewBag.BackUrl = "/Employees";
    ViewBag.BackText = "الرجوع للموظفين";
}

<partial name="_PageHeader" />

<form method="post" action="@(isEdit ? $"/Employees/Edit/{Model.EmployeeId}" : "/Employees/Create")" class="max-w-2xl">
    @Html.AntiForgeryToken()
    @if (isEdit) { <input type="hidden" name="EmployeeId" value="@Model.EmployeeId" /> }

    @if (ViewContext.ModelState.ErrorCount > 0)
    {
        <div asp-validation-summary="All" class="rounded-xl p-4 mb-6 font-semibold text-sm bg-danger-subtle text-danger border border-danger-subtle"></div>
    }

    <div class="bg-surface border border-border rounded-2xl p-5" style="border-color:var(--color-border)">
        @{
            ViewBag.SectionIcon = "person";
            ViewBag.SectionTitle = "الملف التعريفي للموظف";
        }
        <partial name="_SectionHeader" />

        <div class="space-y-4">
            @{
                ViewBag.FieldLabel = "الاسم الكامل"; ViewBag.FieldName = "FullName";
                ViewBag.FieldIcon = "person"; ViewBag.FieldValue = Model.FullName;
                ViewBag.FieldRequired = true; ViewBag.FieldPlaceholder = "مثال: أحمد محمد";
            }
            <partial name="_FormField" />

            @{
                var roleOptions = (staffRoles ?? new()).Select(r => new SelectListItem { Value = r.StaffRoleId.ToString(), Text = r.RoleName, Selected = Model.StaffRoleId == r.StaffRoleId }).ToList();
                roleOptions.Insert(0, new SelectListItem { Value = "", Text = "— اختر —" });
                ViewBag.FieldLabel = "الدور الوظيفي"; ViewBag.FieldName = "StaffRoleId";
                ViewBag.FieldIcon = "work"; ViewBag.FieldType = "select";
                ViewBag.FieldRequired = true; ViewBag.FieldOptions = roleOptions;
            }
            <partial name="_FormField" />

            @{
                ViewBag.FieldLabel = "ملاحظات"; ViewBag.FieldName = "Notes";
                ViewBag.FieldIcon = "notes"; ViewBag.FieldValue = Model.Notes;
                ViewBag.FieldType = "textarea"; ViewBag.FieldPlaceholder = "ملاحظات إضافية حول مهام الموظف…";
            }
            <partial name="_FormField" />
        </div>
    </div>

    <div class="flex items-center justify-end gap-2 mt-6">
        <a href="/Employees" class="btn btn-ghost rounded-xl gap-2">
            <span class="material-symbols-rounded">cancel</span>إلغاء
        </a>
        <button type="submit" class="btn btn-primary rounded-xl gap-2">
            <span class="material-symbols-rounded">save</span>حفظ البيانات
        </button>
    </div>
</form>
