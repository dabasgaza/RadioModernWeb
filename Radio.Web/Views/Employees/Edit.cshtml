@model EmployeeDto
@{
    ViewData["Title"] = Model.EmployeeId == 0 ? "موظف جديد" : "تعديل موظف";
    var isEdit = Model.EmployeeId != 0;
    var staffRoles = ViewBag.StaffRoles as List<StaffRoleDto>;
}

<div class="page-header">
    <div class="relative z-10">
        <nav class="breadcrumb">
            <a href="/Employees">الموظفون</a>
            <span class="material-icons">chevron_left</span>
            <span>@(isEdit ? "تعديل" : "جديد")</span>
        </nav>
        <h1>
            <span class="material-icons">@(isEdit ? "edit" : "add")</span>
            @(isEdit ? "تعديل موظف" : "موظف جديد")
        </h1>
    </div>
</div>

<form method="post" action="@(isEdit ? $"/Employees/Edit/{Model.EmployeeId}" : "/Employees/Create")" class="max-w-2xl">
    @Html.AntiForgeryToken()
    @if (isEdit) { <input type="hidden" name="EmployeeId" value="@Model.EmployeeId" /> }
    @if (ViewContext.ModelState.ErrorCount > 0)
    {
        <div asp-validation-summary="All" class="bg-red-50 border border-red-200 text-danger rounded-xl p-4 mb-4"></div>
    }

    <div class="card-premium p-5 space-y-4">
        <div>
            <label class="form-label">الاسم الكامل *</label>
            <input type="text" name="FullName" value="@Model.FullName" class="form-input" required />
        </div>
        <div>
            <label class="form-label">الدور الوظيفي *</label>
            <select name="StaffRoleId" class="form-input" required>
                <option value="">— اختر —</option>
                @foreach (var r in staffRoles ?? new())
                {
                    <option value="@r.StaffRoleId" selected="@(Model.StaffRoleId == r.StaffRoleId)">@r.RoleName</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label">ملاحظات</label>
            <textarea name="Notes" rows="3" class="form-input">@Model.Notes</textarea>
        </div>
    </div>

    <div class="flex items-center justify-end gap-2 mt-4">
        <a href="/Employees" class="btn-secondary"><span class="material-icons">cancel</span> إلغاء</a>
        <button type="submit" class="btn-primary"><span class="material-icons">save</span> حفظ</button>
    </div>
</form>
