@model EmployeeDto
@{
    ViewData["Title"] = Model.EmployeeId == 0 ? "موظف جديد" : "تعديل موظف";
    var isEdit = Model.EmployeeId != 0;
    var staffRoles = ViewBag.StaffRoles as List<StaffRoleDto>;
    ViewBag.IsEdit = isEdit;
    ViewBag.Icon = isEdit ? "edit" : "add";
    ViewBag.Title = isEdit ? "تعديل بيانات الموظف" : "إضافة موظف جديد";
    ViewBag.Description = "إدخال وتحديث بيانات أعضاء طاقم العمل والمهام المرتبطة بهم";
    ViewBag.EntityName = "الموظفون";
    ViewBag.EntityUrl = "/Employees";
    ViewBag.BackUrl = "/Employees";
    ViewBag.BackText = "الرجوع للموظفين";
}

<partial name="_CreateEditHeader" />

<form method="post" action="@(isEdit ? $"/Employees/Edit/{Model.EmployeeId}" : "/Employees/Create")" class="max-w-2xl">
    @Html.AntiForgeryToken()
    @if (isEdit) { <input type="hidden" name="EmployeeId" value="@Model.EmployeeId" /> }

    @if (ViewContext.ModelState.ErrorCount > 0)
    {
        <div asp-validation-summary="All" class="bg-error/10 border border-error/20 text-error rounded-xl p-4 mb-6 font-semibold text-sm"></div>
    }

    <div class="wf-card">
        <div class="card-body space-y-4">
            <div class="flex items-center gap-2">
                <span class="material-symbols-rounded text-primary">person</span>
                <h3 class="font-bold text-base-content text-base">الملف التعريفي للموظف</h3>
            </div>
            <div>
                <label class="label">الاسم الكامل *</label>
                <div class="relative">
                    <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-base-content/40 pointer-events-none text-lg">person</span>
                    <input type="text" name="FullName" value="@Model.FullName" class="input input-bordered w-full pr-10" required placeholder="مثال: أحمد محمد" />
                </div>
            </div>
            <div>
                <label class="label">الدور الوظيفي *</label>
                <div class="relative">
                    <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-base-content/40 pointer-events-none text-lg">work</span>
                    <select name="StaffRoleId" class="select select-bordered w-full pr-10" required>
                        <option value="">— اختر —</option>
                        @foreach (var r in staffRoles ?? new())
                        {
                            <option value="@r.StaffRoleId" selected="@(Model.StaffRoleId == r.StaffRoleId)">@r.RoleName</option>
                        }
                    </select>
                </div>
            </div>
            <div>
                <label class="label">ملاحظات</label>
                <div class="relative">
                    <span class="material-symbols-rounded absolute right-3 text-base-content/40 pointer-events-none text-lg" style="top:1rem;transform:none">notes</span>
                    <textarea name="Notes" rows="4" class="textarea textarea-bordered w-full pr-10" placeholder="ملاحظات إضافية حول مهام الموظف…">@Model.Notes</textarea>
                </div>
            </div>
        </div>
    </div>

    <div class="flex items-center justify-end gap-2 mt-6">
        <a href="/Employees" class="btn btn-ghost">
            <span class="material-symbols-rounded">cancel</span>
            إلغاء
        </a>
        <button type="submit" class="btn btn-primary">
            <span class="material-symbols-rounded">save</span>
            حفظ البيانات
        </button>
    </div>
</form>
