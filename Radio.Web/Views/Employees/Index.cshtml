@model List<EmployeeDto>
@{
    ViewData["Title"] = "الموظفون";
    ViewData["HeaderIcon"] = "badge";
    ViewData["HeaderDescription"] = "إدارة أعضاء طاقم العمل والمسميات الوظيفية المرتبطة بهم";
    ViewBag.EntityName = "الموظفون";
    var staffRoles = ViewBag.StaffRoles as List<StaffRoleDto>;

    if (User.HasPermission(AppPermissions.StaffManage))
    {
        ViewData["HeaderActions"] = "<a href='/Employees/Create' class='btn btn-primary rounded-xl px-5 shadow-sm gap-2'><span class='material-symbols-rounded'>add_circle</span><span>موظف جديد</span></a>";
    }
}

<partial name="_PageHeader" />

@{ ViewBag.SearchValue = ViewBag.Search; ViewBag.SearchPlaceholder = "بحث باسم الموظف..."; ViewBag.SearchAction = "/Employees"; }
<partial name="_SearchBar" />

<!-- Employees Content -->
@if (!Model.Any())
{
    ViewBag.EmptyIcon = "badge";
    ViewBag.EmptyTitle = "لا موظفين";
    ViewBag.EmptyDesc = "لم يتم العثور على أي موظفين تطابق البحث.";
    ViewBag.EmptySecondaryUrl = "/Employees";
    ViewBag.EmptySecondaryText = "إعادة ضبط البحث";
    ViewBag.EmptyActionUrl = User.HasPermission(AppPermissions.StaffManage) ? "/Employees/Create" : null;
    ViewBag.EmptyActionText = "إضافة موظف جديد";
    ViewBag.EmptyActionIcon = "add";
    <partial name="_EmptyState" />
}
else
{
    <div class="wf-card overflow-hidden">
        <div class="overflow-x-auto">
            <table class="table w-full text-sm">
                <thead>
                    <tr style="background: var(--color-surface-3)">
                        <th class="px-6 py-4 text-right font-bold text-xs uppercase tracking-wider" style="color: var(--color-text-3)">الاسم</th>
                        <th class="px-6 py-4 text-right font-bold text-xs uppercase tracking-wider" style="color: var(--color-text-3)">الدور</th>
                        <th class="px-6 py-4 text-right font-bold text-xs uppercase tracking-wider" style="color: var(--color-text-3)">ملاحظات</th>
                        <th class="px-6 py-4 text-center font-bold text-xs uppercase tracking-wider" style="color: var(--color-text-3)">إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr class="transition-colors duration-200" style="border-bottom: 1px solid color-mix(in srgb, var(--color-border) 40%, transparent)">
                            <td class="px-6 py-4 font-semibold" style="color: var(--color-text)">@e.FullName</td>
                            <td class="px-6 py-4">
                                @if (!string.IsNullOrWhiteSpace(e.StaffRoleName))
                                {
                                    <span class="inline-flex items-center justify-center font-bold text-xs rounded-lg px-3 py-1.5" style="background: color-mix(in srgb, var(--color-info) 10%, transparent); color: var(--color-info)">@e.StaffRoleName</span>
                                }
                                else { <span style="color: var(--color-text-tertiary)">—</span> }
                            </td>
                            <td class="px-6 py-4" style="color: var(--color-text-3)">@(e.Notes ?? "—")</td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                @if (User.HasPermission(AppPermissions.StaffManage))
                                {
                                    <div class="flex items-center justify-center gap-1">
                                        <a href="/Employees/Edit/@e.EmployeeId" class="btn btn-ghost btn-square btn-sm" title="تعديل" aria-label="تعديل" style="color: var(--color-primary)">
                                            <span class="material-symbols-rounded text-xl leading-none">edit</span>
                                        </a>
                                        <form method="post" action="/Employees/Delete/@e.EmployeeId" class="inline" data-confirm="هل أنت متأكد من حذف الموظف «@e.FullName»؟">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-ghost btn-square btn-sm" title="حذف" aria-label="حذف" style="color: var(--color-danger)">
                                                <span class="material-symbols-rounded text-xl leading-none">delete</span>
                                            </button>
                                        </form>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
