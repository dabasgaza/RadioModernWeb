@model List<EmployeeDto>
@{
    ViewData["Title"] = "الموظفون";
    var staffRoles = ViewBag.StaffRoles as List<StaffRoleDto>;
}

<div class="page-header">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 relative z-10">
        <div>
            <nav class="breadcrumb">
                <span class="material-symbols-rounded">home</span>
                <a href="/">الرئيسية</a>
                <span class="material-symbols-rounded">chevron_left</span>
                <span>الموظفون</span>
            </nav>
            <h1>
                <span class="material-symbols-rounded text-primary">badge</span>
                الموظفون
            </h1>
            <p>إدارة أعضاء طاقم العمل والمسميات الوظيفية المرتبطة بهم</p>
        </div>
        <div class="flex items-center gap-2">
            @if (User.HasPermission(AppPermissions.StaffManage))
            {
                <a href="/Employees/Create" class="btn-primary">
                    <span class="material-symbols-rounded">add</span>
                    موظف جديد
                </a>
            }
        </div>
    </div>
</div>

<div class="filter-premium">
    <form method="get" class="flex gap-3">
        <div class="relative flex-1">
            <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-ink-soft">search</span>
            <input type="text" name="search" value="@ViewBag.Search" placeholder="بحث باسم الموظف…" class="form-input pr-10" />
        </div>
        <button type="submit" class="btn-primary">
            <span class="material-symbols-rounded">search</span>
            بحث
        </button>
        <a href="/Employees" class="btn-secondary" title="إعادة ضبط">
            <span class="material-symbols-rounded">refresh</span>
        </a>
    </form>
</div>

<div class="table-premium">
    @if (!Model.Any())
    {
        <div class="empty-state p-12">
            <span class="material-symbols-rounded empty-icon">badge</span>
            <h3 class="font-bold text-ink text-lg mb-2">لا موظفين</h3>
            <p class="text-ink-muted text-sm mb-4">لم يتم العثور على أي موظفين تطابق البحث.</p>
            @if (User.HasPermission(AppPermissions.StaffManage))
            {
                <a href="/Employees/Create" class="btn-primary">
                    <span class="material-symbols-rounded">add</span>
                    إضافة موظف جديد
                </a>
            }
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr>
                        <th class="px-5 py-3 text-right font-semibold">الاسم</th>
                        <th class="px-5 py-3 text-right font-semibold">الدور</th>
                        <th class="px-5 py-3 text-right font-semibold">ملاحظات</th>
                        <th class="px-5 py-3 text-right font-semibold">إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td class="px-5 py-3 font-semibold text-ink">@e.FullName</td>
                            <td class="px-5 py-3">
                                @if (!string.IsNullOrWhiteSpace(e.StaffRoleName))
                                {
                                    <span class="badge badge-info">@e.StaffRoleName</span>
                                }
                                else { <span class="text-ink-soft">—</span> }
                            </td>
                            <td class="px-5 py-3 text-ink-muted">@(e.Notes ?? "—")</td>
                            <td class="px-5 py-3">
                                @if (User.HasPermission(AppPermissions.StaffManage))
                                {
                                    <a href="/Employees/Edit/@e.EmployeeId" class="icon-btn icon-btn-primary"><span class="material-symbols-rounded">edit</span></a>
                                    <form method="post" action="/Employees/Delete/@e.EmployeeId" class="inline" data-confirm="هل أنت متأكد من حذف الموظف «@e.FullName»؟">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="icon-btn icon-btn-danger"><span class="material-symbols-rounded">delete</span></button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
