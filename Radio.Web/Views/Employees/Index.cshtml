@model List<EmployeeDto>
@{
    ViewData["Title"] = "الموظفون";
    ViewData["HeaderIcon"] = "badge";
    ViewData["HeaderDescription"] = "إدارة أعضاء طاقم العمل والمسميات الوظيفية المرتبطة بهم";
    ViewBag.EntityName = "الموظفون";
    var staffRoles = ViewBag.StaffRoles as List<StaffRoleDto>;

    if (User.HasPermission(AppPermissions.StaffManage))
    {
        ViewData["HeaderActions"] = "<a href='/Employees/Create' class='btn btn-primary rounded-xl px-5 shadow-sm gap-2'><span class='material-symbols-rounded'>add_circle</span><span>موظف جديد</span></a>";
    }
}

<partial name="_PageHeader" />

@{ ViewBag.SearchValue = ViewBag.Search; ViewBag.SearchPlaceholder = "بحث باسم الموظف..."; ViewBag.SearchAction = "/Employees"; }
<partial name="_SearchBar" />

@if (!Model.Any())
{
    ViewBag.EmptyIcon = "badge";
    ViewBag.EmptyTitle = "لا موظفين";
    ViewBag.EmptyDesc = "لم يتم العثور على أي موظفين تطابق البحث.";
    ViewBag.EmptySecondaryUrl = "/Employees";
    ViewBag.EmptySecondaryText = "إعادة ضبط البحث";
    ViewBag.EmptyActionUrl = User.HasPermission(AppPermissions.StaffManage) ? "/Employees/Create" : null;
    ViewBag.EmptyActionText = "إضافة موظف جديد";
    ViewBag.EmptyActionIcon = "add";
    <partial name="_EmptyState" />
}
else
{
    <div class="card overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm" aria-label="قائمة الموظفين">
                <thead>
                    <tr class="text-xs font-semibold text-text-secondary bg-surface-hover border-b border-border">
                        <th class="px-6 py-4 text-right">الاسم</th>
                        <th class="px-6 py-4 text-right">الدور</th>
                        <th class="px-6 py-4 text-right hidden md:table-cell">ملاحظات</th>
                        <th class="px-6 py-4 text-center"><span class="sr-only">إجراءات</span></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border">
                    @foreach (var e in Model)
                    {
                        <tr class="hover:bg-surface-hover/50 transition-colors">
                            <td class="px-6 py-4 font-semibold text-text">@e.FullName</td>
                            <td class="px-6 py-4">
                                @if (!string.IsNullOrWhiteSpace(e.StaffRoleName))
                                {
                                    <span class="badge badge-primary">@e.StaffRoleName</span>
                                }
                                else { <span class="text-text-muted">—</span> }
                            </td>
                            <td class="px-6 py-4 hidden md:table-cell text-text-secondary">@(e.Notes ?? "—")</td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                @if (User.HasPermission(AppPermissions.StaffManage))
                                {
                                    <div class="flex items-center justify-center gap-1">
                                        <a href="/Employees/Edit/@e.EmployeeId" class="btn btn-icon btn-sm btn-ghost text-primary" title="تعديل" aria-label="تعديل @e.FullName">
                                            <span class="material-symbols-rounded text-lg">edit</span>
                                        </a>
                                        <form method="post" action="/Employees/Delete/@e.EmployeeId" class="inline" data-confirm="هل أنت متأكد من حذف الموظف «@e.FullName»؟">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-icon btn-sm btn-ghost text-danger" title="حذف" aria-label="حذف @e.FullName">
                                                <span class="material-symbols-rounded text-lg">delete</span>
                                            </button>
                                        </form>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
