@{
    ViewData["Title"] = "دليل التصميم";
    ViewData["HeaderIcon"] = "palette";
    ViewData["HeaderDescription"] = "جميع مكونات واجهة المستخدم الموحدة للنظام";
    Layout = "_Layout";
}
<div class="max-w-5xl mx-auto">
    <partial name="_PageHeader" />

    <div class="grid grid-cols-1 gap-8">

        @* ── Colors ── *@
        <section class="p-6" aria-label="الألوان" style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 12px; box-shadow: 0 1px 3px 0 rgba(0,0,0,0.1)">
            <h2 class="text-lg font-bold mb-4 flex items-center gap-2" style="color: var(--color-text)">
                <span class="material-symbols-rounded text-primary">circles</span>
                الألوان — Colors
            </h2>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                @foreach (var c in new[] {
                    ("primary", "إجراء/تنقل", "primary-dark", "حالة نشطة", "primary-light", "تمييز"),
                    ("secondary", "اكتمال", "secondary-dark", "اكتمال نشط", "accent", "معلومة مساندة"),
                    ("success", "نجاح", "warning", "تحذير", "danger", "خطأ")
                })
                {
                    <div class="space-y-2">
                        <div class="h-12 rounded-lg" style="background:var(--@c.Item1)"></div>
                        <div class="text-xs font-mono" style="color: var(--color-text-secondary)">--@c.Item1</div>
                        <div class="text-xs font-mono" style="color: var(--color-text-muted)">@c.Item2</div>
                    </div>
                }
            </div>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mt-4">
                @foreach (var c in new[] {
                    ("--surface", "var(--surface)", "السطح الأساسي"),
                    ("--surface-2", "var(--surface-2)", "السطح الثانوي"),
                    ("--surface-3", "var(--surface-3)", "السطح الثالث"),
                    ("--border", "var(--border)", "الحدود"),
                    ("--ink", "var(--ink)", "النص الأساسي"),
                    ("--ink-muted", "var(--ink-muted)", "النص الخافت"),
                    ("--ink-soft", "var(--ink-soft)", "النص الناعم")
                })
                {
                    <div class="flex items-center gap-3 p-3 rounded-lg" style="border: 1px solid var(--color-border); background: var(--color-surface)">
                        <div class="w-8 h-8 rounded" style="background:@c.Item2"></div>
                        <div>
                            <div class="text-xs font-mono" style="color: var(--color-text-secondary)">@c.Item1</div>
                            <div class="text-[10px]" style="color: var(--color-text-muted)">@c.Item3</div>
                        </div>
                    </div>
                }
            </div>
        </section>

        @* ── Status Badges ── *@
        <section class="p-6" aria-label="شارات الحالة" style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 12px; box-shadow: 0 1px 3px 0 rgba(0,0,0,0.1)">
            <h2 class="text-lg font-bold mb-4 flex items-center gap-2" style="color: var(--color-text)">
                <span class="material-symbols-rounded text-primary">rounded_corner</span>
                شارات الحالة — Status Badges
            </h2>
            <div class="flex flex-wrap gap-3">
                @foreach (var s in new[] {
                    ("planned", "مجدولة", "event_note"),
                    ("executed", "منفّذة", "check_circle"),
                    ("published", "منشورة", "rss_feed"),
                    ("website-published", "منشورة على الموقع", "public"),
                    ("cancelled", "ملغاة", "cancel")
                })
                {
                    <partial name="_StatusBadge" model='new StatusBadgeViewModel { Type = "episode", Status = s.Item1, Label = s.Item2 }' />
                }
            </div>
            <div class="flex flex-wrap gap-3 mt-3">
                @foreach (var s in new[] {
                    ("pending", "بانتظار التنفيذ", "schedule"),
                    ("in-progress", "قيد التنفيذ", "pending"),
                    ("completed", "تم التنفيذ", "check_circle"),
                    ("failed", "فشل", "error")
                })
                {
                    <partial name="_StatusBadge" model='new StatusBadgeViewModel { Type = "execution", Status = s.Item1, Label = s.Item2 }' />
                }
            </div>
        </section>

        @* ── Buttons ── *@
        <section class="p-6" aria-label="الأزرار" style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 12px; box-shadow: 0 1px 3px 0 rgba(0,0,0,0.1)">
            <h2 class="text-lg font-bold mb-4 flex items-center gap-2" style="color: var(--color-text)">
                <span class="material-symbols-rounded text-primary">smart_button</span>
                الأزرار — Buttons
            </h2>
            <div class="flex flex-wrap gap-3">
                <button style="display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.5rem 1rem; font-size: 0.875rem; font-weight: 600; border-radius: 0.5rem; border: none; cursor: pointer; background: var(--color-primary); color: var(--color-primary-text); transition: all 0.2s">زر رئيسي</button>
                <button style="display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.5rem 1rem; font-size: 0.875rem; font-weight: 600; border-radius: 0.5rem; border: none; cursor: pointer; background: transparent; color: var(--color-text); transition: all 0.2s">زر ثانوي</button>
                <button style="display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.5rem 1rem; font-size: 0.875rem; font-weight: 600; border-radius: 0.5rem; border: 1px solid var(--color-border); cursor: pointer; background: transparent; color: var(--color-text); transition: all 0.2s">زر حدودي</button>
                <button style="display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.5rem 1rem; font-size: 0.875rem; font-weight: 600; border-radius: 0.5rem; border: none; cursor: pointer; background: transparent; color: var(--color-text); transition: all 0.2s">زر شفاف</button>
                <button style="display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.5rem 1rem; font-size: 0.875rem; font-weight: 600; border-radius: 0.5rem; border: none; cursor: pointer; background: var(--color-success); color: var(--color-success-text); transition: all 0.2s">نجاح</button>
                <button style="display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.5rem 1rem; font-size: 0.875rem; font-weight: 600; border-radius: 0.5rem; border: none; cursor: pointer; background: var(--color-warning); color: #1a1a1a; transition: all 0.2s">تحذير</button>
                <button style="display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.5rem 1rem; font-size: 0.875rem; font-weight: 600; border-radius: 0.5rem; border: none; cursor: pointer; background: var(--color-danger); color: var(--color-danger-text); transition: all 0.2s">حذف</button>
            </div>
            <div class="flex flex-wrap gap-3 mt-3">
                <button style="display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.5rem 1rem; font-size: 0.875rem; font-weight: 600; border-radius: 0.5rem; border: none; background: var(--color-primary); color: var(--color-primary-text); opacity: 0.5; cursor: not-allowed; pointer-events: none" disabled>معطل</button>
                <button style="display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.5rem 1rem; font-size: 0.875rem; font-weight: 600; border-radius: 0.5rem; border: none; cursor: pointer; background: var(--color-primary); color: var(--color-primary-text); transition: all 0.2s"><span class="loading loading-spinner loading-xs"></span>جارٍ التحميل</button>
                <button style="display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.5rem 1rem; font-size: 0.875rem; font-weight: 600; border-radius: 0.5rem; border: none; cursor: pointer; background: transparent; color: var(--color-text); transition: all 0.2s">
                    <span class="material-symbols-rounded text-sm">add</span>
                    مع أيقونة
                </button>
            </div>
        </section>

        @* ── Form Elements ── *@
        <section class="p-6" aria-label="عناصر النماذج" style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 12px; box-shadow: 0 1px 3px 0 rgba(0,0,0,0.1)">
            <h2 class="text-lg font-bold mb-4 flex items-center gap-2" style="color: var(--color-text)">
                <span class="material-symbols-rounded text-primary">view_quilt</span>
                عناصر النماذج — Form Elements
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="label">حقل نصي</label>
                    <input type="text" class="input input-bordered" placeholder="نص تجريبي..." />
                </div>
                <div>
                    <label class="label">قائمة منسدلة</label>
                    <select class="select select-bordered">
                        <option>خيار 1</option>
                        <option>خيار 2</option>
                    </select>
                </div>
                <div>
                    <label class="label">مفتاح تبديل</label>
                    <label class="toggle-switch">
                        <input type="checkbox" class="peer sr-only" />
                        <span class="toggle-track"></span>
                        <span class="toggle-label">مفعل</span>
                    </label>
                </div>
                <div class="flex items-center gap-2">
                    <input type="checkbox" class="form-checkbox" id="chk1" />
                    <label for="chk1" class="label">خيار محدد</label>
                </div>
            </div>
        </section>

        @* ── Cards ── *@
        <section class="p-6" aria-label="البطاقات" style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 12px; box-shadow: 0 1px 3px 0 rgba(0,0,0,0.1)">
            <h2 class="text-lg font-bold mb-4 flex items-center gap-2" style="color: var(--color-text)">
                <span class="material-symbols-rounded text-primary">dashboard</span>
                البطاقات — Cards
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="p-4" style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 12px; box-shadow: 0 1px 3px 0 rgba(0,0,0,0.1)">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center">
                            <span class="material-symbols-rounded text-primary">bar_chart</span>
                        </div>
                        <div>
                            <div class="text-xs" style="color: var(--color-text-secondary)">بطاقة إحصائية</div>
                            <div class="text-xl font-bold" style="color: var(--color-text)">1,234</div>
                        </div>
                    </div>
                </div>
                <div class="p-6" style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 12px; box-shadow: 0 1px 3px 0 rgba(0,0,0,0.1)">
                    <div class="card-body p-0 flex flex-row items-center justify-between">
                        <div>
                            <div class="wf-stat-value">567</div>
                            <div class="wf-stat-label">تم بنجاح</div>
                        </div>
                        <div class="wf-stat-ico bg-success/10 text-success">
                            <span class="material-symbols-rounded">check_circle</span>
                        </div>
                    </div>
                </div>
                <div class="p-4 flex items-center gap-3" style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 12px; box-shadow: 0 1px 3px 0 rgba(0,0,0,0.1)">
                    <div class="w-10 h-10 rounded-full bg-warning/10 text-warning flex items-center justify-center">
                        <span class="material-symbols-rounded">warning</span>
                    </div>
                    <div class="text-sm font-bold" style="color: var(--color-text)">بطاقة مدمجة</div>
                </div>
            </div>
        </section>

        @* ── Badges ── *@
        <section class="p-6" aria-label="الشارات" style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 12px; box-shadow: 0 1px 3px 0 rgba(0,0,0,0.1)">
            <h2 class="text-lg font-bold mb-4 flex items-center gap-2" style="color: var(--color-text)">
                <span class="material-symbols-rounded text-primary">label</span>
                الشارات — Badges
            </h2>
            <div class="flex flex-wrap gap-2">
                <span style="display: inline-flex; align-items: center; gap: 0.25rem; padding: 0.375rem 0.75rem; font-size: 0.75rem; font-weight: 700; border-radius: 9999px; background: color-mix(in srgb, var(--color-primary) 10%, transparent); color: var(--color-primary)">رئيسي</span>
                <span style="display: inline-flex; align-items: center; gap: 0.25rem; padding: 0.375rem 0.75rem; font-size: 0.75rem; font-weight: 700; border-radius: 9999px; background: color-mix(in srgb, var(--color-success) 10%, transparent); color: var(--color-success)">نجاح</span>
                <span style="display: inline-flex; align-items: center; gap: 0.25rem; padding: 0.375rem 0.75rem; font-size: 0.75rem; font-weight: 700; border-radius: 9999px; background: color-mix(in srgb, var(--color-warning) 10%, transparent); color: var(--color-warning)">تحذير</span>
                <span style="display: inline-flex; align-items: center; gap: 0.25rem; padding: 0.375rem 0.75rem; font-size: 0.75rem; font-weight: 700; border-radius: 9999px; background: color-mix(in srgb, var(--color-danger) 10%, transparent); color: var(--color-danger)">خطأ</span>
                <span style="display: inline-flex; align-items: center; gap: 0.25rem; padding: 0.375rem 0.75rem; font-size: 0.75rem; font-weight: 700; border-radius: 9999px; background: color-mix(in srgb, var(--color-info) 10%, transparent); color: var(--color-info)">معلومات</span>
                <span style="display: inline-flex; align-items: center; gap: 0.25rem; padding: 0.375rem 0.75rem; font-size: 0.75rem; font-weight: 700; border-radius: 9999px; background: color-mix(in srgb, var(--color-accent) 10%, transparent); color: var(--color-accent)">تمييز</span>
            </div>
        </section>

    </div>
</div>
