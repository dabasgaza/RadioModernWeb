@{
    ViewData["Title"] = "دليل التصميم";
    ViewData["HeaderIcon"] = "palette";
    ViewData["HeaderDescription"] = "جميع مكونات واجهة المستخدم الموحدة للنظام";
    Layout = "_Layout";
}
<div class="max-w-5xl mx-auto">
    <partial name="_PageHeader" />

    <div class="grid grid-cols-1 gap-8">

        @* ── Colors ── *@
        <section class="card p-6" aria-label="الألوان">
            @{
                ViewBag.SectionIcon = "circles";
                ViewBag.SectionTitle = "الألوان — Colors";
                ViewBag.SectionSubtitle = "البالتات اللونية الأساسية المستخدمة في النظام";
                ViewBag.SectionAction = null;
            }
            <partial name="_SectionHeader" />
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div class="space-y-2">
                    <div class="h-12 rounded-lg bg-primary"></div>
                    <div class="text-caption font-mono text-text-secondary">bg-primary</div>
                    <div class="text-micro text-text-muted">إجراء/تنقل</div>
                </div>
                <div class="space-y-2">
                    <div class="h-12 rounded-lg bg-success"></div>
                    <div class="text-caption font-mono text-text-secondary">bg-success</div>
                    <div class="text-micro text-text-muted">نجاح</div>
                </div>
                <div class="space-y-2">
                    <div class="h-12 rounded-lg bg-warning"></div>
                    <div class="text-caption font-mono text-text-secondary">bg-warning</div>
                    <div class="text-micro text-text-muted">تحذير</div>
                </div>
                <div class="space-y-2">
                    <div class="h-12 rounded-lg bg-danger"></div>
                    <div class="text-caption font-mono text-text-secondary">bg-danger</div>
                    <div class="text-micro text-text-muted">خطأ</div>
                </div>
            </div>
        </section>

        @* ── Status Badges ── *@
        <section class="card p-6" aria-label="شارات الحالة">
            @{
                ViewBag.SectionIcon = "rounded_corner";
                ViewBag.SectionTitle = "شارات الحالة — Status Badges";
                ViewBag.SectionSubtitle = "نماذج شارات حالة الحلقات والتنفيذ";
                ViewBag.SectionAction = null;
            }
            <partial name="_SectionHeader" />
            <div class="flex flex-wrap gap-3">
                @foreach (var s in new[] {
                    ("planned", "مجدولة", "event_note"),
                    ("executed", "منفّذة", "check_circle"),
                    ("published", "منشورة", "rss_feed"),
                    ("website-published", "منشورة على الموقع", "public"),
                    ("cancelled", "ملغاة", "cancel")
                })
                {
                    <partial name="_StatusBadge" model='new StatusBadgeViewModel { Type = "episode", Status = s.Item1, Label = s.Item2 }' />
                }
            </div>
            <div class="flex flex-wrap gap-3 mt-3">
                @foreach (var s in new[] {
                    ("pending", "بانتظار التنفيذ", "schedule"),
                    ("in-progress", "قيد التنفيذ", "pending"),
                    ("completed", "تم التنفيذ", "check_circle"),
                    ("failed", "فشل", "error")
                })
                {
                    <partial name="_StatusBadge" model='new StatusBadgeViewModel { Type = "execution", Status = s.Item1, Label = s.Item2 }' />
                }
            </div>
        </section>

        @* ── Buttons ── *@
        <section class="card p-6" aria-label="الأزرار">
            @{
                ViewBag.SectionIcon = "smart_button";
                ViewBag.SectionTitle = "الأزرار — Buttons";
                ViewBag.SectionSubtitle = "جميع أنواع الأزرار المتوفرة مع حالات التفاعل";
                ViewBag.SectionAction = null;
            }
            <partial name="_SectionHeader" />
            <div class="flex flex-wrap gap-3 items-center">
                <button class="btn btn-primary">زر رئيسي</button>
                <button class="btn btn-secondary">زر ثانوي</button>
                <button class="btn btn-outline">زر حدودي</button>
                <button class="btn btn-ghost">زر شفاف</button>
                <button class="btn btn-success">نجاح</button>
                <button class="btn btn-warning">تحذير</button>
                <button class="btn btn-destructive">حذف</button>
            </div>
            <div class="flex flex-wrap gap-3 mt-3 items-center">
                <button class="btn btn-primary" disabled aria-disabled="true">معطل</button>
                <button class="btn btn-primary btn-loading">جارٍ التحميل</button>
                <button class="btn btn-ghost">
                    <span class="material-symbols-rounded text-sm" aria-hidden="true">add</span>
                    مع أيقونة
                </button>
                <button class="btn btn-primary btn-sm">صغير</button>
                <button class="btn btn-primary btn-lg">كبير</button>
            </div>
        </section>

        @* ── Form Elements ── *@
        <section class="card p-6" aria-label="عناصر النماذج">
            @{
                ViewBag.SectionIcon = "view_quilt";
                ViewBag.SectionTitle = "عناصر النماذج — Form Elements";
                ViewBag.SectionSubtitle = "الحقول والقوائم والمفاتيح";
                ViewBag.SectionAction = null;
            }
            <partial name="_SectionHeader" />
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="label text-text-secondary block mb-1">حقل نصي</label>
                    <input type="text" class="input" placeholder="نص تجريبي..." />
                </div>
                <div>
                    <label class="label text-text-secondary block mb-1">قائمة منسدلة</label>
                    <select class="input">
                        <option>خيار 1</option>
                        <option>خيار 2</option>
                    </select>
                </div>
                <div>
                    <label class="label text-text-secondary block mb-1">مفتاح تبديل</label>
                    <label class="inline-flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" class="toggle" checked />
                        <span class="text-caption text-text-muted">مفعل</span>
                    </label>
                </div>
                <div class="flex items-center gap-2">
                    <input type="checkbox" class="w-4 h-4 accent-primary" id="chk1" />
                    <label for="chk1" class="text-text-secondary">خيار محدد</label>
                </div>
            </div>
        </section>

        @* ── Cards ── *@
        <section class="card p-6" aria-label="البطاقات">
            @{
                ViewBag.SectionIcon = "dashboard";
                ViewBag.SectionTitle = "البطاقات — Cards";
                ViewBag.SectionSubtitle = "أنماط البطاقات المختلفة للبيانات والإحصائيات";
                ViewBag.SectionAction = null;
            }
            <partial name="_SectionHeader" />
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="card p-4">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-primary-subtle flex items-center justify-center">
                            <span class="material-symbols-rounded text-primary" aria-hidden="true">bar_chart</span>
                        </div>
                        <div>
                            <div class="text-caption text-text-secondary">بطاقة إحصائية</div>
                            <div class="text-title font-bold text-text">1,234</div>
                        </div>
                    </div>
                </div>
                <div class="card p-6">
                    <div class="flex items-center justify-between">
                        <div>
                            <div class="text-body font-bold text-text">567</div>
                            <div class="text-caption text-text-muted">تم بنجاح</div>
                        </div>
                        <div class="w-10 h-10 rounded-xl bg-success-subtle text-success flex items-center justify-center">
                            <span class="material-symbols-rounded" aria-hidden="true">check_circle</span>
                        </div>
                    </div>
                </div>
                <div class="card p-4 flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-warning-subtle text-warning flex items-center justify-center">
                        <span class="material-symbols-rounded" aria-hidden="true">warning</span>
                    </div>
                    <div class="text-label font-bold text-text">بطاقة مدمجة</div>
                </div>
            </div>
        </section>

        @* ── Badges ── *@
        <section class="card p-6" aria-label="الشارات">
            @{
                ViewBag.SectionIcon = "label";
                ViewBag.SectionTitle = "الشارات — Badges";
                ViewBag.SectionSubtitle = "الشارات الملونة للحالات المختلفة";
                ViewBag.SectionAction = null;
            }
            <partial name="_SectionHeader" />
            <div class="flex flex-wrap gap-2">
                <span class="badge badge-primary">رئيسي</span>
                <span class="badge badge-success">نجاح</span>
                <span class="badge badge-warning">تحذير</span>
                <span class="badge badge-danger">خطأ</span>
                <span class="badge badge-info">معلومات</span>
                <span class="badge badge-accent">تمييز</span>
                <span class="badge badge-outline">حدودي</span>
            </div>
        </section>

    </div>
</div>
