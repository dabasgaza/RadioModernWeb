@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "الوصول مرفوض";
}

<div class="flex items-center justify-center min-h-screen">
    <div class="wf-card text-center p-10 max-w-sm">
        <div class="w-16 h-16 bg-[var(--color-danger-light)] rounded-full flex items-center justify-center mx-auto mb-5">
            <span class="material-symbols-rounded text-3xl text-[var(--color-danger)]">lock</span>
        </div>
        <h2 class="text-xl font-bold text-[var(--color-text)] mb-2">الوصول مرفوض</h2>
        <p class="text-sm text-[var(--color-text-4)] mb-6">عذراً، لا تملك صلاحية الوصول إلى هذه الصفحة. تواصل مع مسؤول النظام إذا كنت تعتقد أن هذا خطأ.</p>
        <a href="/" class="inline-flex items-center gap-2 px-5 py-2.5 bg-primary text-primary-foreground text-sm font-semibold rounded-lg hover:bg-[var(--color-primary-hover)] transition-colors shadow-sm">
            <span class="material-symbols-rounded text-lg">home</span>
            العودة للرئيسية
        </a>
    </div>
</div>
