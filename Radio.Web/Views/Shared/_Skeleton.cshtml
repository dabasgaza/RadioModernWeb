@model dynamic
@{
    string type = Model?.Type ?? "card";
    int count = Model?.Count ?? 1;
    var lineWidths = new[] { "40%", "60%", "75%", "50%", "30%" };
}

@if (type == "card")
{
    @for (int i = 0; i < count; i++)
    {
        <div class="rounded-xl border p-5 animate-pulse" style="background:var(--color-surface);border-color:var(--color-border)">
            <div class="flex items-start justify-between gap-3">
                <div class="flex-1 space-y-3">
                    <div class="h-3 rounded w-1/3" style="background:var(--color-bg-hover-high)"></div>
                    <div class="h-8 rounded w-1/2" style="background:var(--color-bg-hover-high)"></div>
                    <div class="h-3 rounded w-2/3" style="background:var(--color-bg-hover-high)"></div>
                </div>
                <div class="w-11 h-11 rounded-xl shrink-0" style="background:var(--color-bg-hover-high)"></div>
            </div>
        </div>
    }
}
else if (type == "table-row")
{
    @for (int i = 0; i < count; i++)
    {
        <div class="flex items-center gap-4 p-4 animate-pulse" style="border-bottom:1px solid var(--color-border)">
            <div class="w-10 h-10 rounded-lg shrink-0" style="background:var(--color-bg-hover-high)"></div>
            <div class="flex-1 space-y-2">
                <div class="h-3 rounded w-1/3" style="background:var(--color-bg-hover-high)"></div>
                <div class="h-3 rounded w-1/2" style="background:var(--color-bg-hover-high)"></div>
            </div>
            <div class="h-6 rounded-full w-16" style="background:var(--color-bg-hover-high)"></div>
        </div>
    }
}
else if (type == "line")
{
    @for (int i = 0; i < count; i++)
    {
        <div class="h-3 rounded mb-3 animate-pulse" style="background:var(--color-bg-hover-high);width:@lineWidths[i % lineWidths.Length]"></div>
    }
}
else if (type == "avatar")
{
    <div class="flex items-center gap-3 animate-pulse">
        <div class="w-10 h-10 rounded-full shrink-0" style="background:var(--color-bg-hover-high)"></div>
        <div class="space-y-2 flex-1">
            <div class="h-3 rounded w-1/3" style="background:var(--color-bg-hover-high)"></div>
            <div class="h-3 rounded w-1/2" style="background:var(--color-bg-hover-high)"></div>
        </div>
    </div>
}
