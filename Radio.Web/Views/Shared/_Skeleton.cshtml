@{
    var type = ViewBag.SkeletonType ?? "card";
    var count = ViewBag.SkeletonCount ?? 1;
    var lineWidths = new[] { "75%", "55%", "85%", "45%", "65%" };
}

@switch (type)
{
    case "card":
        for (int i = 0; i < (int)count; i++)
        {
            <div class="card border-border overflow-hidden">
                <div class="p-5 space-y-4">
                    <div class="skeleton h-3 rounded w-1/3"></div>
                    <div class="skeleton h-8 rounded w-1/2"></div>
                    <div class="skeleton h-3 rounded w-2/3"></div>
                </div>
                <div class="skeleton w-11 h-11 rounded-xl shrink-0"></div>
            </div>
        }
        break;
    case "table-row":
        for (int i = 0; i < (int)count; i++)
        {
            <div class="flex items-center gap-3 p-4 border-b border-border-light">
                <div class="skeleton w-10 h-10 rounded-lg shrink-0"></div>
                <div class="flex-1 space-y-2">
                    <div class="skeleton h-3 rounded w-1/3"></div>
                    <div class="skeleton h-3 rounded w-1/2"></div>
                </div>
                <div class="skeleton h-6 rounded-full w-16"></div>
            </div>
        }
        break;
    case "line":
        for (int i = 0; i < (int)count; i++)
        {
            <div class="skeleton h-3 rounded mb-3" style="width:@lineWidths[i % lineWidths.Length]"></div>
        }
        break;
    case "avatar":
        for (int i = 0; i < (int)count; i++)
        {
            <div class="flex items-center gap-3">
                <div class="skeleton w-10 h-10 rounded-full shrink-0"></div>
                <div class="flex-1 space-y-2">
                    <div class="skeleton h-3 rounded w-1/3"></div>
                    <div class="skeleton h-3 rounded w-1/2"></div>
                </div>
            </div>
        }
        break;
}
