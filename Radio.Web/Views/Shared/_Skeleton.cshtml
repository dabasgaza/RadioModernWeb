@{
    var type = ViewBag.SkeletonType ?? "card";
    var count = ViewBag.SkeletonCount ?? 1;
    var lineWidths = new[] { "75%", "55%", "85%", "45%", "65%" };
}

@switch (type)
{
    case "card":
        for (int i = 0; i < (int)count; i++)
        {
            <div class="rounded-xl border border-border overflow-hidden animate-pulse" style="background:var(--color-surface)">
                <div class="p-5 space-y-4">
                    <div class="h-3 rounded w-1/3" style="background:var(--color-bg-hover)"></div>
                    <div class="h-8 rounded w-1/2" style="background:var(--color-bg-hover)"></div>
                    <div class="h-3 rounded w-2/3" style="background:var(--color-bg-hover)"></div>
                </div>
                <div class="w-11 h-11 rounded-xl shrink-0" style="background:var(--color-bg-hover)"></div>
            </div>
        }
        break;
    case "table-row":
        for (int i = 0; i < (int)count; i++)
        {
            <div class="flex items-center gap-3 p-4 animate-pulse" style="border-bottom:1px solid var(--color-border)">
                <div class="w-10 h-10 rounded-lg shrink-0" style="background:var(--color-bg-hover)"></div>
                <div class="flex-1 space-y-2">
                    <div class="h-3 rounded w-1/3" style="background:var(--color-bg-hover)"></div>
                    <div class="h-3 rounded w-1/2" style="background:var(--color-bg-hover)"></div>
                </div>
                <div class="h-6 rounded-full w-16" style="background:var(--color-bg-hover)"></div>
            </div>
        }
        break;
    case "line":
        for (int i = 0; i < (int)count; i++)
        {
            <div class="h-3 rounded mb-3 animate-pulse" style="background:var(--color-bg-hover);width:@lineWidths[i % lineWidths.Length]"></div>
        }
        break;
    case "avatar":
        for (int i = 0; i < (int)count; i++)
        {
            <div class="flex items-center gap-3 animate-pulse">
                <div class="w-10 h-10 rounded-full shrink-0" style="background:var(--color-bg-hover)"></div>
                <div class="flex-1 space-y-2">
                    <div class="h-3 rounded w-1/3" style="background:var(--color-bg-hover)"></div>
                    <div class="h-3 rounded w-1/2" style="background:var(--color-bg-hover)"></div>
                </div>
            </div>
        }
        break;
}
