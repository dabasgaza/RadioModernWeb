@{
    string icon = ViewBag.EmptyIcon ?? "inbox";
    string title = ViewBag.EmptyTitle ?? "لا توجد نتائج";
    string description = ViewBag.EmptyDesc ?? "";
    string? actionUrl = ViewBag.EmptyActionUrl;
    string? actionText = ViewBag.EmptyActionText;
    string? actionIcon = ViewBag.EmptyActionIcon ?? "add";
    string? secondaryUrl = ViewBag.EmptySecondaryUrl;
    string? secondaryText = ViewBag.EmptySecondaryText;
}

<div class="empty-state">
    <div class="empty-state-icon">
        <span class="material-symbols-rounded">@icon</span>
    </div>
    <h3 class="empty-state-title">@title</h3>
    @if (!string.IsNullOrEmpty(description))
    {
        <p class="empty-state-desc">@description</p>
    }
    <div class="empty-state-actions">
        @if (!string.IsNullOrEmpty(actionUrl) && !string.IsNullOrEmpty(actionText))
        {
            <a href="@actionUrl" class="btn btn-primary">
                <span class="material-symbols-rounded text-lg">@actionIcon</span>
                @actionText
            </a>
        }
        @if (!string.IsNullOrEmpty(secondaryUrl) && !string.IsNullOrEmpty(secondaryText))
        {
            <a href="@secondaryUrl" class="btn btn-ghost">
                @secondaryText
            </a>
        }
    </div>
</div>
