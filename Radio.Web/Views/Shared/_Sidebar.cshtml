@using DataAccess.Common
@inject ICurrentUserService CurrentUser
@{
    var controller = ViewContext.RouteData.Values["Controller"]?.ToString();
    var action = ViewContext.RouteData.Values["Action"]?.ToString();
    bool IsActive(string c, string? a = null) => controller == c && (a == null || action == a);
    bool HasAny(params string[] perms) => perms.Any(p => CurrentUser.HasPermission(p));
}
<div class="flex items-center justify-between h-16 px-4 border-b border-border bg-surface shrink-0">
    <a href="/" class="flex items-center gap-2">
        <span class="flex items-center justify-center w-9 h-9 rounded-xl bg-signal/10 text-signal">
            <span class="material-symbols-rounded text-2xl">radio</span>
        </span>
        <span class="font-bold text-lg text-ink">نظام البث</span>
    </a>
    <span class="wf-onair" title="مباشر" aria-label="النظام على الهواء"></span>
</div>
<ul class="menu menu-md p-3 gap-0.5 overflow-y-auto flex-1 bg-surface flex-nowrap">
    <li><a href="/" class="@(IsActive("Home") ? "active" : "")">
        <span class="material-symbols-rounded">dashboard</span>لوحة التحكم
    </a></li>
    <li><a href="/Search" class="@(IsActive("Search") ? "active" : "")">
        <span class="material-symbols-rounded">search</span>بحث عام
    </a></li>
    <li><a href="/Calendar" class="@(IsActive("Calendar") ? "active" : "")">
        <span class="material-symbols-rounded">calendar_month</span>التقويم الشهري
    </a></li>

    @if (HasAny(AppPermissions.EpisodesView, AppPermissions.EpisodesCreate, AppPermissions.EpisodesEdit, AppPermissions.ExecutionExecute))
    {
        <li><a href="/Episodes" class="@(IsActive("Episodes", "Index") ? "active" : "")">
            <span class="material-symbols-rounded">podcasts</span>الحلقات
        </a></li>
        <li><a href="/Episodes/LiveBoard" class="@(IsActive("Episodes", "LiveBoard") ? "active" : "")">
            <span class="material-symbols-rounded">tv</span>شاشة العرض المباشر
        </a></li>
        <li><a href="/Production" class="@(IsActive("Production") ? "active" : "")">
            <span class="material-symbols-rounded">view_column</span>لوحة الإنتاج
        </a></li>
    }

    @if (HasAny(AppPermissions.ProgramsView, AppPermissions.ProgramsManage))
    {
        <li><a href="/Programs" class="@(IsActive("Programs") ? "active" : "")">
            <span class="material-symbols-rounded">radio</span>البرامج
        </a></li>
    }

    @if (HasAny(AppPermissions.GuestsView, AppPermissions.GuestsManage))
    {
        <li><a href="/Guests" class="@(IsActive("Guests") ? "active" : "")">
            <span class="material-symbols-rounded">people_alt</span>الضيوف
        </a></li>
    }

    @if (HasAny(AppPermissions.CoordinationView, AppPermissions.CoordinationManage))
    {
        <li><a href="/Correspondents" class="@(IsActive("Correspondents") ? "active" : "")">
            <span class="material-symbols-rounded">map</span>المراسلون
        </a></li>
        <li><a href="/Coverage" class="@(IsActive("Coverage") ? "active" : "")">
            <span class="material-symbols-rounded">edit_location_alt</span>التغطيات الميدانية
        </a></li>
    }

    @if (HasAny(AppPermissions.StaffView, AppPermissions.StaffManage))
    {
        <li>
            <details @(IsActive("Employees") || IsActive("StaffRoles") ? "open" : "")>
                <summary><span class="material-symbols-rounded">badge</span>طاقم العمل</summary>
                <ul>
                    <li><a href="/Employees" class="@(IsActive("Employees") ? "active" : "")">الموظفون</a></li>
                    <li><a href="/StaffRoles" class="@(IsActive("StaffRoles") ? "active" : "")">المسميات الوظيفية</a></li>
                </ul>
            </details>
        </li>
        <li><a href="/SocialPlatforms" class="@(IsActive("SocialPlatforms") ? "active" : "")">
            <span class="material-symbols-rounded">share</span>منصات النشر
        </a></li>
    }

    @if (HasAny(AppPermissions.SocialPublishingView, AppPermissions.WebsitePublishingView, AppPermissions.ExecutionView, AppPermissions.SocialPublishingPublish, AppPermissions.WebsitePublishingPublish, AppPermissions.ExecutionExecute))
    {
        <li>
            <details @(IsActive("Publishing") || IsActive("WebsitePublishing") || IsActive("ExecutionLogs") ? "open" : "")>
                <summary><span class="material-symbols-rounded">publish</span>النشر الرقمي</summary>
                <ul>
                    @if (HasAny(AppPermissions.SocialPublishingPublish, AppPermissions.SocialPublishingView))
                    {
                        <li><a href="/Publishing" class="@(IsActive("Publishing") ? "active" : "")">النشر الاجتماعي</a></li>
                    }
                    @if (HasAny(AppPermissions.WebsitePublishingPublish, AppPermissions.WebsitePublishingView))
                    {
                        <li><a href="/WebsitePublishing" class="@(IsActive("WebsitePublishing") ? "active" : "")">نشر الموقع</a></li>
                    }
                    @if (HasAny(AppPermissions.ExecutionExecute, AppPermissions.ExecutionView))
                    {
                        <li><a href="/ExecutionLogs" class="@(IsActive("ExecutionLogs") ? "active" : "")">سجلات التنفيذ</a></li>
                    }
                </ul>
            </details>
        </li>
    }

    @if (CurrentUser.HasPermission(AppPermissions.ReportsView))
    {
        <li><a href="/Reports" class="@(IsActive("Reports") ? "active" : "")">
            <span class="material-symbols-rounded">assessment</span>التقارير
        </a></li>
    }

    @if (HasAny(AppPermissions.AdminUsersManage, AppPermissions.AdminRolesManage))
    {
        <li>
            <details @(IsActive("Users") || IsActive("Roles") || IsActive("Permissions") || IsActive("AuditLogs") || IsActive("Database") || IsActive("Diagnostics") || IsActive("Settings") ? "open" : "")>
                <summary><span class="material-symbols-rounded">admin_panel_settings</span>إدارة النظام</summary>
                <ul>
                    <li><a href="/Users" class="@(IsActive("Users") ? "active" : "")">المستخدمون</a></li>
                    <li><a href="/Roles" class="@(IsActive("Roles") ? "active" : "")">الأدوار</a></li>
                    <li><a href="/Permissions" class="@(IsActive("Permissions") ? "active" : "")">الصلاحيات</a></li>
                    @if (CurrentUser.HasPermission(AppPermissions.SystemViewAuditLogs))
                    {
                        <li><a href="/AuditLogs" class="@(IsActive("AuditLogs") ? "active" : "")">سجل التدقيق</a></li>
                    }
                    @if (CurrentUser.HasPermission(AppPermissions.SystemDatabaseManage))
                    {
                        <li><a href="/Database" class="@(IsActive("Database") ? "active" : "")">
                            <span class="material-symbols-rounded text-sm">storage</span>قاعدة البيانات
                        </a></li>
                        <li><a href="/Diagnostics" class="@(IsActive("Diagnostics") ? "active" : "")">
                            <span class="material-symbols-rounded text-sm">monitor_heart</span>تشخيص النظام
                        </a></li>
                    }
                    <li><a href="/Settings" class="@(IsActive("Settings") ? "active" : "")">
                        <span class="material-symbols-rounded text-sm">settings</span>الإعدادات
                    </a></li>
                </ul>
            </details>
        </li>
    }
</ul>
