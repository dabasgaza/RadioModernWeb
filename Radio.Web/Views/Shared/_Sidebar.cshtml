@using DataAccess.Common
@inject ICurrentUserService CurrentUser
@using Microsoft.AspNetCore.Mvc.Rendering
@using Microsoft.AspNetCore.Html
@{
    var controller = ViewContext.RouteData.Values["Controller"]?.ToString();
    var action = ViewContext.RouteData.Values["Action"]?.ToString();
    bool IsActive(string c, string? a = null) => controller == c && (a == null || action == a);
    bool HasAny(params string[] perms) => perms.Any(p => CurrentUser.HasPermission(p));
    Func<bool, string> NavLinkClass = (active) => active ? "sidebar-link active" : "sidebar-link";
}
<div class="flex flex-col h-full select-none w-full min-w-0">
    <!-- Brand Header -->
    <a href="/" class="flex items-center gap-3 h-16 px-4 shrink-0 border-b border-border bg-surface transition-colors hover:bg-surface-hover min-w-0">
        <div class="flex items-center justify-center w-10 h-10 rounded-xl bg-primary text-primary-foreground font-bold shadow-sm shrink-0">
            <span class="material-symbols-rounded text-xl">live_tv</span>
        </div>
        <div class="flex flex-col min-w-0 flex-1">
            <span class="font-extrabold text-sm tracking-tight text-text truncate">نظام إدارة البث الإذاعي</span>
            <span class="text-[11px] font-medium text-accent truncate">برامج — حلقات — بث مباشر</span>
        </div>
    </a>

    <!-- On Air Now Card -->
    <div class="mx-3 mt-3 p-3 rounded-xl border transition-all duration-300 shrink-0 bg-live-subtle border-live-border min-w-0" id="sidebar-onair-card">
        <div class="flex items-center gap-3 min-w-0">
            <span class="relative flex h-3 w-3 shrink-0" id="sidebar-onair-badge">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-live opacity-75"></span>
                <span class="relative inline-flex rounded-full h-3 w-3 bg-live"></span>
            </span>
            <div class="flex-1 min-w-0">
                <div class="text-caption font-bold text-live truncate" id="sidebar-onair-status">على الهواء الآن</div>
                <div class="text-micro text-live truncate font-medium mt-0.5" id="sidebar-onair-name">—</div>
            </div>
        </div>
    </div>

    <!-- Scrollable Nav List -->
    <nav class="flex-1 overflow-y-auto p-3 space-y-1 min-w-0" aria-label="التنقل الرئيسي">
        @* ── القائمة الأساسية الثابتة ── *@
        <a href="/" class="@NavLinkClass(IsActive("Home"))">
            <span class="material-symbols-rounded shrink-0">dashboard</span>
            <span class="truncate">لوحة التحكم الرئيسية</span>
        </a>
        <a href="/Search" class="@NavLinkClass(IsActive("Search"))">
            <span class="material-symbols-rounded shrink-0">search</span>
            <span class="truncate">البحث العام</span>
        </a>
        <a href="/Calendar" class="@NavLinkClass(IsActive("Calendar"))">
            <span class="material-symbols-rounded shrink-0">calendar_month</span>
            <span class="truncate">جدول البث والإعادة</span>
        </a>

        @* ── المجموعة 1: البث والإنتاج ── *@
        @if (HasAny(AppPermissions.EpisodesView, AppPermissions.EpisodesCreate, AppPermissions.EpisodesEdit, AppPermissions.ExecutionExecute))
        {
            var isBroadcastActive = IsActive("Episodes") || IsActive("Production");
            <button type="button" class="sidebar-group-toggle" data-sidebar-toggle="group-broadcast" aria-expanded="@(isBroadcastActive ? "true" : "false")" aria-controls="sidebar-group-broadcast">
                <span class="flex items-center gap-2 min-w-0 truncate">
                    <span class="material-symbols-rounded text-base text-primary shrink-0">live_tv</span>
                    <span class="truncate">البث والإنتاج</span>
                </span>
                <span class="material-symbols-rounded sidebar-group-chevron shrink-0">expand_more</span>
            </button>
            <div id="sidebar-group-broadcast" data-sidebar-content="group-broadcast" class="sidebar-group-content @(isBroadcastActive ? "" : "hidden")">
                <a href="/Episodes/LiveBoard" class="@NavLinkClass(IsActive("Episodes", "LiveBoard"))">
                    <span class="material-symbols-rounded text-live shrink-0">live_tv</span>
                    <span class="truncate">شاشة البث المباشر</span>
                </a>
                <a href="/Episodes" class="@NavLinkClass(IsActive("Episodes", "Index"))">
                    <span class="material-symbols-rounded shrink-0">tv</span>
                    <span class="truncate">سجل الحلقات</span>
                </a>
                <a href="/Production" class="@NavLinkClass(IsActive("Production"))">
                    <span class="material-symbols-rounded shrink-0">view_column</span>
                    <span class="truncate">لوحة سير الإنتاج</span>
                </a>
            </div>
        }

        @* ── المجموعة 2: البرامج والمحتوى ── *@
        @if (HasAny(AppPermissions.ProgramsView, AppPermissions.ProgramsManage, AppPermissions.GuestsView, AppPermissions.GuestsManage, AppPermissions.CoordinationView, AppPermissions.CoordinationManage))
        {
            var isContentActive = IsActive("Programs") || IsActive("Guests") || IsActive("Correspondents") || IsActive("Coverage");
            <button type="button" class="sidebar-group-toggle" data-sidebar-toggle="group-content" aria-expanded="@(isContentActive ? "true" : "false")" aria-controls="sidebar-group-content">
                <span class="flex items-center gap-2 min-w-0 truncate">
                    <span class="material-symbols-rounded text-base text-accent shrink-0">radio</span>
                    <span class="truncate">البرامج والمحتوى</span>
                </span>
                <span class="material-symbols-rounded sidebar-group-chevron shrink-0">expand_more</span>
            </button>
            <div id="sidebar-group-content" data-sidebar-content="group-content" class="sidebar-group-content @(isContentActive ? "" : "hidden")">
                @if (HasAny(AppPermissions.ProgramsView, AppPermissions.ProgramsManage))
                {
                    <a href="/Programs" class="@NavLinkClass(IsActive("Programs"))">
                        <span class="material-symbols-rounded shrink-0">radio</span>
                        <span class="truncate">دليل البرامج</span>
                    </a>
                }
                @if (HasAny(AppPermissions.GuestsView, AppPermissions.GuestsManage))
                {
                    <a href="/Guests" class="@NavLinkClass(IsActive("Guests"))">
                        <span class="material-symbols-rounded shrink-0">people_alt</span>
                        <span class="truncate">سجل الضيوف</span>
                    </a>
                }
                @if (HasAny(AppPermissions.CoordinationView, AppPermissions.CoordinationManage))
                {
                    <a href="/Correspondents" class="@NavLinkClass(IsActive("Correspondents"))">
                        <span class="material-symbols-rounded shrink-0">map</span>
                        <span class="truncate">المراسلون الميدانيون</span>
                    </a>
                    <a href="/Coverage" class="@NavLinkClass(IsActive("Coverage"))">
                        <span class="material-symbols-rounded shrink-0">edit_location_alt</span>
                        <span class="truncate">التغطيات الميدانية</span>
                    </a>
                }
            </div>
        }

        @* ── المجموعة 3: النشر والتوزيع ── *@
        @if (HasAny(AppPermissions.SocialPublishingPublish, AppPermissions.SocialPublishingView, AppPermissions.WebsitePublishingPublish, AppPermissions.WebsitePublishingView, AppPermissions.ExecutionExecute, AppPermissions.ExecutionView))
        {
            var isPublishingActive = IsActive("Publishing") || IsActive("WebsitePublishing") || IsActive("ExecutionLogs");
            <button type="button" class="sidebar-group-toggle" data-sidebar-toggle="group-publishing" aria-expanded="@(isPublishingActive ? "true" : "false")" aria-controls="sidebar-group-publishing">
                <span class="flex items-center gap-2 min-w-0 truncate">
                    <span class="material-symbols-rounded text-base text-success shrink-0">rss_feed</span>
                    <span class="truncate">النشر والتوزيع</span>
                </span>
                <span class="material-symbols-rounded sidebar-group-chevron shrink-0">expand_more</span>
            </button>
            <div id="sidebar-group-publishing" data-sidebar-content="group-publishing" class="sidebar-group-content @(isPublishingActive ? "" : "hidden")">
                @if (HasAny(AppPermissions.SocialPublishingPublish, AppPermissions.SocialPublishingView))
                {
                    <a href="/Publishing" class="@NavLinkClass(IsActive("Publishing"))">
                        <span class="material-symbols-rounded shrink-0">rss_feed</span>
                        <span class="truncate">سجل النشر الرقمي</span>
                    </a>
                }
                @if (HasAny(AppPermissions.WebsitePublishingPublish, AppPermissions.WebsitePublishingView))
                {
                    <a href="/WebsitePublishing" class="@NavLinkClass(IsActive("WebsitePublishing"))">
                        <span class="material-symbols-rounded shrink-0">public</span>
                        <span class="truncate">نشر البوابة الرقمية</span>
                    </a>
                }
                @if (HasAny(AppPermissions.ExecutionExecute, AppPermissions.ExecutionView))
                {
                    <a href="/ExecutionLogs" class="@NavLinkClass(IsActive("ExecutionLogs"))">
                        <span class="material-symbols-rounded shrink-0">assignment</span>
                        <span class="truncate">سجلات التنفيذ والإعادة</span>
                    </a>
                }
            </div>
        }

        @* ── المجموعة 4: التقارير والتحليلات ── *@
        @if (CurrentUser.HasPermission(AppPermissions.ReportsView))
        {
            var isReportsActive = IsActive("Reports");
            <button type="button" class="sidebar-group-toggle" data-sidebar-toggle="group-reports" aria-expanded="@(isReportsActive ? "true" : "false")" aria-controls="sidebar-group-reports">
                <span class="flex items-center gap-2 min-w-0 truncate">
                    <span class="material-symbols-rounded text-base text-info shrink-0">assessment</span>
                    <span class="truncate">التقارير والإحصائيات</span>
                </span>
                <span class="material-symbols-rounded sidebar-group-chevron shrink-0">expand_more</span>
            </button>
            <div id="sidebar-group-reports" data-sidebar-content="group-reports" class="sidebar-group-content @(isReportsActive ? "" : "hidden")">
                <a href="/Reports" class="@NavLinkClass(IsActive("Reports"))">
                    <span class="material-symbols-rounded shrink-0">assessment</span>
                    <span class="truncate">تقارير الإنتاج والأداء</span>
                </a>
            </div>
        }

        @* ── المجموعة 5: الإدارة والكوادر ── *@
        @if (HasAny(AppPermissions.StaffView, AppPermissions.StaffManage, AppPermissions.AdminUsersManage, AppPermissions.AdminRolesManage, AppPermissions.SystemViewAuditLogs, AppPermissions.SystemDatabaseManage))
        {
            var isAdminActive = IsActive("Employees") || IsActive("StaffRoles") || IsActive("SocialPlatforms") || IsActive("Users") || IsActive("Roles") || IsActive("Permissions") || IsActive("AuditLogs") || IsActive("Database") || IsActive("Diagnostics") || IsActive("Settings");
            <button type="button" class="sidebar-group-toggle" data-sidebar-toggle="group-admin" aria-expanded="@(isAdminActive ? "true" : "false")" aria-controls="sidebar-group-admin">
                <span class="flex items-center gap-2 min-w-0 truncate">
                    <span class="material-symbols-rounded text-base text-primary shrink-0">admin_panel_settings</span>
                    <span class="truncate">الإدارة والكوادر</span>
                </span>
                <span class="material-symbols-rounded sidebar-group-chevron shrink-0">expand_more</span>
            </button>
            <div id="sidebar-group-admin" data-sidebar-content="group-admin" class="sidebar-group-content @(isAdminActive ? "" : "hidden")">
                @if (HasAny(AppPermissions.StaffView, AppPermissions.StaffManage))
                {
                    <a href="/Employees" class="@NavLinkClass(IsActive("Employees"))">
                        <span class="material-symbols-rounded shrink-0">badge</span>
                        <span class="truncate">الموظفون والكادر</span>
                    </a>
                    <a href="/StaffRoles" class="@NavLinkClass(IsActive("StaffRoles"))">
                        <span class="material-symbols-rounded shrink-0">work_history</span>
                        <span class="truncate">المسميات الوظيفية</span>
                    </a>
                    <a href="/SocialPlatforms" class="@NavLinkClass(IsActive("SocialPlatforms"))">
                        <span class="material-symbols-rounded shrink-0">share</span>
                        <span class="truncate">منصات النشر الرقمي</span>
                    </a>
                }
                @if (HasAny(AppPermissions.AdminUsersManage, AppPermissions.AdminRolesManage))
                {
                    <a href="/Users" class="@NavLinkClass(IsActive("Users"))">
                        <span class="material-symbols-rounded shrink-0">group</span>
                        <span class="truncate">المستخدمون</span>
                    </a>
                    <a href="/Roles" class="@NavLinkClass(IsActive("Roles"))">
                        <span class="material-symbols-rounded shrink-0">group_work</span>
                        <span class="truncate">الأدوار والصلاحيات</span>
                    </a>
                    <a href="/Permissions" class="@NavLinkClass(IsActive("Permissions"))">
                        <span class="material-symbols-rounded shrink-0">admin_panel_settings</span>
                        <span class="truncate">جدول الصلاحيات</span>
                    </a>
                }
                @if (CurrentUser.HasPermission(AppPermissions.SystemViewAuditLogs))
                {
                    <a href="/AuditLogs" class="@NavLinkClass(IsActive("AuditLogs"))">
                        <span class="material-symbols-rounded shrink-0">history</span>
                        <span class="truncate">سجل التدقيق</span>
                    </a>
                }
                @if (CurrentUser.HasPermission(AppPermissions.SystemDatabaseManage))
                {
                    <a href="/Database" class="@NavLinkClass(IsActive("Database"))">
                        <span class="material-symbols-rounded shrink-0">storage</span>
                        <span class="truncate">إدارة قاعدة البيانات</span>
                    </a>
                    <a href="/Diagnostics" class="@NavLinkClass(IsActive("Diagnostics"))">
                        <span class="material-symbols-rounded shrink-0">monitor_heart</span>
                        <span class="truncate">تشخيص النظام</span>
                    </a>
                }
                <a href="/Settings" class="@NavLinkClass(IsActive("Settings"))">
                    <span class="material-symbols-rounded shrink-0">settings</span>
                    <span class="truncate">إعدادات النظام</span>
                </a>
            </div>
        }
    </nav>
</div>

<script>
    (function() {
        const STORAGE_KEY = 'radio_sidebar_collapsed_groups';

        function getSavedState() {
            try { return JSON.parse(localStorage.getItem(STORAGE_KEY)) || {}; }
            catch(e) { return {}; }
        }

        function saveState(state) {
            try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); }
            catch(e) {}
        }

        function initSidebar() {
            const toggles = document.querySelectorAll('[data-sidebar-toggle]');
            if (!toggles.length) return;
            const saved = getSavedState();

            toggles.forEach(function(toggle) {
                const groupId = toggle.getAttribute('data-sidebar-toggle');
                const content = document.querySelector('[data-sidebar-content="' + groupId + '"]');
                if (!content) return;

                const hasActive = content.querySelector('.sidebar-link.active') !== null;
                let isOpen = hasActive ? true : (saved[groupId] !== undefined ? saved[groupId] : false);

                setGroupState(toggle, content, isOpen);

                toggle.addEventListener('click', function() {
                    const currentState = toggle.getAttribute('aria-expanded') === 'true';
                    const newState = !currentState;
                    setGroupState(toggle, content, newState);

                    if (!hasActive) {
                        saved[groupId] = newState;
                        saveState(saved);
                    }
                });

                toggle.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter' || e.key === ' ') {
                        e.preventDefault();
                        toggle.click();
                    }
                });
            });

            function setGroupState(toggle, content, isOpen) {
                toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
                if (isOpen) {
                    content.classList.remove('hidden');
                } else {
                    content.classList.add('hidden');
                }
            }

            // Mobile drawer link click handler
            const drawerToggle = document.getElementById('sidebar-drawer');
            const links = document.querySelectorAll('.sidebar-link');
            links.forEach(function(link) {
                link.addEventListener('click', function() {
                    if (drawerToggle && window.innerWidth < 1024) {
                        drawerToggle.checked = false;
                    }
                });
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initSidebar);
        } else {
            initSidebar();
        }
    })();
</script>
