            </a>
            @if (CurrentUser.HasPermission(AppPermissions.SystemViewAuditLogs))
            {
                <a href="/AuditLogs" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all duration-200 @(IsActive("AuditLogs") ? "font-bold" : "")"
                   style="@(IsActive("AuditLogs") ? "background:var(--color-primary);color:var(--color-primary-foreground)" : "color:var(--color-text-variant);background:transparent")"
