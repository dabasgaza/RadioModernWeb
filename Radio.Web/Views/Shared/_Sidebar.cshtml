            <a href="/Roles" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all duration-200 @(IsActive("Roles") ? "font-bold" : "")"
               style="@(IsActive("Roles") ? "background:var(--color-primary);color:var(--color-primary-foreground)" : "color:var(--color-text-variant);background:transparent")"
               onmouseover="this.style.background='var(--color-bg-hover-high)';this.style.color='var(--color-text)'"
               onmouseout="this.style.background='@(IsActive("Roles") ? "var(--color-primary)" : "transparent")';this.style.color='@(IsActive("Roles") ? "var(--color-primary-foreground)" : "var(--color-text-variant)")'">
                <span class="material-symbols-rounded text-lg">group_work</span>
                أدوار العمل والصلاحيات
            </a>
            <a href="/Permissions" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all duration-200 @(IsActive("Permissions") ? "font-bold" : "")"
               style="@(IsActive("Permissions") ? "background:var(--color-primary);color:var(--color-primary-foreground)" : "color:var(--color-text-variant);background:transparent")"
               onmouseover="this.style.background='var(--color-bg-hover-high)';this.style.color='var(--color-text)'"
               onmouseout="this.style.background='@(IsActive("Permissions") ? "var(--color-primary)" : "transparent")';this.style.color='@(IsActive("Permissions") ? "var(--color-primary-foreground)" : "var(--color-text-variant)")'">
