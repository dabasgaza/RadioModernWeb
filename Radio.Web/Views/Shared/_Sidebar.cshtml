@using DataAccess.Common
@inject ICurrentUserService CurrentUser
@{
    var controller = ViewContext.RouteData.Values["Controller"]?.ToString();
    var action = ViewContext.RouteData.Values["Action"]?.ToString();
    bool IsActive(string c, string? a = null) => controller == c && (a == null || action == a);
    bool HasAny(params string[] perms) => perms.Any(p => CurrentUser.HasPermission(p));
}
<div class="flex flex-col h-full select-none" style="background:var(--color-surface);border-left:1px solid var(--color-border)">
    <a href="/" class="flex items-center gap-3 h-16 px-5 shrink-0" style="border-bottom:1px solid var(--color-border);background:var(--color-bg-hover-low)">
        <div class="flex items-center justify-center w-10 h-10 rounded-xl" style="background:var(--color-primary);color:var(--color-primary-foreground)">
            <span class="material-symbols-rounded text-xl">live_tv</span>
        </div>
        <div class="flex flex-col">
            <span class="font-bold text-sm tracking-wide" style="color:var(--color-text)">نظام إدارة الإنتاج التلفزيوني</span>
            <span class="text-[11px] font-medium" style="color:var(--color-accent)">برامج — حلقات — بث مباشر</span>
        </div>
        <span class="wf-onair mr-auto shrink-0"></span>
    </a>

    <nav class="flex-1 overflow-y-auto p-3 space-y-1 custom-scrollbar" aria-label="التنقل الرئيسي">
        <a href="/" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all duration-200 @(IsActive("Home") ? "font-bold" : "")"
           style="@(IsActive("Home") ? "background:var(--color-primary);color:var(--color-primary-foreground)" : "color:var(--color-text-variant);background:transparent")"
           onmouseover="this.style.background='var(--color-bg-hover-high)';this.style.color='var(--color-text)'"
           onmouseout="this.style.background='@(IsActive("Home") ? "var(--color-primary)" : "transparent")';this.style.color='@(IsActive("Home") ? "var(--color-primary-foreground)" : "var(--color-text-variant)")'">
            <span class="material-symbols-rounded text-lg">dashboard</span>
            لوحة التحكم الرئيسية
        </a>
        <a href="/Search" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all duration-200 @(IsActive("Search") ? "font-bold" : "")"
           style="@(IsActive("Search") ? "background:var(--color-primary);color:var(--color-primary-foreground)" : "color:var(--color-text-variant);background:transparent")"
           onmouseover="this.style.background='var(--color-bg-hover-high)';this.style.color='var(--color-text)'"
           onmouseout="this.style.background='@(IsActive("Search") ? "var(--color-primary)" : "transparent")';this.style.color='@(IsActive("Search") ? "var(--color-primary-foreground)" : "var(--color-text-variant)")'">
            <span class="material-symbols-rounded text-lg">search</span>
            البحث العام
        </a>
        <a href="/Calendar" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all duration-200 @(IsActive("Calendar") ? "font-bold" : "")"
           style="@(IsActive("Calendar") ? "background:var(--color-primary);color:var(--color-primary-foreground)" : "color:var(--color-text-variant);background:transparent")"
           onmouseover="this.style.background='var(--color-bg-hover-high)';this.style.color='var(--color-text)'"
           onmouseout="this.style.background='@(IsActive("Calendar") ? "var(--color-primary)" : "transparent")';this.style.color='@(IsActive("Calendar") ? "var(--color-primary-foreground)" : "var(--color-text-variant)")'">
            <span class="material-symbols-rounded text-lg">calendar_month</span>
            جدول البث والإعادة
        </a>

        @if (HasAny(AppPermissions.EpisodesView, AppPermissions.EpisodesCreate, AppPermissions.EpisodesEdit, AppPermissions.ExecutionExecute))
        {
            <div class="pt-4 pb-1.5 px-3">
                <div class="text-[10px] font-bold uppercase tracking-widest" style="color:var(--color-text-muted)">إدارة الإنتاج التلفزيوني</div>
            </div>
            <a href="/Episodes" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all duration-200 @(IsActive("Episodes", "Index") ? "font-bold" : "")"
               style="@(IsActive("Episodes", "Index") ? "background:var(--color-primary);color:var(--color-primary-foreground)" : "color:var(--color-text-variant);background:transparent")"
               onmouseover="this.style.background='var(--color-bg-hover-high)';this.style.color='var(--color-text)'"
               onmouseout="this.style.background='@(IsActive("Episodes", "Index") ? "var(--color-primary)" : "transparent")';this.style.color='@(IsActive("Episodes", "Index") ? "var(--color-primary-foreground)" : "var(--color-text-variant)")'">
                <span class="material-symbols-rounded text-lg">tv</span>
                سجل الحلقات
            </a>
            <a href="/Episodes/LiveBoard" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all duration-200 @(IsActive("Episodes", "LiveBoard") ? "font-bold" : "")"
               style="@(IsActive("Episodes", "LiveBoard") ? "background:var(--color-primary);color:var(--color-primary-foreground)" : "color:var(--color-text-variant);background:transparent")"
               onmouseover="this.style.background='var(--color-bg-hover-high)';this.style.color='var(--color-text)'"
               onmouseout="this.style.background='@(IsActive("Episodes", "LiveBoard") ? "var(--color-primary)" : "transparent")';this.style.color='@(IsActive("Episodes", "LiveBoard") ? "var(--color-primary-foreground)" : "var(--color-text-variant)")'">
                <span class="material-symbols-rounded text-lg">live_tv</span>
                شاشة العرض المباشر
            </a>
            <a href="/Production" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all duration-200 @(IsActive("Production") ? "font-bold" : "")"
               style="@(IsActive("Production") ? "background:var(--color-primary);color:var(--color-primary-foreground)" : "color:var(--color-text-variant);background:transparent")"
               onmouseover="this.style.background='var(--color-bg-hover-high)';this.style.color='var(--color-text)'"
               onmouseout="this.style.background='@(IsActive("Production") ? "var(--color-primary)" : "transparent")';this.style.color='@(IsActive("Production") ? "var(--color-primary-foreground)" : "var(--color-text-variant)")'">
                <span class="material-symbols-rounded text-lg">view_column</span>
                لوحة سير الإنتاج
            </a>
        }

        @if (HasAny(AppPermissions.ProgramsView, AppPermissions.ProgramsManage))
        {
            <a href="/Programs" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all duration-200 @(IsActive("Programs") ? "font-bold" : "")"
               style="@(IsActive("Programs") ? "background:var(--color-primary);color:var(--color-primary-foreground)" : "color:var(--color-text-variant);background:transparent")"
               onmouseover="this.style.background='var(--color-bg-hover-high)';this.style.color='var(--color-text)'"
               onmouseout="this.style.background='@(IsActive("Programs") ? "var(--color-primary)" : "transparent")';this.style.color='@(IsActive("Programs") ? "var(--color-primary-foreground)" : "var(--color-text-variant)")'">
                <span class="material-symbols-rounded text-lg">live_tv</span>
                دليل البرامج
            </a>
        }

        @if (HasAny(AppPermissions.GuestsView, AppPermissions.GuestsManage))
        {
            <div class="pt-4 pb-1.5 px-3">
                <div class="text-[10px] font-bold uppercase tracking-widest" style="color:var(--color-text-muted)">المشاركون والضيوف</div>
            </div>
            <a href="/Guests" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all duration-200 @(IsActive("Guests") ? "font-bold" : "")"
               style="@(IsActive("Guests") ? "background:var(--color-primary);color:var(--color-primary-foreground)" : "color:var(--color-text-variant);background:transparent")"
               onmouseover="this.style.background='var(--color-bg-hover-high)';this.style.color='var(--color-text)'"
               onmouseout="this.style.background='@(IsActive("Guests") ? "var(--color-primary)" : "transparent")';this.style.color='@(IsActive("Guests") ? "var(--color-primary-foreground)" : "var(--color-text-variant)")'">
                <span class="material-symbols-rounded text-lg">people_alt</span>
                سجل الضيوف
            </a>
        }

        @if (HasAny(AppPermissions.CoordinationView, AppPermissions.CoordinationManage))
        {
            <a href="/Correspondents" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all duration-200 @(IsActive("Correspondents") ? "font-bold" : "")"
               style="@(IsActive("Correspondents") ? "background:var(--color-primary);color:var(--color-primary-foreground)" : "color:var(--color-text-variant);background:transparent")"
               onmouseover="this.style.background='var(--color-bg-hover-high)';this.style.color='var(--color-text)'"
               onmouseout="this.style.background='@(IsActive("Correspondents") ? "var(--color-primary)" : "transparent")';this.style.color='@(IsActive("Correspondents") ? "var(--color-primary-foreground)" : "var(--color-text-variant)")'">
                <span class="material-symbols-rounded text-lg">map</span>
                المراسلون الميدانيون
            </a>
            <a href="/Coverage" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all duration-200 @(IsActive("Coverage") ? "font-bold" : "")"
               style="@(IsActive("Coverage") ? "background:var(--color-primary);color:var(--color-primary-foreground)" : "color:var(--color-text-variant);background:transparent")"
               onmouseover="this.style.background='var(--color-bg-hover-high)';this.style.color='var(--color-text)'"
               onmouseout="this.style.background='@(IsActive("Coverage") ? "var(--color-primary)" : "transparent")';this.style.color='@(IsActive("Coverage") ? "var(--color-primary-foreground)" : "var(--color-text-variant)")'">
                <span class="material-symbols-rounded text-lg">edit_location_alt</span>
                التغطيات الميدانية
            </a>
        }

        @if (HasAny(AppPermissions.StaffView, AppPermissions.StaffManage))
        {
            <div class="pt-4 pb-1.5 px-3">
                <div class="text-[10px] font-bold uppercase tracking-widest" style="color:var(--color-text-muted)">إدارة الكادر والمشاريع</div>
            </div>
            <a href="/Employees" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all duration-200 @(IsActive("Employees") ? "font-bold" : "")"
               style="@(IsActive("Employees") ? "background:var(--color-primary);color:var(--color-primary-foreground)" : "color:var(--color-text-variant);background:transparent")"
               onmouseover="this.style.background='var(--color-bg-hover-high)';this.style.color='var(--color-text)'"
               onmouseout="this.style.background='@(IsActive("Employees") ? "var(--color-primary)" : "transparent")';this.style.color='@(IsActive("Employees") ? "var(--color-primary-foreground)" : "var(--color-text-variant)")'">
                <span class="material-symbols-rounded text-lg">badge</span>
                الموظفون والكادر
            </a>
            <a href="/StaffRoles" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all duration-200 @(IsActive("StaffRoles") ? "font-bold" : "")"
               style="@(IsActive("StaffRoles") ? "background:var(--color-primary);color:var(--color-primary-foreground)" : "color:var(--color-text-variant);background:transparent")"
               onmouseover="this.style.background='var(--color-bg-hover-high)';this.style.color='var(--color-text)'"
               onmouseout="this.style.background='@(IsActive("StaffRoles") ? "var(--color-primary)" : "transparent")';this.style.color='@(IsActive("StaffRoles") ? "var(--color-primary-foreground)" : "var(--color-text-variant)")'">
                <span class="material-symbols-rounded text-lg">work_history</span>
                المسميات الوظيفية
            </a>
            <a href="/SocialPlatforms" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all duration-200 @(IsActive("SocialPlatforms") ? "font-bold" : "")"
               style="@(IsActive("SocialPlatforms") ? "background:var(--color-primary);color:var(--color-primary-foreground)" : "color:var(--color-text-variant);background:transparent")"
               onmouseover="this.style.background='var(--color-bg-hover-high)';this.style.color='var(--color-text)'"
               onmouseout="this.style.background='@(IsActive("SocialPlatforms") ? "var(--color-primary)" : "transparent")';this.style.color='@(IsActive("SocialPlatforms") ? "var(--color-primary-foreground)" : "var(--color-text-variant)")'">
                <span class="material-symbols-rounded text-lg">share</span>
                منصات النشر الرقمي
            </a>
        }

        @if (HasAny(AppPermissions.SocialPublishingView, AppPermissions.WebsitePublishingView, AppPermissions.ExecutionView, AppPermissions.SocialPublishingPublish, AppPermissions.WebsitePublishingPublish, AppPermissions.ExecutionExecute))
        {
            <div class="pt-4 pb-1.5 px-3">
                <div class="text-[10px] font-bold uppercase tracking-widest" style="color:var(--color-text-muted)">النشر والتوزيع</div>
            </div>
            @if (HasAny(AppPermissions.SocialPublishingPublish, AppPermissions.SocialPublishingView))
            {
                <a href="/Publishing" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all duration-200 @(IsActive("Publishing") ? "font-bold" : "")"
                   style="@(IsActive("Publishing") ? "background:var(--color-primary);color:var(--color-primary-foreground)" : "color:var(--color-text-variant);background:transparent")"
                   onmouseover="this.style.background='var(--color-bg-hover-high)';this.style.color='var(--color-text)'"
                   onmouseout="this.style.background='@(IsActive("Publishing") ? "var(--color-primary)" : "transparent")';this.style.color='@(IsActive("Publishing") ? "var(--color-primary-foreground)" : "var(--color-text-variant)")'">
                    <span class="material-symbols-rounded text-lg">rss_feed</span>
                    سجل التواصل الاجتماعي
                </a>
            }
            @if (HasAny(AppPermissions.WebsitePublishingPublish, AppPermissions.WebsitePublishingView))
            {
                <a href="/WebsitePublishing" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all duration-200 @(IsActive("WebsitePublishing") ? "font-bold" : "")"
                   style="@(IsActive("WebsitePublishing") ? "background:var(--color-primary);color:var(--color-primary-foreground)" : "color:var(--color-text-variant);background:transparent")"
                   onmouseover="this.style.background='var(--color-bg-hover-high)';this.style.color='var(--color-text)'"
                   onmouseout="this.style.background='@(IsActive("WebsitePublishing") ? "var(--color-primary)" : "transparent")';this.style.color='@(IsActive("WebsitePublishing") ? "var(--color-primary-foreground)" : "var(--color-text-variant)")'">
                    <span class="material-symbols-rounded text-lg">public</span>
                    نشر البوابة الرقمية
                </a>
            }
            @if (HasAny(AppPermissions.ExecutionExecute, AppPermissions.ExecutionView))
            {
                <a href="/ExecutionLogs" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all duration-200 @(IsActive("ExecutionLogs") ? "font-bold" : "")"
                   style="@(IsActive("ExecutionLogs") ? "background:var(--color-primary);color:var(--color-primary-foreground)" : "color:var(--color-text-variant);background:transparent")"
                   onmouseover="this.style.background='var(--color-bg-hover-high)';this.style.color='var(--color-text)'"
                   onmouseout="this.style.background='@(IsActive("ExecutionLogs") ? "var(--color-primary)" : "transparent")';this.style.color='@(IsActive("ExecutionLogs") ? "var(--color-primary-foreground)" : "var(--color-text-variant)")'">
                    <span class="material-symbols-rounded text-lg">assignment</span>
                    سجلات التنفيذ والإعادة
                </a>
            }
        }

        @if (CurrentUser.HasPermission(AppPermissions.ReportsView))
        {
            <div class="pt-4 pb-1.5 px-3">
                <div class="text-[10px] font-bold uppercase tracking-widest" style="color:var(--color-text-muted)">التقارير والإحصائيات</div>
            </div>
            <a href="/Reports" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all duration-200 @(IsActive("Reports") ? "font-bold" : "")"
               style="@(IsActive("Reports") ? "background:var(--color-primary);color:var(--color-primary-foreground)" : "color:var(--color-text-variant);background:transparent")"
               onmouseover="this.style.background='var(--color-bg-hover-high)';this.style.color='var(--color-text)'"
               onmouseout="this.style.background='@(IsActive("Reports") ? "var(--color-primary)" : "transparent")';this.style.color='@(IsActive("Reports") ? "var(--color-primary-foreground)" : "var(--color-text-variant)")'">
                <span class="material-symbols-rounded text-lg">assessment</span>
                تقارير الإنتاج والأداء
            </a>
        }

        @if (HasAny(AppPermissions.AdminUsersManage, AppPermissions.AdminRolesManage))
        {
            <div class="pt-4 pb-1.5 px-3">
                <div class="text-[10px] font-bold uppercase tracking-widest" style="color:var(--color-text-muted)">إعدادات النظام</div>
            </div>
            <a href="/Users" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all duration-200 @(IsActive("Users") ? "font-bold" : "")"
               style="@(IsActive("Users") ? "background:var(--color-primary);color:var(--color-primary-foreground)" : "color:var(--color-text-variant);background:transparent")"
               onmouseover="this.style.background='var(--color-bg-hover-high)';this.style.color='var(--color-text)'"
