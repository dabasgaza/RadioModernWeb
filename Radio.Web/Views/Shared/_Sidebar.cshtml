                </a>
            }
            @if (CurrentUser.HasPermission(AppPermissions.SystemDatabaseManage))
            {
                <a href="/Database" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all duration-200 @(IsActive("Database") ? "font-bold" : "")"
                   style="@(IsActive("Database") ? "background:var(--color-primary);color:var(--color-primary-foreground)" : "color:var(--color-text-variant);background:transparent")"
