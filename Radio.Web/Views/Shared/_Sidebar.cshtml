                </a>
                <a href="/Diagnostics" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all duration-200 @(IsActive("Diagnostics") ? "font-bold" : "")"
                   style="@(IsActive("Diagnostics") ? "background:var(--color-primary);color:var(--color-primary-foreground)" : "color:var(--color-text-variant);background:transparent")"
                   onmouseover="this.style.background='var(--color-bg-hover-high)';this.style.color='var(--color-text)'"
                   onmouseout="this.style.background='@(IsActive("Diagnostics") ? "var(--color-primary)" : "transparent")';this.style.color='@(IsActive("Diagnostics") ? "var(--color-primary-foreground)" : "var(--color-text-variant)")'">
                    <span class="material-symbols-rounded text-lg">monitor_heart</span>
                    تشخيص حالة النظام
                </a>
