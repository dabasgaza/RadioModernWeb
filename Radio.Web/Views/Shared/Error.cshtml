@{
    ViewData["Title"] = "خطأ";
    var error = ViewData["ErrorMessage"] as string;
}

<div class="flex items-center justify-center min-h-[60vh]">
    <div class="wf-card text-center p-10 max-w-md">
        <div class="w-16 h-16 bg-[var(--color-danger-light)] rounded-full flex items-center justify-center mx-auto mb-5">
            <span class="material-symbols-rounded text-3xl text-[var(--color-danger)]">error</span>
        </div>
        <h2 class="text-xl font-bold text-[var(--color-text)] mb-2">حدث خطأ</h2>
        <p class="text-sm text-[var(--color-text-4)] mb-6">@(error ?? "حدث خطأ غير متوقع أثناء معالجة طلبك. يرجى المحاولة مرة أخرى لاحقاً.")</p>
        <div class="flex items-center justify-center gap-3">
            <a href="/" class="inline-flex items-center gap-2 px-5 py-2.5 bg-[var(--color-primary)] text-white text-sm font-semibold rounded-lg hover:bg-[var(--color-primary-hover)] transition-colors shadow-sm">
                <span class="material-symbols-rounded text-lg">home</span>
                الرئيسية
            </a>
            <button onclick="history.back()" class="inline-flex items-center gap-2 px-5 py-2.5 bg-[var(--color-bg-hover)] text-[var(--color-text)] text-sm font-semibold rounded-lg hover:bg-[var(--color-bg-active)] transition-colors border border-[var(--color-border)]">
                <span class="material-symbols-rounded text-lg">arrow_back</span>
                رجوع
            </button>
        </div>
    </div>
</div>
