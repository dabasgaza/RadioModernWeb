@{
    ViewData["Title"] = "خطأ";
    var error = ViewData["ErrorMessage"] as string;
}

<div class="flex items-center justify-center min-h-[60vh]">
    <div class="card text-center p-10 max-w-md">
        <div class="w-16 h-16 bg-danger-subtle rounded-full flex items-center justify-center mx-auto mb-5">
            <span class="material-symbols-rounded text-3xl text-danger">error</span>
        </div>
        <h2 class="text-headline font-bold text-text mb-2">حدث خطأ</h2>
        <p class="text-body text-text-muted mb-6">@(error ?? "حدث خطأ غير متوقع أثناء معالجة طلبك. يرجى المحاولة مرة أخرى لاحقاً.")</p>
        <div class="flex items-center justify-center gap-3">
            <a href="/" class="btn btn-primary">
                <span class="material-symbols-rounded text-lg">home</span>
                الرئيسية
            </a>
            <button onclick="history.back()" class="btn btn-outline">
                <span class="material-symbols-rounded text-lg">arrow_back</span>
                رجوع
            </button>
        </div>
    </div>
</div>
