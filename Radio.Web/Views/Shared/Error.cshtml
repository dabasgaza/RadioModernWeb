@{
    ViewData["Title"] = "خطأ";
    var error = ViewData["ErrorMessage"] as string;
}

<div class="flex items-center justify-center min-h-[60vh] p-4">
    <div class="wf-card text-center p-12 max-w-lg">
        <div class="w-20 h-20 bg-danger/10 rounded-full flex items-center justify-center mx-auto mb-6">
            <span class="material-symbols-rounded text-danger" style="font-size: 40px;">error</span>
        </div>
        <h2 class="text-2xl font-bold text-ink mb-2">حدث خطأ</h2>
        <p class="text-ink-muted mb-6">@(error ?? "حدث خطأ غير متوقع أثناء معالجة طلبك. يرجى المحاولة مرة أخرى لاحقاً.")</p>
        <div class="flex items-center justify-center gap-3">
            <a href="/" class="inline-flex items-center gap-2 bg-primary text-white px-6 py-3 rounded-lg font-semibold hover:bg-primary-dark transition">
                <span class="material-symbols-rounded" style="font-size: 18px;">home</span>
                الرئيسية
            </a>
            <button onclick="history.back()" class="inline-flex items-center gap-2 bg-surface-3 text-ink px-6 py-3 rounded-lg font-semibold hover:bg-border transition">
                <span class="material-symbols-rounded" style="font-size: 18px;">arrow_back</span>
                رجوع
            </button>
        </div>
    </div>
</div>
