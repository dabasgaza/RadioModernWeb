@inject ICurrentUserService CurrentUser

<header class="sticky top-0 z-sticky h-16 flex items-center px-6 gap-4 transition-colors duration-normal border-b border-border backdrop-blur-md"
        style="background:var(--color-topbar)">
    <label for="sidebar-drawer" class="lg:hidden p-2 rounded-xl cursor-pointer transition-colors text-text-secondary hover:bg-surface-hover">
        <span class="material-symbols-rounded text-2xl">menu</span>
    </label>

    <div class="flex-1 max-w-md hidden md:block">
        <form action="/Search" method="get" class="relative">
            <span class="material-symbols-rounded absolute right-3.5 top-1/2 -translate-y-1/2 text-lg pointer-events-none text-text-muted">search</span>
            <input type="text" name="q" placeholder="بحث سريع في الحلقات، الضيوف، والبرامج..."
                   class="input pr-11 pl-4 text-caption font-medium bg-surface-hover" />
        </form>
    </div>

    <div class="flex items-center gap-2 mr-auto">
        <button class="btn btn-icon btn-ghost" id="theme-toggle-btn" aria-label="تبديل السمة" onclick="toggleTheme()">
            <span class="material-symbols-rounded text-xl" id="theme-icon">dark_mode</span>
        </button>

        <div class="relative">
            <button class="relative btn btn-icon btn-ghost" onclick="toggleNotifications(event)">
                <span class="material-symbols-rounded text-xl">notifications</span>
                <span id="notification-badge-ping" class="hidden absolute top-1.5 left-1.5 w-2.5 h-2.5 rounded-full animate-ping bg-danger"></span>
                <span id="notification-badge" class="hidden absolute top-1 left-1 text-micro rounded-full w-4 h-4 flex items-center justify-center font-bold ring-2 bg-danger text-danger-foreground" style="--tw-ring-color:var(--color-surface)">0</span>
            </button>
            <div id="notifications-dropdown" class="hidden absolute left-0 mt-3 w-80 rounded-2xl z-dropdown max-h-96 overflow-y-auto bg-surface border border-border shadow-dropdown">
                <div class="p-4 flex items-center justify-between border-b border-border">
                    <span class="font-bold text-caption text-text">مركز الإشعارات</span>
                    <button class="text-caption font-semibold hover:underline text-primary" onclick="clearNotifications()">مسح الكل</button>
                </div>
                <div id="notifications-list" class="border-border">
                    <div class="p-6 text-caption text-center text-text-secondary">لا توجد إشعارات حالية</div>
                </div>
            </div>
        </div>

        <div class="relative">
            <button class="flex items-center gap-3 p-1.5 pr-3 rounded-xl transition-colors duration-normal bg-surface-hover border border-border hover:bg-bg-hover" onclick="toggleUserMenu(event)">
                <div class="w-8 h-8 rounded-lg flex items-center justify-center font-bold text-caption shrink-0 bg-primary text-primary-foreground">
                    @(CurrentUser.FullName?.Substring(0, 1) ?? "U")
                </div>
                <div class="hidden md:block text-right">
                    <div class="text-caption font-bold leading-tight text-text">@(CurrentUser.FullName ?? "مستخدم النظام")</div>
                    <div class="text-micro font-medium text-text-secondary">@CurrentUser.PrimaryRole</div>
                </div>
                <span class="material-symbols-rounded text-lg hidden md:inline text-text-muted">expand_more</span>
            </button>
            <div id="user-menu" class="hidden absolute left-0 mt-3 w-60 rounded-2xl z-dropdown overflow-hidden bg-surface border border-border shadow-dropdown">
                <a href="/Account/Profile" class="flex items-center gap-3 px-4 py-3 text-caption font-semibold transition-colors text-text hover:bg-surface-hover">
                    <span class="material-symbols-rounded text-lg text-text-muted">person</span>
                    <span>الملف الشخصي</span>
                </a>
                <a href="/Account/Settings" class="flex items-center gap-3 px-4 py-3 text-caption font-semibold transition-colors text-text hover:bg-surface-hover">
                    <span class="material-symbols-rounded text-lg text-text-muted">settings</span>
                    <span>تفضيلات الإعدادات</span>
                </a>
                <div class="border-t border-border"></div>
                <form action="/Account/Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="w-full flex items-center gap-3 px-4 py-3 text-caption font-semibold transition-colors text-danger hover:bg-danger-subtle">
                        <span class="material-symbols-rounded text-lg">logout</span>
                        <span>تسجيل الخروج</span>
                    </button>
                </form>
            </div>
        </div>
    </div>
</header>
