@inject ICurrentUserService CurrentUser

<header class="sticky top-0 z-30 h-16 flex items-center px-6 gap-4 bg-sys-surface-bright/80 backdrop-blur-xl border-b border-sys-outline-variant shadow-sm transition-all duration-200">
    <label for="sidebar-drawer" class="lg:hidden p-2 rounded-xl text-sys-on-surface-variant hover:bg-sys-surface-container-high cursor-pointer transition-colors">
        <span class="material-symbols-rounded text-2xl">menu</span>
    </label>

    <div class="flex-1 max-w-md hidden md:block">
        <form action="/Search" method="get" class="relative">
            <span class="material-symbols-rounded absolute right-3.5 top-1/2 -translate-y-1/2 text-sys-outline text-xl">search</span>
            <input type="text" name="q" placeholder="بحث سريع في الحلقات، الضيوف، والبرامج..."
                   class="w-full h-10 bg-sys-surface-container-low border border-sys-outline-variant rounded-xl pr-11 pl-4 text-xs font-medium text-sys-on-surface placeholder:text-sys-outline focus:outline-none focus:border-sys-primary focus:ring-2 focus:ring-sys-primary/20 transition-all duration-200" />
        </form>
    </div>

    <div class="flex items-center gap-2 mr-auto">
        <button class="p-2.5 rounded-xl text-sys-on-surface-variant hover:bg-sys-surface-container-high transition-colors" onclick="toggleTheme()" id="theme-toggle-btn" aria-label="تبديل السمة">
            <span class="material-symbols-rounded text-xl" id="theme-icon">dark_mode</span>
        </button>

        <div class="relative">
            <button class="relative p-2.5 rounded-xl text-sys-on-surface-variant hover:bg-sys-surface-container-high transition-colors" onclick="toggleNotifications(event)">
                <span class="material-symbols-rounded text-xl">notifications</span>
                <span id="notification-badge-ping" class="hidden absolute top-1.5 left-1.5 w-2.5 h-2.5 bg-sys-error rounded-full animate-ping"></span>
                <span id="notification-badge" class="hidden absolute top-1 left-1 bg-sys-error text-sys-on-error text-[9px] rounded-full w-4 h-4 flex items-center justify-center font-bold ring-2 ring-sys-surface-bright">0</span>
            </button>
            <div id="notifications-dropdown" class="hidden absolute left-0 mt-3 w-80 bg-sys-surface-bright rounded-2xl shadow-2xl border border-sys-outline-variant z-50 max-h-96 overflow-y-auto">
                <div class="p-4 border-b border-sys-outline-variant flex items-center justify-between">
                    <span class="font-bold text-xs text-sys-on-surface">مركز الإشعارات</span>
                    <button class="text-xs text-sys-primary font-semibold hover:underline" onclick="clearNotifications()">مسح الكل</button>
                </div>
                <div id="notifications-list" class="divide-y divide-sys-outline-variant">
                    <div class="p-6 text-xs text-sys-on-surface-variant text-center">لا توجد إشعارات حالية</div>
                </div>
            </div>
        </div>

        <div class="relative">
            <button class="flex items-center gap-3 p-1.5 pr-3 bg-sys-surface-container-low hover:bg-sys-surface-container-high rounded-xl border border-sys-outline-variant transition-all duration-200" onclick="toggleUserMenu(event)">
                <div class="w-8 h-8 rounded-lg bg-sys-primary text-sys-on-primary flex items-center justify-center font-bold text-xs shadow-md shrink-0">
                    @(CurrentUser.FullName?.Substring(0, 1) ?? "U")
                </div>
                <div class="hidden md:block text-right">
                    <div class="text-xs font-bold text-sys-on-surface leading-tight">@(CurrentUser.FullName ?? "مستخدم النظام")</div>
                    <div class="text-[10px] text-sys-on-surface-variant font-medium">@CurrentUser.PrimaryRole</div>
                </div>
                <span class="material-symbols-rounded text-lg text-sys-outline hidden md:inline">expand_more</span>
            </button>
            <div id="user-menu" class="hidden absolute left-0 mt-3 w-60 bg-sys-surface-bright rounded-2xl border border-sys-outline-variant z-50 shadow-2xl overflow-hidden">
                <a href="/Account/Profile" class="flex items-center gap-3 px-4 py-3 hover:bg-sys-surface-container-high text-xs font-semibold text-sys-on-surface transition-colors">
                    <span class="material-symbols-rounded text-lg text-sys-outline">person</span>
                    <span>الملف الشخصي</span>
                </a>
                <a href="/Account/Settings" class="flex items-center gap-3 px-4 py-3 hover:bg-sys-surface-container-high text-xs font-semibold text-sys-on-surface transition-colors">
                    <span class="material-symbols-rounded text-lg text-sys-outline">settings</span>
                    <span>تفضيلات الإعدادات</span>
                </a>
                <div class="border-t border-sys-outline-variant"></div>
                <form action="/Account/Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="w-full flex items-center gap-3 px-4 py-3 hover:bg-sys-error-container/20 text-xs font-semibold text-sys-error transition-colors">
                        <span class="material-symbols-rounded text-lg text-sys-error">logout</span>
                        <span>تسجيل الخروج</span>
                    </button>
                </form>
            </div>
        </div>
    </div>
</header>

