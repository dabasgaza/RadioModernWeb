@inject ICurrentUserService CurrentUser

<header class="sticky top-0 z-30 glass-topbar h-16 flex items-center px-4 gap-4 shadow-sm">
    <label for="sidebar-drawer" class="lg:hidden text-ink-muted p-2 hover:bg-surface-3 rounded-lg cursor-pointer">
        <span class="material-symbols-rounded">menu</span>
    </label>

    <div class="flex items-center gap-2">
        <span class="material-symbols-rounded text-primary">radio</span>
        <span class="font-bold text-ink hidden sm:inline">نظام سير عمل البث الإذاعي</span>
    </div>

    <div class="flex-1 max-w-md mx-auto hidden md:block">
        <form action="/Search" method="get" class="relative">
            <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-ink-soft">search</span>
            <input type="text" name="q" placeholder="بحث سريع…"
                   class="input input-bordered w-full rounded-lg py-2 pr-10 pl-4 text-sm" />
        </form>
    </div>

    <div class="flex items-center gap-1 mr-auto">
        <!-- Dark Mode Toggle -->
        <button class="p-2 hover:bg-surface-3 rounded-lg text-ink-muted" onclick="toggleTheme()" id="theme-toggle-btn" aria-label="تبديل السمة">
            <span class="material-symbols-rounded" id="theme-icon">dark_mode</span>
        </button>

        <!-- Notifications dropdown -->
        <div class="relative">
            <button class="relative p-2 hover:bg-surface-3 rounded-lg text-ink-muted" onclick="toggleNotifications(event)">
                <span class="material-symbols-rounded">notifications</span>
                <span id="notification-badge-ping" class="hidden absolute -top-0.5 -left-0.5 w-3.5 h-3.5 bg-danger/50 rounded-full ping-notification"></span>
                <span id="notification-badge" class="hidden absolute -top-0.5 -left-0.5 bg-danger text-white text-[9px] rounded-full w-3.5 h-3.5 flex items-center justify-center font-bold">0</span>
            </button>
            <div id="notifications-dropdown" class="hidden absolute left-0 mt-2 w-80 bg-surface rounded-xl shadow-xl border border-border z-50 max-h-96 overflow-y-auto">
                <div class="p-3 border-b border-border flex items-center justify-between">
                    <span class="font-bold">الإشعارات</span>
                    <button class="text-xs text-primary" onclick="clearNotifications()">مسح الكل</button>
                </div>
                <div id="notifications-list" class="divide-y divide-border">
                    <div class="p-3 text-sm text-ink-soft text-center">لا توجد إشعارات</div>
                </div>
            </div>
        </div>

        <!-- User menu -->
        <div class="relative">
            <button class="flex items-center gap-2 p-1 pr-2 bg-surface-2 hover:bg-surface-3 rounded-lg border border-border transition-all duration-200" onclick="toggleUserMenu(event)">
                <div class="w-9 h-9 rounded-full bg-gradient-to-br from-primary to-secondary text-white flex items-center justify-center font-bold text-sm shadow-sm">
                    @(CurrentUser.FullName?.Substring(0, 1) ?? "U")
                </div>
                <div class="hidden md:block text-right">
                    <div class="text-sm font-bold text-ink leading-tight">@(CurrentUser.FullName ?? "مستخدم")</div>
                    <div class="text-xs text-ink-soft">@CurrentUser.PrimaryRole</div>
                </div>
                <span class="material-symbols-rounded text-ink-soft text-base hidden md:inline">expand_more</span>
            </button>
            <div id="user-menu" class="hidden absolute left-0 mt-2 w-56 bg-surface rounded-xl border border-border z-50 user-dropdown-menu">
                <a href="/Account/Profile" class="flex px-4 py-2.5 hover:bg-surface-3 text-sm items-center gap-2 rounded-t-xl transition-colors">
                    <span class="material-symbols-rounded text-ink-muted text-base">person</span>
                    <span class="text-ink">الملف الشخصي</span>
                </a>
                <a href="/Account/Settings" class="flex px-4 py-2.5 hover:bg-surface-3 text-sm items-center gap-2 transition-colors">
                    <span class="material-symbols-rounded text-ink-muted text-base">settings</span>
                    <span class="text-ink">الإعدادات</span>
                </a>
                <div class="border-t border-border my-1"></div>
                <form action="/Account/Logout" method="post" class="block">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="w-full text-right px-4 py-2.5 hover:bg-red-50 text-sm flex items-center gap-2 text-danger rounded-b-xl transition-colors logout-btn">
                        <span class="material-symbols-rounded text-base">logout</span>
                        تسجيل الخروج
                    </button>
                </form>
            </div>
        </div>
    </div>
</header>
