@{
    var kpiItems = ViewBag.KpiItems as List<Radio.Web.ViewModels.KpiItem> ?? new();
}
@if (kpiItems.Any())
{
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        @foreach (var kpi in kpiItems)
        {
            <div class="rounded-2xl border p-5" style="background: var(--color-surface); border-color: var(--color-border)">
                <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium" style="color: var(--color-text-tertiary)">@kpi.Label</p>
                        <p class="text-2xl font-black mt-1" style="color: @(kpi.Color ?? "var(--color-primary)");">@kpi.Value</p>
                    </div>
                    <div class="w-11 h-11 rounded-xl flex items-center justify-center shrink-0 transition-transform duration-200"
                         style="background: @(kpi.IconBg ?? "color-mix(in srgb, var(--color-primary) 10%, transparent)"); color: @(kpi.IconColor ?? kpi.Color ?? "var(--color-primary)");">
                        <span class="material-symbols-rounded text-xl">@kpi.Icon</span>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(kpi.Subtitle))
                {
                    <p class="text-xs mt-2 flex items-center gap-1" style="color: var(--color-text-tertiary)">
                        <span class="material-symbols-rounded text-sm">info</span>
                        @kpi.Subtitle
                    </p>
                }
            </div>
        }
    </div>
}
