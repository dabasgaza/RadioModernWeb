@{
    var kpiItems = ViewBag.KpiItems as List<Radio.Web.ViewModels.KpiItem> ?? new();
}
@if (kpiItems.Any())
{
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        @foreach (var kpi in kpiItems)
        {
            <div class="kpi-card">
                <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0 flex-1">
                        <p class="text-body font-medium text-text-secondary">@kpi.Label</p>
                        <p class="text-headline font-bold mt-1 tabular-nums text-primary">@kpi.Value</p>
                    </div>
                    <div class="w-11 h-11 rounded-xl flex items-center justify-center shrink-0 transition-transform duration-normal hover:scale-110 bg-primary-subtle text-primary">
                        <span class="material-symbols-rounded text-xl">@(kpi.Icon ?? "bar_chart")</span>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(kpi.Subtitle))
                {
                    <p class="text-caption mt-2 flex items-center gap-1 text-text-secondary">
                        <span class="material-symbols-rounded text-sm" aria-hidden="true">info</span>
                        @kpi.Subtitle
                    </p>
                }
            </div>
        }
    </div>
}
