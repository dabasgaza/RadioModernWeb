<!DOCTYPE html>
<html lang="ar" dir="rtl" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — نظام سير عمل البث الإذاعي</title>
    <meta name="description" content="نظام إدارة سير عمل البث الإذاعي - إدارة الحلقات والبرامج والضيوف والنشر الرقمي" />
    <meta name="theme-color" content="#2563EB" />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800&family=Tajawal:wght@300;400;500;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: { DEFAULT: '#2563EB', dark: '#1D4ED8', light: '#3B82F6' },
                        secondary: { DEFAULT: '#7C3AED', dark: '#6D28D9' },
                        accent: '#0EA5E9',
                        success: '#10B981',
                        warning: '#F59E0B',
                        danger: '#EF4444',
                        surface: '#FFFFFF',
                        'surface-2': '#F8FAFC',
                        'surface-3': '#F1F5F9',
                        border: '#E2E8F0',
                        ink: { DEFAULT: '#0F172A', muted: '#475569', soft: '#94A3B8' }
                    },
                    fontFamily: {
                        sans: ['Cairo', 'Tajawal', 'Segoe UI', 'sans-serif']
                    },
                    borderRadius: {
                        xl: '14px'
                    }
                }
            }
        }
    </script>
    <link href="~/css/site.css" rel="stylesheet" />
    <link href="~/css/login.css" rel="stylesheet" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-surface-2 text-ink font-sans antialiased">
    <!-- Sidebar Overlay (mobile) -->
    <div class="sidebar-overlay" id="sidebar-overlay" onclick="closeSidebar()"></div>

    <!-- Sidebar -->
    <partial name="_Sidebar" />

    <!-- Main Wrapper -->
    <div class="main-wrapper">
        <!-- Topbar -->
        <partial name="_Topbar" />

        <!-- Flash Messages -->
        <partial name="_Toastr" />

        <!-- Main Content -->
        <main class="main-content">
            @RenderBody()
        </main>

        <!-- Footer -->
        <footer class="footer-premium">
            <span>© @DateTime.UtcNow.Year نظام سير عمل البث الإذاعي — جميع الحقوق محفوظة</span>
        </footer>
    </div>

    <!-- Modal container -->
    <div id="modal-root"></div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <link href="https://unpkg.com/tabulator-tables@6.3.1/dist/css/tabulator_simple.min.css" rel="stylesheet" />
    <script src="https://unpkg.com/tabulator-tables@6.3.1/dist/js/tabulator.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    <script src="~/js/notifications.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
