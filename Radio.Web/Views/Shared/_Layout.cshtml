<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — نظام إدارة البث الإذاعي</title>
    <meta name="theme-color" content="#F9FAFB" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0D1116" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800&family=Almarai:wght@300;400;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,0" rel="stylesheet" />
    <link href="~/lib/flatpickr/flatpickr.min.css" rel="stylesheet" />
    <link href="~/css/flatpickr-theme.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/site.css" rel="stylesheet" />
    <link href="~/css/app.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/login.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/lib/toastr/toastr.min.css" rel="stylesheet" />
    <link href="~/lib/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    <link href="~/lib/nprogress/nprogress.css" rel="stylesheet" />
    @await RenderSectionAsync("Styles", required: false)
    <script>
        (function(){try{var t=localStorage.getItem('theme');var d=t==='dark'||(!t&&window.matchMedia('(prefers-color-scheme:dark)').matches);document.documentElement.classList.toggle('dark',d)}catch(e){}})();
    </script>
</head>
<body class="bg-bg text-text font-sans antialiased min-h-screen">
    <a href="#main-content" class="skip-link">تجاوز إلى المحتوى الرئيسي</a>
    <div class="drawer lg:drawer-open">
        <input id="sidebar-drawer" type="checkbox" class="drawer-toggle" />
        <div class="drawer-content flex flex-col min-h-screen">
            <partial name="_Topbar" />
            <partial name="_Toastr" />
            <main id="main-content" class="flex-1 p-5 lg:p-6 page-transition">
                @RenderBody()
            </main>
            <footer class="border-t border-border px-6 py-4 text-center text-caption text-text-muted">
                <span>© @DateTime.UtcNow.Year — نظام إدارة البث الإذاعي</span>
            </footer>
        </div>
        <div class="drawer-side">
            <label for="sidebar-drawer" class="drawer-overlay"></label>
            <aside class="w-72 h-full flex flex-col bg-surface border-l border-border">
                <partial name="_Sidebar" />
            </aside>
        </div>
    </div>

    <div id="modal-root"></div>

    <button id="back-to-top" onclick="window.scrollTo({top:0,behavior:'smooth'})" aria-label="العودة إلى الأعلى">
        <span class="material-symbols-rounded">arrow_upward</span>
    </button>

    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script src="~/lib/toastr/toastr.min.js"></script>
    <script src="~/lib/chartjs/chart.umd.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.min.js"></script>
    <script src="~/lib/preline/preline.min.js"></script>
    <script src="~/lib/flatpickr/flatpickr.min.js"></script>
    <script src="~/lib/flatpickr/l10n/ar.js"></script>
    <script src="~/lib/nprogress/nprogress.js"></script>
    <script src="~/js/theme-toggle.js" asp-append-version="true"></script>
    <script src="~/js/waveform.js" asp-append-version="true"></script>
    <script src="~/js/datepicker-init.js" asp-append-version="true"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    <script src="~/js/notifications.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
