<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — نظام سير عمل البث الإذاعي</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800&family=Tajawal:wght@300;400;500;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,0" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/app.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/theme-dark-overrides.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/login.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/lib/flatpickr/flatpickr.min.css" rel="stylesheet" />
    <link href="~/css/flatpickr-theme.css" rel="stylesheet" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <script>
        (function() {
            var theme = localStorage.getItem('theme');
            var isDark = theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches);
            document.documentElement.setAttribute('data-theme', isDark ? 'radiomodernDark' : 'radiomodern');
            document.documentElement.classList.toggle('dark', isDark);
        })();
    </script>
</head>
<body class="bg-surface-2 text-ink font-sans antialiased">
    <div class="drawer lg:drawer-open">
        <input id="sidebar-drawer" type="checkbox" class="drawer-toggle" />

        <div class="drawer-content flex flex-col min-h-screen">
            <partial name="_Topbar" />
            <partial name="_Toastr" />
            <main class="flex-1 p-6 page-transition">
                @RenderBody()
            </main>
            <footer class="bg-surface border-t border-border px-6 py-3 text-center text-sm text-ink-soft">
                <span>© @DateTime.UtcNow.Year نظام سير عمل البث الإذاعي — جميع الحقوق محفوظة</span>
            </footer>
        </div>

        <div class="drawer-side z-40">
            <label for="sidebar-drawer" class="drawer-overlay"></label>
            <aside class="w-72 min-h-full bg-base-100 border-l border-base-200 flex flex-col">
                <partial name="_Sidebar" />
            </aside>
        </div>
    </div>

    <div id="modal-root"></div>

    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/signalr/signalr.min.js"></script>
    <link href="~/lib/toastr/toastr.min.css" rel="stylesheet" />
    <script src="~/lib/toastr/toastr.min.js"></script>
    <link href="~/lib/tabulator/tabulator_simple.min.css" rel="stylesheet" />
    <script src="~/lib/tabulator/tabulator.min.js"></script>
    <script src="~/lib/chartjs/chart.umd.js"></script>
    <link href="~/lib/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    <script src="~/lib/sweetalert2/sweetalert2.min.js"></script>

    <button id="back-to-top" onclick="window.scrollTo({top:0,behavior:'smooth'})" aria-label="العودة إلى الأعلى">
        <span class="material-symbols-rounded">arrow_upward</span>
    </button>

    <script src="~/js/theme-toggle.js"></script>
    <script src="~/lib/preline/preline.min.js"></script>
    <script src="~/lib/flatpickr/flatpickr.min.js"></script>
    <script src="~/lib/flatpickr/l10n/ar.js"></script>
    <script src="~/js/datepicker-init.js" asp-append-version="true"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    <script src="~/js/notifications.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
