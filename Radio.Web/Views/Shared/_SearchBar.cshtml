@{
    var searchValue = ViewBag.SearchValue as string ?? "";
    var searchPlaceholder = ViewBag.SearchPlaceholder as string ?? "بحث...";
    var searchAction = ViewBag.SearchAction as string ?? Context.Request.Path;
    var hideCard = ViewBag.SearchHideCard as bool? ?? false;
}
@if (!hideCard)
{
    @:<div class="rounded-xl p-5 mb-8" style="background: var(--color-bg-elevated); border: 1px solid var(--color-border);">
}
<form method="get" class="flex gap-3">
    <div class="relative flex-1">
        <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none" style="color: var(--color-text-tertiary);">search</span>
        <input type="text" name="search" value="@searchValue" placeholder="@searchPlaceholder"
               class="w-full rounded-xl py-2.5 pr-10 pl-3 text-sm font-medium focus:outline-none focus:ring-2 transition-all"
               style="background: var(--color-bg); border: 1px solid var(--color-border); color: var(--color-text); --tw-ring-color: var(--color-primary);" />
        @if (!string.IsNullOrWhiteSpace(searchValue))
        {
            <a href="@searchAction" class="absolute left-3 top-1/2 -translate-y-1/2" style="color: var(--color-text-tertiary)" title="مسح البحث">
                <span class="material-symbols-rounded text-lg">close</span>
            </a>
        }
    </div>
    <div class="flex items-center gap-2 shrink-0">
        <button type="submit" class="btn btn-primary rounded-xl gap-2">
            <span class="material-symbols-rounded">search</span>
            بحث
        </button>
        @if (!string.IsNullOrWhiteSpace(searchValue))
        {
            <a href="@searchAction" class="btn btn-ghost rounded-xl" title="إعادة ضبط">
                <span class="material-symbols-rounded">restart_alt</span>
            </a>
        }
    </div>
</form>
@if (!hideCard)
{
    @:</div>
}
