@{
    var isEdit = ViewBag.IsEdit ?? false;
    var icon = ViewBag.Icon ?? (isEdit ? "edit" : "add");
    var title = ViewBag.Title ?? "";
    var description = ViewBag.Description ?? "";
    var backUrl = ViewBag.BackUrl ?? "";
    var backText = ViewBag.BackText ?? "العودة";
    var entityName = ViewBag.EntityName ?? "";
    var entityUrl = ViewBag.EntityUrl ?? "";
}

<div class="mb-6">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <div class="text-xs font-medium text-text-secondary mb-1 flex items-center gap-1.5">
                <a href="/" class="hover:text-primary transition-colors text-text-muted">الرئيسية</a>
                <span class="text-border">·</span>
                <a href="@entityUrl" class="hover:text-primary transition-colors text-text-muted">@entityName</a>
                <span class="text-border">·</span>
                <span class="text-text">@(isEdit ? "تعديل" : "جديد")</span>
            </div>
            <h1 class="text-xl font-bold text-text flex items-center gap-2 mt-1">
                <span class="material-symbols-rounded text-lg text-primary">@icon</span>
                @title
            </h1>
            <p class="text-sm text-text-secondary mt-0.5">@description</p>
        </div>
        <div class="flex items-center gap-2">
            <a href="@backUrl" class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium text-text-secondary hover:text-text hover:bg-surface-hover rounded-lg transition-colors">
                <span class="material-symbols-rounded text-lg">arrow_forward</span>
                @backText
            </a>
        </div>
    </div>
</div>
