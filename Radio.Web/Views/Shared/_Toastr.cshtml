@using Microsoft.AspNetCore.Mvc.ViewFeatures
@inject ITempDataDictionaryFactory TempDataFactory

@{
    var tempData = TempDataFactory.GetTempData(Context);
    var notificationsJson = tempData["ToastrNotifications"] as string;
    var success = tempData["Success"] as string;
    var error = tempData["Error"] as string;
    var info = tempData["Info"] as string;
    var warning = tempData["Warning"] as string;
}

<script>
    document.addEventListener('DOMContentLoaded', function () {
        function showToast(type, message) {
            if (typeof toastr === 'undefined') return;
            toastr[type](message, '', {
                positionClass: 'toast-bottom-left',
                timeOut: 5000,
                extendedTimeOut: 2000,
                closeButton: true,
                progressBar: true,
                rtl: true
            });
        }

        @if (!string.IsNullOrEmpty(success))
        {
            <text>showToast('success', @Json.Serialize(success));</text>
        }
        @if (!string.IsNullOrEmpty(error))
        {
            <text>showToast('error', @Json.Serialize(error));</text>
        }
        @if (!string.IsNullOrEmpty(info))
        {
            <text>showToast('info', @Json.Serialize(info));</text>
        }
        @if (!string.IsNullOrEmpty(warning))
        {
            <text>showToast('warning', @Json.Serialize(warning));</text>
        }

        @if (!string.IsNullOrEmpty(notificationsJson))
        {
            <text>
                try {
                    var notifications = @Json.Serialize(notificationsJson);
                    if (!Array.isArray(notifications)) notifications = [notifications];
                    notifications.forEach(function (n) {
                        showToast(n.type || 'info', n.message || '');
                    });
                } catch (e) {
                    console.error('Failed to parse notifications:', e);
                }
            </text>
        }
    });
</script>
