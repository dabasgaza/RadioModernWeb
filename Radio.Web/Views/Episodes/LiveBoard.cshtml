@model List<DataAccess.DTOs.ActiveEpisodeDto>
@using DataAccess.Services
@{
    ViewData["Title"] = "شاشة عرض الحلقات المباشرة";

    var nowTime = DateTime.Now;
    var nextEpisode = Model
        .Where(e => e.StatusId == EpisodeStatusValues.Planned && e.ScheduledExecutionTime.HasValue && e.ScheduledExecutionTime.Value >= nowTime)
        .OrderBy(e => e.ScheduledExecutionTime)
        .FirstOrDefault();
}

<style>
    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
    @@keyframes pulseGlow {
        0%, 100% { box-shadow: 0 0 15px -3px var(--color-primary-subtle), 0 0 6px -2px var(--color-primary-subtle); border-color: color-mix(in srgb, var(--color-primary) 40%, transparent); }
        50% { box-shadow: 0 0 25px 2px color-mix(in srgb, var(--color-primary) 60%, transparent), 0 0 12px 0px color-mix(in srgb, var(--color-primary) 60%, transparent); border-color: color-mix(in srgb, var(--color-primary) 90%, transparent); }
    }
    .animate-card-in { animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) both; }
    .active-pulse-glow { animation: pulseGlow 2.5s infinite ease-in-out; }

    body.kiosk-active {
        background: var(--color-surface) !important;
        overflow: hidden !important;
        font-size: clamp(1rem, 0.6vw + 0.75rem, 1.75rem) !important;
    }
    body.kiosk-active .drawer-side,
    body.kiosk-active footer,
    body.kiosk-active header,
    body.kiosk-active #back-to-top { display: none !important; }
    body.kiosk-active .drawer { display: block !important; }
    body.kiosk-active .drawer-content {
        min-height: 100vh !important;
        padding: 0 !important;
        margin: 0 !important;
        background: var(--color-surface) !important;
    }
    body.kiosk-active main {
        padding: 1.5rem !important;
        height: 100vh !important;
        overflow: hidden !important;
        display: flex !important;
        flex-direction: column !important;
    }
    body.kiosk-active #liveboard-scroll-area {
        flex: 1 !important;
        overflow-y: auto !important;
        scrollbar-width: none;
    }
    body.kiosk-active #liveboard-scroll-area::-webkit-scrollbar { display: none; }
    body.kiosk-active h1 { font-size: clamp(1.5rem, 1.2vw + 1rem, 3rem) !important; }
    body.kiosk-active .text-sm { font-size: clamp(0.875rem, 0.5vw + 0.65rem, 1.5rem) !important; }
    body.kiosk-active .text-xs { font-size: clamp(0.75rem, 0.4vw + 0.55rem, 1.25rem) !important; }
    body.kiosk-active .badge { font-size: clamp(0.75rem, 0.4vw + 0.55rem, 1.25rem) !important; height: auto !important; padding: 0.5em 0.75em !important; }
</style>

<div id="liveboard-content-wrapper" class="flex flex-col h-full gap-4">
    <div class="card p-4 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div class="flex items-center gap-4">
            <div class="p-3 rounded-2xl text-primary-foreground shadow-md" style="background:linear-gradient(to bottom right,var(--color-primary),var(--color-accent))">
                <span class="material-symbols-rounded text-3xl" aria-hidden="true">tv</span>
            </div>
            <div>
                <h1 class="text-2xl font-black flex items-center gap-2 text-text">
                    شاشة عرض الحلقات المجدولة
                </h1>
                <p class="text-sm mt-0.5 text-text-secondary">متابعة فورية ومباشرة لحلقات اليوم وتفاصيل البث</p>
            </div>
        </div>

        <div class="flex flex-wrap items-center gap-4 justify-end">
            <span id="connection-indicator" class="inline-flex items-center gap-1 px-3 py-1.5 text-caption font-bold rounded-full bg-success-subtle text-success">
                <span class="w-2.5 h-2.5 rounded-full bg-white animate-ping"></span>
                <span id="connection-status-text">متصل بالبث الفوري</span>
            </span>

            <div id="live-clock-bar" class="rounded-2xl px-6 py-2.5 font-mono text-xl font-bold flex items-center gap-3 bg-surface-hover shadow-float">
                <span class="material-symbols-rounded text-accent" aria-hidden="true">schedule</span>
                <span id="live-clock" class="text-text">00:00:00</span>
                <span class="text-xs text-text-muted" id="live-date">--/--/----</span>
            </div>

            <div class="join shadow-md">
                <button onclick="toggleAutoScroll()" id="btn-autoscroll" class="btn btn-ghost join-item">
                    <span class="material-symbols-rounded" id="icon-autoscroll">play_arrow</span>
                    <span>تمرير تلقائي</span>
                </button>
                <button onclick="toggleKioskMode()" id="btn-kiosk" class="btn btn-primary join-item">
                    <span class="material-symbols-rounded" id="icon-kiosk">fullscreen</span>
                    <span>ملء الشاشة</span>
                </button>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="hover:-translate-y-1 transition-all duration-300 bg-surface rounded-xl shadow-sm" style="border-inline-start:8px solid var(--color-primary)">
            <div class="p-4 flex flex-row items-center gap-4">
                <div class="p-3 rounded-2xl shadow-inner bg-primary-subtle text-primary">
                    <span class="material-symbols-rounded text-3xl" aria-hidden="true">view_list</span>
                </div>
                <div>
                    <div class="text-sm font-semibold text-text-secondary">إجمالي حلقات اليوم</div>
                    <div class="text-3xl font-black mt-1 text-text">@Model.Count</div>
                </div>
            </div>
        </div>

        <div class="hover:-translate-y-1 transition-all duration-300 bg-surface rounded-xl shadow-sm" style="border-inline-start:8px solid var(--color-accent)">
            <div class="p-4 flex flex-row items-center gap-4">
                <div class="p-3 rounded-2xl shadow-inner bg-accent-subtle text-accent">
                    <span class="material-symbols-rounded text-3xl" aria-hidden="true">pending_actions</span>
                </div>
                <div>
                    <div class="text-sm font-semibold text-text-secondary">مجدولة / بانتظار البث</div>
                    <div class="text-3xl font-black mt-1 text-text">@Model.Count(e => e.StatusId == EpisodeStatusValues.Planned)</div>
                </div>
            </div>
        </div>

        <div class="hover:-translate-y-1 transition-all duration-300 bg-surface rounded-xl shadow-sm" style="border-inline-start:8px solid var(--color-success)">
            <div class="p-4 flex flex-row items-center gap-4">
                <div class="p-3 rounded-2xl shadow-inner bg-success-subtle text-success">
                    <span class="material-symbols-rounded text-3xl" aria-hidden="true">check_circle</span>
                </div>
                <div>
                    <div class="text-sm font-semibold text-text-secondary">تم التنفيذ والبث</div>
                    <div class="text-3xl font-black mt-1 text-text">@Model.Count(e => e.StatusId == EpisodeStatusValues.Executed || e.StatusId == EpisodeStatusValues.Published || e.StatusId == EpisodeStatusValues.WebsitePublished)</div>
                </div>
            </div>
        </div>

        <div class="hover:-translate-y-1 transition-all duration-300 bg-surface rounded-xl shadow-sm" style="border-inline-start:8px solid var(--color-danger)">
            <div class="p-4 flex flex-row items-center gap-4">
                <div class="p-3 rounded-2xl shadow-inner bg-danger-subtle text-danger">
                    <span class="material-symbols-rounded text-3xl" aria-hidden="true">cancel</span>
                </div>
                <div>
                    <div class="text-sm font-semibold text-text-secondary">حلقات ملغاة</div>
                    <div class="text-3xl font-black mt-1 text-text">@Model.Count(e => e.StatusId == EpisodeStatusValues.Cancelled)</div>
                </div>
            </div>
        </div>
    </div>

    <div id="liveboard-scroll-area" class="w-full flex-1 overflow-y-auto pr-1">
        @if (!Model.Any())
        {
            <div class="p-20 text-center flex flex-col items-center justify-center gap-6 bg-surface border border-border rounded-xl shadow-sm">
                <div class="w-24 h-24 rounded-full flex items-center justify-center animate-pulse bg-bg text-text-muted">
                    <span class="material-symbols-rounded text-6xl" aria-hidden="true">event_busy</span>
                </div>
                <div>
                    <h3 class="text-2xl font-black text-text">لا توجد حلقات مجدولة لليوم</h3>
                    <p class="max-w-md mt-2 leading-relaxed text-text-secondary">سيتم عرض الحلقات وتفاصيل الطاقم والضيوف هنا فور جدولتها في النظام لليوم الحالي.</p>
                </div>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 xl:grid-cols-2 2xl:grid-cols-3 gap-6">
                @for (int i = 0; i < Model.Count; i++)
                {
                    var episode = Model[i];
                    var isCancelled = episode.StatusId == EpisodeStatusValues.Cancelled;
                    var isNext = nextEpisode != null && episode.EpisodeId == nextEpisode.EpisodeId;

                    var borderColor = episode.StatusId switch
                    {
                        EpisodeStatusValues.Planned => "var(--color-accent)",
                        EpisodeStatusValues.Executed => "var(--color-info)",
                        EpisodeStatusValues.Published => "var(--color-success)",
                        EpisodeStatusValues.WebsitePublished => "var(--color-primary)",
                        EpisodeStatusValues.Cancelled => "var(--color-danger)",
                        _ => "var(--color-border)"
                    };

                    var displayTime = "--:--";
                    if (episode.ScheduledExecutionTime.HasValue)
                    {
                        var timeVal = episode.ScheduledExecutionTime.Value;
                        var hour12 = timeVal.Hour % 12;
                        if (hour12 == 0) hour12 = 12;
                        var ampm = timeVal.Hour >= 12 ? "مساءً" : "صباحاً";
                        displayTime = $"{hour12:D2}:{timeVal.Minute:D2} {ampm}";
                    }

                    <div class="transition-all duration-500 hover:scale-[1.02] hover:shadow-2xl animate-card-in @(isNext ? "active-pulse-glow" : "") @(isCancelled ? "opacity-60" : "")"
                         style="background:var(--color-surface);border-radius:12px;border-top:8px solid @borderColor;@(isNext ? "border-inline:1px solid var(--color-border)" : "box-shadow:var(--shadow-card)") animation-delay:@(i * 70)ms">
                        <div class="p-6 flex flex-col justify-between gap-4">
                            <div class="flex items-start justify-between gap-2 pb-4 border-b border-border">
                                <div class="flex flex-col gap-1">
                                    <div class="flex items-center gap-2">
                                        <span class="chip">
                                            <span class="material-symbols-rounded text-sm" aria-hidden="true">alarm</span>
                                            @displayTime
                                        </span>
                                        @if (isNext)
                                        {
                                            <span class="chip bg-primary-subtle text-primary border-primary">
                                                <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
                                                الحلقة التالية
                                            </span>
                                        }
                                    </div>
                                    <div class="text-xs text-primary font-extrabold tracking-wide mt-2">
                                        @episode.ProgramName
                                    </div>
                                </div>

                                <div>
                                    @await Html.PartialAsync("_StatusBadge", new StatusBadgeViewModel
                                    {
                                        Type = "episode",
                                        Status = episode.StatusId switch
                                        {
                                            EpisodeStatusValues.Planned => "planned",
                                            EpisodeStatusValues.Executed => "executed",
                                            EpisodeStatusValues.Published => "published",
                                            EpisodeStatusValues.WebsitePublished => "website-published",
                                            EpisodeStatusValues.Cancelled => "cancelled",
                                            _ => "planned"
                                        },
                                        Label = EpisodeStatusValues.GetDisplayName(episode.StatusId)
                                    })
                                </div>
                            </div>

                            <div class="flex-1">
                                <h2 class="text-xl font-extrabold flex items-center gap-2 leading-snug text-text">
                                    @episode.EpisodeName
                                </h2>
                                @if (!string.IsNullOrWhiteSpace(episode.EpisodeDescription))
                                {
                                    <p class="text-sm mt-2 line-clamp-3 leading-relaxed text-text-secondary">
                                        @episode.EpisodeDescription
                                    </p>
                                }
                            </div>

                            @if (episode.EmployeeItems.Any())
                            {
                                <div class="mt-2">
                                    <div class="text-xs font-bold mb-2.5 flex items-center gap-1 text-text-muted">
                                        <span class="material-symbols-rounded text-sm text-primary" aria-hidden="true">groups</span>
                                        طاقم العمل:
                                    </div>
                                    <div class="flex flex-wrap gap-2">
                                        @foreach (var emp in episode.EmployeeItems)
                                        {
                                            var iconName = emp.StaffRoleName switch
                                            {
                                                var r when r.Contains("مذيع") || r.Contains("مقدم") => "mic",
                                                var r when r.Contains("مخرج") => "movie",
                                                var r when r.Contains("صوت") || r.Contains("مهندس") || r.Contains("فني") => "equalizer",
                                                _ => "person"
                                            };
                                            <span class="chip">
                                                <span class="material-symbols-rounded text-xs text-primary" aria-hidden="true">@iconName</span>
                                                <span class="opacity-70">@emp.StaffRoleName:</span>
                                                <span class="font-bold">@emp.FullName</span>
                                            </span>
                                        }
                                    </div>
                                </div>
                            }

                            @if (episode.GuestItems.Any() || episode.CorrespondentItems.Any())
                            {
                                <div class="mt-2 pt-4 border-t border-border">
                                    <div class="flex flex-col gap-2.5">
                                        @if (episode.GuestItems.Any())
                                        {
                                            <div class="flex items-center gap-2 flex-wrap">
                                                <span class="text-xs font-bold text-text-muted">الضيوف:</span>
                                                @foreach (var guest in episode.GuestItems)
                                                {
                                                    <span class="chip bg-info-subtle text-info border-info">
                                                        <span class="material-symbols-rounded text-xs" aria-hidden="true">person</span>
                                                        @guest.Name
                                                    </span>
                                                }
                                            </div>
                                        }

                                        @if (episode.CorrespondentItems.Any())
                                        {
                                            <div class="flex items-center gap-2 flex-wrap">
                                                <span class="text-xs font-bold text-text-muted">المراسلون:</span>
                                                @foreach (var corr in episode.CorrespondentItems)
                                                {
                                                    <span class="chip bg-accent-subtle text-accent border-accent">
                                                        <span class="material-symbols-rounded text-xs" aria-hidden="true">record_voice_over</span>
                                                        @corr.FullName
                                                        @if (corr.HostingTime.HasValue)
                                                        {
                                                            <span class="opacity-80 text-caption font-mono">(@corr.HostingTime.Value.ToString(@"hh\:mm"))</span>
                                                        }
                                                    </span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(episode.SpecialNotes) || (isCancelled && !string.IsNullOrWhiteSpace(episode.CancellationReason)))
                            {
                                <div class="mt-2 pt-4 border-t border-border">
                                    @if (!string.IsNullOrWhiteSpace(episode.SpecialNotes))
                                    {
                                        <div class="flex items-start gap-2 py-2.5 px-4 text-xs rounded-xl bg-info-subtle text-info">
                                            <span class="material-symbols-rounded text-sm shrink-0 mt-0.5" aria-hidden="true">info</span>
                                            <span><strong>ملاحظات:</strong> @episode.SpecialNotes</span>
                                        </div>
                                    }
                                    @if (isCancelled && !string.IsNullOrWhiteSpace(episode.CancellationReason))
                                    {
                                        <div class="flex items-start gap-2 py-2.5 px-4 text-xs rounded-xl bg-danger-subtle text-danger mt-1">
                                            <span class="material-symbols-rounded text-sm shrink-0 mt-0.5" aria-hidden="true">warning</span>
                                            <span><strong>سبب الإلغاء:</strong> @episode.CancellationReason</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        let autoScrollInterval = null;
        let isAutoScrolling = false;

        function updateClock() {
            const now = new Date();
            let hours = now.getHours();
            const minutes = String(now.getMinutes()).padStart(2, '0');
            const seconds = String(now.getSeconds()).padStart(2, '0');
            const ampm = hours >= 12 ? 'مساءً' : 'صباحاً';
            hours = hours % 12 || 12;
            const strHours = String(hours).padStart(2, '0');
            const clockEl = document.getElementById('live-clock');
            if (clockEl) clockEl.textContent = `${strHours}:${minutes}:${seconds} ${ampm}`;
            const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
            const dateEl = document.getElementById('live-date');
            if (dateEl) dateEl.textContent = now.toLocaleDateString('ar-EG', options);
        }

        function updateConnectionBadge(el, bg, color, text) {
            if (!el) return;
            el.style.background = bg;
            el.style.color = color;
            var txt = el.querySelector('#connection-status-text, span:last-child');
            if (txt) txt.textContent = text;
        }

        function toggleKioskMode() {
            const body = document.body;
            const icon = document.getElementById('icon-kiosk');
            const btnText = document.querySelector('#btn-kiosk span:not(.material-symbols-rounded)');
            body.classList.toggle('kiosk-active');
            if (body.classList.contains('kiosk-active')) {
                if (document.documentElement.requestFullscreen) document.documentElement.requestFullscreen().catch(() => {});
                if (icon) icon.textContent = 'fullscreen_exit';
                if (btnText) btnText.textContent = 'خروج من الوضع الكامل';
            } else {
                if (document.exitFullscreen && document.fullscreenElement) document.exitFullscreen().catch(() => {});
                if (icon) icon.textContent = 'fullscreen';
                if (btnText) btnText.textContent = 'ملء الشاشة';
            }
        }

        function toggleAutoScroll() {
            const scrollArea = document.getElementById('liveboard-scroll-area');
            const icon = document.getElementById('icon-autoscroll');
            const btnText = document.querySelector('#btn-autoscroll span:not(.material-symbols-rounded)');
            if (!scrollArea) return;
            isAutoScrolling = !isAutoScrolling;
            if (isAutoScrolling) {
                if (icon) icon.textContent = 'pause';
                if (btnText) btnText.textContent = 'إيقاف التمرير';
                let direction = 1;
                autoScrollInterval = setInterval(() => {
                    if (scrollArea.scrollTop >= scrollArea.scrollHeight - scrollArea.clientHeight - 5) direction = -1;
                    else if (scrollArea.scrollTop <= 5) direction = 1;
                    scrollArea.scrollBy({ top: direction, behavior: 'auto' });
                }, 40);
            } else {
                if (icon) icon.textContent = 'play_arrow';
                if (btnText) btnText.textContent = 'تمرير تلقائي';
                clearInterval(autoScrollInterval);
                autoScrollInterval = null;
            }
        }

        async function refreshDashboard() {
            try {
                const resp = await fetch(window.location.href);
                if (resp.ok) {
                    const html = await resp.text();
                    const doc = new DOMParser().parseFromString(html, 'text/html');
                    const cur = document.getElementById('liveboard-content-wrapper');
                    const nw = doc.getElementById('liveboard-content-wrapper');
                    if (cur && nw) {
                        const kiosk = document.body.classList.contains('kiosk-active');
                        const top = document.getElementById('liveboard-scroll-area')?.scrollTop || 0;
                        cur.innerHTML = nw.innerHTML;
                        if (kiosk) document.body.classList.add('kiosk-active');
                        const sa = document.getElementById('liveboard-scroll-area');
                        if (sa) sa.scrollTop = top;
                        if (isAutoScrolling) { isAutoScrolling = false; toggleAutoScroll(); }
                    }
                }
            } catch (e) { console.error('Refresh error:', e); }
        }

        function initSignalR() {
            if (typeof signalR === 'undefined') {
                const el = document.getElementById('connection-indicator');
                if (el) { el.style.background = 'color-mix(in srgb, var(--color-accent) 10%, transparent)'; el.style.color = 'var(--color-accent)'; document.getElementById('connection-status-text').textContent = 'التحديث التلقائي (غير مفعل)'; }
                return;
            }
            const conn = new signalR.HubConnectionBuilder().withUrl('/hubs/notifications').withAutomaticReconnect([0, 1000, 3000, 5000, 10000, 30000]).build();
            conn.on('NotificationReceived', function (n) {
                if (n.type === 'EpisodeStatusChanged' || n.type === 'AuditLogCreated') { console.log('SignalR:', n); refreshDashboard(); }
            });
            conn.start().then(() => {
                const el = document.getElementById('connection-indicator');
                if (el) { el.className = 'inline-flex items-center gap-1 px-3 py-1.5 text-caption font-bold rounded-full bg-success-subtle text-success'; document.getElementById('connection-status-text').textContent = 'متصل بالبث الفوري'; }
            }).catch(() => {
                const el = document.getElementById('connection-indicator');
                if (el) { el.className = 'inline-flex items-center gap-1 px-3 py-1.5 text-caption font-bold rounded-full bg-danger-subtle text-danger'; document.getElementById('connection-status-text').textContent = 'فشل الاتصال بالبث المباشر'; }
            });
            conn.onreconnecting(() => {
                const el = document.getElementById('connection-indicator');
                if (el) { el.className = 'inline-flex items-center gap-1 px-3 py-1.5 text-caption font-bold rounded-full bg-warning-subtle text-warning'; document.getElementById('connection-status-text').textContent = 'إعادة الاتصال بالبث...'; }
            });
            conn.onreconnected(() => {
                const el = document.getElementById('connection-indicator');
                if (el) { el.className = 'inline-flex items-center gap-1 px-3 py-1.5 text-caption font-bold rounded-full bg-success-subtle text-success'; document.getElementById('connection-status-text').textContent = 'تمت إعادة الاتصال'; }
                refreshDashboard();
            });
            conn.onclose(() => {
                const el = document.getElementById('connection-indicator');
                if (el) { el.className = 'inline-flex items-center gap-1 px-3 py-1.5 text-caption font-bold rounded-full bg-danger-subtle text-danger'; document.getElementById('connection-status-text').textContent = 'انقطع الاتصال بالخادم'; }
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            setInterval(updateClock, 1000);
            updateClock();
            initSignalR();
            setInterval(refreshDashboard, 60000);
        });
    </script>
}
