@model EpisodeListViewModel
@using System.Text.Encodings.Web
@using Radio.Web.ViewModels
@{
    ViewData["Title"] = "إدارة الحلقات الإذاعية";
    ViewData["HeaderIcon"] = "podcasts";
    ViewData["HeaderDescription"] = "متابعة دورة حياة الحلقات من الإعداد والجدولة حتى التنفيذ والنشر";
    ViewBag.EntityName = "الحلقات";

    if (User.HasPermission(AppPermissions.EpisodesCreate))
    {
        ViewData["HeaderActions"] = "<a href='/Episodes/Create' class='btn btn-primary rounded-xl gap-2'><span class='material-symbols-rounded'>add</span>حلقة جديدة</a>";
    }

    var totalCount = Model.Episodes.Count();
    var scheduledCount = Model.Episodes.Count(e => e.StatusId == 0);
    var executedCount = Model.Episodes.Count(e => e.StatusId == 1);
    var publishedCount = Model.Episodes.Count(e => e.StatusId == 2 || e.StatusId == 3);
    var cancelledCount = Model.Episodes.Count(e => e.StatusId == 4);

    var kpiItems = new List<KpiItem>
    {
        new() { Label = "إجمالي الحلقات", Value = totalCount.ToString(), Icon = "view_list", Color = "var(--color-primary)", IconBg = "color-mix(in srgb, var(--color-primary) 10%, transparent)", IconColor = "var(--color-primary)", Subtitle = "الأرشيف الكامل" },
        new() { Label = "الحلقات المجدولة", Value = scheduledCount.ToString(), Icon = "event_upcoming", Color = "var(--color-info)", IconBg = "color-mix(in srgb, var(--color-info) 10%, transparent)", IconColor = "var(--color-info)", Subtitle = "قيد الجدولة للبث" },
        new() { Label = "الحلقات المنفذة", Value = executedCount.ToString(), Icon = "task_alt", Color = "var(--color-success)", IconBg = "color-mix(in srgb, var(--color-success) 10%, transparent)", IconColor = "var(--color-success)", Subtitle = "تم تنفيذها وتسجيلها" },
        new() { Label = "الحلقات المنشورة", Value = publishedCount.ToString(), Icon = "podcasts", Color = "var(--color-accent)", IconBg = "color-mix(in srgb, var(--color-accent) 10%, transparent)", IconColor = "var(--color-accent)", Subtitle = "منشورة رقمياً وعلى الموقع" }
    };
    ViewBag.KpiItems = kpiItems;
    ViewBag.PaginationLabel = "حلقة";
}

<partial name="_PageHeader" />
<partial name="_KpiCards" />

<!-- Episodes Grid -->
@if (!Model.Episodes.Any())
{
    <div class="glass-card rounded-xl p-12">
        ViewBag.EmptyIcon = "podcasts_off";
        ViewBag.EmptyTitle = "لا توجد حلقات مطابقة";
        ViewBag.EmptyDesc = "لم يتم العثور على نتائج تطابق معايير البحث الحالية. يمكنك إعادة ضبط البحث أو إضافة حلقة جديدة.";
        ViewBag.EmptyActionUrl = "/Episodes/Create";
        ViewBag.EmptyActionText = "إضافة حلقة";
        ViewBag.EmptyActionIcon = "add";
        <partial name="_EmptyState" />
    </div>
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mb-8">
        @foreach (var ep in Model.Episodes)
        {
            var statusDetails = GetStatusDetails(ep.StatusId);

            <div class="glass-card rounded-xl overflow-hidden group hover:shadow-lg transition-all duration-200 flex flex-col">
                <!-- Card Header -->
                <div class="p-4 flex items-center justify-between gap-3 border-b border-border/60">
                    <span class="chip gap-1.5" style="background: @statusDetails.BgColor; color: @statusDetails.Color;">
                        <span class="material-symbols-rounded text-sm">@statusDetails.Icon</span>
                        @ep.StatusText
                    </span>
                    <span class="type-caption-md text-ink-muted inline-flex items-center gap-1 bg-surface-2 px-2 py-1 rounded-lg">
                        <span class="material-symbols-rounded text-sm">radio</span>
                        @ep.ProgramName
                    </span>
                </div>

                <!-- Card Body -->
                <div class="p-4 flex-1 flex flex-col gap-3">
                    <a href="/Episodes/Details/@ep.EpisodeId" class="type-body-md font-semibold text-ink hover:text-primary transition-colors line-clamp-2">
                        @ep.EpisodeName
                    </a>

                    @if (!string.IsNullOrWhiteSpace(ep.SpecialNotes))
                    {
                        <p class="type-caption-md text-ink-muted line-clamp-2 p-2.5 rounded-lg bg-surface-2 border border-border/60">
                            @ep.SpecialNotes
                        </p>
                    }

                    <div class="flex items-center justify-between text-xs p-3 rounded-lg bg-surface-2">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-rounded text-base text-primary">calendar_today</span>
                            <div>
                                <span class="type-body-sm font-semibold text-ink block">
                                    @(ep.ScheduledExecutionTime.HasValue ? ep.ScheduledExecutionTime.Value.ToString("dddd", new System.Globalization.CultureInfo("ar")) : "غير محدد")
                                </span>
                                <span class="type-caption-md text-ink-muted">
                                    @(ep.ScheduledExecutionTime.HasValue ? ep.ScheduledExecutionTime.Value.ToString("yyyy-MM-dd") : "—")
                                </span>
                            </div>
                        </div>
                        <div class="flex items-center gap-1.5 type-body-sm font-semibold text-primary">
                            <span class="material-symbols-rounded text-sm">schedule</span>
                            @(ep.ScheduledExecutionTime.HasValue ? ep.ScheduledExecutionTime.Value.ToString("hh:mm tt", new System.Globalization.CultureInfo("ar")) : "—")
                        </div>
                    </div>

                    <div class="flex items-center justify-between">
                        <span class="type-caption-md text-ink-muted">الضيوف:</span>
                        @if (ep.GuestItems.Any())
                        {
                            <span class="chip gap-1 bg-primary-soft text-primary">
                                <span class="material-symbols-rounded text-sm">people</span>
                                @ep.GuestItems.Count ضيف
                            </span>
                        }
                        else
                        {
                            <span class="type-caption-md text-ink-soft">لا يوجد</span>
                        }
                    </div>
                </div>

                <!-- Card Footer -->
                <div class="p-3 flex items-center justify-between gap-2 bg-surface-2 border-t border-border/60">
                    <div class="flex items-center gap-1">
                        <a href="/Episodes/Details/@ep.EpisodeId" class="btn btn-ghost btn-xs rounded-lg gap-1 text-ink-muted font-semibold" title="التفاصيل">
                            <span class="material-symbols-rounded text-sm">visibility</span>
                            التفاصيل
                        </a>
                        <a href="/Publishing?episodeId=@ep.EpisodeId" class="btn btn-ghost btn-xs rounded-lg text-ink-muted" title="النشر">
                            <span class="material-symbols-rounded text-sm">share</span>
                        </a>
                        @if (User.HasPermission(AppPermissions.EpisodeEdit))
                        {
                            <a href="/Episodes/Edit/@ep.EpisodeId" class="btn btn-ghost btn-xs rounded-lg text-ink-muted" title="تعديل">
                                <span class="material-symbols-rounded text-sm">edit</span>
                            </a>
                        }
                    </div>
                    <div class="flex items-center gap-1">
                        @if (User.HasPermission(AppPermissions.EpisodeExecute) && ep.StatusId == 0)
                        {
                            <button type="button" class="btn btn-success btn-xs rounded-lg gap-1"
                                    onclick="openExecuteModal(@ep.EpisodeId, '@JavaScriptEncoder.Default.Encode(ep.EpisodeName)')">
                                <span class="material-symbols-rounded text-sm">play_circle</span>
                                تنفيذ
                            </button>
                        }
                        @if (User.HasPermission(AppPermissions.EpisodeRevert) && ep.CanCancel)
                        {
                            <button type="button" class="btn btn-error btn-xs btn-outline rounded-lg"
                                    onclick="openCancelModal(@ep.EpisodeId, '@JavaScriptEncoder.Default.Encode(ep.EpisodeName)')">
                                <span class="material-symbols-rounded text-sm">cancel</span>
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Modal: Execute Episode -->
@{
    ViewBag.ModalId = "executeModal";
    ViewBag.ModalTitle = "تسجيل تنفيذ الحلقة";
    ViewBag.ModalMessage = "تأكيد تنفيذ البث وإدخال الملاحظات الفنية";
    ViewBag.ModalIcon = "task_alt";
    ViewBag.ModalIconBg = "var(--color-success-subtle)";
    ViewBag.ModalIconColor = "var(--color-success)";
    ViewBag.ModalConfirmText = "تأكيد التسجيل";
    ViewBag.ModalFormAction = "";
    ViewBag.ModalBody = Html.Raw(@"<div class=""space-y-4"">
        <div>
            <label class=""text-xs font-semibold text-text-muted block mb-1.5"">ملاحظات التنفيذ</label>
            <textarea name=""executionNotes"" rows=""3""
                      class=""w-full bg-surface-hover border border-border rounded-lg px-3 py-2.5 text-sm text-text placeholder:text-text-muted focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary-subtle transition-all""
                      placeholder=""ملاحظات حول أداء الحلقة أو البث...""></textarea>
        </div>
        <div>
            <label class=""text-xs font-semibold text-text-muted block mb-1.5"">مشكلات واجهت التنفيذ</label>
            <textarea name=""issuesEncountered"" rows=""2""
                      class=""w-full bg-surface-hover border border-border rounded-lg px-3 py-2.5 text-sm text-text placeholder:text-text-muted focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary-subtle transition-all""
                      placeholder=""المشاكل الفنية أو الصوتية إن وجدت...""></textarea>
        </div>
        <div>
            <label class=""text-xs font-semibold text-text-muted block mb-1.5"">المدة الفعلية (بالدقائق) *</label>
            <input type=""number"" name=""durationMinutes"" min=""1"" max=""720"" value=""60"" required
                   class=""w-full bg-surface-hover border border-border rounded-lg px-3 py-2.5 text-sm text-text focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary-subtle transition-all"" />
        </div>
    </div>");
}
<partial name="_ConfirmModal" />

<!-- Modal: Cancel Episode -->
@{
    ViewBag.ModalId = "cancelModal";
    ViewBag.ModalTitle = "إلغاء الحلقة الإذاعية";
    ViewBag.ModalMessage = "هل أنت متأكد من إلغاء الحلقة المجدولة؟";
    ViewBag.ModalIcon = "warning";
    ViewBag.ModalIconBg = "var(--color-danger-subtle)";
    ViewBag.ModalIconColor = "var(--color-danger)";
    ViewBag.ModalConfirmText = "تأكيد الإلغاء";
    ViewBag.ModalFormAction = "";
    ViewBag.ModalDestructive = true;
    ViewBag.ModalBody = Html.Raw(@"<div>
        <label class=""text-xs font-semibold text-text-muted block mb-1.5"">سبب الإلغاء *</label>
        <textarea name=""reason"" rows=""3"" required
                  class=""w-full bg-surface-hover border border-border rounded-lg px-3 py-2.5 text-sm text-text placeholder:text-text-muted focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary-subtle transition-all""
                  placeholder=""يرجى كتابة سبب الإلغاء بالتفصيل...""></textarea>
    </div>");
}
<partial name="_ConfirmModal" />

@section Scripts {
    <script>
        function openExecuteModal(id, name) {
            document.getElementById('executeModalForm').action = '/Episodes/Execute/' + id;
            document.getElementById('executeModal').showModal();
        }
        function openCancelModal(id, name) {
            document.getElementById('cancelModalForm').action = '/Episodes/Cancel/' + id;
            document.getElementById('cancelModal').showModal();
        }
        function closeModal(id) {
            document.getElementById(id).close();
        }
    </script>
}

@functions {
    (string BgColor, string Color, string Icon) GetStatusDetails(byte statusId) => statusId switch
    {
        0 => ("var(--status-planned-bg)", "var(--status-planned-text)", "event"),
        1 => ("var(--status-executed-bg)", "var(--status-executed-text)", "task_alt"),
        2 => ("var(--status-published-bg)", "var(--status-published-text)", "share"),
        3 => ("var(--status-website-bg)", "var(--status-website-text)", "language"),
        4 => ("var(--status-cancelled-bg)", "var(--status-cancelled-text)", "cancel"),
        _ => ("var(--color-bg-hover)", "var(--color-text-secondary)", "help")
    };
}
