@model EpisodeListViewModel
@using System.Text.Encodings.Web
@using Radio.Web.ViewModels
@{
    ViewData["Title"] = "إدارة الحلقات الإذاعية";
    ViewData["HeaderIcon"] = "podcasts";
    ViewData["HeaderDescription"] = "متابعة دورة حياة الحلقات من الإعداد والجدولة حتى التنفيذ والنشر";
    ViewBag.EntityName = "الحلقات";

    if (User.HasPermission(AppPermissions.EpisodesCreate))
    {
        ViewData["HeaderActions"] = "<a href='/Episodes/Create' class='btn btn-primary'><span class='material-symbols-rounded'>add</span>حلقة جديدة</a>";
    }

    ViewBag.KpiItems = Model.KpiItems;
    ViewBag.PaginationLabel = "حلقة";

    string StatusKey(byte statusId) => statusId switch
    {
        0 => "planned",
        1 => "executed",
        2 => "published",
        3 => "website-published",
        4 => "cancelled",
        _ => "planned"
    };

    var statusOptions = new[] {
        new { Value = "", Label = "جميع الحالات" },
        new { Value = "0", Label = "مجدولة" },
        new { Value = "1", Label = "منفّذة" },
        new { Value = "2", Label = "منشورة رقمياً" },
        new { Value = "3", Label = "منشورة على الموقع" },
        new { Value = "4", Label = "ملغاة" }
    };
}

<partial name="_PageHeader" />
<partial name="_KpiCards" />

<div class="card p-5 mb-6">
    <form method="get" class="flex flex-col sm:flex-row gap-3">
        <div class="relative flex-1">
            <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-text-muted">search</span>
            <input type="text" name="search" value="@Model.SearchTerm" placeholder="بحث في الحلقات، الضيوف، والبرامج..."
                   class="input pr-10" />
            @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
            {
                <a href="@Context.Request.Path" class="absolute left-3 top-1/2 -translate-y-1/2 text-text-muted hover:text-text" title="مسح البحث">
                    <span class="material-symbols-rounded text-lg">close</span>
                </a>
            }
        </div>
        <select name="status" class="input sm:w-44">
            @foreach (var opt in statusOptions)
            {
                var isSelected = Model.StatusFilter.HasValue && Model.StatusFilter.Value.ToString() == opt.Value;
                <option value="@opt.Value" selected="@(isSelected ? "selected" : null)">@opt.Label</option>
            }
        </select>
        <select name="programId" class="input sm:w-44">
            <option value="">جميع البرامج</option>
            @foreach (var prog in Model.Programs)
            {
                var isSelected = Model.ProgramFilter.HasValue && Model.ProgramFilter.Value == prog.ProgramId;
                <option value="@prog.ProgramId" selected="@(isSelected ? "selected" : null)">@prog.ProgramName</option>
            }
        </select>
        <button type="submit" class="btn btn-primary shrink-0">
            <span class="material-symbols-rounded">filter_alt</span>
            تصفية
        </button>
        @if (!string.IsNullOrWhiteSpace(Model.SearchTerm) || Model.StatusFilter.HasValue || Model.ProgramFilter.HasValue)
        {
            <a href="/Episodes" class="btn btn-ghost shrink-0">
                <span class="material-symbols-rounded">restart_alt</span>
            </a>
        }
    </form>
</div>

@if (!Model.Episodes.Any())
{
    ViewBag.EmptyIcon = "podcasts_off";
    ViewBag.EmptyTitle = "لا توجد حلقات مطابقة";
    ViewBag.EmptyDesc = "لم يتم العثور على نتائج تطابق معايير البحث الحالية. يمكنك إعادة ضبط البحث أو إضافة حلقة جديدة.";
    ViewBag.EmptyActionUrl = "/Episodes/Create";
    ViewBag.EmptyActionText = "إضافة حلقة";
    ViewBag.EmptyActionIcon = "add";
    <partial name="_EmptyState" />
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        @foreach (var ep in Model.Episodes)
        {
            <div class="card overflow-hidden flex flex-col">
                <div class="p-4 flex items-center justify-between gap-3 border-b border-border-light">
                    <partial name="_StatusBadge" model='new StatusBadgeViewModel { Type = "episode", Status = StatusKey(ep.StatusId), Label = ep.StatusText }' />
                    <span class="meta-pill">
                        <span class="material-symbols-rounded text-sm">radio</span>
                        @ep.ProgramName
                    </span>
                </div>

                <div class="p-4 flex-1 flex flex-col gap-3">
                    <a href="/Episodes/Details/@ep.EpisodeId" class="text-body font-semibold text-text hover:text-primary transition-colors line-clamp-2">
                        @ep.EpisodeName
                    </a>

                    @if (!string.IsNullOrWhiteSpace(ep.SpecialNotes))
                    {
                        <p class="text-caption text-text-muted line-clamp-2 p-2.5 rounded-lg bg-bg border border-border-light">
                            @ep.SpecialNotes
                        </p>
                    }

                    <div class="flex items-center justify-between text-caption p-3 rounded-lg bg-bg-hover mt-auto">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-rounded text-base text-primary" aria-hidden="true">calendar_today</span>
                            <div>
                                <span class="text-body font-semibold text-text block">
                                    @(ep.ScheduledExecutionTime.HasValue ? ep.ScheduledExecutionTime.Value.ToString("dddd", new System.Globalization.CultureInfo("ar")) : "غير محدد")
                                </span>
                                <span class="text-caption text-text-muted">
                                    @(ep.ScheduledExecutionTime.HasValue ? ep.ScheduledExecutionTime.Value.ToString("yyyy-MM-dd") : "—")
                                </span>
                            </div>
                        </div>
                        <div class="flex items-center gap-1.5 text-body font-semibold text-primary">
                            <span class="material-symbols-rounded text-sm" aria-hidden="true">schedule</span>
                            @(ep.ScheduledExecutionTime.HasValue ? ep.ScheduledExecutionTime.Value.ToString("hh:mm tt", new System.Globalization.CultureInfo("ar")) : "—")
                        </div>
                    </div>

                    <div class="flex items-center justify-between">
                        <span class="text-caption text-text-muted">الضيوف:</span>
                        @if (ep.GuestItems.Any())
                        {
                            <span class="chip bg-primary-subtle text-primary">
                                <span class="material-symbols-rounded text-sm" aria-hidden="true">people</span>
                                @ep.GuestItems.Count ضيف
                            </span>
                        }
                        else
                        {
                            <span class="text-caption text-text-secondary">لا يوجد</span>
                        }
                    </div>
                </div>

                <div class="p-3 flex items-center justify-between gap-2 bg-bg-hover border-t border-border-light">
                    <div class="flex items-center gap-1">
                        <a href="/Episodes/Details/@ep.EpisodeId" class="btn btn-ghost btn-xs text-text-muted" title="التفاصيل">
                            <span class="material-symbols-rounded text-sm" aria-hidden="true">visibility</span>
                            التفاصيل
                        </a>
                        <a href="/Publishing?episodeId=@ep.EpisodeId" class="btn btn-ghost btn-xs text-text-muted" title="النشر">
                            <span class="material-symbols-rounded text-sm" aria-hidden="true">share</span>
                        </a>
                        @if (User.HasPermission(AppPermissions.EpisodesEdit))
                        {
                            <a href="/Episodes/Edit/@ep.EpisodeId" class="btn btn-ghost btn-xs text-text-muted" title="تعديل">
                                <span class="material-symbols-rounded text-sm" aria-hidden="true">edit</span>
                            </a>
                        }
                    </div>
                    <div class="flex items-center gap-1">
                        @if (User.HasPermission(AppPermissions.ExecutionExecute) && ep.StatusId == 0)
                        {
                            <button type="button" class="btn btn-success btn-xs"
                                    onclick="openExecuteModal(@ep.EpisodeId, '@JavaScriptEncoder.Default.Encode(ep.EpisodeName)')">
                                <span class="material-symbols-rounded text-sm" aria-hidden="true">play_circle</span>
                                تنفيذ
                            </button>
                        }
                        @if (User.HasPermission(AppPermissions.ExecutionCancel) && ep.CanCancel)
                        {
                            <button type="button" class="btn btn-destructive btn-xs btn-outline"
                                    onclick="openCancelModal(@ep.EpisodeId, '@JavaScriptEncoder.Default.Encode(ep.EpisodeName)')">
                                <span class="material-symbols-rounded text-sm" aria-hidden="true">cancel</span>
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@{
    ViewBag.ModalId = "executeModal";
    ViewBag.ModalTitle = "تسجيل تنفيذ الحلقة";
    ViewBag.ModalMessage = "تأكيد تنفيذ البث وإدخال الملاحظات الفنية";
    ViewBag.ModalIcon = "task_alt";
    ViewBag.ModalIconBg = "var(--color-success-subtle)";
    ViewBag.ModalIconColor = "var(--color-success)";
    ViewBag.ModalConfirmText = "تأكيد التسجيل";
    ViewBag.ModalFormAction = "";
    ViewBag.ModalBody = Html.Raw(@"<div class=""space-y-4"">
        <div>
            <label class=""text-label font-semibold text-text-muted block mb-1.5"">ملاحظات التنفيذ</label>
            <textarea name=""executionNotes"" rows=""3"" class=""input"" placeholder=""ملاحظات حول أداء الحلقة أو البث...""></textarea>
        </div>
        <div>
            <label class=""text-label font-semibold text-text-muted block mb-1.5"">مشكلات واجهت التنفيذ</label>
            <textarea name=""issuesEncountered"" rows=""2"" class=""input"" placeholder=""المشاكل الفنية أو الصوتية إن وجدت...""></textarea>
        </div>
        <div>
            <label class=""text-label font-semibold text-text-muted block mb-1.5"">المدة الفعلية (بالدقائق) *</label>
            <input type=""number"" name=""durationMinutes"" min=""1"" max=""720"" value=""60"" required class=""input"" />
        </div>
    </div>");
}
<partial name="_ConfirmModal" />

@{
    ViewBag.ModalId = "cancelModal";
    ViewBag.ModalTitle = "إلغاء الحلقة الإذاعية";
    ViewBag.ModalMessage = "هل أنت متأكد من إلغاء الحلقة المجدولة؟";
    ViewBag.ModalIcon = "warning";
    ViewBag.ModalIconBg = "var(--color-danger-subtle)";
    ViewBag.ModalIconColor = "var(--color-danger)";
    ViewBag.ModalConfirmText = "تأكيد الإلغاء";
    ViewBag.ModalFormAction = "";
    ViewBag.ModalDestructive = true;
    ViewBag.ModalBody = Html.Raw(@"<div>
        <label class=""text-label font-semibold text-text-muted block mb-1.5"">سبب الإلغاء *</label>
        <textarea name=""reason"" rows=""3"" required class=""input"" placeholder=""يرجى كتابة سبب الإلغاء بالتفصيل...""></textarea>
    </div>");
}
<partial name="_ConfirmModal" />

@section Scripts {
    <script>
        function openExecuteModal(id, name) {
            document.getElementById('executeModalForm').action = '/Episodes/Execute/' + id;
            document.getElementById('executeModal').showModal();
        }
        function openCancelModal(id, name) {
            document.getElementById('cancelModalForm').action = '/Episodes/Cancel/' + id;
            document.getElementById('cancelModal').showModal();
        }
        function closeModal(id) {
            document.getElementById(id).close();
        }
    </script>
}
