@model EpisodeEditViewModel
@{
    ViewData["Title"] = Model.Episode.EpisodeId == 0 ? "حلقة جديدة" : "تعديل حلقة";
    var isEdit = Model.Episode.EpisodeId != 0;
    ViewData["HeaderIcon"] = isEdit ? "edit" : "add";
    ViewData["HeaderDescription"] = "إدخال وتعديل البيانات والتفاصيل والضيوف المشاركين في الحلقة";
    ViewBag.IsEdit = isEdit;
    ViewBag.EntityName = "الحلقات";
    ViewBag.EntityUrl = "/Episodes";
    ViewBag.BackUrl = "/Episodes";
    ViewBag.BackText = "الرجوع للحلقات";
}

<partial name="_PageHeader" />

<form method="post" action="@(isEdit ? $"/Episodes/Edit/{Model.Episode.EpisodeId}" : "/Episodes/Create")" id="episodeForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="EpisodeId" value="@Model.Episode.EpisodeId" />

    @if (ViewContext.ModelState.ErrorCount > 0)
    {
        <div asp-validation-summary="All" class="rounded-lg p-4 mb-6 font-semibold text-sm bg-danger/5 border border-danger/20 text-danger"></div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

        <div class="lg:col-span-8 space-y-6">

            <div class="glass-card rounded-xl p-6">
                <div class="flex items-center gap-3 mb-4 pb-3 border-b border-border/60">
                    <div class="w-9 h-9 rounded-lg bg-primary-soft text-primary flex items-center justify-center">
                        <span class="material-symbols-rounded text-xl">info</span>
                    </div>
                    <h3 class="type-title-lg text-ink">المعلومات الأساسية</h3>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="type-label-md text-ink-muted mb-1.5 block">البرنامج *</label>
                        <div class="relative">
                            <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-lg text-ink-soft">radio</span>
                            <select name="ProgramId" class="w-full bg-surface-2 border border-border/60 rounded-lg py-2.5 pr-10 pl-3 text-sm text-ink focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/15 transition-all appearance-none" required>
                                <option value="">— اختر البرنامج —</option>
                                @foreach (var p in Model.Programs)
                                {
                                    <option value="@p.ProgramId" selected="@(Model.Episode.ProgramId == p.ProgramId)">@p.ProgramName</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div>
                        <label class="type-label-md text-ink-muted mb-1.5 block">عنوان الحلقة *</label>
                        <div class="relative">
                            <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-lg text-ink-soft">edit</span>
                            <input type="text" name="EpisodeName" value="@Model.Episode.EpisodeName"
                                   class="w-full bg-surface-2 border border-border/60 rounded-lg py-2.5 pr-10 pl-3 text-sm text-ink focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/15 transition-all"
                                   required placeholder="مثال: حلقة السبت" />
                        </div>
                    </div>
                    <div class="md:col-span-2">
                        <label class="type-label-md text-ink-muted mb-1.5 block">وصف الحلقة</label>
                        <div class="relative">
                            <span class="material-symbols-rounded absolute right-3 pointer-events-none text-lg text-ink-soft" style="top: 1rem; transform: none;">description</span>
                            <textarea name="EpisodeDescription" rows="4" class="w-full bg-surface-2 border border-border/60 rounded-lg py-2.5 pr-10 pl-3 text-sm text-ink focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/15 transition-all"
                                      placeholder="وصف مختصر لمحتوى الحلقة وموضوعاتها الرئيسية…">@Model.Episode.EpisodeDescription</textarea>
                        </div>
                    </div>
                    <div class="md:col-span-2">
                        <label class="type-label-md text-ink-muted mb-1.5 block">ملاحظات خاصة</label>
                        <div class="relative">
                            <span class="material-symbols-rounded absolute right-3 pointer-events-none text-lg text-ink-soft" style="top: 1rem; transform: none;">notes</span>
                            <textarea name="SpecialNotes" rows="3" class="w-full bg-surface-2 border border-border/60 rounded-lg py-2.5 pr-10 pl-3 text-sm text-ink focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/15 transition-all"
                                      placeholder="ملاحظات داخلية حول التحضير والإنتاج…">@Model.Episode.SpecialNotes</textarea>
                        </div>
                    </div>
                </div>
            </div>

            <div class="glass-card rounded-xl p-6">
                <div class="flex items-center justify-between gap-2 mb-4 pb-3 border-b border-border/60">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-lg bg-primary-soft text-primary flex items-center justify-center">
                            <span class="material-symbols-rounded text-xl">people_alt</span>
                        </div>
                        <h3 class="type-title-lg text-ink">الضيوف</h3>
                    </div>
                    <button type="button" class="btn btn-success btn-sm rounded-lg gap-1" onclick="EP.addRow('guests-container','guest-row-tpl')">
                        <span class="material-symbols-rounded text-sm">add</span>
                        إضافة ضيف
                    </button>
                </div>
                <div id="guests-container" data-empty="true" class="space-y-3">
                    @if (Model.Episode.Guests.Any())
                    {
                        @for (int i = 0; i < Model.Episode.Guests.Count; i++)
                        {
                            var g = Model.Episode.Guests[i];
                            <div class="ep-row guest-row" draggable="true">
                                <input type="hidden" name="Guests[@i].EpisodeGuestId" value="@g.EpisodeGuestId" />
                                <div class="ep-row-handle" title="سحب لإعادة الترتيب"><span class="material-symbols-rounded">drag_indicator</span></div>
                                <div class="ep-row-body">
                                    <div class="ep-row-fields">
                                        <div class="ep-field flex-1">
                                            <select name="Guests[@i].GuestId" class="w-full rounded-lg py-2 px-3 text-sm focus:outline-none focus:ring-2 transition-all"
                                                    style="background: var(--color-bg); border: 1px solid var(--color-border); color: var(--color-text); --tw-ring-color: var(--color-primary);">
                                                <option value="">— اختر الضيف —</option>
                                                @foreach (var guest in Model.Guests)
                                                {
                                                    <option value="@guest.GuestId" selected="@(g.GuestId == guest.GuestId)">@guest.FullName</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="ep-field flex-1">
                                            <input type="text" name="Guests[@i].Topic" value="@g.Topic" class="w-full rounded-lg py-2 px-3 text-sm focus:outline-none focus:ring-2 transition-all"
                                                   style="background: var(--color-bg); border: 1px solid var(--color-border); color: var(--color-text); --tw-ring-color: var(--color-primary);" placeholder="موضوع الاستضافة" />
                                        </div>
                                        <div class="ep-field w-28">
                                            <input type="text" name="Guests[@i].HostingTime" value="@(g.HostingTime?.ToString(@"hh\:mm"))" class="w-full rounded-lg py-2 px-3 text-sm focus:outline-none focus:ring-2 transition-all timepicker"
                                                   style="background: var(--color-bg); border: 1px solid var(--color-border); color: var(--color-text); --tw-ring-color: var(--color-primary);" />
                                        </div>
                                        <input type="hidden" name="Guests[@i].ClipNotes" value="@g.ClipNotes" />
                                    </div>
                                    <div class="ep-row-actions">
                                        <button type="button" class="ep-row-del" title="حذف" onclick="EP.removeRow(this)">
                                            <span class="material-symbols-rounded">close</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="flex flex-col items-center justify-center py-8 text-center rounded-xl border-2 border-dashed"
                             style="background: var(--color-bg); border-color: var(--color-border);">
                            <span class="material-symbols-rounded text-3xl mb-2 text-[var(--color-text-4)]">groups</span>
                            <p class="text-sm font-bold text-[var(--color-text-3)]">لم تتم إضافة ضيوف بعد</p>
                            <p class="text-xs mt-1 text-[var(--color-text-4)]">انقر على زر الإضافة أعلاه لتسجيل ضيف في الحلقة</p>
                        </div>
                    }
                </div>
            </div>

            <div class="glass-card rounded-xl p-6">
                <div class="flex items-center justify-between gap-2 mb-4 pb-3 border-b border-border/60">
                    <div class="flex items-center gap-2">
                        <div class="w-9 h-9 rounded-lg bg-primary-soft text-primary flex items-center justify-center">
                            <span class="material-symbols-rounded text-lg">map</span>
                        </div>
                        <h3 class="font-bold text-ink">المراسلون</h3>
                    </div>
                    <button type="button" class="btn btn-success btn-sm rounded-xl gap-1" onclick="EP.addRow('correspondents-container','corr-row-tpl')">
                        <span class="material-symbols-rounded text-sm">add</span>
                        إضافة مراسل
                    </button>
                </div>
                <div id="correspondents-container" data-empty="true" class="space-y-3">
                    @if (Model.Episode.Correspondents.Any())
                    {
                        @for (int i = 0; i < Model.Episode.Correspondents.Count; i++)
                        {
                            var c = Model.Episode.Correspondents[i];
                            <div class="ep-row corr-row" draggable="true">
                                <input type="hidden" name="Correspondents[@i].Id" value="@c.Id" />
                                <div class="ep-row-handle" title="سحب لإعادة الترتيب"><span class="material-symbols-rounded">drag_indicator</span></div>
                                <div class="ep-row-body">
                                    <div class="ep-row-fields">
                                        <div class="ep-field flex-1">
                                            <select name="Correspondents[@i].CorrespondentId" class="w-full rounded-lg py-2 px-3 text-sm focus:outline-none focus:ring-2 transition-all"
                                                    style="background: var(--color-bg); border: 1px solid var(--color-border); color: var(--color-text); --tw-ring-color: var(--color-primary);">
                                                <option value="">— اختر —</option>
                                                @foreach (var cor in Model.Correspondents)
                                                {
                                                    <option value="@cor.CorrespondentId" selected="@(c.CorrespondentId == cor.CorrespondentId)">@cor.FullName</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="ep-field flex-1">
                                            <input type="text" name="Correspondents[@i].Topic" value="@c.Topic" class="w-full rounded-lg py-2 px-3 text-sm focus:outline-none focus:ring-2 transition-all"
                                                   style="background: var(--color-bg); border: 1px solid var(--color-border); color: var(--color-text); --tw-ring-color: var(--color-primary);" placeholder="موضوع التغطية" />
                                        </div>
                                        <div class="ep-field w-28">
                                            <input type="text" name="Correspondents[@i].HostingTime" value="@(c.HostingTime?.ToString(@"hh\:mm"))" class="w-full rounded-lg py-2 px-3 text-sm focus:outline-none focus:ring-2 transition-all timepicker"
                                                   style="background: var(--color-bg); border: 1px solid var(--color-border); color: var(--color-text); --tw-ring-color: var(--color-primary);" />
                                        </div>
                                    </div>
                                    <div class="ep-row-actions">
                                        <button type="button" class="ep-row-del" title="حذف" onclick="EP.removeRow(this)">
                                            <span class="material-symbols-rounded">close</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="flex flex-col items-center justify-center py-8 text-center rounded-xl border-2 border-dashed"
                             style="background: var(--color-bg); border-color: var(--color-border);">
                            <span class="material-symbols-rounded text-3xl mb-2 text-[var(--color-text-4)]">map</span>
                            <p class="text-sm font-bold text-[var(--color-text-3)]">لم تتم إضافة مراسلين بعد</p>
                            <p class="text-xs mt-1 text-[var(--color-text-4)]">انقر على زر الإضافة لتسجيل مراسل ميداني للتغطية</p>
                        </div>
                    }
                </div>
            </div>

            <div class="glass-card rounded-xl p-6">
                <div class="flex items-center justify-between gap-2 mb-4 pb-3 border-b border-border/60">
                    <div class="flex items-center gap-2">
                        <div class="w-9 h-9 rounded-lg bg-primary-soft text-primary flex items-center justify-center">
                            <span class="material-symbols-rounded text-lg">badge</span>
                        </div>
                        <h3 class="font-bold text-ink">طاقم العمل والإنتاج</h3>
                    </div>
                    <button type="button" class="btn btn-success btn-sm rounded-xl gap-1" onclick="EP.addRow('employees-container','emp-row-tpl')">
                        <span class="material-symbols-rounded text-sm">add</span>
                        إضافة عضو للطاقم
                    </button>
                </div>
                <div id="employees-container" data-empty="true" class="space-y-3">
                    @if (Model.Episode.Employees.Any())
                    {
                        @for (int i = 0; i < Model.Episode.Employees.Count; i++)
                        {
                            var e = Model.Episode.Employees[i];
                            <div class="ep-row emp-row" draggable="true">
                                <input type="hidden" name="Employees[@i].Id" value="@e.Id" />
                                <div class="ep-row-handle" title="سحب لإعادة الترتيب"><span class="material-symbols-rounded">drag_indicator</span></div>
                                <div class="ep-row-body">
                                    <div class="ep-row-fields">
                                        <div class="ep-field flex-1">
                                            <select name="Employees[@i].EmployeeId" class="w-full rounded-lg py-2 px-3 text-sm focus:outline-none focus:ring-2 transition-all"
                                                    style="background: var(--color-bg); border: 1px solid var(--color-border); color: var(--color-text); --tw-ring-color: var(--color-primary);">
                                                <option value="">— اختر عضو الطاقم —</option>
                                                @foreach (var emp in Model.Employees)
                                                {
                                                    <option value="@emp.EmployeeId" selected="@(e.EmployeeId == emp.EmployeeId)">
                                                        @emp.FullName@(emp.StaffRoleName != null ? $" — {emp.StaffRoleName}" : "")
                                                    </option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="ep-row-actions">
                                        <button type="button" class="ep-row-del" title="حذف" onclick="EP.removeRow(this)">
                                            <span class="material-symbols-rounded">close</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="flex flex-col items-center justify-center py-8 text-center rounded-xl border-2 border-dashed"
                             style="background: var(--color-bg); border-color: var(--color-border);">
                            <span class="material-symbols-rounded text-3xl mb-2 text-[var(--color-text-4)]">badge</span>
                            <p class="text-sm font-bold text-[var(--color-text-3)]">لم يتم إضافة أي موظف للطاقم بعد</p>
                            <p class="text-xs mt-1 text-[var(--color-text-4)]">انقر على زر الإضافة لتسجيل أعضاء فريق الإنتاج</p>
                        </div>
                    }
                </div>
            </div>

        </div>

        <div class="lg:col-span-4 space-y-6 lg:sticky lg:top-6">

            @if (isEdit)
            {
                <div class="glass-card rounded-xl p-6">
                    <div class="flex items-center gap-2 mb-4 pb-3 border-b border-border/60">
                        <div class="w-9 h-9 rounded-lg bg-primary-soft text-primary flex items-center justify-center">
                            <span class="material-symbols-rounded text-lg">timeline</span>
                        </div>
                        <h3 class="font-bold text-ink">مسار الحلقة</h3>
                    </div>
                    <div class="status-timeline">
                        @{
                            var stages = new[] {
                                new { Id = 0, Name = "مجدولة",       Icon = "calendar_today" },
                                new { Id = 1, Name = "منفّذة",        Icon = "play_circle" },
                                new { Id = 2, Name = "منشورة رقمياً", Icon = "share" },
                                new { Id = 3, Name = "منشورة على الموقع", Icon = "public" }
                            };
                            var sid = Model.StatusId;
                            var isCancelled = sid == 4;
                        }
                        @for (int i = 0; i < stages.Length; i++)
                        {
                            var s = stages[i];
                            var cls = sid > s.Id ? "done" : (sid == s.Id ? "active" : "");
                            <div class="status-timeline-item @cls">
                                <div class="status-timeline-dot"></div>
                                <div class="status-timeline-text">@s.Name</div>
                                @if (sid == s.Id && !isCancelled)
                                {
                                    <div class="status-timeline-date font-bold text-[var(--color-primary)]">الحالية</div>
                                }
                            </div>
                        }
                        @if (isCancelled)
                        {
                            <div class="status-timeline-item cancelled">
                                <div class="status-timeline-dot"></div>
                                <div class="status-timeline-text">ملغاة</div>
                                <div class="status-timeline-date font-bold text-[var(--color-danger)]">نهائية</div>
                            </div>
                        }
                    </div>
                </div>
            }

            @{
                var arDays = new[] { "الأحد", "الاثنين", "الثلاثاء", "الأربعاء", "الخميس", "الجمعة", "السبت" };
                var arMonths = new[] { "يناير", "فبراير", "مارس", "أبريل", "مايو", "يونيو", "يوليو", "أغسطس", "سبتمبر", "أكتوبر", "نوفمبر", "ديسمبر" };
                var dt = Model.Episode.ScheduledDate;
                var tm = Model.Episode.BroadcastTime;
                string dayName, dayNum, monthName, yearNum, timeStr;
                if (dt.HasValue) { var d = dt.Value; dayName = arDays[(int)d.DayOfWeek]; dayNum = d.Day.ToString(); monthName = arMonths[d.Month - 1]; yearNum = d.Year.ToString(); }
                else { dayName = "اليوم"; dayNum = "–"; monthName = ""; yearNum = ""; }
                timeStr = tm?.ToString(@"hh\:mm") ?? "";
            }
            <div class="glass-card rounded-xl p-6">
                <div class="flex items-center gap-2 mb-4 pb-3 border-b border-border/60">
                    <div class="w-9 h-9 rounded-lg bg-primary-soft text-primary flex items-center justify-center">
                        <span class="material-symbols-rounded text-lg">schedule</span>
                    </div>
                    <h3 class="font-bold text-ink">الموعد</h3>
                </div>
                <div id="date-preview" class="text-center py-5 px-4 mb-5 rounded-xl transition-all duration-300"
                     style="background: var(--color-bg); border: 1px solid var(--color-border);">
                    <div class="text-4xl font-bold leading-tight tracking-tight text-[var(--color-primary)]" id="preview-day">@dayName</div>
                    <div class="w-10 h-px mx-auto my-3 rounded-full" style="background: var(--color-primary); opacity: 0.3;"></div>
                    <div class="text-sm font-semibold text-[var(--color-text-3)]" id="preview-date">
                        @if (dt.HasValue) { <text>@dayNum @monthName @yearNum</text> } else { <text>لم يُحدد</text> }
                    </div>
                    @if (dt.HasValue || tm.HasValue)
                    {
                        <div class="inline-flex items-center gap-1.5 mt-3 text-xs font-bold rounded-full px-3 py-1.5"
                             style="background: var(--color-bg); color: var(--color-text-4); border: 1px solid var(--color-border);">
                            <span class="material-symbols-rounded text-sm" style="color: var(--color-primary);">access_time</span>
                            <span id="preview-time">@(tm.HasValue ? timeStr : "–")</span>
                        </div>
                    }
                </div>

                <div class="space-y-3">
                    <div>
                        <label class="type-label-md text-ink-muted mb-1.5 block">التاريخ</label>
                        <div class="relative">
                            <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-lg text-[var(--color-text-4)]">calendar_month</span>
                            <input type="text" name="ScheduledDate"
                                   value="@(dt?.ToString("yyyy-MM-dd"))"
                                   class="w-full rounded-xl py-2.5 pr-10 pl-3 text-sm font-medium focus:outline-none focus:ring-2 transition-all datepicker"
                                   style="background: var(--color-bg); border: 1px solid var(--color-border); color: var(--color-text); --tw-ring-color: var(--color-primary);" id="input-date" />
                        </div>
                    </div>
                    <div>
                        <label class="type-label-md text-ink-muted mb-1.5 block">الوقت</label>
                        <div class="relative">
                            <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-lg text-[var(--color-text-4)]">access_time</span>
                            <input type="text" name="BroadcastTime"
                                   value="@(tm?.ToString(@"hh\:mm"))"
                                   class="w-full rounded-xl py-2.5 pr-10 pl-3 text-sm font-medium focus:outline-none focus:ring-2 transition-all timepicker"
                                   style="background: var(--color-bg); border: 1px solid var(--color-border); color: var(--color-text); --tw-ring-color: var(--color-primary);" id="input-time" />
                        </div>
                    </div>
                </div>
            </div>

            <script>
                document.addEventListener('DOMContentLoaded', function () {
                    var dateInput = document.getElementById('input-date');
                    var timeInput = document.getElementById('input-time');
                    var previewDay = document.getElementById('preview-day');
                    var previewDate = document.getElementById('preview-date');
                    var previewTime = document.getElementById('preview-time');
                    var preview = document.getElementById('date-preview');
                    var arDays = ["الأحد","الاثنين","الثلاثاء","الأربعاء","الخميس","الجمعة","السبت"];
                    var arMonths = ["يناير","فبراير","مارس","أبريل","مايو","يونيو","يوليو","أغسطس","سبتمبر","أكتوبر","نوفمبر","ديسمبر"];
                    function updatePreview() {
                        var fp = dateInput ? dateInput._flatpickr : null;
                        var d = fp ? fp.selectedDates[0] : null;
                        if (d) {
                            previewDay.textContent = arDays[d.getDay()];
                            previewDate.textContent = d.getDate() + ' ' + arMonths[d.getMonth()] + ' ' + d.getFullYear();
                            preview.classList.remove('opacity-50');
                        } else {
                            previewDay.textContent = 'اليوم';
                            previewDate.textContent = 'لم يُحدد';
                            preview.classList.add('opacity-50');
                        }
                        if (previewTime && timeInput && timeInput._flatpickr) {
                            previewTime.textContent = timeInput._flatpickr.altInput.value || '–';
                        }
                    }
                    if (dateInput && dateInput._flatpickr) {
                        dateInput._flatpickr.config.onChange.push(updatePreview);
                    }
                    if (timeInput && timeInput._flatpickr) {
                        timeInput._flatpickr.config.onChange.push(updatePreview);
                    }
                });
            </script>

            @if (isEdit)
            {
                <div class="glass-card rounded-xl p-6">
                    <div class="flex items-center gap-2 mb-4 pb-3 border-b border-border/60">
                        <div class="w-9 h-9 rounded-lg bg-primary-soft text-primary flex items-center justify-center">
                            <span class="material-symbols-rounded text-lg">info</span>
                        </div>
                        <h3 class="font-bold text-ink">معلومات الحلقة</h3>
                    </div>
                    <div class="space-y-3 text-sm">
                        <div class="meta-pill w-full">
                            <span class="material-symbols-rounded">tag</span>
                            <span class="flex-1">رقم الحلقة</span>
                            <span class="font-bold text-ink" dir="ltr">#@Model.Episode.EpisodeId</span>
                        </div>
                        <div class="meta-pill w-full">
                            <span class="material-symbols-rounded">calendar_today</span>
                            <span class="flex-1">تاريخ الإنشاء</span>
                            <span class="font-bold text-ink">—</span>
                        </div>
                        <div class="meta-pill w-full">
                            <span class="material-symbols-rounded">update</span>
                            <span class="flex-1">آخر تعديل</span>
                            <span class="font-bold text-ink">—</span>
                        </div>
                    </div>
                </div>
            }

            <div class="glass-card rounded-xl p-6">
                <div class="flex items-center gap-2 mb-4 pb-3 border-b border-border/60">
                    <div class="w-9 h-9 rounded-lg bg-primary-soft text-primary flex items-center justify-center">
                        <span class="material-symbols-rounded text-lg">save</span>
                    </div>
                    <h3 class="font-bold text-ink">حفظ التغييرات</h3>
                </div>
                <div class="flex flex-col gap-3">
                    <button type="submit" class="btn btn-primary rounded-xl w-full justify-center py-3 gap-2">
                        <span class="material-symbols-rounded">save</span>
                        @(isEdit ? "حفظ التغييرات" : "إنشاء الحلقة")
                    </button>
                    <a href="/Episodes" class="inline-flex items-center justify-center gap-2 w-full py-3 rounded-xl text-sm font-medium transition-all"
                       style="color: var(--color-text-3); background: var(--color-bg); border: 1px solid var(--color-border);">
                        <span class="material-symbols-rounded">close</span>
                        إلغاء والعودة
                    </a>
                </div>
            </div>

        </div>
    </div>
</form>

<template id="guest-row-tpl">
    <div class="ep-row guest-row" draggable="true">
        <input type="hidden" name="Guests[{i}].EpisodeGuestId" value="0" />
        <div class="ep-row-handle"><span class="material-symbols-rounded">drag_indicator</span></div>
        <div class="ep-row-body">
            <div class="ep-row-fields">
                <div class="ep-field flex-1">
                    <select name="Guests[{i}].GuestId" class="w-full rounded-lg py-2 px-3 text-sm focus:outline-none focus:ring-2 transition-all"
                            style="background: var(--color-bg); border: 1px solid var(--color-border); color: var(--color-text); --tw-ring-color: var(--color-primary);">
                        <option value="">— اختر الضيف —</option>
                        @foreach (var g in Model.Guests)
                        {
                            <option value="@g.GuestId">@g.FullName</option>
                        }
                    </select>
                </div>
                <div class="ep-field flex-1">
                    <input type="text" name="Guests[{i}].Topic" class="w-full rounded-lg py-2 px-3 text-sm focus:outline-none focus:ring-2 transition-all"
                           style="background: var(--color-bg); border: 1px solid var(--color-border); color: var(--color-text); --tw-ring-color: var(--color-primary);" placeholder="موضوع الاستضافة" />
                </div>
                <div class="ep-field w-28">
                    <input type="text" name="Guests[{i}].HostingTime" class="w-full rounded-lg py-2 px-3 text-sm focus:outline-none focus:ring-2 transition-all timepicker"
                           style="background: var(--color-bg); border: 1px solid var(--color-border); color: var(--color-text); --tw-ring-color: var(--color-primary);" />
                </div>
                <input type="hidden" name="Guests[{i}].ClipNotes" value="" />
            </div>
            <div class="ep-row-actions">
                <button type="button" class="ep-row-del" onclick="EP.removeRow(this)">
                    <span class="material-symbols-rounded">close</span>
                </button>
            </div>
        </div>
    </div>
</template>

