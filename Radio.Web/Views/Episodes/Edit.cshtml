@model EpisodeEditViewModel
@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = Model.Episode.EpisodeId == 0 ? "حلقة جديدة" : "تعديل حلقة";
    var isEdit = Model.Episode.EpisodeId != 0;
    ViewData["HeaderIcon"] = isEdit ? "edit" : "add";
    ViewData["HeaderDescription"] = "إدخال وتعديل البيانات والتفاصيل والضيوف المشاركين في الحلقة";
    ViewBag.IsEdit = isEdit;
    ViewBag.EntityName = "الحلقات";
    ViewBag.EntityUrl = "/Episodes";
    ViewBag.BackUrl = "/Episodes";
    ViewBag.BackText = "الرجوع للحلقات";

    var arDays = new[] { "الأحد", "الاثنين", "الثلاثاء", "الأربعاء", "الخميس", "الجمعة", "السبت" };
    var arMonths = new[] { "يناير", "فبراير", "مارس", "أبريل", "مايو", "يونيو", "يوليو", "أغسطس", "سبتمبر", "أكتوبر", "نوفمبر", "ديسمبر" };
    var dt = Model.Episode.ScheduledDate;
    var tm = Model.Episode.BroadcastTime;
    string dayName, dayNum, monthName, yearNum, timeStr;
    if (dt.HasValue) { var d = dt.Value; dayName = arDays[(int)d.DayOfWeek]; dayNum = d.Day.ToString(); monthName = arMonths[d.Month - 1]; yearNum = d.Year.ToString(); }
    else { dayName = "اليوم"; dayNum = "–"; monthName = ""; yearNum = ""; }
    timeStr = tm?.ToString(@"hh\:mm") ?? "";
}

<partial name="_PageHeader" />

<form method="post" action="@(isEdit ? $"/Episodes/Edit/{Model.Episode.EpisodeId}" : "/Episodes/Create")" id="episodeForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="EpisodeId" value="@Model.Episode.EpisodeId" />

    @if (ViewContext.ModelState.ErrorCount > 0)
    {
        <div asp-validation-summary="All" class="rounded-lg p-4 mb-6 bg-danger-subtle border border-danger-border text-danger text-sm font-semibold" role="alert"></div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

        <div class="lg:col-span-8 space-y-6">

            <div class="card p-6">
                @{
                    ViewBag.SectionIcon = "info";
                    ViewBag.SectionTitle = "المعلومات الأساسية";
                    ViewBag.SectionSubtitle = null;
                    ViewBag.SectionAction = null;
                }
                <partial name="_SectionHeader" />
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label for="ProgramId" class="text-label font-semibold text-text-muted mb-1.5 block">البرنامج *</label>
                        <div class="relative">
                            <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-lg text-text-muted" aria-hidden="true">radio</span>
                            <select id="ProgramId" name="ProgramId" class="input pr-10" required aria-required="true">
                                <option value="">— اختر البرنامج —</option>
                                @foreach (var p in Model.Programs)
                                {
                                    <option value="@p.ProgramId" selected="@(Model.Episode.ProgramId == p.ProgramId)">@p.ProgramName</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div>
                        <label for="EpisodeName" class="text-label font-semibold text-text-muted mb-1.5 block">عنوان الحلقة *</label>
                        <div class="relative">
                            <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-lg text-text-muted" aria-hidden="true">edit</span>
                            <input id="EpisodeName" type="text" name="EpisodeName" value="@Model.Episode.EpisodeName"
                                   class="input pr-10" required aria-required="true" placeholder="مثال: حلقة السبت" />
                        </div>
                    </div>
                    <div class="md:col-span-2">
                        <label for="EpisodeDescription" class="text-label font-semibold text-text-muted mb-1.5 block">وصف الحلقة</label>
                        <div class="relative">
                            <span class="material-symbols-rounded absolute right-3 top-4 pointer-events-none text-lg text-text-muted" aria-hidden="true">description</span>
                            <textarea id="EpisodeDescription" name="EpisodeDescription" rows="4" class="input pr-10"
                                      placeholder="وصف مختصر لمحتوى الحلقة وموضوعاتها الرئيسية…">@Model.Episode.EpisodeDescription</textarea>
                        </div>
                    </div>
                    <div class="md:col-span-2">
                        <label for="SpecialNotes" class="text-label font-semibold text-text-muted mb-1.5 block">ملاحظات خاصة</label>
                        <div class="relative">
                            <span class="material-symbols-rounded absolute right-3 top-4 pointer-events-none text-lg text-text-muted" aria-hidden="true">notes</span>
                            <textarea id="SpecialNotes" name="SpecialNotes" rows="3" class="input pr-10"
                                      placeholder="ملاحظات داخلية حول التحضير والإنتاج…">@Model.Episode.SpecialNotes</textarea>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card p-6">
                @{
                    ViewBag.SectionIcon = "people_alt";
                    ViewBag.SectionTitle = "الضيوف";
                    ViewBag.SectionSubtitle = null;
                    ViewBag.SectionAction = new HtmlString("<button type=\"button\" class=\"btn btn-success btn-sm gap-1\" onclick=\"EP.addRow('guests-container','guest-row-tpl')\"><span class=\"material-symbols-rounded text-sm\" aria-hidden=\"true\">add</span>إضافة ضيف</button>");
                }
                <partial name="_SectionHeader" />
                <div id="guests-container" data-empty="true" class="space-y-3">
                    @if (Model.Episode.Guests.Any())
                    {
                        @for (int i = 0; i < Model.Episode.Guests.Count; i++)
                        {
                            var g = Model.Episode.Guests[i];
                            <div class="ep-row guest-row" draggable="true">
                                <input type="hidden" name="Guests[@i].EpisodeGuestId" value="@g.EpisodeGuestId" />
                                <div class="ep-row-handle" title="سحب لإعادة الترتيب"><span class="material-symbols-rounded" aria-hidden="true">drag_indicator</span></div>
                                <div class="ep-row-body">
                                    <div class="ep-row-fields">
                                        <div class="ep-field flex-1">
                                            <select name="Guests[@i].GuestId" class="input" aria-label="اختيار ضيف">
                                                <option value="">— اختر الضيف —</option>
                                                @foreach (var guest in Model.Guests)
                                                {
                                                    <option value="@guest.GuestId" selected="@(g.GuestId == guest.GuestId)">@guest.FullName</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="ep-field flex-1">
                                            <input type="text" name="Guests[@i].Topic" value="@g.Topic" class="input" placeholder="موضوع الاستضافة" aria-label="موضوع الاستضافة" />
                                        </div>
                                        <div class="ep-field w-28">
                                            <input type="text" name="Guests[@i].HostingTime" value="@(g.HostingTime?.ToString(@"hh\:mm"))" class="input timepicker" aria-label="وقت الاستضافة" />
                                        </div>
                                        <input type="hidden" name="Guests[@i].ClipNotes" value="@g.ClipNotes" />
                                    </div>
                                    <div class="ep-row-actions">
                                        <button type="button" class="ep-row-del" title="حذف" aria-label="حذف الضيف" onclick="EP.removeRow(this)">
                                            <span class="material-symbols-rounded" aria-hidden="true">close</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        ViewBag.EmptyIcon = "groups";
                        ViewBag.EmptyTitle = "لم تتم إضافة ضيوف بعد";
                        ViewBag.EmptyDesc = "انقر على زر الإضافة أعلاه لتسجيل ضيف في الحلقة";
                        <partial name="_EmptyState" />
                    }
                </div>
            </div>

            <div class="card p-6">
                @{
                    ViewBag.SectionIcon = "map";
                    ViewBag.SectionTitle = "المراسلون";
                    ViewBag.SectionSubtitle = null;
                    ViewBag.SectionAction = new HtmlString("<button type=\"button\" class=\"btn btn-success btn-sm gap-1\" onclick=\"EP.addRow('correspondents-container','corr-row-tpl')\"><span class=\"material-symbols-rounded text-sm\" aria-hidden=\"true\">add</span>إضافة مراسل</button>");
                }
                <partial name="_SectionHeader" />
                <div id="correspondents-container" data-empty="true" class="space-y-3">
                    @if (Model.Episode.Correspondents.Any())
                    {
                        @for (int i = 0; i < Model.Episode.Correspondents.Count; i++)
                        {
                            var c = Model.Episode.Correspondents[i];
                            <div class="ep-row corr-row" draggable="true">
                                <input type="hidden" name="Correspondents[@i].Id" value="@c.Id" />
                                <div class="ep-row-handle" title="سحب لإعادة الترتيب"><span class="material-symbols-rounded" aria-hidden="true">drag_indicator</span></div>
                                <div class="ep-row-body">
                                    <div class="ep-row-fields">
                                        <div class="ep-field flex-1">
                                            <select name="Correspondents[@i].CorrespondentId" class="input" aria-label="اختيار مراسل">
                                                <option value="">— اختر —</option>
                                                @foreach (var cor in Model.Correspondents)
                                                {
                                                    <option value="@cor.CorrespondentId" selected="@(c.CorrespondentId == cor.CorrespondentId)">@cor.FullName</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="ep-field flex-1">
                                            <input type="text" name="Correspondents[@i].Topic" value="@c.Topic" class="input" placeholder="موضوع التغطية" aria-label="موضوع التغطية" />
                                        </div>
                                        <div class="ep-field w-28">
                                            <input type="text" name="Correspondents[@i].HostingTime" value="@(c.HostingTime?.ToString(@"hh\:mm"))" class="input timepicker" aria-label="وقت التغطية" />
                                        </div>
                                    </div>
                                    <div class="ep-row-actions">
                                        <button type="button" class="ep-row-del" title="حذف" aria-label="حذف المراسل" onclick="EP.removeRow(this)">
                                            <span class="material-symbols-rounded" aria-hidden="true">close</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        ViewBag.EmptyIcon = "map";
                        ViewBag.EmptyTitle = "لم تتم إضافة مراسلين بعد";
                        ViewBag.EmptyDesc = "انقر على زر الإضافة لتسجيل مراسل ميداني للتغطية";
                        <partial name="_EmptyState" />
                    }
                </div>
            </div>

            <div class="card p-6">
                @{
                    ViewBag.SectionIcon = "badge";
                    ViewBag.SectionTitle = "طاقم العمل والإنتاج";
                    ViewBag.SectionSubtitle = null;
                    ViewBag.SectionAction = new HtmlString("<button type=\"button\" class=\"btn btn-success btn-sm gap-1\" onclick=\"EP.addRow('employees-container','emp-row-tpl')\"><span class=\"material-symbols-rounded text-sm\" aria-hidden=\"true\">add</span>إضافة عضو للطاقم</button>");
                }
                <partial name="_SectionHeader" />
                <div id="employees-container" data-empty="true" class="space-y-3">
                    @if (Model.Episode.Employees.Any())
                    {
                        @for (int i = 0; i < Model.Episode.Employees.Count; i++)
                        {
                            var e = Model.Episode.Employees[i];
                            <div class="ep-row emp-row" draggable="true">
                                <input type="hidden" name="Employees[@i].Id" value="@e.Id" />
                                <div class="ep-row-handle" title="سحب لإعادة الترتيب"><span class="material-symbols-rounded" aria-hidden="true">drag_indicator</span></div>
                                <div class="ep-row-body">
                                    <div class="ep-row-fields">
                                        <div class="ep-field flex-1">
                                            <select name="Employees[@i].EmployeeId" class="input" aria-label="اختيار عضو الطاقم">
                                                <option value="">— اختر عضو الطاقم —</option>
                                                @foreach (var emp in Model.Employees)
                                                {
                                                    <option value="@emp.EmployeeId" selected="@(e.EmployeeId == emp.EmployeeId)">
                                                        @emp.FullName@(emp.StaffRoleName != null ? $" — {emp.StaffRoleName}" : "")
                                                    </option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="ep-row-actions">
                                        <button type="button" class="ep-row-del" title="حذف" aria-label="حذف عضو الطاقم" onclick="EP.removeRow(this)">
                                            <span class="material-symbols-rounded" aria-hidden="true">close</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        ViewBag.EmptyIcon = "badge";
                        ViewBag.EmptyTitle = "لم يتم إضافة أي موظف للطاقم بعد";
                        ViewBag.EmptyDesc = "انقر على زر الإضافة لتسجيل أعضاء فريق الإنتاج";
                        <partial name="_EmptyState" />
                    }
                </div>
            </div>

        </div>

        <div class="lg:col-span-4 space-y-6 lg:sticky lg:top-6">

            @if (isEdit)
            {
                <div class="card p-6">
                    @{
                        ViewBag.SectionIcon = "timeline";
                        ViewBag.SectionTitle = "مسار الحلقة";
                        ViewBag.SectionSubtitle = null;
                        ViewBag.SectionAction = null;
                    }
                    <partial name="_SectionHeader" />
                    <div class="status-timeline">
                        @{
                            var stages = new[] {
                                new { Id = 0, Name = "مجدولة",       Icon = "calendar_today" },
                                new { Id = 1, Name = "منفّذة",        Icon = "play_circle" },
                                new { Id = 2, Name = "منشورة رقمياً", Icon = "share" },
                                new { Id = 3, Name = "منشورة على الموقع", Icon = "public" }
                            };
                            var sid = Model.StatusId;
                            var isCancelled = sid == 4;
                        }
                        @for (int i = 0; i < stages.Length; i++)
                        {
                            var s = stages[i];
                            var cls = sid > s.Id ? "done" : (sid == s.Id ? "active" : "");
                            <div class="status-timeline-item @cls">
                                <div class="status-timeline-dot"></div>
                                <div class="status-timeline-text">@s.Name</div>
                                @if (sid == s.Id && !isCancelled)
                                {
                                    <div class="status-timeline-date font-bold text-primary">الحالية</div>
                                }
                            </div>
                        }
                        @if (isCancelled)
                        {
                            <div class="status-timeline-item cancelled">
                                <div class="status-timeline-dot"></div>
                                <div class="status-timeline-text">ملغاة</div>
                                <div class="status-timeline-date font-bold text-danger">نهائية</div>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="card p-6">
                @{
                    ViewBag.SectionIcon = "schedule";
                    ViewBag.SectionTitle = "الموعد";
                    ViewBag.SectionSubtitle = null;
                    ViewBag.SectionAction = null;
                }
                <partial name="_SectionHeader" />
                <div id="date-preview" class="text-center py-5 px-4 mb-5 rounded-xl bg-bg border border-border transition-all duration-300">
                    <div class="text-4xl font-bold leading-tight tracking-tight text-primary" id="preview-day">@dayName</div>
                    <div class="w-10 h-px mx-auto my-3 rounded-full bg-primary opacity-30"></div>
                    <div class="text-sm font-semibold text-text-secondary" id="preview-date">
                        @if (dt.HasValue) { <text>@dayNum @monthName @yearNum</text> } else { <text>لم يُحدد</text> }
                    </div>
                    @if (dt.HasValue || tm.HasValue)
                    {
                        <div class="inline-flex items-center gap-1.5 mt-3 text-xs font-bold rounded-full px-3 py-1.5 bg-bg text-text-muted border border-border">
                            <span class="material-symbols-rounded text-sm text-primary" aria-hidden="true">access_time</span>
                            <span id="preview-time">@(tm.HasValue ? timeStr : "–")</span>
                        </div>
                    }
                </div>

                <div class="space-y-3">
                    <div>
                        <label for="input-date" class="text-label font-semibold text-text-muted mb-1.5 block">التاريخ</label>
                        <div class="relative">
                            <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-lg text-text-muted" aria-hidden="true">calendar_month</span>
                            <input type="text" id="input-date" name="ScheduledDate"
                                   value="@(dt?.ToString("yyyy-MM-dd"))"
                                   class="input pr-10 timepicker datepicker" aria-label="تاريخ البث" />
                        </div>
                    </div>
                    <div>
                        <label for="input-time" class="text-label font-semibold text-text-muted mb-1.5 block">الوقت</label>
                        <div class="relative">
                            <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-lg text-text-muted" aria-hidden="true">access_time</span>
                            <input type="text" id="input-time" name="BroadcastTime"
                                   value="@(tm?.ToString(@"hh\:mm"))"
                                   class="input pr-10 timepicker" aria-label="وقت البث" />
                        </div>
                    </div>
                </div>
            </div>

            @if (isEdit)
            {
                <div class="card p-6">
                    @{
                        ViewBag.SectionIcon = "info";
                        ViewBag.SectionTitle = "معلومات الحلقة";
                        ViewBag.SectionSubtitle = null;
                        ViewBag.SectionAction = null;
                    }
                    <partial name="_SectionHeader" />
                    <div class="space-y-3 text-sm">
                        <div class="meta-pill w-full">
                            <span class="material-symbols-rounded" aria-hidden="true">tag</span>
                            <span class="flex-1">رقم الحلقة</span>
                            <span class="font-bold text-text" dir="ltr">#@Model.Episode.EpisodeId</span>
                        </div>
                        <div class="meta-pill w-full">
                            <span class="material-symbols-rounded" aria-hidden="true">calendar_today</span>
                            <span class="flex-1">تاريخ الإنشاء</span>
                            <span class="font-bold text-text">—</span>
                        </div>
                        <div class="meta-pill w-full">
                            <span class="material-symbols-rounded" aria-hidden="true">update</span>
                            <span class="flex-1">آخر تعديل</span>
                            <span class="font-bold text-text">—</span>
                        </div>
                    </div>
                </div>
            }

            <div class="card p-6">
                @{
                    ViewBag.SectionIcon = "save";
                    ViewBag.SectionTitle = "حفظ التغييرات";
                    ViewBag.SectionSubtitle = null;
                    ViewBag.SectionAction = null;
                }
                <partial name="_SectionHeader" />
                <div class="flex flex-col gap-3">
                    <button type="submit" class="btn btn-primary w-full justify-center py-3 gap-2" aria-label="@(isEdit ? "حفظ التغييرات" : "إنشاء الحلقة")">
                        <span class="material-symbols-rounded" aria-hidden="true">save</span>
                        @(isEdit ? "حفظ التغييرات" : "إنشاء الحلقة")
                    </button>
                    <a href="/Episodes" class="btn btn-ghost w-full justify-center py-3 gap-2">
                        <span class="material-symbols-rounded" aria-hidden="true">close</span>
                        إلغاء والعودة
                    </a>
                </div>
            </div>

        </div>
    </div>
</form>

<template id="guest-row-tpl">
    <div class="ep-row guest-row" draggable="true">
        <input type="hidden" name="Guests[{i}].EpisodeGuestId" value="0" />
        <div class="ep-row-handle"><span class="material-symbols-rounded" aria-hidden="true">drag_indicator</span></div>
        <div class="ep-row-body">
            <div class="ep-row-fields">
                <div class="ep-field flex-1">
                    <select name="Guests[{i}].GuestId" class="input" aria-label="اختيار ضيف">
                        <option value="">— اختر الضيف —</option>
                        @foreach (var g in Model.Guests)
                        {
                            <option value="@g.GuestId">@g.FullName</option>
                        }
                    </select>
                </div>
                <div class="ep-field flex-1">
                    <input type="text" name="Guests[{i}].Topic" class="input" placeholder="موضوع الاستضافة" aria-label="موضوع الاستضافة" />
                </div>
                <div class="ep-field w-28">
                    <input type="text" name="Guests[{i}].HostingTime" class="input timepicker" aria-label="وقت الاستضافة" />
                </div>
                <input type="hidden" name="Guests[{i}].ClipNotes" value="" />
            </div>
            <div class="ep-row-actions">
                <button type="button" class="ep-row-del" onclick="EP.removeRow(this)" aria-label="حذف الضيف">
                    <span class="material-symbols-rounded" aria-hidden="true">close</span>
                </button>
            </div>
        </div>
    </div>
</template>

<template id="corr-row-tpl">
    <div class="ep-row corr-row" draggable="true">
        <input type="hidden" name="Correspondents[{i}].Id" value="0" />
        <div class="ep-row-handle"><span class="material-symbols-rounded" aria-hidden="true">drag_indicator</span></div>
        <div class="ep-row-body">
            <div class="ep-row-fields">
                <div class="ep-field flex-1">
                    <select name="Correspondents[{i}].CorrespondentId" class="input" aria-label="اختيار مراسل">
                        <option value="">— اختر —</option>
                        @foreach (var c in Model.Correspondents)
                        {
                            <option value="@c.CorrespondentId">@c.FullName</option>
                        }
                    </select>
                </div>
                <div class="ep-field flex-1">
                    <input type="text" name="Correspondents[{i}].Topic" class="input" placeholder="موضوع التغطية" aria-label="موضوع التغطية" />
                </div>
                <div class="ep-field w-28">
                    <input type="text" name="Correspondents[{i}].HostingTime" class="input timepicker" aria-label="وقت التغطية" />
                </div>
            </div>
            <div class="ep-row-actions">
                <button type="button" class="ep-row-del" onclick="EP.removeRow(this)" aria-label="حذف المراسل">
                    <span class="material-symbols-rounded" aria-hidden="true">close</span>
                </button>
            </div>
        </div>
    </div>
</template>

<template id="emp-row-tpl">
    <div class="ep-row emp-row" draggable="true">
        <input type="hidden" name="Employees[{i}].Id" value="0" />
        <div class="ep-row-handle"><span class="material-symbols-rounded" aria-hidden="true">drag_indicator</span></div>
        <div class="ep-row-body">
            <div class="ep-row-fields">
                <div class="ep-field flex-1">
                    <select name="Employees[{i}].EmployeeId" class="input" aria-label="اختيار عضو الطاقم">
                        <option value="">— اختر عضو الطاقم —</option>
                        @foreach (var emp in Model.Employees)
                        {
                            <option value="@emp.EmployeeId">@emp.FullName@(emp.StaffRoleName != null ? $" — {emp.StaffRoleName}" : "")</option>
                        }
                    </select>
                </div>
            </div>
            <div class="ep-row-actions">
                <button type="button" class="ep-row-del" onclick="EP.removeRow(this)" aria-label="حذف عضو الطاقم">
                    <span class="material-symbols-rounded" aria-hidden="true">close</span>
                </button>
            </div>
        </div>
    </div>
</template>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var dateInput = document.getElementById('input-date');
            var timeInput = document.getElementById('input-time');
            var previewDay = document.getElementById('preview-day');
            var previewDate = document.getElementById('preview-date');
            var previewTime = document.getElementById('preview-time');
            var preview = document.getElementById('date-preview');
            var arDays = ["الأحد","الاثنين","الثلاثاء","الأربعاء","الخميس","الجمعة","السبت"];
            var arMonths = ["يناير","فبراير","مارس","أبريل","مايو","يونيو","يوليو","أغسطس","سبتمبر","أكتوبر","نوفمبر","ديسمبر"];
            function updatePreview() {
                var fp = dateInput ? dateInput._flatpickr : null;
                var d = fp ? fp.selectedDates[0] : null;
                if (d) {
                    previewDay.textContent = arDays[d.getDay()];
                    previewDate.textContent = d.getDate() + ' ' + arMonths[d.getMonth()] + ' ' + d.getFullYear();
                    preview.classList.remove('opacity-50');
                } else {
                    previewDay.textContent = 'اليوم';
                    previewDate.textContent = 'لم يُحدد';
                    preview.classList.add('opacity-50');
                }
                if (previewTime && timeInput && timeInput._flatpickr) {
                    previewTime.textContent = timeInput._flatpickr.altInput.value || '–';
                }
            }
            if (dateInput && dateInput._flatpickr) {
                dateInput._flatpickr.config.onChange.push(updatePreview);
            }
            if (timeInput && timeInput._flatpickr) {
                timeInput._flatpickr.config.onChange.push(updatePreview);
            }
        });
    </script>
    <script src="~/js/episode-edit.js" asp-append-version="true"></script>
}
