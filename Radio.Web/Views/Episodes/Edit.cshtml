@model EpisodeEditViewModel
@{
    ViewData["Title"] = Model.Episode.EpisodeId == 0 ? "حلقة جديدة" : "تعديل حلقة";
    var isEdit = Model.Episode.EpisodeId != 0;
    ViewBag.IsEdit = isEdit;
    ViewBag.Icon = isEdit ? "edit" : "add";
    ViewBag.Title = isEdit ? "تعديل الحلقة" : "حلقة جديدة";
    ViewBag.Description = "إدخال وتعديل البيانات والتفاصيل والضيوف المشاركين في الحلقة";
    ViewBag.EntityName = "الحلقات";
    ViewBag.EntityUrl = "/Episodes";
    ViewBag.BackUrl = "/Episodes";
    ViewBag.BackText = "الرجوع للحلقات";
}

<div class="page-header-enhanced p-6">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 relative z-10">
        <div>
            <div class="breadcrumbs text-sm text-base-content/60">
                <ul>
                    <li><a href="/" class="inline-flex items-center gap-1"><span class="material-symbols-rounded text-lg">home</span>الرئيسية</a></li>
                    <li><a href="/Episodes" class="inline-flex items-center gap-1"><span class="material-symbols-rounded text-lg">podcasts</span>الحلقات</a></li>
                    <li><span class="inline-flex items-center gap-1">@(isEdit ? "تعديل حلقة" : "حلقة جديدة")</span></li>
                </ul>
            </div>
            <div class="flex items-center gap-3 flex-wrap">
                <h1 class="text-2xl font-extrabold text-base-content flex items-center gap-2">
                    <span class="material-symbols-rounded text-primary">podcasts</span>
                    @(isEdit ? "تعديل حلقة" : "حلقة جديدة")
                </h1>
                @if (isEdit)
                {
                    var statusColors = new Dictionary<byte, string>
                    {
                        { 0, "bg-blue-50 text-blue-700 border-blue-200" },
                        { 1, "bg-emerald-50 text-emerald-700 border-emerald-200" },
                        { 2, "bg-indigo-50 text-indigo-700 border-indigo-200" },
                        { 3, "bg-cyan-50 text-cyan-700 border-cyan-200" },
                        { 4, "bg-red-50 text-red-700 border-red-200" },
                    };
                    var sc = statusColors.GetValueOrDefault(Model.StatusId, "bg-base-300 text-base-content/60 border-base-200");
                    <span class="status-badge @sc border text-sm px-3 py-1">@(Model.StatusText ?? "—")</span>
                    <span class="text-xs text-base-content/40 font-semibold flex items-center gap-1">
                        <span class="material-symbols-rounded text-xs">tag</span>
                        #@Model.Episode.EpisodeId
                    </span>
                }
            </div>
            <p class="text-sm text-base-content/60 mt-0.5">إدخال وتعديل البيانات والتفاصيل والضيوف المشاركين في الحلقة</p>
        </div>
        <div class="flex items-center gap-2">
            <a href="/Episodes" class="btn btn-ghost">
                <span class="material-symbols-rounded">arrow_forward</span>
                الرجوع للحلقات
            </a>
        </div>
    </div>
</div>

<form method="post" action="@(isEdit ? $"/Episodes/Edit/{Model.Episode.EpisodeId}" : "/Episodes/Create")" id="episodeForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="EpisodeId" value="@Model.Episode.EpisodeId" />

    @if (ViewContext.ModelState.ErrorCount > 0)
    {
        <div asp-validation-summary="All" class="bg-red-50 border border-red-200 text-error rounded-xl p-4 mb-6 font-semibold text-sm"></div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

        <!-- ─── Main Column ─── -->
        <div class="lg:col-span-8 space-y-6">

            <!-- ═══ Basic Info ═══ -->
            <div class="card bg-base-100 shadow-md">
                <div class="card-body">
                    <div class="flex items-center gap-2 mb-4">
                        <span class="material-symbols-rounded text-primary">info</span>
                        <h3 class="font-bold text-base-content text-base">المعلومات الأساسية</h3>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="label">البرنامج *</label>
                        <div class="relative">
                            <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-base-content/40 pointer-events-none text-lg">radio</span>
                            <select name="ProgramId" class="select select-bordered" required>
                                <option value="">— اختر البرنامج —</option>
                                @foreach (var p in Model.Programs)
                                {
                                    <option value="@p.ProgramId" selected="@(Model.Episode.ProgramId == p.ProgramId)">@p.ProgramName</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div>
                        <label class="label">عنوان الحلقة *</label>
                        <div class="relative">
                            <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-base-content/40 pointer-events-none text-lg">edit</span>
                            <input type="text" name="EpisodeName" value="@Model.Episode.EpisodeName" class="input input-bordered w-full pr-10" required placeholder="مثال: حلقة السبت" />
                        </div>
                    </div>
                    <div class="md:col-span-2">
                        <label class="label">وصف الحلقة</label>
                        <div class="relative">
                            <span class="material-symbols-rounded absolute right-3 text-base-content/40 pointer-events-none text-lg" style="top:1rem;transform:none">description</span>
                            <textarea name="EpisodeDescription" rows="4" class="textarea textarea-bordered w-full pr-10" placeholder="وصف مختصر لمحتوى الحلقة وموضوعاتها الرئيسية…">@Model.Episode.EpisodeDescription</textarea>
                        </div>
                    </div>
                    <div class="md:col-span-2">
                        <label class="label">ملاحظات خاصة</label>
                        <div class="relative">
                            <span class="material-symbols-rounded absolute right-3 text-base-content/40 pointer-events-none text-lg" style="top:1rem;transform:none">notes</span>
                            <textarea name="SpecialNotes" rows="3" class="textarea textarea-bordered w-full pr-10" placeholder="ملاحظات داخلية حول التحضير والإنتاج…">@Model.Episode.SpecialNotes</textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ═══ Guests ═══ -->
            <div class="card bg-base-100 shadow-md">
                <div class="card-body">
                    <div class="flex items-center justify-between gap-2 mb-4">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-rounded text-primary">people_alt</span>
                            <h3 class="font-bold text-base-content text-base">الضيوف</h3>
                        </div>
                        <button type="button" class="btn btn-success text-xs" onclick="EP.addRow('guests-container','guest-row-tpl')">
                            <span class="material-symbols-rounded text-sm">add</span>
                            إضافة ضيف
                        </button>
                    </div>
                    <div id="guests-container" data-empty="true" class="space-y-3">
                        @if (Model.Episode.Guests.Any())
                        {
                            @for (int i = 0; i < Model.Episode.Guests.Count; i++)
                            {
                                var g = Model.Episode.Guests[i];
                                <div class="ep-row guest-row" draggable="true">
                                    <input type="hidden" name="Guests[@i].EpisodeGuestId" value="@g.EpisodeGuestId" />
                                    <div class="ep-row-handle" title="سحب لإعادة الترتيب"><span class="material-symbols-rounded">drag_indicator</span></div>
                                    <div class="ep-row-body">
                                        <div class="ep-row-fields">
                                            <div class="ep-field flex-1">
                                                <select name="Guests[@i].GuestId" class="select select-bordered">
                                                    <option value="">— اختر الضيف —</option>
                                                    @foreach (var guest in Model.Guests)
                                                    {
                                                        <option value="@guest.GuestId" selected="@(g.GuestId == guest.GuestId)">@guest.FullName</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="ep-field flex-1">
                                                <input type="text" name="Guests[@i].Topic" value="@g.Topic" class="input input-bordered" placeholder="موضوع الاستضافة" />
                                            </div>
                                            <div class="ep-field w-28">
                                                                <input type="text" name="Guests[@i].HostingTime" value="@(g.HostingTime?.ToString(@"hh\:mm"))" class="input input-bordered timepicker" />
                                            </div>
                                            <input type="hidden" name="Guests[@i].ClipNotes" value="@g.ClipNotes" />
                                        </div>
                                        <div class="ep-row-actions">
                                            <button type="button" class="ep-row-del" title="حذف" onclick="EP.removeRow(this)">
                                                <span class="material-symbols-rounded">close</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="flex flex-col items-center justify-center py-8 text-center bg-base-200 rounded-xl border-2 border-dashed border-base-200/50">
                                <span class="material-symbols-rounded text-base-content/40 text-3xl mb-2">groups</span>
                                <p class="text-sm font-bold text-base-content/60">لم تتم إضافة ضيوف بعد</p>
                                <p class="text-xs text-base-content/40 mt-1">انقر على زر الإضافة أعلاه لتسجيل ضيف في الحلقة</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- ═══ Correspondents ═══ -->
            <div class="card bg-base-100 shadow-md">
                <div class="card-body">
                    <div class="flex items-center justify-between gap-2 mb-4">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-rounded text-primary">map</span>
                            <h3 class="font-bold text-base-content text-base">المراسلون</h3>
                        </div>
                        <button type="button" class="btn btn-success text-xs" onclick="EP.addRow('correspondents-container','corr-row-tpl')">
                            <span class="material-symbols-rounded text-sm">add</span>
                            إضافة مراسل
                        </button>
                    </div>
                    <div id="correspondents-container" data-empty="true" class="space-y-3">
                        @if (Model.Episode.Correspondents.Any())
                        {
                            @for (int i = 0; i < Model.Episode.Correspondents.Count; i++)
                            {
                                var c = Model.Episode.Correspondents[i];
                                <div class="ep-row corr-row" draggable="true">
                                    <input type="hidden" name="Correspondents[@i].Id" value="@c.Id" />
                                    <div class="ep-row-handle" title="سحب لإعادة الترتيب"><span class="material-symbols-rounded">drag_indicator</span></div>
                                    <div class="ep-row-body">
                                        <div class="ep-row-fields">
                                            <div class="ep-field flex-1">
                                                <select name="Correspondents[@i].CorrespondentId" class="select select-bordered">
                                                    <option value="">— اختر —</option>
                                                    @foreach (var cor in Model.Correspondents)
                                                    {
                                                        <option value="@cor.CorrespondentId" selected="@(c.CorrespondentId == cor.CorrespondentId)">@cor.FullName</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="ep-field flex-1">
                                                <input type="text" name="Correspondents[@i].Topic" value="@c.Topic" class="input input-bordered" placeholder="موضوع التغطية" />
                                            </div>
                                            <div class="ep-field w-28">
                                                                <input type="text" name="Correspondents[@i].HostingTime" value="@(c.HostingTime?.ToString(@"hh\:mm"))" class="input input-bordered timepicker" />
                                            </div>
                                        </div>
                                        <div class="ep-row-actions">
                                            <button type="button" class="ep-row-del" title="حذف" onclick="EP.removeRow(this)">
                                                <span class="material-symbols-rounded">close</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="flex flex-col items-center justify-center py-8 text-center bg-base-200 rounded-xl border-2 border-dashed border-base-200/50">
                                <span class="material-symbols-rounded text-base-content/40 text-3xl mb-2">map</span>
                                <p class="text-sm font-bold text-base-content/60">لم تتم إضافة مراسلين بعد</p>
                                <p class="text-xs text-base-content/40 mt-1">انقر على زر الإضافة لتسجيل مراسل ميداني للتغطية</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- ═══ Employees ═══ -->
            <div class="card bg-base-100 shadow-md">
                <div class="card-body">
                    <div class="flex items-center justify-between gap-2 mb-4">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-rounded text-primary">badge</span>
                            <h3 class="font-bold text-base-content text-base">طاقم العمل والإنتاج</h3>
                        </div>
                        <button type="button" class="btn btn-success text-xs" onclick="EP.addRow('employees-container','emp-row-tpl')">
                            <span class="material-symbols-rounded text-sm">add</span>
                            إضافة عضو للطاقم
                        </button>
                    </div>
                    <div id="employees-container" data-empty="true" class="space-y-3">
                        @if (Model.Episode.Employees.Any())
                        {
                            @for (int i = 0; i < Model.Episode.Employees.Count; i++)
                            {
                                var e = Model.Episode.Employees[i];
                                <div class="ep-row emp-row" draggable="true">
                                    <input type="hidden" name="Employees[@i].Id" value="@e.Id" />
                                    <div class="ep-row-handle" title="سحب لإعادة الترتيب"><span class="material-symbols-rounded">drag_indicator</span></div>
                                    <div class="ep-row-body">
                                        <div class="ep-row-fields">
                                            <div class="ep-field flex-1">
                                                <select name="Employees[@i].EmployeeId" class="select select-bordered">
                                                    <option value="">— اختر عضو الطاقم —</option>
                                                    @foreach (var emp in Model.Employees)
                                                    {
                                                        <option value="@emp.EmployeeId" selected="@(e.EmployeeId == emp.EmployeeId)">
                                                            @emp.FullName@(emp.StaffRoleName != null ? $" — {emp.StaffRoleName}" : "")
                                                        </option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                        <div class="ep-row-actions">
                                            <button type="button" class="ep-row-del" title="حذف" onclick="EP.removeRow(this)">
                                                <span class="material-symbols-rounded">close</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="flex flex-col items-center justify-center py-8 text-center bg-base-200 rounded-xl border-2 border-dashed border-base-200/50">
                                <span class="material-symbols-rounded text-base-content/40 text-3xl mb-2">badge</span>
                                <p class="text-sm font-bold text-base-content/60">لم يتم إضافة أي موظف للطاقم بعد</p>
                                <p class="text-xs text-base-content/40 mt-1">انقر على زر الإضافة لتسجيل أعضاء فريق الإنتاج</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

        </div>

        <!-- ─── Sidebar ─── -->
        <div class="lg:col-span-4 space-y-6 lg:sticky lg:top-6">

            @if (isEdit)
            {
                <!-- ═══ Status Timeline ═══ -->
                <div class="card bg-base-100 shadow-md">
                    <div class="card-body">
                        <div class="flex items-center gap-2 mb-4">
                            <span class="material-symbols-rounded text-primary">timeline</span>
                            <h3 class="font-bold text-base-content text-base">مسار الحلقة</h3>
                        </div>
                        <div class="status-timeline">
                            @{
                                var stages = new[] {
                                    new { Id = 0, Name = "مجدولة",       Icon = "calendar_today" },
                                    new { Id = 1, Name = "منفّذة",        Icon = "play_circle" },
                                    new { Id = 2, Name = "منشورة رقمياً", Icon = "share" },
                                    new { Id = 3, Name = "منشورة على الموقع", Icon = "public" }
                                };
                                var sid = Model.StatusId;
                                var isCancelled = sid == 4;
                            }
                            @for (int i = 0; i < stages.Length; i++)
                            {
                                var s = stages[i];
                                var cls = sid > s.Id ? "done" : (sid == s.Id ? "active" : "");
                                <div class="status-timeline-item @cls">
                                    <div class="status-timeline-dot"></div>
                                    <div class="status-timeline-text">@s.Name</div>
                                    @if (sid == s.Id && !isCancelled)
                                    {
                                        <div class="status-timeline-date text-primary font-bold">الحالية</div>
                                    }
                                </div>
                            }
                            @if (isCancelled)
                            {
                                <div class="status-timeline-item cancelled">
                                    <div class="status-timeline-dot"></div>
                                    <div class="status-timeline-text">ملغاة</div>
                                    <div class="status-timeline-date text-error font-bold">نهائية</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- ═══ Scheduling ═══ -->
            @{
                var arDays = new[] { "الأحد", "الاثنين", "الثلاثاء", "الأربعاء", "الخميس", "الجمعة", "السبت" };
                var arMonths = new[] { "يناير", "فبراير", "مارس", "أبريل", "مايو", "يونيو", "يوليو", "أغسطس", "سبتمبر", "أكتوبر", "نوفمبر", "ديسمبر" };
                var dt = Model.Episode.ScheduledDate;
                var tm = Model.Episode.BroadcastTime;
                string dayName, dayNum, monthName, yearNum, timeStr;
                if (dt.HasValue) { var d = dt.Value; dayName = arDays[(int)d.DayOfWeek]; dayNum = d.Day.ToString(); monthName = arMonths[d.Month - 1]; yearNum = d.Year.ToString(); }
                else { dayName = "اليوم"; dayNum = "–"; monthName = ""; yearNum = ""; }
                timeStr = tm?.ToString(@"hh\:mm") ?? "";
            }
            <div class="card bg-base-100 shadow-md">
                <div class="card-body">
                    <div class="flex items-center gap-2 mb-4">
                        <span class="material-symbols-rounded text-primary">schedule</span>
                        <h3 class="font-bold text-base-content text-base">الموعد</h3>
                    </div>
                    <div id="date-preview" class="text-center py-5 px-4 mb-5 bg-base-200 rounded-xl border border-base-200 shadow-sm transition-all duration-300">
                        <div class="text-4xl font-black text-primary leading-tight tracking-tight" id="preview-day">@dayName</div>
                        <div class="w-10 h-px bg-primary/30 mx-auto my-3 rounded-full"></div>
                        <div class="text-sm font-semibold text-base-content/60" id="preview-date">
                            @if (dt.HasValue) { <text>@dayNum @monthName @yearNum</text> } else { <text>لم يُحدد</text> }
                        </div>
                        @if (dt.HasValue || tm.HasValue)
                        {
                            <div class="inline-flex items-center gap-1.5 mt-3 text-xs font-bold text-base-content/40 bg-base-300 px-3 py-1.5 rounded-full border border-base-200/70">
                                <span class="material-symbols-rounded text-sm text-primary/70">access_time</span>
                                <span id="preview-time">@(tm.HasValue ? timeStr : "–")</span>
                            </div>
                        }
                    </div>

                    <div class="space-y-3">
                        <div>
                            <label class="label">التاريخ</label>
                            <div class="relative">
                                <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-base-content/40 pointer-events-none text-lg">calendar_month</span>
                                <input type="text" name="ScheduledDate"
                                       value="@(dt?.ToString("yyyy-MM-dd"))"
                                       class="input input-bordered datepicker w-full pr-10" id="input-date" />
                            </div>
                        </div>
                        <div>
                            <label class="label">الوقت</label>
                            <div class="relative">
                                <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-base-content/40 pointer-events-none text-lg">access_time</span>
                                <input type="text" name="BroadcastTime"
                                       value="@(tm?.ToString(@"hh\:mm"))"
                                       class="input input-bordered timepicker w-full pr-10" id="input-time" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <script>
                document.addEventListener('DOMContentLoaded', function () {
                    var dateInput = document.getElementById('input-date');
                    var timeInput = document.getElementById('input-time');
                    var previewDay = document.getElementById('preview-day');
                    var previewDate = document.getElementById('preview-date');
                    var previewTime = document.getElementById('preview-time');
                    var preview = document.getElementById('date-preview');
                    var arDays = ["الأحد","الاثنين","الثلاثاء","الأربعاء","الخميس","الجمعة","السبت"];
                    var arMonths = ["يناير","فبراير","مارس","أبريل","مايو","يونيو","يوليو","أغسطس","سبتمبر","أكتوبر","نوفمبر","ديسمبر"];
                    function updatePreview() {
                        var fp = dateInput ? dateInput._flatpickr : null;
                        var d = fp ? fp.selectedDates[0] : null;
                        if (d) {
                            previewDay.textContent = arDays[d.getDay()];
                            previewDate.textContent = d.getDate() + ' ' + arMonths[d.getMonth()] + ' ' + d.getFullYear();
                            preview.classList.remove('opacity-50');
                        } else {
                            previewDay.textContent = 'اليوم';
                            previewDate.textContent = 'لم يُحدد';
                            preview.classList.add('opacity-50');
                        }
                        if (previewTime && timeInput && timeInput._flatpickr) {
                            previewTime.textContent = timeInput._flatpickr.altInput.value || '–';
                        }
                    }
                    if (dateInput && dateInput._flatpickr) {
                        dateInput._flatpickr.config.onChange.push(updatePreview);
                    }
                    if (timeInput && timeInput._flatpickr) {
                        timeInput._flatpickr.config.onChange.push(updatePreview);
                    }
                });
            </script>

            @if (isEdit)
            {
                <!-- ═══ Metadata ═══ -->
                <div class="card bg-base-100 shadow-md">
                    <div class="card-body">
                        <div class="flex items-center gap-2 mb-4">
                            <span class="material-symbols-rounded text-primary">info</span>
                            <h3 class="font-bold text-base-content text-base">معلومات الحلقة</h3>
                        </div>
                        <div class="space-y-3 text-sm">
                        <div class="meta-pill w-full">
                            <span class="material-symbols-rounded">tag</span>
                            <span class="flex-1">رقم الحلقة</span>
                            <span class="font-bold text-base-content" dir="ltr">#@Model.Episode.EpisodeId</span>
                        </div>
                        <div class="meta-pill w-full">
                            <span class="material-symbols-rounded">calendar_today</span>
                            <span class="flex-1">تاريخ الإنشاء</span>
                            <span class="font-bold text-base-content">—</span>
                        </div>
                        <div class="meta-pill w-full">
                            <span class="material-symbols-rounded">update</span>
                            <span class="flex-1">آخر تعديل</span>
                            <span class="font-bold text-base-content">—</span>
                        </div>
                    </div>
                </div>
            </div>
            }

            <!-- ═══ Save Actions ═══ -->
            <div class="card bg-base-100 shadow-md">
                <div class="card-body">
                    <div class="flex items-center gap-2 mb-4">
                        <span class="material-symbols-rounded text-primary">save</span>
                        <h3 class="font-bold text-base-content text-base">حفظ التغييرات</h3>
                    </div>
                    <div class="flex flex-col gap-3">
                    <button type="submit" class="btn btn-primary w-full justify-center py-3">
                        <span class="material-symbols-rounded">save</span>
                        @(isEdit ? "حفظ التغييرات" : "إنشاء الحلقة")
                    </button>
                    <a href="/Episodes" class="btn btn-ghost w-full justify-center py-3">
                        <span class="material-symbols-rounded">close</span>
                        إلغاء والعودة
                    </a>
                </div>
            </div>

        </div>
    </div>
</form>

<!-- ═══════════════════════════════════════════════════════
     Templates for dynamic rows
     ═══════════════════════════════════════════════════════ -->
<template id="guest-row-tpl">
    <div class="ep-row guest-row" draggable="true">
        <input type="hidden" name="Guests[{i}].EpisodeGuestId" value="0" />
        <div class="ep-row-handle"><span class="material-symbols-rounded">drag_indicator</span></div>
        <div class="ep-row-body">
            <div class="ep-row-fields">
                <div class="ep-field flex-1">
                    <select name="Guests[{i}].GuestId" class="select select-bordered">
                        <option value="">— اختر الضيف —</option>
                        @foreach (var g in Model.Guests)
                        {
                            <option value="@g.GuestId">@g.FullName</option>
                        }
                    </select>
                </div>
                <div class="ep-field flex-1">
                    <input type="text" name="Guests[{i}].Topic" class="input input-bordered" placeholder="موضوع الاستضافة" />
                </div>
                <div class="ep-field w-28">
                                <input type="text" name="Guests[{i}].HostingTime" class="input input-bordered timepicker" />
                </div>
                <input type="hidden" name="Guests[{i}].ClipNotes" value="" />
            </div>
            <div class="ep-row-actions">
                <button type="button" class="ep-row-del" onclick="EP.removeRow(this)">
                    <span class="material-symbols-rounded">close</span>
                </button>
            </div>
        </div>
    </div>
</template>

<template id="corr-row-tpl">
    <div class="ep-row corr-row" draggable="true">
        <input type="hidden" name="Correspondents[{i}].Id" value="0" />
