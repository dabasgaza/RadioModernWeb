@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var dateInput = document.getElementById('input-date');
            var timeInput = document.getElementById('input-time');
            var previewDay = document.getElementById('preview-day');
            var previewDate = document.getElementById('preview-date');
            var previewTime = document.getElementById('preview-time');
            var preview = document.getElementById('date-preview');
            var arDays = ["الأحد","الاثنين","الثلاثاء","الأربعاء","الخميس","الجمعة","السبت"];
            var arMonths = ["يناير","فبراير","مارس","أبريل","مايو","يونيو","يوليو","أغسطس","سبتمبر","أكتوبر","نوفمبر","ديسمبر"];
            function updatePreview() {
                var fp = dateInput ? dateInput._flatpickr : null;
                var d = fp ? fp.selectedDates[0] : null;
                if (d) {
                    previewDay.textContent = arDays[d.getDay()];
                    previewDate.textContent = d.getDate() + ' ' + arMonths[d.getMonth()] + ' ' + d.getFullYear();
                    preview.classList.remove('opacity-50');
                } else {
                    previewDay.textContent = 'اليوم';
                    previewDate.textContent = 'لم يُحدد';
                    preview.classList.add('opacity-50');
                }
                if (previewTime && timeInput && timeInput._flatpickr) {
                    previewTime.textContent = timeInput._flatpickr.altInput.value || '–';
                }
            }
            if (dateInput && dateInput._flatpickr) {
                dateInput._flatpickr.config.onChange.push(updatePreview);
            }
            if (timeInput && timeInput._flatpickr) {
                timeInput._flatpickr.config.onChange.push(updatePreview);
            }
        });
    </script>
    <script>
        (function () {
            'use strict';
            var arMonthsW = ["يناير","فبراير","مارس","أبريل","مايو","يونيو","يوليو","أغسطس","سبتمبر","أكتوبر","نوفمبر","ديسمبر"];
            var arDaysW = ["الأحد","الاثنين","الثلاثاء","الأربعاء","الخميس","الجمعة","السبت"];

            function initialsOf(name) {
                if (!name) return '';
                var clean = String(name).split('—')[0].trim();
                if (!clean) return '';
                var parts = clean.split(/\s+/).filter(Boolean);
                if (!parts.length) return '';
                var init = parts[0].charAt(0);
                if (parts.length > 1 && parts[1]) init += parts[1].charAt(0);
                return init;
            }

            function updateAvatar(row) {
                var avatar = row.querySelector('[data-avatar]');
                var sel = row.querySelector('select');
                if (!avatar || !sel) return;
                var text = sel.selectedIndex > 0 ? sel.options[sel.selectedIndex].text : '';
                var init = initialsOf(text);
                if (init) {
                    avatar.textContent = init;
                } else {
                    avatar.textContent = '';
                    avatar.innerHTML = '<span class="material-symbols-rounded" aria-hidden="true">person</span>';
                }
            }

            var containers = ['guests-container', 'correspondents-container', 'employees-container'];
            var statIds = {
                'guests-container': 'stat-guests',
                'correspondents-container': 'stat-correspondents',
                'employees-container': 'stat-employees'
            };

            function updateStats() {
                containers.forEach(function (id) {
                    var c = document.getElementById(id);
                    var s = document.getElementById(statIds[id]);
                    if (c && s) s.textContent = c.querySelectorAll('.ep-row').length;
                });
            }

            containers.forEach(function (id) {
                var c = document.getElementById(id);
                if (!c) return;
                c.addEventListener('change', function (e) {
                    var row = e.target.closest('.ep-row');
                    if (row) updateAvatar(row);
                });
                if (window.MutationObserver) {
                    new MutationObserver(updateStats).observe(c, { childList: true });
                }
            });

            function pad(n) { return n < 10 ? '0' + n : '' + n; }

            function updateCalendar() {
                var dateInput = document.getElementById('input-date');
                var timeInput = document.getElementById('input-time');
                var fp = dateInput && dateInput._flatpickr ? dateInput._flatpickr : null;
                var d = fp ? fp.selectedDates[0] : null;

                var dn = document.getElementById('preview-daynum');
                var mn = document.getElementById('preview-month');
                var yn = document.getElementById('preview-year');
                if (dn) dn.textContent = d ? d.getDate() : '–';
                if (mn) mn.textContent = d ? arMonthsW[d.getMonth()] : '';
                if (yn) yn.textContent = d ? d.getFullYear() : '';

                var sd = document.getElementById('ws-summary-date');
                if (sd) {
                    sd.textContent = d ? (arDaysW[d.getDay()] + ' ' + d.getDate() + ' ' + arMonthsW[d.getMonth()] + ' ' + d.getFullYear()) : 'لم يُحدد';
                }
                var st = document.getElementById('ws-summary-time');
                if (st) {
                    var tfp = timeInput && timeInput._flatpickr ? timeInput._flatpickr : null;
                    var td = tfp ? tfp.selectedDates[0] : null;
                    st.textContent = td ? pad(td.getHours()) + ':' + pad(td.getMinutes()) : 'لم يُحدد';
                }
            }

            function updateProgram() {
                var sel = document.getElementById('ProgramId');
                if (!sel) return;
                var text = sel.selectedIndex > 0 ? sel.options[sel.selectedIndex].text : '';
                var v = text || 'لم يُحدد';
                var h = document.getElementById('ws-header-program');
                var s = document.getElementById('ws-side-program');
                if (h) h.textContent = v;
                if (s) s.textContent = v;
            }

            function attachRipple(btn) {
                btn.addEventListener('click', function (e) {
                    if (btn.disabled || btn.getAttribute('aria-disabled') === 'true') return;
                    var rect = btn.getBoundingClientRect();
                    var size = Math.max(rect.width, rect.height) * 2;
                    var span = document.createElement('span');
                    span.className = 'ws-ripple';
                    span.style.width = span.style.height = size + 'px';
                    span.style.left = (e.clientX - rect.left - size / 2) + 'px';
                    span.style.top = (e.clientY - rect.top - size / 2) + 'px';
                    btn.appendChild(span);
                    window.setTimeout(function () { span.remove(); }, 700);
                });
            }

            document.addEventListener('DOMContentLoaded', function () {
                document.querySelectorAll('.ws-edit .btn').forEach(attachRipple);

                var dateInput = document.getElementById('input-date');
                var timeInput = document.getElementById('input-time');
                if (dateInput && dateInput._flatpickr) dateInput._flatpickr.config.onChange.push(updateCalendar);
                if (timeInput && timeInput._flatpickr) timeInput._flatpickr.config.onChange.push(updateCalendar);

                var prog = document.getElementById('ProgramId');
                if (prog) prog.addEventListener('change', updateProgram);

                updateCalendar();
                updateProgram();
                updateStats();
                containers.forEach(function (id) {
                    var c = document.getElementById(id);
                    if (c) c.querySelectorAll('.ep-row').forEach(updateAvatar);
                });
            });
        })();
    </script>
    <script src="~/js/episode-edit.js" asp-append-version="true"></script>
}
