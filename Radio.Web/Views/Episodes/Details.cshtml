@model EpisodeDetailsViewModel
@{
    ViewData["Title"] = Model.Episode.EpisodeName;
    var ep = Model.Episode;
}

<div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4 bg-surface p-6 rounded-2xl border border-border/80 shadow-sm relative overflow-hidden group">
    <div class="absolute -top-10 -right-10 w-32 h-32 bg-primary/5 rounded-full blur-xl transition-all duration-500"></div>
    <div class="relative z-10">
        <nav class="text-xs font-semibold text-ink-muted mb-2 flex items-center gap-1.5">
            <a href="/Episodes" class="hover:text-primary transition">الحلقات</a>
            <span class="material-symbols-rounded text-xs text-ink-soft">chevron_left</span>
            <span class="text-ink">تفاصيل الحلقة</span>
        </nav>
        <h1 class="text-2xl font-black text-ink flex items-center gap-2 mb-1">
            <span class="material-symbols-rounded text-primary p-1 bg-primary/10 rounded-lg">podcasts</span>
            @ep.EpisodeName
        </h1>
        <p class="text-ink-muted text-xs flex items-center gap-1">
            <span class="material-symbols-rounded text-xs text-ink-soft">radio</span>
            @ep.ProgramName
        </p>
    </div>
    <div class="flex items-center gap-2 relative z-10">
        <a href="/Episodes" class="btn btn-ghost px-4 py-2 text-xs flex items-center gap-1 rounded-xl">
            <span class="material-symbols-rounded text-sm">arrow_forward</span>
            الرجوع لقائمة الحلقات
        </a>
        <partial name="_StatusBadge" model='new StatusBadgeViewModel { Type = "episode", Status = ep.StatusText, Label = ep.StatusText }' />
    </div>
</div>

<!-- Workflow Timeline -->
<div class="bg-surface rounded-2xl border border-border/80 p-6 mb-6 shadow-md relative overflow-hidden group">
    <div class="absolute -top-10 -right-10 w-28 h-28 bg-primary/5 rounded-full blur-xl transition-all duration-500 group-hover:scale-125"></div>
    <div class="flex items-center justify-between mb-6 pb-3 border-b border-border/60">
        <div class="flex items-center gap-2">
            <span class="material-symbols-rounded text-primary p-1.5 bg-primary/10 rounded-lg text-lg">timeline</span>
            <h3 class="font-bold text-ink text-base">مسار سير العمل</h3>
        </div>
        @if (ep.StatusId == 4)
        {
            <span class="badge bg-danger/10 text-danger border border-danger/20 flex items-center gap-1 font-bold text-xs py-1 px-3 rounded-full">
                <span class="material-symbols-rounded text-xs">cancel</span>
                ملغاة
            </span>
        }
        else
        {
            <span class="badge bg-primary/5 text-primary border border-primary/10 flex items-center gap-1 font-bold text-xs py-1 px-3 rounded-full">
                <span class="material-symbols-rounded text-xs">sync</span>
                المرحلة الحالية: @ep.StatusText
            </span>
        }
    </div>

    @{
        var stages = new[] {
            new { Id = 0, Name = "مجدولة",       Icon = "calendar_today" },
            new { Id = 1, Name = "منفّذة",        Icon = "play_circle" },
            new { Id = 2, Name = "منشورة رقمياً", Icon = "share" },
            new { Id = 3, Name = "منشورة على الموقع", Icon = "public" }
        };
        var isCancelled = ep.StatusId == 4;

        bool IsDone(int i)
        {
            if (isCancelled) return i == 0;
            var s = stages[i];
            return ep.StatusId > s.Id || (ep.StatusId == s.Id && i == stages.Length - 1);
        }

        bool IsCurrent(int i)
        {
            if (isCancelled) return false;
            return ep.StatusId == stages[i].Id;
        }
    }

    <div class="relative flex items-center justify-between gap-0 w-full mt-4">
        @for (int i = 0; i < stages.Length; i++)
        {
            var s = stages[i];
            var done = IsDone(i);
            var current = IsCurrent(i);

            <div class="flex-1 flex flex-col items-center relative">
                <!-- Connector Line -->
                @if (i > 0)
                {
                    var lineActive = IsDone(i) || IsCurrent(i);
                    <div class="absolute top-[20px] -right-[50%] w-[100%] h-1 z-0 transition-all duration-500 @(lineActive && !isCancelled ? "bg-success" : "bg-border")"></div>
                }

                <!-- Stage circle -->
                <div class="w-10 h-10 rounded-full flex items-center justify-center z-10 transition-all duration-300 border-2
                    @(done && !isCancelled ? "bg-success text-white border-success shadow-md shadow-success/15 hover:scale-105" :
                      current && !isCancelled ? "bg-primary text-white border-white shadow-lg ring-4 ring-primary/25 scale-110" :
                      "bg-surface-3 text-ink-soft border-border/80") shrink-0">
                    <span class="material-symbols-rounded text-base">@(done && !isCancelled ? "check" : s.Icon)</span>
                </div>

                <!-- Stage label -->
                <div class="mt-3 text-center px-1 z-10">
                    <div class="text-xs font-bold leading-tight transition-colors duration-300 @(done && !isCancelled ? "text-success" : current && !isCancelled ? "text-primary font-extrabold" : "text-ink-muted")">
                        @s.Name
                    </div>
                    @if (current && !isCancelled)
                    {
                        <span class="text-[9px] font-bold text-primary bg-primary/10 px-2 py-0.5 rounded-full mt-1 inline-block">الحالية</span>
                    }
                </div>
            </div>
        }

        @if (isCancelled)
        {
            <div class="flex-1 flex flex-col items-center relative">
                <div class="absolute top-[20px] -right-[50%] w-[100%] h-1 z-0 bg-danger/30"></div>
                <div class="w-10 h-10 rounded-full flex items-center justify-center bg-danger text-white border-2 border-danger shadow-md shadow-danger/20 z-10 shrink-0 hover:scale-105 transition-all">
                    <span class="material-symbols-rounded text-base">cancel</span>
                </div>
                <div class="mt-3 text-center px-1 z-10">
                    <div class="text-xs font-bold leading-tight text-danger">ملغاة</div>
                    <span class="text-[9px] font-bold text-danger bg-danger/10 px-2 py-0.5 rounded-full mt-1 inline-block">نهائية</span>
                </div>
            </div>
        }
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-4">
    <!-- Properties Card -->
    <div class="lg:col-span-2 space-y-4">
        <!-- Basic Info -->
        <div class="bg-surface rounded-2xl border border-border/80 shadow-sm p-6 relative overflow-hidden group">
            <div class="flex items-center gap-2 mb-4 pb-3 border-b border-border/60">
                <span class="material-symbols-rounded text-primary p-1 bg-primary/10 rounded-lg text-lg">info</span>
                <h3 class="font-bold text-ink text-base">معلومات الحلقة الأساسية</h3>
            </div>
            
            <div class="space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="bg-surface-3 p-3 rounded-xl border border-border/50">
                        <div class="text-[10px] font-bold text-ink-muted mb-1">البرنامج الإذاعي</div>
                        <div class="font-bold text-ink text-sm flex items-center gap-1">
                            <span class="material-symbols-rounded text-sm text-primary">radio</span>
                            @ep.ProgramName
                        </div>
                    </div>
                    <div class="bg-surface-3 p-3 rounded-xl border border-border/50">
                        <div class="text-[10px] font-bold text-ink-muted mb-1">حالة الحلقة الحالية</div>
                        <partial name="_StatusBadge" model='new StatusBadgeViewModel { Type = "episode", Status = ep.StatusText, Label = ep.StatusText }' />
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(ep.EpisodeDescription))
                {
                    <div class="border-r-4 border-primary bg-primary/5 rounded-l-xl p-4 shadow-inner">
                        <div class="text-[10px] font-bold text-primary mb-1">وصف ومحتوى الحلقة</div>
                        <div class="text-ink text-sm leading-relaxed whitespace-pre-line font-medium">@ep.EpisodeDescription</div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(ep.SpecialNotes))
                {
                    <div class="border-r-4 border-warning bg-warning/10 rounded-l-xl p-4">
                        <div class="text-[10px] font-bold text-warning mb-1">ملاحظات وتوجيهات خاصة</div>
                        <div class="text-ink text-sm font-medium">@ep.SpecialNotes</div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(ep.CancellationReason))
                {
                    <div class="border-r-4 border-danger bg-danger/10 rounded-l-xl p-4">
                        <div class="text-[10px] font-bold text-danger mb-1 flex items-center gap-1">
                            <span class="material-symbols-rounded text-xs">warning</span>
                            سبب إلغاء وجدولة الحلقة
                        </div>
                        <div class="text-ink text-sm font-medium">@ep.CancellationReason</div>
                    </div>
                }
            </div>
        </div>

        <!-- Stage Properties: Planning -->
        <div class="bg-surface rounded-2xl border border-border/80 shadow-sm p-6 @(ep.StatusId < 1 ? "ring-2 ring-primary/20" : "")">
            <div class="flex items-center gap-2 mb-4 pb-3 border-b border-border/60">
                <span class="material-symbols-rounded text-primary p-1 bg-primary/10 rounded-lg text-lg">calendar_today</span>
                <h3 class="font-bold text-ink text-base flex-1">تفاصيل مرحلة التخطيط</h3>
                @if (ep.StatusId == 0)
                {
                    <span class="badge bg-primary/10 text-primary border border-primary/20 text-xs font-bold py-0.5 px-2.5 rounded-full">المرحلة الحالية</span>
                }
            </div>
            
            <div class="space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="bg-surface-3 p-3 rounded-xl border border-border/50">
                        <div class="text-[10px] font-bold text-ink-muted mb-1">الموعد المجدول للبث</div>
                        <div class="font-bold text-ink text-sm flex items-center gap-1.5">
                            <span class="material-symbols-rounded text-sm text-primary">schedule</span>
                            @(ep.ScheduledExecutionTime?.ToString("yyyy-MM-dd HH:mm") ?? "—")
                        </div>
                    </div>
                    <div class="bg-surface-3 p-3 rounded-xl border border-border/50">
                        <div class="text-[10px] font-bold text-ink-muted mb-1">البرنامج</div>
                        <div class="font-bold text-ink text-sm flex items-center gap-1.5">
                            <span class="material-symbols-rounded text-sm text-primary">radio</span>
                            @ep.ProgramName
                        </div>
                    </div>
                </div>

                @if (ep.GuestItems.Any())
                {
                    <div>
                        <div class="text-xs font-bold text-ink mb-2 flex items-center gap-1">
                            <span class="material-symbols-rounded text-sm text-primary">groups</span>
                            الضيوف المشاركون (@ep.GuestItems.Count)
                        </div>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var g in ep.GuestItems)
                            {
                                <span class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl bg-primary/10 text-primary border border-primary/20 text-xs font-bold shadow-sm">
                                    <span class="material-symbols-rounded text-xs">person</span>
                                    @g.Name
                                    @if (!string.IsNullOrWhiteSpace(g.Topic))
                                    {
                                        <span class="opacity-75 font-medium border-r border-primary/20 pr-1.5 mr-1.5">- @g.Topic</span>
                                    }
                                </span>
                            }
                        </div>
                    </div>
                }

                @if (ep.CorrespondentItems.Any())
                {
                    <div>
                        <div class="text-xs font-bold text-ink mb-2 flex items-center gap-1">
                            <span class="material-symbols-rounded text-sm text-warning">map</span>
                            المراسلون الميدانيون (@ep.CorrespondentItems.Count)
                        </div>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var c in ep.CorrespondentItems)
                            {
                                <span class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl bg-warning/10 text-warning border border-warning/20 text-xs font-bold shadow-sm">
                                    <span class="material-symbols-rounded text-xs">my_location</span>
                                    @c.FullName
                                </span>
                            }
                        </div>
                    </div>
                }

                @if (ep.EmployeeItems.Any())
                {
                    <div>
                        <div class="text-xs font-bold text-ink mb-2 flex items-center gap-1">
                            <span class="material-symbols-rounded text-sm text-ink-muted">badge</span>
                            طاقم العمل والإنتاج (@ep.EmployeeItems.Count)
                        </div>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var e in ep.EmployeeItems)
                            {
                                <span class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl bg-surface-3 text-ink-muted border border-border/80 text-xs font-bold shadow-sm">
                                    <span class="material-symbols-rounded text-xs">engineering</span>
                                    @e.FullName
                                    @if (!string.IsNullOrWhiteSpace(e.StaffRoleName))
                                    {
                                        <span class="opacity-75 font-medium border-r border-border pr-1.5 mr-1.5">(@e.StaffRoleName)</span>
                                    }
                                </span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Stage Properties: Execution -->
        @if (ep.StatusId >= 1)
        {
            <div class="bg-surface rounded-2xl border border-border/80 shadow-sm p-6 @(ep.StatusId == 1 ? "ring-2 ring-success/20" : "")">
                <div class="flex items-center gap-2 mb-4 pb-3 border-b border-border/60">
                    <span class="material-symbols-rounded text-success p-1 bg-success/10 rounded-lg text-lg">play_circle</span>
                    <h3 class="font-bold text-ink text-base flex-1">تفاصيل مرحلة التنفيذ (الإنتاج)</h3>
                    @if (ep.StatusId == 1)
                    {
                        <span class="badge bg-success/10 text-success border border-success/20 text-xs font-bold py-0.5 px-2.5 rounded-full">المرحلة الحالية</span>
                    }
                </div>
                
                <div class="space-y-3">
                    @if (ep.ActualExecutionTime.HasValue)
                    {
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="bg-surface-3 p-3 rounded-xl border border-border/50">
                                <div class="text-[10px] font-bold text-ink-muted mb-1">وقت التنفيذ الفعلي للبث</div>
                                <div class="font-bold text-ink text-sm flex items-center gap-1.5">
                                    <span class="material-symbols-rounded text-sm text-success">event_available</span>
                                    @ep.ActualExecutionTime.Value.ToString("yyyy-MM-dd HH:mm")
                                </div>
                            </div>
                            @{
                                var execLog = Model.PublishingRecords.FirstOrDefault(r => r.RecordType == "Execution");
                            }
                    @if (execLog != null)
                    {
                        <div class="bg-surface-3 p-3 rounded-xl border border-border/50">
                            <div class="text-[10px] font-bold text-ink-muted mb-1">الملخص والمدة</div>
                            <div class="font-bold text-ink text-sm flex items-center gap-1.5">
                                <span class="material-symbols-rounded text-sm text-success">hourglass_empty</span>
                                @execLog.Summary
                            </div>
                        </div>
                    }
                        </div>
                    @if (User.HasPermission(AppPermissions.EpisodeExecute) && execLog != null)
                    {
                        <a href="/ExecutionLogs/Edit/@execLog.RecordId" class="flex items-center justify-center gap-1.5 px-4 py-2 rounded-xl border border-success/30 bg-success/5 hover:bg-success/10 text-success hover:text-success/80 hover:shadow-sm transition-all duration-200 font-semibold text-xs w-full text-center">
                            <span class="material-symbols-rounded text-sm">edit</span>
                            تعديل بيانات التنفيذ
                        </a>
                    }
                    }
                    else
                    {
                        <div class="text-ink-muted text-sm flex items-center gap-2 py-2">
                            <span class="material-symbols-rounded text-ink-soft">help_outline</span>
                            لم يتم تسجيل وقت التنفيذ الفعلي بعد.
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Stage Properties: Publishing -->
        @if (ep.StatusId >= 2)
        {
            <div class="bg-surface rounded-2xl border border-border/80 shadow-sm p-6 @(ep.StatusId == 2 ? "ring-2 ring-success/20" : "")">
                <div class="flex items-center gap-2 mb-4 pb-3 border-b border-border/60">
                    <span class="material-symbols-rounded text-success p-1 bg-success/10 rounded-lg text-lg">share</span>
                    <h3 class="font-bold text-ink text-base flex-1">تفاصيل النشر الرقمي (سوشال)</h3>
                    @if (ep.StatusId == 2)
                    {
                        <span class="badge bg-success/10 text-success border border-success/20 text-xs font-bold py-0.5 px-2.5 rounded-full">المرحلة الحالية</span>
                    }
                </div>
                
                <div class="space-y-3">
                    @{
                        var socialRecords = Model.PublishingRecords.Where(r => r.RecordType == "SocialMedia").ToList();
                    }
                    @if (socialRecords.Any())
                    {
                        <div class="space-y-3">
                            @foreach (var sr in socialRecords)
                            {
                                <div class="bg-surface-3 border border-border/50 rounded-xl p-4 hover:shadow-sm transition">
                                    <div class="flex items-center justify-between mb-2 pb-2 border-b border-border/40">
                                        <span class="font-bold text-ink text-sm flex items-center gap-1.5">
                                            <span class="material-symbols-rounded text-sm text-primary">person_pin</span>
                                            @sr.Summary
                                        </span>
                                        <span class="text-xs text-ink-muted font-medium flex items-center gap-1">
                                            <span class="material-symbols-rounded text-xs">schedule</span>
                                            @sr.RecordDate.ToString("yyyy-MM-dd HH:mm")
                                        </span>
                                    </div>
                                    <div class="text-xs text-ink-muted flex items-center gap-1">
                                        <span class="material-symbols-rounded text-xs text-ink-soft">account_circle</span>
                                        المسؤول عن النشر: @(sr.RecordedBy ?? "تلقائي")
                                    </div>
                                    @if (User.HasPermission(AppPermissions.EpisodePublish))
                                    {
                                        <a href="/Publishing/Edit/@sr.RecordId" class="flex items-center justify-center gap-1.5 w-full mt-3 py-2 rounded-xl border border-primary/30 bg-primary/5 hover:bg-primary/10 text-primary hover:text-primary/80 transition font-semibold text-xs text-center">
                                            <span class="material-symbols-rounded text-sm">edit</span>
                                            تعديل النشر الرقمي
                                        </a>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-ink-muted text-sm flex items-center gap-2 py-2">
                            <span class="material-symbols-rounded text-ink-soft">help_outline</span>
                            لا توجد سجلات نشر رقمي مسجلة بعد.
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Stage Properties: Website -->
        @if (ep.StatusId >= 3)
        {
            <div class="bg-surface rounded-2xl border border-border/80 shadow-sm p-6 @(ep.StatusId == 3 ? "ring-2 ring-accent/20" : "")">
                <div class="flex items-center gap-2 mb-4 pb-3 border-b border-border/60">
                    <span class="material-symbols-rounded text-accent p-1 bg-accent/10 rounded-lg text-lg">public</span>
                    <h3 class="font-bold text-ink text-base flex-1">تفاصيل النشر على الموقع الرسمي</h3>
                    @if (ep.StatusId == 3)
                    {
                        <span class="badge bg-accent/10 text-accent border border-accent/20 text-xs font-bold py-0.5 px-2.5 rounded-full">المرحلة الحالية</span>
                    }
                </div>
                
                <div class="space-y-3">
                    @{
                        var websiteRecords = Model.PublishingRecords.Where(r => r.RecordType == "Website").ToList();
                    }
                    @if (websiteRecords.Any())
                    {
                        <div class="space-y-3">
                            @foreach (var wr in websiteRecords)
                            {
                                <div class="bg-surface-3 border border-border/50 rounded-xl p-4 hover:shadow-sm transition">
                                    <div class="flex items-center justify-between mb-2 pb-2 border-b border-border/40">
                                        <span class="font-bold text-ink text-sm flex items-center gap-1.5">
                                            <span class="material-symbols-rounded text-sm text-accent">language</span>
                                            @wr.Summary
                                        </span>
                                        <span class="text-xs text-ink-muted font-medium flex items-center gap-1">
                                            <span class="material-symbols-rounded text-xs">schedule</span>
                                            @wr.RecordDate.ToString("yyyy-MM-dd HH:mm")
                                        </span>
                                    </div>
                                    <div class="text-xs text-ink-muted flex items-center gap-1">
                                        <span class="material-symbols-rounded text-xs text-ink-soft">account_circle</span>
                                        المسؤول عن النشر: @(wr.RecordedBy ?? "تلقائي")
                                    </div>
                                    @if (User.HasPermission(AppPermissions.EpisodeWebPublish))
                                    {
                                        <a href="/WebsitePublishing/Edit/@wr.RecordId" class="flex items-center justify-center gap-1.5 w-full mt-3 py-2 rounded-xl border border-accent/30 bg-accent/5 hover:bg-accent/10 text-accent hover:text-accent/80 transition font-semibold text-xs text-center">
                                            <span class="material-symbols-rounded text-sm">edit</span>
                                            تعديل النشر على الموقع
                                        </a>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-ink-muted text-sm flex items-center gap-2 py-2">
                            <span class="material-symbols-rounded text-ink-soft">help_outline</span>
                            لا توجد سجلات نشر موقع مسجلة بعد.
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Sidebar: Actions & Timeline -->
    <div class="space-y-4">
        <!-- Actions Card -->
        <div class="bg-surface rounded-2xl border border-border/80 shadow-md p-6 relative overflow-hidden group">
            <div class="absolute -top-10 -left-10 w-28 h-28 bg-primary/5 rounded-full blur-xl transition-all duration-500 group-hover:scale-125"></div>
            <div class="flex items-center gap-2 mb-4 border-b border-border/60 pb-3">
                <span class="material-symbols-rounded text-primary p-1.5 bg-primary/10 rounded-lg text-lg">bolt</span>
                <h3 class="font-bold text-ink text-base">إجراءات الحلقة</h3>
            </div>
            <div class="space-y-3">
                @if (User.HasPermission(AppPermissions.EpisodeEdit) && ep.StatusId != 4)
                {
                    <a href="/Episodes/Edit/@ep.EpisodeId" class="flex items-center gap-3 px-4 py-3 rounded-xl border border-primary/20 bg-primary/10 text-primary hover:bg-primary/20 hover:shadow-sm transition-all duration-200 font-semibold text-sm w-full">
                        <span class="material-symbols-rounded text-lg">edit</span>
                        تعديل خصائص الحلقة
                    </a>
                }
                @if (User.HasPermission(AppPermissions.EpisodeExecute) && ep.StatusId == 0)
                {
                    <button type="button" class="flex items-center gap-3 px-4 py-3 rounded-xl border border-success/20 bg-success/10 text-success hover:bg-success/20 hover:shadow-sm transition-all duration-200 font-semibold text-sm w-full" onclick="openExecuteModal(@ep.EpisodeId, '@ep.EpisodeName')">
                        <span class="material-symbols-rounded text-lg">play_circle</span>
                        تسجيل وتوثيق التنفيذ
                    </button>
                }
                @if (User.HasPermission(AppPermissions.EpisodePublish) && ep.StatusId == 1)
                {
                    <a href="/Publishing/LogSocial/@ep.EpisodeId" class="flex items-center gap-3 px-4 py-3 rounded-xl border border-info/20 bg-info/10 text-info hover:bg-info/20 hover:shadow-sm transition-all duration-200 font-semibold text-sm w-full">
                        <span class="material-symbols-rounded text-lg">share</span>
                        البدء بالنشر الرقمي (سوشال)
                    </a>
                }
                @if (User.HasPermission(AppPermissions.EpisodeWebPublish) && (ep.StatusId == 1 || ep.StatusId == 2))
                {
                    <a href="/WebsitePublishing/Publish/@ep.EpisodeId" class="flex items-center gap-3 px-4 py-3 rounded-xl border border-accent/20 bg-accent/10 text-accent hover:bg-accent/20 hover:shadow-sm transition-all duration-200 font-semibold text-sm w-full">
                        <span class="material-symbols-rounded text-lg">public</span>
                        النشر على الموقع الرسمي
                    </a>
                }
                @if (User.HasPermission(AppPermissions.EpisodeRevert) && ep.StatusId is 1 or 2 or 3)
                {
                    <button type="button" class="flex items-center gap-3 px-4 py-3 rounded-xl border border-warning/20 bg-warning/10 text-warning hover:bg-warning/20 hover:shadow-sm transition-all duration-200 font-semibold text-sm w-full" onclick="openRevertModal(@ep.EpisodeId, '@ep.EpisodeName')">
                        <span class="material-symbols-rounded text-lg">undo</span>
                        التراجع عن الحالة السابقة
                    </button>
                }
                @if (User.HasPermission(AppPermissions.EpisodeDelete) && ep.StatusId != 4)
                {
                    <button type="button" class="flex items-center gap-3 px-4 py-3 rounded-xl border border-danger/20 bg-danger/10 text-danger hover:bg-danger/20 hover:shadow-sm transition-all duration-200 font-semibold text-sm w-full" onclick="openCancelModal(@ep.EpisodeId, '@ep.EpisodeName')">
                        <span class="material-symbols-rounded text-lg">cancel</span>
                        إلغاء الحلقة
                    </button>
                }
            </div>
        </div>

        <!-- Attachments -->
        <div class="bg-surface rounded-2xl border border-border/80 shadow-md p-6 relative overflow-hidden group">
            <div class="flex items-center gap-2 mb-4 border-b border-border/60 pb-3">
                <span class="material-symbols-rounded text-primary p-1.5 bg-primary/10 rounded-lg text-lg">attach_file</span>
                <h3 class="font-bold text-ink text-base">المرفقات</h3>
            </div>
            <form method="post" action="/Upload/Episode/@Model.Episode.EpisodeId" enctype="multipart/form-data" class="mb-3">
                <div class="flex gap-2">
                    <input type="file" name="files" multiple class="file-input file-input-bordered file-input-sm flex-1" />
                    <button type="submit" class="btn btn-primary btn-sm">
                        <span class="material-symbols-rounded text-sm">upload</span>
                        رفع
                    </button>
                </div>
            </form>
            <div id="attachmentList" class="space-y-1">
                <div class="text-center py-4 text-ink-muted text-xs">
                    <span class="material-symbols-rounded text-lg block mb-1 text-ink-soft">cloud_upload</span>
                    جاري تحميل المرفقات…
                </div>
            </div>
        </div>

        <!-- Activity Timeline -->
        <div class="bg-surface rounded-2xl border border-border/80 shadow-md p-6 relative overflow-hidden group">
            <div class="flex items-center gap-2 mb-4 border-b border-border/60 pb-3">
                <span class="material-symbols-rounded text-accent p-1.5 bg-accent/10 rounded-lg text-lg">history</span>
                <h3 class="font-bold text-ink text-base">السجل الزمني للعمليات</h3>
            </div>
            
            <div class="relative border-r-2 border-border/60 pr-4 mr-2 space-y-5">
                @if (!Model.PublishingRecords.Any())
                {
                    <div class="text-center py-6 text-ink-muted text-xs">
                        <span class="material-symbols-rounded text-lg block mb-1 text-ink-soft">history_toggle_off</span>
                        لا توجد عمليات مسجلة بعد.
                    </div>
                }
                @foreach (var r in Model.PublishingRecords.OrderByDescending(x => x.RecordDate).Take(5))
                {
                    <div class="relative flex items-start gap-3">
                        <!-- Dot indicator on the timeline line -->
                        <div class="absolute -right-[23px] top-1.5 w-3.5 h-3.5 rounded-full border-2 border-surface flex items-center justify-center shadow-sm" style="background-color: @r.RecordColor"></div>
                        
                        <div class="flex-1 min-w-0">
                            <div class="text-xs font-bold text-ink truncate">@r.Summary</div>
                            <div class="text-[10px] text-ink-muted mt-0.5 flex items-center gap-1">
                                <span class="material-symbols-rounded text-[10px]">schedule</span>
                                @r.RecordDate.ToString("yyyy-MM-dd HH:mm")
                                @if (!string.IsNullOrEmpty(r.RecordedBy))
                                {
                                    <span class="border-r border-border pr-1 mr-1">بواسطة: @r.RecordedBy</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
            @if (Model.PublishingRecords.Any())
            {
                <div class="mt-4 pt-3 border-t border-border/60">
                    <a href="/Publishing?episodeId=@ep.EpisodeId" class="flex items-center justify-center gap-1.5 w-full py-2.5 rounded-xl border border-border bg-surface-3 hover:bg-surface-2 text-ink-muted hover:text-primary transition font-semibold text-xs text-center">
                        <span class="material-symbols-rounded text-sm">list_alt</span>
                        عرض كافة سجلات النشر والإنتاج
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<!-- Execute Modal -->
<div id="executeModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4">
    <div class="bg-surface rounded-xl shadow-xl max-w-md w-full p-6">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-bold text-ink">تسجيل تنفيذ الحلقة</h3>
            <button type="button" class="text-ink-soft hover:text-ink" onclick="closeModal('executeModal')">
                <span class="material-symbols-rounded">close</span>
            </button>
        </div>
        <form id="executeForm" method="post" action="">
            @Html.AntiForgeryToken()
            <div class="mb-4">
                <label class="label">ملاحظات التنفيذ</label>
                <textarea name="executionNotes" rows="3" class="textarea textarea-bordered"></textarea>
            </div>
            <div class="mb-4">
                <label class="label">مشكلات واجهت التنفيذ</label>
                <textarea name="issuesEncountered" rows="2" class="textarea textarea-bordered"></textarea>
            </div>
            <div class="mb-4">
                <label class="label">المدة (دقيقة) *</label>
                <input type="number" name="durationMinutes" min="1" max="720" value="60" class="input input-bordered  required />
            </div>
            <div class="flex gap-2 justify-end">
                <button type="button" class="btn btn-ghost" onclick="closeModal('executeModal')">إلغاء</button>
                <button type="submit" class="btn btn-success">تسجيل التنفيذ</button>
            </div>
        </form>
    </div>
</div>

<!-- Cancel Modal -->
<div id="cancelModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4">
    <div class="bg-surface rounded-xl shadow-xl max-w-md w-full p-6">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-bold text-ink">إلغاء الحلقة</h3>
            <button type="button" class="text-ink-soft hover:text-ink" onclick="closeModal('cancelModal')">
                <span class="material-symbols-rounded">close</span>
            </button>
        </div>
        <form id="cancelForm" method="post" action="">
            @Html.AntiForgeryToken()
            <div class="mb-4">
                <label class="label">سبب الإلغاء *</label>
                <textarea name="reason" rows="3" class="textarea textarea-bordered" required></textarea>
            </div>
            <div class="flex gap-2 justify-end">
                <button type="button" class="btn btn-ghost" onclick="closeModal('cancelModal')">إلغاء</button>
                <button type="submit" class="btn btn-error">تأكيد الإلغاء</button>
            </div>
        </form>
    </div>
</div>

<!-- Revert Modal -->
<div id="revertModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4">
    <div class="bg-surface rounded-xl shadow-xl max-w-md w-full p-6">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-bold text-ink">تراجع عن الحالة</h3>
            <button type="button" class="text-ink-soft hover:text-ink" onclick="closeModal('revertModal')">
                <span class="material-symbols-rounded">close</span>
            </button>
        </div>
        <form id="revertForm" method="post" action="">
            @Html.AntiForgeryToken()
            <div class="mb-4">
                <label class="label">سبب التراجع *</label>
                <textarea name="reason" rows="3" class="textarea textarea-bordered" required placeholder="سبب التراجع عن الحالة"></textarea>
            </div>
            <div class="flex gap-2 justify-end">
                <button type="button" class="btn btn-ghost" onclick="closeModal('revertModal')">إلغاء</button>
                <button type="submit" class="btn btn-warning">تأكيد التراجع</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openExecuteModal(id, name) {
            document.getElementById('executeForm').action = '/Episodes/Execute/' + id;
            document.getElementById('executeModal').classList.remove('hidden');
            document.getElementById('executeModal').classList.add('flex');
        }
        function openCancelModal(id, name) {
            document.getElementById('cancelForm').action = '/Episodes/Cancel/' + id;
            document.getElementById('cancelModal').classList.remove('hidden');
            document.getElementById('cancelModal').classList.add('flex');
        }
        function openRevertModal(id, name) {
            document.getElementById('revertForm').action = '/Episodes/Revert/' + id;
            document.getElementById('revertModal').classList.remove('hidden');
            document.getElementById('revertModal').classList.add('flex');
        }
        function closeModal(id) {
            const modal = document.getElementById(id);
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }
        document.addEventListener('click', function (e) {
            if (e.target.classList.contains('bg-black/50')) {
                closeModal('executeModal');
                closeModal('cancelModal');
                closeModal('revertModal');
            }
        });

        function loadAttachments() {
            fetch('/Upload/Episode/@Model.Episode.EpisodeId')
                .then(r => r.json())
                .then(files => {
                    const container = document.getElementById('attachmentList');
                    if (!files || files.length === 0) {
                        container.innerHTML = '<div class="text-center py-4 text-ink-muted text-xs"><span class="material-symbols-rounded text-lg block mb-1 text-ink-soft">cloud_off</span>لا توجد مرفقات</div>';
                        return;
                    }
                    container.innerHTML = files.map(f =>
                        '<div class="flex items-center gap-2 p-2 rounded-lg hover:bg-base-200/50 transition-colors">' +
                            '<span class="material-symbols-rounded text-sm text-primary">description</span>' +
                            '<a href="/uploads/' + @Model.Episode.EpisodeId + '/' + f.storedName + '" target="_blank" class="flex-1 text-sm text-primary hover:underline truncate">' + f.fileName + '</a>' +
                            '<span class="text-xs text-ink-muted" dir="ltr">' + formatSize(f.sizeBytes) + '</span>' +
                            '<form method="post" action="/Upload/Delete/' + @Model.Episode.EpisodeId + '/' + f.storedName + '" class="inline" onsubmit="return confirm(\'حذف الملف؟\')">' +
                                '<button class="btn btn-ghost btn-xs text-danger"><span class="material-symbols-rounded text-sm">delete</span></button>' +
                            '</form>' +
                        '</div>'
                    ).join('');
                });
        }

        function formatSize(bytes) {
            if (bytes < 1024) return bytes + ' B';
            if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
            return (bytes / 1048576).toFixed(1) + ' MB';
        }

        document.addEventListener('DOMContentLoaded', loadAttachments);
    </script>
}

