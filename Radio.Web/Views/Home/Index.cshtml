@model DashboardViewModel
@{
    ViewData["Title"] = "لوحة التحكم";
}

<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
    <div>
        <div class="breadcrumbs text-sm text-base-content/60">
            <ul>
                <li><span class="inline-flex items-center gap-1"><span class="material-symbols-rounded text-lg">space_dashboard</span>لوحة التحكم</span></li>
            </ul>
        </div>
        <h1 class="text-2xl font-extrabold text-base-content mt-1 flex items-center gap-2">
            <span class="material-symbols-rounded text-primary p-1 bg-primary/10 rounded-lg">space_dashboard</span>
            لوحة التحكم
        </h1>
        <p class="text-sm text-base-content/60 mt-0.5">مرحباً بك! إليك ملخصاً فورياً وإحصائيات سريعة حول نشاط البث والإنتاج اليوم.</p>
    </div>
</div>

<!-- Stat Cards -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-6">
    <div class="card bg-base-100 shadow-md p-6 text-primary">
        <div class="card-body p-0">
            <div class="flex items-center justify-between">
                <div>
                    <div class="text-2xl font-black text-base-content">@Model.TodayEpisodes.Count</div>
                    <div class="text-xs font-bold text-base-content/60 mt-1">حلقات اليوم</div>
                </div>
                <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center">
                    <span class="material-symbols-rounded">podcasts</span>
                </div>
            </div>
        </div>
    </div>

    <div class="card bg-base-100 shadow-md p-6 text-accent">
        <div class="card-body p-0">
            <div class="flex items-center justify-between">
                <div>
                    <div class="text-2xl font-black text-base-content">@Model.TotalEpisodes</div>
                    <div class="text-xs font-bold text-base-content/60 mt-1">إجمالي الحلقات</div>
                </div>
                <div class="w-12 h-12 rounded-xl bg-accent/10 text-accent flex items-center justify-center">
                    <span class="material-symbols-rounded">analytics</span>
                </div>
            </div>
        </div>
    </div>

    <div class="card bg-base-100 shadow-md p-6 text-success">
        <div class="card-body p-0">
            <div class="flex items-center justify-between">
                <div>
                    <div class="text-2xl font-black text-base-content">@Model.TotalPrograms</div>
                    <div class="text-xs font-bold text-base-content/60 mt-1">البرامج النشطة</div>
                </div>
                <div class="w-12 h-12 rounded-xl bg-success/10 text-success flex items-center justify-center">
                    <span class="material-symbols-rounded">radio</span>
                </div>
            </div>
        </div>
    </div>

    <div class="card bg-base-100 shadow-md p-6 text-error">
        <div class="card-body p-0">
            <div class="flex items-center justify-between">
                <div>
                    <div class="text-2xl font-black text-base-content">@Model.CancelledEpisodes.Count</div>
                    <div class="text-xs font-bold text-base-content/60 mt-1">حلقات ملغاة</div>
                </div>
                <div class="w-12 h-12 rounded-xl bg-error/10 text-error flex items-center justify-center">
                    <span class="material-symbols-rounded">cancel</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
    <div class="card bg-base-100 shadow-md">
        <div class="card-body">
            <div class="flex items-center gap-2 mb-4">
                <span class="material-symbols-rounded text-primary">donut_large</span>
                <h3 class="font-bold text-base-content text-base">توزيع حالات الحلقات</h3>
            </div>
            <div class="relative h-64">
                <canvas id="statusChart"></canvas>
            </div>
        </div>
    </div>

    <div class="card bg-base-100 shadow-md">
        <div class="card-body">
            <div class="flex items-center gap-2 mb-4">
                <span class="material-symbols-rounded text-primary">bar_chart</span>
                <h3 class="font-bold text-base-content text-base">أكثر البرامج نشاطاً</h3>
            </div>
            <div class="relative h-64">
                <canvas id="programsChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Today Episodes Table -->
<div class="card bg-base-100 shadow-md overflow-hidden mb-6">
    <div class="overflow-x-auto">
    <div class="p-5 border-b border-base-200 flex items-center justify-between">
        <h3 class="font-bold text-base-content flex items-center gap-2 text-base">
            <span class="material-symbols-rounded text-primary">today</span>
            حلقات البث لليوم
        </h3>
        <a href="/Episodes" class="text-xs text-primary font-bold hover:underline flex items-center gap-0.5">
            عرض كافة الحلقات
            <span class="material-symbols-rounded text-xs">arrow_left</span>
        </a>
    </div>
    @if (Model.TodayEpisodes.Any())
    {
        <table class="table table-zebra w-full text-sm">
            <thead>
                <tr>
                    <th class="text-right font-semibold">الحلقة</th>
                    <th class="text-right font-semibold">البرنامج</th>
                    <th class="text-right font-semibold">الضيوف</th>
                    <th class="text-right font-semibold">الوقت</th>
                    <th class="text-right font-semibold">الحالة</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ep in Model.TodayEpisodes)
                {
                    <tr>
                        <td class="">
                            <a href="/Episodes/Details/@ep.EpisodeId" class="text-primary font-bold hover:underline">@ep.EpisodeName</a>
                        </td>
                        <td class="text-base-content/60">@ep.ProgramName</td>
                        <td class="text-base-content/60">@ep.GuestsDisplay</td>
                        <td class="text-base-content font-semibold">@(ep.ScheduledExecutionTime?.ToString("HH:mm") ?? "—")</td>
                        <td class="">
                            <partial name="_StatusBadge" model='new StatusBadgeViewModel { Type = "episode", Status = ep.StatusText, Label = ep.StatusText }' />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="card bg-base-100 shadow-md"><div class="card-body text-center py-12">
            <span class="material-symbols-rounded text-4xl text-base-content/30 mb-2">event_busy</span>
            <h3 class="font-bold text-lg mb-2">لا توجد حلقات بث لليوم</h3>
            <p class="text-sm text-base-content/60">لم يتم جدولة أي حلقات إذاعية ليتم بثها اليوم.</p>
        </div></div>
    }
</div>
</div>

<!-- Top Guests + Top Programs -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="card bg-base-100 shadow-md">
        <div class="card-body">
            <div class="flex items-center gap-2 mb-4">
                <span class="material-symbols-rounded text-primary">trending_up</span>
                <h3 class="font-bold text-base-content text-base">قائمة البرامج الأكثر نشاطاً</h3>
            </div>
            <div class="divide-y divide-base-200/60">
            @if (Model.TopPrograms.Any())
            {
                @foreach (var p in Model.TopPrograms.Take(5))
                {
                    <div class="flex items-center justify-between py-3.5 first:pt-0 last:pb-0">
                        <div>
                            <div class="font-bold text-base-content text-sm">@p.ProgramName</div>
                            <div class="text-xs text-base-content/40 mt-0.5">@(p.Category ?? "عام")</div>
                        </div>
                        <div class="text-left">
                            <div class="text-base font-black text-primary">@p.TotalEpisodes</div>
                            <div class="text-[10px] text-base-content/40 font-bold">حلقة</div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="card bg-base-100 shadow-md"><div class="card-body text-center py-6">
                    <span class="material-symbols-rounded text-4xl text-base-content/30 mb-2">radio</span>
                    <p class="text-sm text-base-content/60">لا تتوفر برامج كافية حالياً</p>
                </div></div>
            }
        </div>
    </div>

    <div class="card bg-base-100 shadow-md">
        <div class="card-body">
            <div class="flex items-center gap-2 mb-4">
                <span class="material-symbols-rounded text-primary">people_alt</span>
                <h3 class="font-bold text-base-content text-base">الضيوف الأكثر استضافة</h3>
            </div>
            <div class="divide-y divide-base-200/60">
            @if (Model.TopGuests.Any())
            {
                @foreach (var g in Model.TopGuests.Take(5))
                {
                    <div class="flex items-center justify-between py-3.5 first:pt-0 last:pb-0">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-lg bg-primary/10 text-primary text-xs font-black flex items-center justify-center">
                                @g.Rank
                            </div>
                            <div>
                                <div class="font-bold text-base-content text-sm">@g.FullName</div>
                                <div class="text-xs text-base-content/40 mt-0.5">@(g.Organization ?? "مستقل")</div>
                            </div>
                        </div>
                        <div class="text-left">
                            <div class="text-base font-black text-success">@g.AppearanceCount</div>
                            <div class="text-[10px] text-base-content/40 font-bold">مرات ظهور</div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="card bg-base-100 shadow-md"><div class="card-body text-center py-6">
                    <span class="material-symbols-rounded text-4xl text-base-content/30 mb-2">people_alt</span>
                    <p class="text-sm text-base-content/60">لا توجد بيانات استضافة ضيوف بعد</p>
                </div></div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const isDark = document.documentElement.classList.contains('dark');

        // Chart.js: Status Distribution
        const statusCanvas = document.getElementById('statusChart');
        const ctxStatus = statusCanvas.getContext('2d');
        const statusData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StatusStats));
        const statusLabels = Object.keys(statusData).map(k => {
            const map = {
                'Planned': 'مجدولة',
                'Executed': 'منفّذة',
                'Published': 'منشورة رقمياً',
                'WebsitePublished': 'منشورة على الموقع',
                'Cancelled': 'ملغاة'
            };
            return map[k] || k;
        });
        const statusValues = Object.values(statusData);

        function createGrad(ctx, c1, c2) {
            const g = ctx.createLinearGradient(0, 0, 0, 250);
            g.addColorStop(0, c1);
            g.addColorStop(1, c2);
            return g;
        }

        const doughnutGradients = isDark ? [
            createGrad(ctxStatus, '#1E3A5F', '#1D4ED8'),
            createGrad(ctxStatus, '#1A3A5C', '#1E40AF'),
            createGrad(ctxStatus, '#1A3D2E', '#047857'),
            createGrad(ctxStatus, '#1A3D4A', '#0369A1'),
            createGrad(ctxStatus, '#3D1A1A', '#B91C1C')
        ] : [
            createGrad(ctxStatus, '#60A5FA', '#2563EB'),
            createGrad(ctxStatus, '#3B82F6', '#1D4ED8'),
            createGrad(ctxStatus, '#34D399', '#059669'),
            createGrad(ctxStatus, '#38BDF8', '#0284C7'),
            createGrad(ctxStatus, '#F87171', '#DC2626')
        ];

        new Chart(statusCanvas, {
            type: 'doughnut',
            data: {
                labels: statusLabels,
                datasets: [{
                    data: statusValues,
                    backgroundColor: doughnutGradients,
                    borderWidth: 3,
                    borderColor: isDark ? '#1E293B' : '#FFFFFF',
                    hoverOffset: 8
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '70%',
                plugins: {
                    legend: { 
                        position: 'bottom', 
                        rtl: true, 
                        labels: { 
                            padding: 20,
                            usePointStyle: true,
                            pointStyle: 'circle',
                            color: isDark ? '#CBD5E1' : '#475569',
                            font: { family: 'Cairo', weight: '600', size: 11 } 
                        } 
                    }
                },
                animation: {
                    animateScale: true,
                    animateRotate: true
                }
            }
        });

        // Chart.js: Top Programs
        const programsCanvas = document.getElementById('programsChart');
        const ctxPrograms = programsCanvas.getContext('2d');
        const programsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.TopPrograms.Take(5).Select(p => new { name = p.ProgramName, total = p.TotalEpisodes }).ToList()));

        const barGradient = ctxPrograms.createLinearGradient(0, 0, 400, 0);
        if (isDark) {
            barGradient.addColorStop(0, '#4C1D95');
            barGradient.addColorStop(1, '#1D4ED8');
        } else {
            barGradient.addColorStop(0, '#7C3AED');
            barGradient.addColorStop(1, '#2563EB');
        }

        new Chart(programsCanvas, {
            type: 'bar',
            data: {
                labels: programsData.map(p => p.name),
                datasets: [{
                    label: 'عدد الحلقات',
                    data: programsData.map(p => p.total),
                    backgroundColor: barGradient,
                    hoverBackgroundColor: isDark ? '#1D4ED8' : '#1D4ED8',
                    borderRadius: 12,
                    borderSkipped: false,
                    barThickness: 16
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                indexAxis: 'y',
                plugins: { 
                    legend: { display: false }
                },
                scales: {
                    x: { 
                        grid: { color: isDark ? 'rgba(51, 65, 85, 0.5)' : 'rgba(226, 232, 240, 0.5)' },
                        ticks: { font: { family: 'Cairo', weight: 'bold' }, color: isDark ? '#CBD5E1' : '#475569' } 
                    },
                    y: { 
                        grid: { display: false },
                        ticks: { font: { family: 'Cairo', weight: 'bold' }, color: isDark ? '#CBD5E1' : '#475569' } 
                    }
                }
            }
        });
    </script>
}

