@model DashboardViewModel
@{
    ViewData["Title"] = "لوحة التحكم الرئيسية";
    ViewData["HeaderIcon"] = "dashboard";
    ViewData["HeaderDescription"] = "ملخص فوري ومؤشرات أداء الجدولة والبث الإذاعي اليوم";
    ViewData["HeaderActions"] = "<a href='/Episodes/LiveBoard' class='btn btn-sm btn-destructive'><span class='w-2 h-2 rounded-full bg-primary-foreground animate-ping'></span><span class='material-symbols-rounded text-base'>live_tv</span><span>شاشة العرض المباشر</span></a><a href='/Episodes' class='btn btn-primary btn-sm'><span class='material-symbols-rounded text-base'>add_circle</span><span>حلقة جديدة</span></a>";

    var kpiItems = new List<KpiItem>
    {
        new() { Label = "حلقات البث اليوم", Value = Model.TodayEpisodes.Count.ToString(), Subtitle = "مجدولة لليوم", Icon = "live_tv", Color = "var(--color-primary)", IconBg = "color-mix(in srgb, var(--color-primary) 10%, transparent)", IconColor = "var(--color-primary)" },
        new() { Label = "إجمالي الحلقات", Value = Model.TotalEpisodes.ToString(), Subtitle = "الأرشيف والتنفيذ", Icon = "analytics", Color = "var(--color-accent)", IconBg = "color-mix(in srgb, var(--color-accent) 10%, transparent)", IconColor = "var(--color-accent)" },
        new() { Label = "البرامج النشطة", Value = Model.TotalPrograms.ToString(), Subtitle = "الدورة البرامجية", Icon = "tv", Color = "var(--color-warning)", IconBg = "color-mix(in srgb, var(--color-warning) 10%, transparent)", IconColor = "var(--color-warning)" },
        new() { Label = "حلقات ملغاة", Value = Model.CancelledEpisodes.Count.ToString(), Subtitle = "موقوفة أو مستبعدة", Icon = "cancel", Color = "var(--color-danger)", IconBg = "color-mix(in srgb, var(--color-danger) 10%, transparent)", IconColor = "var(--color-danger)" }
    };
    ViewBag.KpiItems = kpiItems;
}
<div class="max-w-7xl mx-auto space-y-6">
    <partial name="_PageHeader" />
    <partial name="_KpiCards" />

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="card p-6">
            <div class="flex items-center justify-between mb-4 pb-3 border-b border-border">
                <div class="flex items-center gap-2">
                    <div class="p-2 rounded-lg bg-primary-subtle text-primary">
                        <span class="material-symbols-rounded text-lg">donut_large</span>
                    </div>
                    <div>
                        <h3 class="font-bold text-body text-text">توزيع حالات الحلقات</h3>
                        <p class="text-micro text-text-secondary">نسب الجدولة، التنفيذ والنشر الرقمي</p>
                    </div>
                </div>
            </div>
            <div class="relative h-64">
                <canvas id="statusChart"></canvas>
            </div>
        </div>
        <div class="card p-6">
            <div class="flex items-center justify-between mb-4 pb-3 border-b border-border">
                <div class="flex items-center gap-2">
                    <div class="p-2 rounded-lg bg-warning-subtle text-warning">
                        <span class="material-symbols-rounded text-lg">bar_chart</span>
                    </div>
                    <div>
                        <h3 class="font-bold text-body text-text">البرامج الأكثر إنتاجاً</h3>
                        <p class="text-micro text-text-secondary">عدد الحلقات المنفذة لكل برنامج</p>
                    </div>
                </div>
            </div>
            <div class="relative h-64">
                <canvas id="programsChart"></canvas>
            </div>
        </div>
    </div>

    <div class="card overflow-hidden">
        <div class="flex items-center justify-between p-5 border-b border-border bg-bg-hover">
            <div class="flex items-center gap-2.5">
                <span class="material-symbols-rounded text-xl text-primary">today</span>
                <div>
                    <h3 class="font-bold text-body text-text">جدول حلقات البث لليوم</h3>
                    <p class="text-micro text-text-secondary">قائمة الحلقات والمواعيد المجدولة للبث الفوري</p>
                </div>
            </div>
            <a href="/Episodes" class="text-caption font-semibold flex items-center gap-1 text-primary hover:underline">
                <span>عرض أرشيف الحلقات</span>
                <span class="material-symbols-rounded text-sm">chevron_left</span>
            </a>
        </div>

        @if (Model.TodayEpisodes.Any())
        {
            <div class="divide-y divide-border-light">
                @foreach (var ep in Model.TodayEpisodes)
                {
                    <div class="flex items-center gap-4 p-4 transition-colors hover:bg-bg-hover">
                        <div class="w-3 h-3 rounded-full shrink-0 ring-4 bg-primary" style="--tw-ring-color:color-mix(in srgb, var(--color-primary) 15%, transparent)"></div>
                        <div class="flex-1 min-w-0">
                            <a href="/Episodes/Details/@ep.EpisodeId" class="font-bold text-caption text-text hover:text-primary transition-colors">@ep.EpisodeName</a>
                            <div class="flex items-center gap-2 mt-1">
                                <span class="text-micro font-semibold text-text-secondary">@ep.ProgramName</span>
                                @if (!string.IsNullOrWhiteSpace(ep.GuestsDisplay))
                                {
                                    <span class="text-caption text-text-muted">·</span>
                                    <span class="text-micro text-text-muted">@ep.GuestsDisplay</span>
                                }
                            </div>
                        </div>
                        <div class="text-right px-2">
                            <div class="text-caption font-bold tabular-nums text-text">@(ep.ScheduledExecutionTime?.ToString("HH:mm") ?? "—")</div>
                            <div class="text-micro text-text-muted">توقيت البث</div>
                        </div>
                        <partial name="_StatusBadge" model='new StatusBadgeViewModel { Type = "episode", Status = ep.StatusText, Label = ep.StatusText }' />
                    </div>
                }
            </div>
        }
        else
        {
            ViewBag.EmptyIcon = "event_busy";
            ViewBag.EmptyTitle = "لا توجد حلقات مجدولة للبث اليوم";
            ViewBag.EmptyDesc = "لم يتم جدولة أية حلقات للبث في الجدول الزمني لليوم حتى الآن";
            <partial name="_EmptyState" />
        }
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="card p-6">
            <div class="flex items-center gap-2 mb-4 pb-3 border-b border-border">
                <span class="material-symbols-rounded text-lg text-primary">trending_up</span>
                <h3 class="font-bold text-body text-text">البرامج الأكثر نشاطاً</h3>
            </div>
            @if (Model.TopPrograms.Any())
            {
                <div class="space-y-1 divide-y divide-border-light">
                    @foreach (var p in Model.TopPrograms.Take(5))
                    {
                        <div class="flex items-center justify-between py-3 first:pt-0 last:pb-0">
                            <div>
                                <div class="font-bold text-caption text-text">@p.ProgramName</div>
                                <div class="text-micro mt-0.5 text-text-secondary">@(p.Category ?? "برنامج عام")</div>
                            </div>
                            <div class="text-left">
                                <div class="text-body font-bold tabular-nums text-primary">@p.TotalEpisodes</div>
                                <div class="text-micro font-medium text-text-secondary">حلقة</div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="flex flex-col items-center py-8 text-center">
                    <span class="material-symbols-rounded text-3xl mb-2 text-text-muted">live_tv</span>
                    <p class="text-caption text-text-secondary">لا تتوفر بيانات كافية حالياً</p>
                </div>
            }
        </div>

        <div class="card p-6">
            <div class="flex items-center gap-2 mb-4 pb-3 border-b border-border">
                <span class="material-symbols-rounded text-lg text-accent">people_alt</span>
                <h3 class="font-bold text-body text-text">الضيوف الأكثر استضافة</h3>
            </div>
            @if (Model.TopGuests.Any())
            {
                <div class="space-y-1 divide-y divide-border-light">
                    @foreach (var g in Model.TopGuests.Take(5))
                    {
                        <div class="flex items-center justify-between py-3 first:pt-0 last:pb-0">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-xl text-caption font-bold flex items-center justify-center shrink-0 bg-primary-subtle text-primary">@g.Rank</div>
                                <div>
                                    <div class="font-bold text-caption text-text">@g.FullName</div>
                                    <div class="text-micro mt-0.5 text-text-secondary">@(g.Organization ?? "ضيف مستقل")</div>
                                </div>
                            </div>
                            <div class="text-left">
                                <div class="text-body font-bold tabular-nums text-primary">@g.AppearanceCount</div>
                                <div class="text-micro font-medium text-text-secondary">مشاركة</div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="flex flex-col items-center py-8 text-center">
                    <span class="material-symbols-rounded text-3xl mb-2 text-text-muted">group</span>
                    <p class="text-caption text-text-secondary">لا توجد سجلات استضافة بعد</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const css = getComputedStyle(document.documentElement);
        const token = name => css.getPropertyValue(name).trim();

        const statusChart = new Chart(document.getElementById('statusChart'), {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new[] { "مجدولة", "منفّذة", "منشورة رقمياً", "منشورة على الموقع", "ملغاة" })),
                datasets: [{
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StatusStats)),
                    // FIX: use --color-chart-* tokens (was --chart-* which returned empty)
                    backgroundColor: ['--color-chart-1', '--color-chart-2', '--color-chart-2', '--color-chart-3', '--color-chart-5'].map(n => token(n)),
                    borderWidth: 3,
                    borderColor: token('--color-surface'),
                    hoverOffset: 8
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false, cutout: '70%',
                plugins: {
                    legend: { position: 'bottom', rtl: true, labels: { padding: 20, usePointStyle: true, pointStyle: 'circle', color: token('--color-text-secondary'), font: { family: 'Cairo', weight: '600', size: 11 } } }
                },
                animation: { animateScale: true, animateRotate: true }
            }
        });

        const programsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopPrograms.Take(5).Select(p => new { name = p.ProgramName, total = p.TotalEpisodes }).ToList()));
        const programsChart = new Chart(document.getElementById('programsChart'), {
            type: 'bar',
            data: {
                labels: programsData.map(p => p.name),
                datasets: [{
                    label: 'عدد الحلقات',
                    data: programsData.map(p => p.total),
                    // FIX: use --color-chart-* tokens
                    backgroundColor: token('--color-chart-4'),
                    borderColor: token('--color-chart-1'),
                    borderWidth: 2,
                    borderRadius: 12,
                    borderSkipped: false,
                    barThickness: 16
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false, indexAxis: 'y',
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { color: token('--color-chart-grid') }, ticks: { font: { family: 'Cairo', weight: 'bold' }, color: token('--color-text-secondary') } },
                    y: { grid: { display: false }, ticks: { font: { family: 'Cairo', weight: 'bold' }, color: token('--color-text-secondary') } }
                }
            }
        });

        // Re-render charts on theme change so colors track tokens
        document.addEventListener('radio:theme-change', function () {
            setTimeout(function () {
                const t = n => getComputedStyle(document.documentElement).getPropertyValue(n).trim();
                statusChart.data.datasets[0].backgroundColor = ['--color-chart-1','--color-chart-2','--color-chart-2','--color-chart-3','--color-chart-5'].map(n => t(n));
                statusChart.data.datasets[0].borderColor = t('--color-surface');
                statusChart.options.plugins.legend.labels.color = t('--color-text-secondary');
                statusChart.update();
                programsChart.data.datasets[0].backgroundColor = t('--color-chart-4');
                programsChart.data.datasets[0].borderColor = t('--color-chart-1');
                programsChart.options.scales.x.grid.color = t('--color-chart-grid');
                programsChart.options.scales.x.ticks.color = t('--color-text-secondary');
                programsChart.options.scales.y.ticks.color = t('--color-text-secondary');
                programsChart.update();
            }, 50);
        });
    </script>
}
