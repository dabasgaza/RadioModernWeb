@model DashboardViewModel
@{
    ViewData["Title"] = "لوحة التحكم الرئيسية";
    ViewData["HeaderIcon"] = "dashboard";
    ViewData["HeaderDescription"] = "ملخص فوري ومؤشرات أداء الجدولة والبث الإذاعي اليوم";
    ViewData["HeaderActions"] = "<a href='/Episodes/LiveBoard' class='btn btn-sm btn-destructive'><span class='w-2 h-2 rounded-full bg-primary-foreground animate-ping'></span><span class='material-symbols-rounded text-base'>live_tv</span><span>شاشة العرض المباشر</span></a><a href='/Episodes/Create' class='btn btn-primary btn-sm'><span class='material-symbols-rounded text-base'>add_circle</span><span>حلقة جديدة</span></a>";

    ViewBag.KpiItems = Model.KpiItems;
}
<div class="max-w-7xl mx-auto space-y-6">
    <partial name="_PageHeader" />
    <partial name="_KpiCards" />

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="card p-6">
            @{
                ViewBag.SectionIcon = "donut_large";
                ViewBag.SectionTitle = "توزيع حالات الحلقات";
                ViewBag.SectionSubtitle = "نسب الجدولة، التنفيذ والنشر الرقمي";
                ViewBag.SectionAction = null;
            }
            <partial name="_SectionHeader" />
            <div class="relative h-64">
                <canvas id="statusChart"></canvas>
            </div>
        </div>
        <div class="card p-6">
            @{
                ViewBag.SectionIcon = "bar_chart";
                ViewBag.SectionTitle = "البرامج الأكثر إنتاجاً";
                ViewBag.SectionSubtitle = "عدد الحلقات المنفذة لكل برنامج";
                ViewBag.SectionAction = null;
            }
            <partial name="_SectionHeader" />
            <div class="relative h-64">
                <canvas id="programsChart"></canvas>
            </div>
        </div>
    </div>

    @{
        var todayEpisodes = Model.TodayEpisodes.ToList();
    }
    <div class="card">
        @{
            ViewBag.SectionIcon = "today";
            ViewBag.SectionTitle = "جدول حلقات البث لليوم";
            ViewBag.SectionSubtitle = "قائمة الحلقات والمواعيد المجدولة للبث الفوري";
            ViewBag.SectionAction = new Microsoft.AspNetCore.Html.HtmlString(
                "<a href='/Episodes' class='text-caption font-semibold flex items-center gap-1 text-primary hover:underline'><span>عرض أرشيف الحلقات</span><span class='material-symbols-rounded text-sm'>chevron_left</span></a>"
            );
        }
        <partial name="_SectionHeader" />

        @if (todayEpisodes.Any())
        {
            <div class="divide-y divide-border-light">
                @foreach (var ep in todayEpisodes)
                {
                    <div class="flex items-center gap-4 p-4 transition-colors hover:bg-bg-hover">
                        <div class="w-3 h-3 rounded-full shrink-0 ring-4 bg-primary" style="--tw-ring-color:color-mix(in srgb, var(--color-primary) 15%, transparent)"></div>
                        <div class="flex-1 min-w-0">
                            <a href="/Episodes/Details/@ep.EpisodeId" class="font-bold text-caption text-text hover:text-primary transition-colors">@ep.EpisodeName</a>
                            <div class="flex items-center gap-2 mt-1">
                                <span class="text-micro font-semibold text-text-secondary">@ep.ProgramName</span>
                                @if (!string.IsNullOrWhiteSpace(ep.GuestsDisplay))
                                {
                                    <span class="text-caption text-text-muted">·</span>
                                    <span class="text-micro text-text-muted">@ep.GuestsDisplay</span>
                                }
                            </div>
                        </div>
                        <div class="text-right px-2">
                            <div class="text-caption font-bold tabular-nums text-text">@(ep.ScheduledExecutionTime?.ToString("HH:mm") ?? "—")</div>
                            <div class="text-micro text-text-muted">توقيت البث</div>
                        </div>
                        <partial name="_StatusBadge" model='new StatusBadgeViewModel { Type = "episode", Status = ep.StatusText, Label = ep.StatusText }' />
                    </div>
                }
            </div>
        }
        else
        {
            ViewBag.EmptyIcon = "event_busy";
            ViewBag.EmptyTitle = "لا توجد حلقات مجدولة للبث اليوم";
            ViewBag.EmptyDesc = "لم يتم جدولة أية حلقات للبث في الجدول الزمني لليوم حتى الآن";
            <partial name="_EmptyState" />
        }
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="card p-6">
            @{
                ViewBag.SectionIcon = "trending_up";
                ViewBag.SectionTitle = "البرامج الأكثر نشاطاً";
                ViewBag.SectionSubtitle = "";
                ViewBag.SectionAction = null;
            }
            <partial name="_SectionHeader" />
            @if (Model.TopPrograms.Any())
            {
                <div class="divide-y divide-border-light">
                    @foreach (var p in Model.TopPrograms.Take(5))
                    {
                        <div class="flex items-center justify-between py-3">
                            <div>
                                <div class="font-bold text-caption text-text">@p.ProgramName</div>
                                <div class="text-micro mt-0.5 text-text-secondary">@(p.Category ?? "برنامج عام")</div>
                            </div>
                            <div class="text-left">
                                <div class="text-body font-bold tabular-nums text-primary">@p.TotalEpisodes</div>
                                <div class="text-micro font-medium text-text-secondary">حلقة</div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                ViewBag.EmptyIcon = "live_tv";
                ViewBag.EmptyTitle = "لا توجد بيانات كافية";
                ViewBag.EmptyDesc = "لم يتم تسجيل أي برامج نشطة بعد";
                <partial name="_EmptyState" />
            }
        </div>

        <div class="card p-6">
            @{
                ViewBag.SectionIcon = "people_alt";
                ViewBag.SectionTitle = "الضيوف الأكثر استضافة";
                ViewBag.SectionSubtitle = "";
                ViewBag.SectionAction = null;
            }
            <partial name="_SectionHeader" />
            @if (Model.TopGuests.Any())
            {
                <div class="divide-y divide-border-light">
                    @foreach (var g in Model.TopGuests.Take(5))
                    {
                        <div class="flex items-center justify-between py-3">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-xl text-caption font-bold flex items-center justify-center shrink-0 bg-primary-subtle text-primary">@g.Rank</div>
                                <div>
                                    <div class="font-bold text-caption text-text">@g.FullName</div>
                                    <div class="text-micro mt-0.5 text-text-secondary">@(g.Organization ?? "ضيف مستقل")</div>
                                </div>
                            </div>
                            <div class="text-left">
                                <div class="text-body font-bold tabular-nums text-primary">@g.AppearanceCount</div>
                                <div class="text-micro font-medium text-text-secondary">مشاركة</div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                ViewBag.EmptyIcon = "group";
                ViewBag.EmptyTitle = "لا توجد سجلات استضافة";
                ViewBag.EmptyDesc = "لم يتم تسجيل أي ضيوف بعد";
                <partial name="_EmptyState" />
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const css = getComputedStyle(document.documentElement);
        const token = name => css.getPropertyValue(name).trim();

        const chartTokens = ['--color-chart-1','--color-chart-2','--color-chart-2','--color-chart-3','--color-chart-5'];

        const statusChart = new Chart(document.getElementById('statusChart'), {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new[] { "مجدولة", "منفّذة", "منشورة رقمياً", "منشورة على الموقع", "ملغاة" })),
                datasets: [{
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StatusStats)),
                    backgroundColor: chartTokens.map(n => token(n)),
                    borderWidth: 3,
                    borderColor: token('--color-surface'),
                    hoverOffset: 8
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false, cutout: '70%',
                plugins: {
                    legend: { position: 'bottom', rtl: true, labels: { padding: 20, usePointStyle: true, pointStyle: 'circle', color: token('--color-text-secondary'), font: { family: 'Cairo', weight: '600', size: 11 } } }
                },
                animation: { animateScale: true, animateRotate: true }
            }
        });

        const programsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopPrograms.Take(5).Select(p => new { name = p.ProgramName, total = p.TotalEpisodes }).ToList()));
        const programsChart = new Chart(document.getElementById('programsChart'), {
            type: 'bar',
            data: {
                labels: programsData.map(p => p.name),
                datasets: [{
                    label: 'عدد الحلقات',
                    data: programsData.map(p => p.total),
                    backgroundColor: token('--color-chart-4'),
                    borderColor: token('--color-chart-1'),
                    borderWidth: 2,
                    borderRadius: 12,
                    borderSkipped: false,
                    barThickness: 16
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false, indexAxis: 'y',
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { color: token('--color-chart-grid') }, ticks: { font: { family: 'Cairo', weight: 'bold' }, color: token('--color-text-secondary') } },
                    y: { grid: { display: false }, ticks: { font: { family: 'Cairo', weight: 'bold' }, color: token('--color-text-secondary') } }
                }
            }
        });

        document.addEventListener('radio:theme-change', function () {
            setTimeout(function () {
                const t = n => getComputedStyle(document.documentElement).getPropertyValue(n).trim();
                statusChart.data.datasets[0].backgroundColor = chartTokens.map(n => t(n));
                statusChart.data.datasets[0].borderColor = t('--color-surface');
                statusChart.options.plugins.legend.labels.color = t('--color-text-secondary');
                statusChart.update();
                programsChart.data.datasets[0].backgroundColor = t('--color-chart-4');
                programsChart.data.datasets[0].borderColor = t('--color-chart-1');
                programsChart.options.scales.x.grid.color = t('--color-chart-grid');
                programsChart.options.scales.x.ticks.color = t('--color-text-secondary');
                programsChart.options.scales.y.ticks.color = t('--color-text-secondary');
                programsChart.update();
            }, 50);
        });
    </script>
}
