@model DashboardViewModel
@{
    ViewData["Title"] = "لوحة التحكم";
}

<div class="page-header">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 relative z-10">
        <div>
            <h1 class="text-2xl font-black text-ink flex items-center gap-2">
                <span class="material-symbols-rounded text-primary p-1 bg-primary/10 rounded-lg">space_dashboard</span>
                لوحة التحكم
            </h1>
            <p>مرحباً بك! إليك ملخصاً فورياً وإحصائيات سريعة حول نشاط البث والإنتاج اليوم.</p>
        </div>
    </div>
</div>

<!-- Stat Cards -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-6">
    <div class="stat-card-premium text-primary">
        <div class="flex items-center justify-between">
            <div>
                <div class="text-2xl font-black text-ink">@Model.TodayEpisodes.Count</div>
                <div class="text-xs font-bold text-ink-muted mt-1">حلقات اليوم</div>
            </div>
            <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center">
                <span class="material-symbols-rounded">podcasts</span>
            </div>
        </div>
    </div>

    <div class="stat-card-premium text-accent">
        <div class="flex items-center justify-between">
            <div>
                <div class="text-2xl font-black text-ink">@Model.TotalEpisodes</div>
                <div class="text-xs font-bold text-ink-muted mt-1">إجمالي الحلقات</div>
            </div>
            <div class="w-12 h-12 rounded-xl bg-accent/10 text-accent flex items-center justify-center">
                <span class="material-symbols-rounded">analytics</span>
            </div>
        </div>
    </div>

    <div class="stat-card-premium text-success">
        <div class="flex items-center justify-between">
            <div>
                <div class="text-2xl font-black text-ink">@Model.TotalPrograms</div>
                <div class="text-xs font-bold text-ink-muted mt-1">البرامج النشطة</div>
            </div>
            <div class="w-12 h-12 rounded-xl bg-success/10 text-success flex items-center justify-center">
                <span class="material-symbols-rounded">radio</span>
            </div>
        </div>
    </div>

    <div class="stat-card-premium text-danger">
        <div class="flex items-center justify-between">
            <div>
                <div class="text-2xl font-black text-ink">@Model.CancelledEpisodes.Count</div>
                <div class="text-xs font-bold text-ink-muted mt-1">حلقات ملغاة</div>
            </div>
            <div class="w-12 h-12 rounded-xl bg-danger/10 text-danger flex items-center justify-center">
                <span class="material-symbols-rounded">cancel</span>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
    <div class="card-premium">
        <div class="card-header">
            <div class="flex items-center gap-2">
                <span class="material-symbols-rounded text-primary">donut_large</span>
                <h3 class="font-bold text-ink text-base">توزيع حالات الحلقات</h3>
            </div>
        </div>
        <div class="card-body">
            <div class="relative h-64">
                <canvas id="statusChart"></canvas>
            </div>
        </div>
    </div>

    <div class="card-premium">
        <div class="card-header">
            <div class="flex items-center gap-2">
                <span class="material-symbols-rounded text-primary">bar_chart</span>
                <h3 class="font-bold text-ink text-base">أكثر البرامج نشاطاً</h3>
            </div>
        </div>
        <div class="card-body">
            <div class="relative h-64">
                <canvas id="programsChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Today Episodes Table -->
<div class="table-premium mb-6">
    <div class="p-5 border-b border-border flex items-center justify-between">
        <h3 class="font-bold text-ink flex items-center gap-2 text-base">
            <span class="material-symbols-rounded text-primary">today</span>
            حلقات البث لليوم
        </h3>
        <a href="/Episodes" class="text-xs text-primary font-bold hover:underline flex items-center gap-0.5">
            عرض كافة الحلقات
            <span class="material-symbols-rounded text-xs">arrow_left</span>
        </a>
    </div>
    <div class="overflow-x-auto">
        @if (Model.TodayEpisodes.Any())
        {
            <table>
                <thead>
                    <tr>
                        <th class="px-5 py-3 text-right font-semibold">الحلقة</th>
                        <th class="px-5 py-3 text-right font-semibold">البرنامج</th>
                        <th class="px-5 py-3 text-right font-semibold">الضيوف</th>
                        <th class="px-5 py-3 text-right font-semibold">الوقت</th>
                        <th class="px-5 py-3 text-right font-semibold">الحالة</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ep in Model.TodayEpisodes)
                    {
                        <tr>
                            <td class="px-5 py-3">
                                <a href="/Episodes/Details/@ep.EpisodeId" class="text-primary font-bold hover:underline">@ep.EpisodeName</a>
                            </td>
                            <td class="px-5 py-3 text-ink-muted">@ep.ProgramName</td>
                            <td class="px-5 py-3 text-ink-muted">@ep.GuestsDisplay</td>
                            <td class="px-5 py-3 text-ink font-semibold">@(ep.ScheduledExecutionTime?.ToString("HH:mm") ?? "—")</td>
                            <td class="px-5 py-3">
                                <span class="status-badge @GetStatusCssClass(ep.StatusText)">@ep.StatusText</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state p-10">
                <span class="material-symbols-rounded empty-icon">event_busy</span>
                <h3 class="font-bold text-ink">لا توجد حلقات بث لليوم</h3>
                <p class="text-ink-muted text-sm">لم يتم جدولة أي حلقات إذاعية ليتم بثها اليوم.</p>
            </div>
        }
    </div>
</div>

<!-- Top Guests + Top Programs -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="card-premium">
        <div class="card-header">
            <div class="flex items-center gap-2">
                <span class="material-symbols-rounded text-primary">trending_up</span>
                <h3 class="font-bold text-ink text-base">قائمة البرامج الأكثر نشاطاً</h3>
            </div>
        </div>
        <div class="card-body divide-y divide-border/60">
            @if (Model.TopPrograms.Any())
            {
                @foreach (var p in Model.TopPrograms.Take(5))
                {
                    <div class="flex items-center justify-between py-3.5 first:pt-0 last:pb-0">
                        <div>
                            <div class="font-bold text-ink text-sm">@p.ProgramName</div>
                            <div class="text-xs text-ink-soft mt-0.5">@(p.Category ?? "عام")</div>
                        </div>
                        <div class="text-left">
                            <div class="text-base font-black text-primary">@p.TotalEpisodes</div>
                            <div class="text-[10px] text-ink-soft font-bold">حلقة</div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state py-6">
                    <span class="material-symbols-rounded empty-icon text-lg">radio</span>
                    <p class="text-ink-muted text-xs">لا تتوفر برامج كافية حالياً</p>
                </div>
            }
        </div>
    </div>

    <div class="card-premium">
        <div class="card-header">
            <div class="flex items-center gap-2">
                <span class="material-symbols-rounded text-primary">people_alt</span>
                <h3 class="font-bold text-ink text-base">الضيوف الأكثر استضافة</h3>
            </div>
        </div>
        <div class="card-body divide-y divide-border/60">
            @if (Model.TopGuests.Any())
            {
                @foreach (var g in Model.TopGuests.Take(5))
                {
                    <div class="flex items-center justify-between py-3.5 first:pt-0 last:pb-0">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-lg bg-primary/10 text-primary text-xs font-black flex items-center justify-center">
                                @g.Rank
                            </div>
                            <div>
                                <div class="font-bold text-ink text-sm">@g.FullName</div>
                                <div class="text-xs text-ink-soft mt-0.5">@(g.Organization ?? "مستقل")</div>
                            </div>
                        </div>
                        <div class="text-left">
                            <div class="text-base font-black text-success">@g.AppearanceCount</div>
                            <div class="text-[10px] text-ink-soft font-bold">مرات ظهور</div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state py-6">
                    <span class="material-symbols-rounded empty-icon text-lg">people_alt</span>
                    <p class="text-ink-muted text-xs">لا توجد بيانات استضافة ضيوف بعد</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Chart.js: Status Distribution
        const statusData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StatusStats));
        const statusLabels = Object.keys(statusData).map(k => {
            const map = {
                'Planned': 'مجدولة',
                'Executed': 'منفّذة',
                'Published': 'منشورة رقمياً',
                'WebsitePublished': 'منشورة على الموقع',
                'Cancelled': 'ملغاة'
            };
            return map[k] || k;
        });
        const statusValues = Object.values(statusData);
 
        new Chart(document.getElementById('statusChart'), {
            type: 'doughnut',
            data: {
                labels: statusLabels,
                datasets: [{
                    data: statusValues,
                    backgroundColor: ['#3B82F6', '#2563EB', '#10B981', '#0EA5E9', '#EF4444'],
                    borderWidth: 2,
                    borderColor: '#FFFFFF'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom', rtl: true, labels: { font: { family: 'Cairo', weight: 'bold', size: 11 } } }
                }
            }
        });
 
        // Chart.js: Top Programs
        const programsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.TopPrograms.Take(5).Select(p => new { name = p.ProgramName, total = p.TotalEpisodes }).ToList()));
 
        new Chart(document.getElementById('programsChart'), {
            type: 'bar',
            data: {
                labels: programsData.map(p => p.name),
                datasets: [{
                    label: 'عدد الحلقات',
                    data: programsData.map(p => p.total),
                    backgroundColor: '#2563EB',
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                indexAxis: 'y',
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { color: '#F1F5F9' }, ticks: { font: { family: 'Cairo', weight: 'bold' } } },
                    y: { grid: { display: false }, ticks: { font: { family: 'Cairo', weight: 'bold' } } }
                }
            }
        });
    </script>
}

@functions {
    string GetStatusCssClass(string statusText) => statusText switch
    {
        "مجدولة" or "مخطط لها" => "planned",
        "تم التنفيذ" or "منفّذة" => "executed",
        "منشورة" or "منشورة رقمياً" => "published",
        "منشورة على الموقع" => "website-published",
        "ملغاة" => "cancelled",
        _ => "planned"
    };
}
