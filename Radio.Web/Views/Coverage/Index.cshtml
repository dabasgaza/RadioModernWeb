@model CoverageListViewModel
@{
    ViewData["Title"] = "التغطيات الميدانية";
    ViewData["HeaderIcon"] = "edit_location_alt";
    ViewData["HeaderDescription"] = "إدارة ومتابعة تغطيات المراسلين الميدانية للحلقات والفعاليات";
    ViewBag.EntityName = "التغطيات الميدانية";

    if (User.HasPermission(AppPermissions.CoordinationManage))
    {
        ViewData["HeaderActions"] = "<a href='/Coverage/Create' class='btn btn-primary rounded-xl px-5 shadow-lg gap-2'><span class='material-symbols-rounded'>add_circle</span>تغطية جديدة</a>";
    }
}

<partial name="_PageHeader" />

@if (!Model.Coverages.Any())
{
    <div class="wf-card rounded-3xl p-12 text-center my-8">
        <div class="w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4" style="background: var(--color-surface-3); color: var(--color-text-tertiary)">
            <span class="material-symbols-rounded text-5xl">edit_location_alt</span>
        </div>
        <h3 class="text-xl font-bold mb-2" style="color: var(--color-text)">لا تغطيات</h3>
        <p class="text-sm max-w-md mx-auto mb-6" style="color: var(--color-text-3)">لم تتم إضافة أي تغطيات ميدانية بعد.</p>
        @if (User.HasPermission(AppPermissions.CoordinationManage))
        {
            <div class="flex items-center justify-center gap-3">
                <a href="/Coverage/Create" class="btn btn-primary rounded-xl gap-2">
                    <span class="material-symbols-rounded">add</span>
                    إضافة تغطية جديدة
                </a>
            </div>
        }
    </div>
}
else
{
    <div class="wf-card overflow-hidden">
        <div class="overflow-x-auto">
            <table class="table w-full text-sm">
                <thead>
                    <tr style="background: var(--color-surface-3)">
                        <th class="px-6 py-4 text-right font-bold text-xs uppercase tracking-wider" style="color: var(--color-text-3)">المراسل</th>
                        <th class="px-6 py-4 text-right font-bold text-xs uppercase tracking-wider" style="color: var(--color-text-3)">الضيف</th>
                        <th class="px-6 py-4 text-right font-bold text-xs uppercase tracking-wider" style="color: var(--color-text-3)">الموقع</th>
                        <th class="px-6 py-4 text-right font-bold text-xs uppercase tracking-wider" style="color: var(--color-text-3)">الموضوع</th>
                        <th class="px-6 py-4 text-right font-bold text-xs uppercase tracking-wider" style="color: var(--color-text-3)">الوقت المجدول</th>
                        <th class="px-6 py-4 text-right font-bold text-xs uppercase tracking-wider" style="color: var(--color-text-3)">الوقت الفعلي</th>
                        <th class="px-6 py-4 text-center font-bold text-xs uppercase tracking-wider" style="color: var(--color-text-3)">إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Coverages)
                    {
                        <tr class="transition-colors duration-200" style="border-bottom: 1px solid color-mix(in srgb, var(--color-border) 40%, transparent)">
                            <td class="px-6 py-4 font-semibold" style="color: var(--color-text)">@c.CorrespondentName</td>
                            <td class="px-6 py-4" style="color: var(--color-text-3)">@(c.GuestName ?? "—")</td>
                            <td class="px-6 py-4" style="color: var(--color-text-3)">@(c.Location ?? "—")</td>
                            <td class="px-6 py-4" style="color: var(--color-text-3)">@(c.Topic ?? "—")</td>
                            <td class="px-6 py-4 font-semibold whitespace-nowrap" dir="ltr" style="color: var(--color-text-3)">@(c.ScheduledTime?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                            <td class="px-6 py-4 font-semibold whitespace-nowrap" dir="ltr" style="color: var(--color-text-3)">@(c.ActualTime?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                            <td class="px-6 py-4">
                                @if (User.HasPermission(AppPermissions.CoordinationManage))
                                {
                                    <div class="flex items-center justify-center gap-1">
                                        <a href="/Coverage/Edit/@c.CoverageId" class="btn btn-ghost btn-square btn-sm" title="تعديل"
                                           style="color: var(--color-primary)">
                                            <span class="material-symbols-rounded text-xl leading-none">edit</span>
                                        </a>
                                        <form method="post" action="/Coverage/Delete/@c.CoverageId" class="inline" data-confirm="هل أنت متأكد من حذف هذه التغطية؟">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-ghost btn-square btn-sm" title="حذف"
                                                    style="color: var(--color-danger)">
                                                <span class="material-symbols-rounded text-xl leading-none">delete</span>
                                            </button>
                                        </form>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
