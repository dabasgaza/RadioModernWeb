@model CoverageListViewModel
@{
    ViewData["Title"] = "التغطيات الميدانية";
    ViewData["HeaderIcon"] = "edit_location_alt";
    ViewData["HeaderDescription"] = "إدارة ومتابعة تغطيات المراسلين الميدانية للحلقات والفعاليات";
    ViewBag.EntityName = "التغطيات الميدانية";

    if (User.HasPermission(AppPermissions.CoordinationManage))
    {
        ViewData["HeaderActions"] = "<a href='/Coverage/Create' class='btn btn-primary rounded-xl px-5 shadow-lg gap-2'><span class='material-symbols-rounded'>add_circle</span>تغطية جديدة</a>";
    }
}

<partial name="_PageHeader" />

@if (!Model.Coverages.Any())
{
    ViewBag.EmptyIcon = "edit_location_alt";
    ViewBag.EmptyTitle = "لا تغطيات";
    ViewBag.EmptyDesc = "لم تتم إضافة أي تغطيات ميدانية بعد.";
    if (User.HasPermission(AppPermissions.CoordinationManage))
    {
        ViewBag.EmptyActionUrl = "/Coverage/Create";
        ViewBag.EmptyActionText = "إضافة تغطية جديدة";
        ViewBag.EmptyActionIcon = "add";
    }
    <partial name="_EmptyState" />
}
else
{
    <div class="wf-card overflow-hidden">
        <div class="overflow-x-auto">
            <table class="table w-full text-sm">
                <thead>
                    <tr style="background: var(--color-bg-hover)">
                        <th class="px-6 py-4 text-right font-bold text-xs uppercase tracking-wider" style="color: var(--color-text-secondary)">المراسل</th>
                        <th class="px-6 py-4 text-right font-bold text-xs uppercase tracking-wider hidden md:table-cell" style="color: var(--color-text-secondary)">الضيف</th>
                        <th class="px-6 py-4 text-right font-bold text-xs uppercase tracking-wider hidden md:table-cell" style="color: var(--color-text-secondary)">الموقع</th>
                        <th class="px-6 py-4 text-right font-bold text-xs uppercase tracking-wider" style="color: var(--color-text-secondary)">الموضوع</th>
                        <th class="px-6 py-4 text-right font-bold text-xs uppercase tracking-wider hidden lg:table-cell" style="color: var(--color-text-secondary)">الوقت المجدول</th>
                        <th class="px-6 py-4 text-right font-bold text-xs uppercase tracking-wider hidden lg:table-cell" style="color: var(--color-text-secondary)">الوقت الفعلي</th>
                        <th class="px-6 py-4 text-center font-bold text-xs uppercase tracking-wider" style="color: var(--color-text-secondary)">إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Coverages)
                    {
                        <tr class="transition-colors duration-200" style="border-bottom: 1px solid color-mix(in srgb, var(--color-border) 40%, transparent)">
                            <td class="px-6 py-4 font-semibold" style="color: var(--color-text)">@c.CorrespondentName</td>
                            <td class="px-6 py-4 hidden md:table-cell" style="color: var(--color-text-secondary)">@(c.GuestName ?? "—")</td>
                            <td class="px-6 py-4 hidden md:table-cell" style="color: var(--color-text-secondary)">@(c.Location ?? "—")</td>
                            <td class="px-6 py-4" style="color: var(--color-text-secondary)">@(c.Topic ?? "—")</td>
                            <td class="px-6 py-4 font-semibold whitespace-nowrap hidden lg:table-cell" dir="ltr" style="color: var(--color-text-secondary)">@(c.ScheduledTime?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                            <td class="px-6 py-4 font-semibold whitespace-nowrap hidden lg:table-cell" dir="ltr" style="color: var(--color-text-secondary)">@(c.ActualTime?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                            <td class="px-6 py-4">
                                @if (User.HasPermission(AppPermissions.CoordinationManage))
                                {
                                    <div class="flex items-center justify-center gap-1">
                                        <a href="/Coverage/Edit/@c.CoverageId" class="btn btn-ghost btn-square btn-sm" title="تعديل"
                                           style="color: var(--color-primary)">
                                            <span class="material-symbols-rounded text-xl leading-none">edit</span>
                                        </a>
                                        <form method="post" action="/Coverage/Delete/@c.CoverageId" class="inline" data-confirm="هل أنت متأكد من حذف هذه التغطية؟">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-ghost btn-square btn-sm" title="حذف"
                                                    style="color: var(--color-danger)">
                                                <span class="material-symbols-rounded text-xl leading-none">delete</span>
                                            </button>
                                        </form>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
