@model CoverageListViewModel
@{
    ViewData["Title"] = "التغطيات الميدانية";
    ViewData["HeaderIcon"] = "edit_location_alt";
    ViewData["HeaderDescription"] = "إدارة ومتابعة تغطيات المراسلين الميدانية للحلقات والفعاليات";
    ViewBag.EntityName = "التغطيات الميدانية";

    if (User.HasPermission(AppPermissions.CoordinationManage))
    {
        ViewData["HeaderActions"] = "<a href='/Coverage/Create' class='btn btn-primary gap-2'><span class='material-symbols-rounded'>add_circle</span>تغطية جديدة</a>";
    }
}

<partial name="_PageHeader" />

@if (!Model.Coverages.Any())
{
    ViewBag.EmptyIcon = "edit_location_alt";
    ViewBag.EmptyTitle = "لا تغطيات";
    ViewBag.EmptyDesc = "لم تتم إضافة أي تغطيات ميدانية بعد.";
    if (User.HasPermission(AppPermissions.CoordinationManage))
    {
        ViewBag.EmptyActionUrl = "/Coverage/Create";
        ViewBag.EmptyActionText = "إضافة تغطية جديدة";
        ViewBag.EmptyActionIcon = "add";
    }
    <partial name="_EmptyState" />
}
else
{
    <div class="card overflow-hidden">
        <div class="overflow-x-auto">
            <table class="data-table">
                <thead>
                    <tr>
                        <th class="px-6 py-4">المراسل</th>
                        <th class="px-6 py-4 hidden md:table-cell">الضيف</th>
                        <th class="px-6 py-4 hidden md:table-cell">الموقع</th>
                        <th class="px-6 py-4">الموضوع</th>
                        <th class="px-6 py-4 hidden lg:table-cell">الوقت المجدول</th>
                        <th class="px-6 py-4 hidden lg:table-cell">الوقت الفعلي</th>
                        <th class="px-6 py-4 text-center">إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Coverages)
                    {
                        <tr class="border-b border-border-light transition-colors hover:bg-bg-hover">
                            <td class="px-6 py-4 font-semibold text-text">@c.CorrespondentName</td>
                            <td class="px-6 py-4 hidden md:table-cell text-text-secondary">@(c.GuestName ?? "—")</td>
                            <td class="px-6 py-4 hidden md:table-cell text-text-secondary">@(c.Location ?? "—")</td>
                            <td class="px-6 py-4 text-text-secondary">@(c.Topic ?? "—")</td>
                            <td class="px-6 py-4 font-semibold whitespace-nowrap hidden lg:table-cell text-text-secondary" dir="ltr">@(c.ScheduledTime?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                            <td class="px-6 py-4 font-semibold whitespace-nowrap hidden lg:table-cell text-text-secondary" dir="ltr">@(c.ActualTime?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                            <td class="px-6 py-4">
                                @if (User.HasPermission(AppPermissions.CoordinationManage))
                                {
                                    <div class="flex items-center justify-center gap-1">
                                        <a href="/Coverage/Edit/@c.CoverageId" class="btn btn-ghost btn-icon btn-sm text-primary" title="تعديل">
                                            <span class="material-symbols-rounded text-lg">edit</span>
                                        </a>
                                        <form method="post" action="/Coverage/Delete/@c.CoverageId" class="inline" data-confirm="هل أنت متأكد من حذف هذه التغطية؟">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-ghost btn-icon btn-sm text-danger" title="حذف">
                                                <span class="material-symbols-rounded text-lg">delete</span>
                                            </button>
                                        </form>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
