@model CoverageEditViewModel
@{
    var coverage = Model.Coverage;
    ViewData["Title"] = coverage.CoverageId == 0 ? "تغطية جديدة" : "تعديل تغطية";
    var isEdit = coverage.CoverageId != 0;
    ViewBag.IsEdit = isEdit;
    ViewBag.Icon = isEdit ? "edit" : "add";
    ViewBag.Title = isEdit ? "تعديل بيانات التغطية" : "إضافة تغطية جديدة";
    ViewBag.Description = "إدخال وتحديث بيانات التغطية الميدانية وربطها بالمراسل والضيف";
    ViewBag.EntityName = "التغطيات الميدانية";
    ViewBag.EntityUrl = "/Coverage";
    ViewBag.BackUrl = "/Coverage";
    ViewBag.BackText = "الرجوع للتغطيات";
}

<partial name="_CreateEditHeader" />

<form method="post" action="@(isEdit ? $"/Coverage/Edit/{coverage.CoverageId}" : "/Coverage/Create")" class="max-w-2xl">
    @Html.AntiForgeryToken()

    @if (ViewContext.ModelState.ErrorCount > 0)
    {
        <div asp-validation-summary="All" class="bg-error/10 border border-error/20 text-error rounded-xl p-4 mb-6 font-semibold text-sm"></div>
    }

    <div class="card bg-base-100 shadow-md">
        <div class="card-body space-y-4">
            <div class="flex items-center gap-2">
                <span class="material-symbols-rounded text-primary">edit_location_alt</span>
                <h3 class="font-bold text-base-content text-base">بيانات التغطية</h3>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="label">المراسل *</label>
                    <div class="relative">
                        <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-base-content/40 pointer-events-none text-lg">map</span>
                        <select name="CorrespondentId" class="select select-bordered w-full pr-10" required>
                            <option value="">— اختر —</option>
                            @foreach (var c in Model.Correspondents)
                            {
                                <option value="@c.CorrespondentId" selected="@(coverage.CorrespondentId == c.CorrespondentId)">@c.FullName</option>
                            }
                        </select>
                    </div>
                </div>
                <div>
                    <label class="label">الضيف</label>
                    <div class="relative">
                        <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-base-content/40 pointer-events-none text-lg">people_alt</span>
                        <select name="GuestId" class="select select-bordered w-full pr-10">
                            <option value="">— بدون —</option>
                            @foreach (var g in Model.Guests)
                            {
                                <option value="@g.GuestId" selected="@(coverage.GuestId == g.GuestId)">@g.FullName</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="label">الموقع</label>
                    <div class="relative">
                        <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-base-content/40 pointer-events-none text-lg">location_on</span>
                        <input type="text" name="Location" value="@coverage.Location" class="input input-bordered w-full pr-10" placeholder="مثال: الرياض - حي الصحافة" />
                    </div>
                </div>
                <div>
                    <label class="label">الموضوع *</label>
                    <div class="relative">
                        <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-base-content/40 pointer-events-none text-lg">topic</span>
                        <input type="text" name="Topic" value="@coverage.Topic" class="input input-bordered w-full pr-10" required placeholder="موضوع التغطية" />
                    </div>
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="label">الوقت المجدول</label>
                    <div class="relative">
                        <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-base-content/40 pointer-events-none text-lg">schedule</span>
                        <input type="text" name="ScheduledTime" value="@(coverage.ScheduledTime?.ToString("yyyy-MM-ddTHH:mm"))" class="input input-bordered w-full pr-10 datetimepicker" />
                    </div>
                </div>
                <div>
                    <label class="label">الوقت الفعلي</label>
                    <div class="relative">
                        <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-base-content/40 pointer-events-none text-lg">access_time</span>
                        <input type="text" name="ActualTime" value="@(coverage.ActualTime?.ToString("yyyy-MM-ddTHH:mm"))" class="input input-bordered w-full pr-10 datetimepicker" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="flex items-center justify-end gap-2 mt-6">
        <a href="/Coverage" class="btn btn-ghost">
            <span class="material-symbols-rounded">cancel</span>
            إلغاء
        </a>
        <button type="submit" class="btn btn-primary">
            <span class="material-symbols-rounded">save</span>
            @(isEdit ? "حفظ التغييرات" : "إضافة التغطية")
        </button>
    </div>
</form>
