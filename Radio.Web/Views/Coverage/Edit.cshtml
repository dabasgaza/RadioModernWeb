@model CoverageEditViewModel
@{
    var coverage = Model.Coverage;
    ViewData["Title"] = coverage.CoverageId == 0 ? "تغطية جديدة" : "تعديل تغطية";
    var isEdit = coverage.CoverageId != 0;
    ViewBag.IsEdit = isEdit;
    ViewBag.Icon = isEdit ? "edit" : "add";
    ViewBag.Title = isEdit ? "تعديل بيانات التغطية" : "إضافة تغطية جديدة";
    ViewBag.Description = "إدخال وتحديث بيانات التغطية الميدانية وربطها بالمراسل والضيف";
    ViewBag.EntityName = "التغطيات الميدانية";
    ViewBag.EntityUrl = "/Coverage";
    ViewBag.BackUrl = "/Coverage";
    ViewBag.BackText = "الرجوع للتغطيات";
}

<partial name="_CreateEditHeader" />

<form method="post" action="@(isEdit ? $"/Coverage/Edit/{coverage.CoverageId}" : "/Coverage/Create")" class="max-w-2xl">
    @Html.AntiForgeryToken()

    @if (ViewContext.ModelState.ErrorCount > 0)
    {
        <div asp-validation-summary="All" class="bg-red-50 border border-red-200 text-danger rounded-xl p-4 mb-6 font-semibold text-sm"></div>
    }

    <div class="card-premium">
        <div class="card-header">
            <div class="flex items-center gap-2">
                <span class="material-symbols-rounded text-primary">edit_location_alt</span>
                <h3 class="font-bold text-ink text-base">بيانات التغطية</h3>
            </div>
        </div>
        <div class="card-body space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="form-label">المراسل *</label>
                    <div class="input-wrapper">
                        <span class="material-symbols-rounded input-icon">map</span>
                        <select name="CorrespondentId" class="form-input" required>
                            <option value="">— اختر —</option>
                            @foreach (var c in Model.Correspondents)
                            {
                                <option value="@c.CorrespondentId" selected="@(coverage.CorrespondentId == c.CorrespondentId)">@c.FullName</option>
                            }
                        </select>
                    </div>
                </div>
                <div>
                    <label class="form-label">الضيف</label>
                    <div class="input-wrapper">
                        <span class="material-symbols-rounded input-icon">people_alt</span>
                        <select name="GuestId" class="form-input">
                            <option value="">— بدون —</option>
                            @foreach (var g in Model.Guests)
                            {
                                <option value="@g.GuestId" selected="@(coverage.GuestId == g.GuestId)">@g.FullName</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="form-label">الموقع</label>
                    <div class="input-wrapper">
                        <span class="material-symbols-rounded input-icon">location_on</span>
                        <input type="text" name="Location" value="@coverage.Location" class="form-input" placeholder="مثال: الرياض - حي الصحافة" />
                    </div>
                </div>
                <div>
                    <label class="form-label">الموضوع *</label>
                    <div class="input-wrapper">
                        <span class="material-symbols-rounded input-icon">topic</span>
                        <input type="text" name="Topic" value="@coverage.Topic" class="form-input" required placeholder="موضوع التغطية" />
                    </div>
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="form-label">الوقت المجدول</label>
                    <div class="input-wrapper">
                        <span class="material-symbols-rounded input-icon">schedule</span>
                        <input type="text" name="ScheduledTime" value="@(coverage.ScheduledTime?.ToString("yyyy-MM-ddTHH:mm"))" class="form-input datetimepicker" />
                    </div>
                </div>
                <div>
                    <label class="form-label">الوقت الفعلي</label>
                    <div class="input-wrapper">
                        <span class="material-symbols-rounded input-icon">access_time</span>
                        <input type="text" name="ActualTime" value="@(coverage.ActualTime?.ToString("yyyy-MM-ddTHH:mm"))" class="form-input datetimepicker" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="flex items-center justify-end gap-2 mt-6">
        <a href="/Coverage" class="btn-secondary">
            <span class="material-symbols-rounded">cancel</span>
            إلغاء
        </a>
        <button type="submit" class="btn-primary">
            <span class="material-symbols-rounded">save</span>
            @(isEdit ? "حفظ التغييرات" : "إضافة التغطية")
        </button>
    </div>
</form>
