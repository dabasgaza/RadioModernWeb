@model CoverageEditViewModel
@using Microsoft.AspNetCore.Html
@{
    var coverage = Model.Coverage;
    var isEdit = coverage.CoverageId != 0;
    ViewData["Title"] = isEdit ? "تعديل تغطية" : "تغطية جديدة";
    ViewBag.IsEdit = isEdit;
    ViewBag.Icon = isEdit ? "edit" : "add";
    ViewBag.Title = isEdit ? "تعديل بيانات التغطية" : "إضافة تغطية جديدة";
    ViewBag.Description = "إدخال وتحديث بيانات التغطية الميدانية وربطها بالمراسل والضيف";
    ViewBag.EntityName = "التغطيات الميدانية";
    ViewBag.EntityUrl = "/Coverage";
    ViewBag.BackUrl = "/Coverage";
    ViewBag.BackText = "الرجوع للتغطيات";
}

<partial name="_PageHeader" />

<form method="post" action="@(isEdit ? $"/Coverage/Edit/{coverage.CoverageId}" : "/Coverage/Create")" class="max-w-2xl">
    @Html.AntiForgeryToken()

    @if (ViewContext.ModelState.ErrorCount > 0)
    {
        <div asp-validation-summary="All" class="rounded-xl p-4 mb-6 font-semibold text-sm bg-danger-subtle text-danger border border-danger-subtle"></div>
    }

    <div class="card p-5">
        <div class="space-y-5">
            @{
                ViewBag.SectionIcon = "edit_location_alt";
                ViewBag.SectionTitle = "بيانات التغطية";
            }
            <partial name="_SectionHeader" />

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                @{
                    ViewBag.FieldLabel = "المراسل";
                    ViewBag.FieldName = "CorrespondentId";
                    ViewBag.FieldType = "select";
                    ViewBag.FieldIcon = "map";
                    ViewBag.FieldRequired = true;
                    ViewBag.FieldOptions = Model.Correspondents
                        .Select(c => new SelectListItem { Value = c.CorrespondentId.ToString(), Text = c.FullName, Selected = c.CorrespondentId == coverage.CorrespondentId })
                        .Prepend(new SelectListItem { Value = "", Text = "— اختر —" })
                        .ToList();
                }
                <partial name="_FormField" />

                @{
                    ViewBag.FieldLabel = "الضيف";
                    ViewBag.FieldName = "GuestId";
                    ViewBag.FieldType = "select";
                    ViewBag.FieldIcon = "people_alt";
                    ViewBag.FieldOptions = Model.Guests
                        .Select(g => new SelectListItem { Value = g.GuestId.ToString(), Text = g.FullName, Selected = g.GuestId == coverage.GuestId })
                        .Prepend(new SelectListItem { Value = "", Text = "— بدون —" })
                        .ToList();
                }
                <partial name="_FormField" />
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                @{
                    ViewBag.FieldLabel = "الموقع";
                    ViewBag.FieldName = "Location";
                    ViewBag.FieldType = "text";
                    ViewBag.FieldIcon = "location_on";
                    ViewBag.FieldValue = coverage.Location;
                    ViewBag.FieldPlaceholder = "مثال: الرياض - حي الصحافة";
                }
                <partial name="_FormField" />

                @{
                    ViewBag.FieldLabel = "الموضوع";
                    ViewBag.FieldName = "Topic";
                    ViewBag.FieldType = "text";
                    ViewBag.FieldIcon = "topic";
                    ViewBag.FieldValue = coverage.Topic;
                    ViewBag.FieldRequired = true;
                    ViewBag.FieldPlaceholder = "موضوع التغطية";
                }
                <partial name="_FormField" />
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                @{
                    ViewBag.FieldLabel = "الوقت المجدول";
                    ViewBag.FieldName = "ScheduledTime";
                    ViewBag.FieldType = "text";
                    ViewBag.FieldIcon = "schedule";
                    ViewBag.FieldValue = coverage.ScheduledTime?.ToString("yyyy-MM-ddTHH:mm");
                    ViewBag.FieldAttrs = "class=datetimepicker";
                }
                <partial name="_FormField" />

                @{
                    ViewBag.FieldLabel = "الوقت الفعلي";
                    ViewBag.FieldName = "ActualTime";
                    ViewBag.FieldType = "text";
                    ViewBag.FieldIcon = "access_time";
                    ViewBag.FieldValue = coverage.ActualTime?.ToString("yyyy-MM-ddTHH:mm");
                    ViewBag.FieldAttrs = "class=datetimepicker";
                }
                <partial name="_FormField" />
            </div>
        </div>
    </div>

    <div class="flex items-center justify-end gap-2 mt-6">
        <a href="/Coverage" class="btn btn-ghost rounded-xl px-5 gap-1.5 text-text-secondary">
            <span class="material-symbols-rounded text-lg">cancel</span>
            إلغاء
        </a>
        <button type="submit" class="btn btn-primary rounded-xl px-6 gap-1.5 shadow-sm">
            <span class="material-symbols-rounded text-lg">save</span>
            @(isEdit ? "حفظ التغييرات" : "إضافة التغطية")
        </button>
    </div>
</form>
