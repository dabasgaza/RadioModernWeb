@{ ViewData["Title"] = "الإعدادات"; }

<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
    <div>
        <div class="breadcrumbs text-sm text-base-content/60">
            <ul>
                <li><a href="/" class="inline-flex items-center gap-1"><span class="material-symbols-rounded text-lg">home</span>الرئيسية</a></li>
                <li><span class="inline-flex items-center gap-1"><span class="material-symbols-rounded text-lg">settings</span>الإعدادات</span></li>
            </ul>
        </div>
        <h1 class="text-2xl font-extrabold text-base-content mt-1 flex items-center gap-2">
            <span class="material-symbols-rounded text-primary">settings</span>
            الإعدادات
        </h1>
        <p class="text-sm text-base-content/60 mt-0.5">إعدادات النظام والبريد الإلكتروني</p>
    </div>
</div>

<div class="card bg-base-100 shadow-md">
    <div class="card-body">
        <h2 class="font-bold text-base-content text-lg mb-4 flex items-center gap-2">
            <span class="material-symbols-rounded text-primary">mail</span>
            البريد الإلكتروني
        </h2>

        <table class="table w-full text-sm">
            <tbody>
                <tr><td class="font-semibold w-40">الحالة</td><td><span class="badge @(ViewBag.EmailConfigured ? "badge-success" : "badge-warning")">@(ViewBag.EmailConfigured ? "مضبوط" : "غير مضبوط")</span></td></tr>
                <tr><td class="font-semibold">خادم SMTP</td><td class="text-base-content/60">@ViewBag.SmtpHost</td></tr>
                <tr><td class="font-semibold">المنفذ</td><td class="text-base-content/60">@ViewBag.SmtpPort</td></tr>
            </tbody>
        </table>

        <div class="mt-4 p-3 bg-base-200 rounded-box text-sm text-base-content/60">
            <p>لتكوين البريد الإلكتروني، أضف الإعدادات التالية في <code>appsettings.json</code>:</p>
            <pre class="text-xs bg-base-300 p-3 rounded-box mt-2" dir="ltr">{
  "Email": {
    "Host": "smtp.example.com",
    "Port": "587",
    "User": "your@email.com",
    "Password": "your-password"
  }
}</pre>
        </div>
    </div>
</div>
