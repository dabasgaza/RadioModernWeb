@{
    ViewData["Title"] = "الإعدادات";
    ViewData["HeaderIcon"] = "settings";
    ViewData["HeaderDescription"] = "إعدادات النظام والبريد الإلكتروني";
    ViewBag.EntityName = "الإعدادات";
}

<partial name="_PageHeader" />

<div class="card p-6">
    <h2 class="font-bold text-lg mb-4 flex items-center gap-2 text-text">
        <span class="material-symbols-rounded text-primary">mail</span>
        البريد الإلكتروني
    </h2>

    <table class="w-full text-sm">
        <tbody class="divide-y divide-border">
            <tr>
                <td class="font-semibold py-3 w-40 text-text">الحالة</td>
                <td class="py-3">
                    <span class="badge @(ViewBag.EmailConfigured ? "badge-success" : "badge-warning")">
                        @(ViewBag.EmailConfigured ? "مضبوط" : "غير مضبوط")
                    </span>
                </td>
            </tr>
            <tr>
                <td class="font-semibold py-3 text-text">خادم SMTP</td>
                <td class="py-3 text-text-secondary font-mono text-xs">@ViewBag.SmtpHost</td>
            </tr>
            <tr>
                <td class="font-semibold py-3 text-text">المنفذ</td>
                <td class="py-3 text-text-secondary font-mono text-xs">@ViewBag.SmtpPort</td>
            </tr>
        </tbody>
    </table>

    <div class="mt-6 p-4 rounded-xl text-sm bg-bg text-text-secondary border border-border">
        <p>لتكوين البريد الإلكتروني، أضف الإعدادات التالية في <code class="bg-surface px-2 py-1 rounded border border-border font-mono text-xs text-primary">appsettings.json</code>:</p>
        <pre class="text-xs p-4 rounded-xl mt-3 dir-ltr bg-surface border border-border text-text font-mono overflow-x-auto">{
  "Email": {
    "Host": "smtp.example.com",
    "Port": "587",
    "User": "your@email.com",
    "Password": "your-password"
  }
}</pre>
    </div>
</div>
