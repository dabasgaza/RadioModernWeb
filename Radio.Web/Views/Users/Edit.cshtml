@model UserViewModel
@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = Model.UserId == 0 ? "مستخدم جديد" : "تعديل مستخدم";
    var isEdit = Model.UserId != 0;
    var roles = ViewBag.Roles as List<RoleDto>;
    ViewBag.IsEdit = isEdit;
    ViewBag.Icon = isEdit ? "edit" : "add";
    ViewBag.Title = isEdit ? "تعديل بيانات المستخدم" : "إضافة مستخدم جديد";
    ViewBag.Description = "إدخال وتحديث بيانات حسابات المستخدمين وتحديد الأدوار والصلاحيات";
    ViewBag.EntityName = "المستخدمون";
    ViewBag.EntityUrl = "/Users";
    ViewBag.BackUrl = "/Users";
    ViewBag.BackText = "الرجوع للمستخدمين";
}

<partial name="_PageHeader" />

<form method="post" action="@(isEdit ? $"/Users/Edit/{Model.UserId}" : "/Users/Create")" class="max-w-2xl">
    @Html.AntiForgeryToken()
    @if (isEdit) { <input type="hidden" name="UserId" value="@Model.UserId" /> }
    <input type="hidden" name="IsActive" value="@Model.IsActive.ToString().ToLower()" />

    @if (ViewContext.ModelState.ErrorCount > 0)
    {
        <div asp-validation-summary="All" class="rounded-xl p-4 mb-6 font-semibold text-sm bg-danger-subtle text-danger border border-danger-subtle"></div>
    }

    <div class="bg-surface border border-border rounded-2xl p-6" style="border-color:var(--color-border)">
        @{
            ViewBag.SectionIcon = "person"; ViewBag.SectionTitle = "الملف التعريفي للمستخدم";
        }
        <partial name="_SectionHeader" />

        <div class="space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                @{
                    ViewBag.FieldLabel = "الاسم الكامل"; ViewBag.FieldName = "FullName";
                    ViewBag.FieldIcon = "person"; ViewBag.FieldValue = Model.FullName;
                    ViewBag.FieldRequired = true; ViewBag.FieldPlaceholder = "مثال: سارة أحمد";
                }
                <partial name="_FormField" />

                @{
                    ViewBag.FieldLabel = "اسم الدخول"; ViewBag.FieldName = "Username";
                    ViewBag.FieldIcon = "account_circle"; ViewBag.FieldValue = Model.Username;
                    ViewBag.FieldRequired = true; ViewBag.FieldAttrs = isEdit ? "readonly" : "";
                    ViewBag.FieldPlaceholder = "example_user";
                }
                <partial name="_FormField" />
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                @{
                    ViewBag.FieldLabel = "البريد الإلكتروني"; ViewBag.FieldName = "EmailAddress";
                    ViewBag.FieldIcon = "email"; ViewBag.FieldValue = Model.EmailAddress;
                    ViewBag.FieldType = "email"; ViewBag.FieldPlaceholder = "user@example.com";
                }
                <partial name="_FormField" />

                @{
                    ViewBag.FieldLabel = "رقم الهاتف"; ViewBag.FieldName = "PhoneNumber";
                    ViewBag.FieldIcon = "phone"; ViewBag.FieldValue = Model.PhoneNumber;
                    ViewBag.FieldPlaceholder = "+966500000000";
                }
                <partial name="_FormField" />
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                @{
                    var roleOptions = (roles ?? new()).Select(r => new SelectListItem { Value = r.RoleId.ToString(), Text = string.IsNullOrWhiteSpace(r.RoleDescription) ? r.RoleName : r.RoleDescription, Selected = Model.RoleId == r.RoleId }).ToList();
                    roleOptions.Insert(0, new SelectListItem { Value = "", Text = "— اختر —" });
                    ViewBag.FieldLabel = "الدور"; ViewBag.FieldName = "RoleId";
                    ViewBag.FieldIcon = "group_work"; ViewBag.FieldType = "select";
                    ViewBag.FieldRequired = true; ViewBag.FieldOptions = roleOptions;
                }
                <partial name="_FormField" />

                <div>
                    @{ ViewBag.FieldLabel = isEdit ? "كلمة مرور جديدة (اتركها فارغة للإبقاء)" : "كلمة المرور"; ViewBag.FieldName = "Password";
                       ViewBag.FieldIcon = "lock"; ViewBag.FieldType = "password";
                       ViewBag.FieldRequired = !isEdit; ViewBag.FieldPlaceholder = isEdit ? "اترك فارغاً" : "••••••••"; }
                    <partial name="_FormField" />
                </div>
            </div>

            @if (isEdit)
            {
                <div class="flex items-center gap-3 pt-2">
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" name="IsActive" value="true" id="IsActive" @(Model.IsActive ? "checked" : "") class="sr-only peer" />
                        <div class="w-11 h-6 rounded-full peer-checked:bg-primary after:content-[''] after:absolute after:top-0.5 after:right-0.5 after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:after:translate-x-5 bg-border border border-border"></div>
                    </label>
                    <label for="IsActive" class="text-sm font-semibold cursor-pointer text-text">الحساب نشط</label>
                </div>
            }
        </div>
    </div>

    <div class="flex items-center justify-between gap-2 mt-6 w-full max-w-2xl">
        @if (isEdit)
        {
            <a href="/Users/Permissions/@Model.UserId" class="btn btn-ghost rounded-xl gap-2 text-success">
                <span class="material-symbols-rounded text-lg">admin_panel_settings</span>
                تعديل الصلاحيات الاستثنائية الفردية
            </a>
        }
        else { <div></div> }
        <div class="flex items-center gap-2">
            <a href="/Users" class="btn btn-ghost rounded-xl gap-2">
                <span class="material-symbols-rounded">cancel</span>إلغاء
            </a>
            <button type="submit" class="btn btn-primary rounded-xl gap-2">
                <span class="material-symbols-rounded">save</span>حفظ البيانات
            </button>
        </div>
    </div>
</form>
