@model UserViewModel
@{
    ViewData["Title"] = Model.UserId == 0 ? "مستخدم جديد" : "تعديل مستخدم";
    var isEdit = Model.UserId != 0;
    var roles = ViewBag.Roles as List<RoleDto>;
    ViewBag.IsEdit = isEdit;
    ViewBag.Icon = isEdit ? "edit" : "add";
    ViewBag.Title = isEdit ? "تعديل بيانات المستخدم" : "إضافة مستخدم جديد";
    ViewBag.Description = "إدخال وتحديث بيانات حسابات المستخدمين وتحديد الأدوار والصلاحيات";
    ViewBag.EntityName = "المستخدمون";
    ViewBag.EntityUrl = "/Users";
    ViewBag.BackUrl = "/Users";
    ViewBag.BackText = "الرجوع للمستخدمين";
}

<partial name="_CreateEditHeader" />

<form method="post" action="@(isEdit ? $"/Users/Edit/{Model.UserId}" : "/Users/Create")" class="max-w-2xl">
    @Html.AntiForgeryToken()
    @if (isEdit) { <input type="hidden" name="UserId" value="@Model.UserId" /> }
    <input type="hidden" name="IsActive" value="@Model.IsActive.ToString().ToLower()" />

    @if (ViewContext.ModelState.ErrorCount > 0)
    {
        <div asp-validation-summary="All" class="bg-error/10 border border-error/20 text-error rounded-xl p-4 mb-6 font-semibold text-sm"></div>
    }

    <div class="card bg-base-100 shadow-md">
        <div class="card-body space-y-4">
            <div class="flex items-center gap-2">
                <span class="material-symbols-rounded text-primary">person</span>
                <h3 class="font-bold text-base-content text-base">الملف التعريفي للمستخدم</h3>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="label">الاسم الكامل *</label>
                    <div class="relative">
                        <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-base-content/40 pointer-events-none text-lg">person</span>
                        <input type="text" name="FullName" value="@Model.FullName" class="input input-bordered w-full pr-10" required placeholder="مثال: سارة أحمد" />
                    </div>
                </div>
                <div>
                    <label class="label">اسم الدخول *</label>
                    <div class="relative">
                        <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-base-content/40 pointer-events-none text-lg">account_circle</span>
                        <input type="text" name="Username" value="@Model.Username" class="input input-bordered w-full pr-10" required @(isEdit ? "readonly" : "") placeholder="example_user" />
                    </div>
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="label">البريد الإلكتروني</label>
                    <div class="relative">
                        <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-base-content/40 pointer-events-none text-lg">email</span>
                        <input type="email" name="EmailAddress" value="@Model.EmailAddress" class="input input-bordered w-full pr-10" placeholder="user@example.com" />
                    </div>
                </div>
                <div>
                    <label class="label">رقم الهاتف</label>
                    <div class="relative">
                        <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-base-content/40 pointer-events-none text-lg">phone</span>
                        <input type="text" name="PhoneNumber" value="@Model.PhoneNumber" class="input input-bordered w-full pr-10" placeholder="+966500000000" />
                    </div>
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="label">الدور *</label>
                    <div class="relative">
                        <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-base-content/40 pointer-events-none text-lg">group_work</span>
                        <select name="RoleId" class="select select-bordered w-full pr-10" required>
                            <option value="">— اختر —</option>
                            @foreach (var r in roles ?? new())
                            {
                                <option value="@r.RoleId" selected="@(Model.RoleId == r.RoleId)">@(string.IsNullOrWhiteSpace(r.RoleDescription) ? r.RoleName : r.RoleDescription)</option>
                            }
                        </select>
                    </div>
                </div>
                <div>
                    <label class="label">@if (isEdit) { <text>كلمة مرور جديدة (اتركها فارغة للإبقاء)</text> } else { <text>كلمة المرور *</text> }</label>
                    <div class="relative">
                        <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-base-content/40 pointer-events-none text-lg">lock</span>
                        <input type="password" name="Password" class="input input-bordered w-full pr-10" placeholder="@(isEdit ? "اترك فارغاً" : "••••••••")" />
                    </div>
                </div>
            </div>
            @if (isEdit)
            {
                <div class="flex items-center gap-3 pt-2">
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" name="IsActive" value="true" id="IsActive" @(Model.IsActive ? "checked" : "") class="sr-only peer" />
                        <div class="w-11 h-6 bg-base-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:right-[2px] after:bg-white after:border-base-200 after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"></div>
                    </label>
                    <label for="IsActive" class="text-sm font-semibold text-base-content cursor-pointer">الحساب نشط</label>
                </div>
            }
        </div>
    </div>

    <div class="flex items-center justify-between gap-2 mt-6 w-full max-w-2xl">
        @if (isEdit)
        {
            <a href="/Users/Permissions/@Model.UserId" class="btn btn-ghost text-success flex items-center gap-1.5 py-3 px-5 rounded-2xl font-bold">
                <span class="material-symbols-rounded">admin_panel_settings</span>
                تعديل الصلاحيات الاستثنائية الفردية
            </a>
        }
        else
        {
            <div></div>
        }
        <div class="flex items-center gap-2">
            <a href="/Users" class="btn btn-ghost">
                <span class="material-symbols-rounded">cancel</span>
                إلغاء
            </a>
            <button type="submit" class="btn btn-primary">
                <span class="material-symbols-rounded">save</span>
                حفظ البيانات
            </button>
        </div>
    </div>
</form>
