@model List<UserDto>
@{ ViewData["Title"] = "المستخدمون"; }

<div class="page-header">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 relative z-10">
        <div>
            <nav class="breadcrumb">
                <span class="material-symbols-rounded">home</span>
                <a href="/">الرئيسية</a>
                <span class="material-symbols-rounded">chevron_left</span>
                <span>المستخدمون</span>
            </nav>
            <h1>
                <span class="material-symbols-rounded text-primary">admin_panel_settings</span>
                المستخدمون
            </h1>
            <p>إدارة حسابات المستخدمين وأدوارهم وصلاحياتهم في النظام</p>
        </div>
        <div class="flex items-center gap-2">
            @if (User.HasPermission(AppPermissions.UserManage))
            {
                <a href="/Users/Create" class="btn-primary">
                    <span class="material-symbols-rounded">add</span>
                    مستخدم جديد
                </a>
            }
        </div>
    </div>
</div>

<div class="filter-premium">
    <form method="get" class="flex gap-3">
        <div class="relative flex-1">
            <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-ink-soft">search</span>
            <input type="text" name="search" value="@ViewBag.Search" placeholder="بحث باسم المستخدم أو البريد…" class="form-input pr-10" />
        </div>
        <button type="submit" class="btn-primary">
            <span class="material-symbols-rounded">search</span>
            بحث
        </button>
        <a href="/Users" class="btn-secondary" title="إعادة ضبط">
            <span class="material-symbols-rounded">refresh</span>
        </a>
    </form>
</div>

<div class="table-premium">
    @if (!Model.Any())
    {
        <div class="empty-state p-12">
            <span class="material-symbols-rounded empty-icon">admin_panel_settings</span>
            <h3 class="font-bold text-ink text-lg mb-2">لا مستخدمين</h3>
            <p class="text-ink-muted text-sm mb-4">لم يتم العثور على أي مستخدمين تطابق البحث.</p>
            @if (User.HasPermission(AppPermissions.UserManage))
            {
                <a href="/Users/Create" class="btn-primary">
                    <span class="material-symbols-rounded">add</span>
                    إضافة مستخدم جديد
                </a>
            }
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr>
                        <th class="px-5 py-3 text-right font-semibold">الاسم</th>
                        <th class="px-5 py-3 text-right font-semibold">اسم الدخول</th>
                        <th class="px-5 py-3 text-right font-semibold">البريد</th>
                        <th class="px-5 py-3 text-right font-semibold">الدور</th>
                        <th class="px-5 py-3 text-right font-semibold">الحالة</th>
                        <th class="px-5 py-3 text-right font-semibold">إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td class="px-5 py-3 font-semibold text-ink">
                                <a href="/Users/Details/@u.UserId" class="hover:text-primary hover:underline transition-colors flex items-center gap-1.5">
                                    <span class="material-symbols-rounded text-base text-ink-muted group-hover:text-primary">account_box</span>
                                    @u.FullName
                                </a>
                            </td>
                            <td class="px-5 py-3 text-ink-muted">@u.Username</td>
                            <td class="px-5 py-3 text-ink-muted">@u.EmailAddress</td>
                            <td class="px-5 py-3"><span class="badge badge-info">@u.RoleName</span></td>
                            <td class="px-5 py-3">
                                <span class="badge @(u.IsActive ? "badge-active" : "badge-inactive")">
                                    @(u.IsActive ? "نشط" : "معطّل")
                                </span>
                            </td>
                            <td class="px-5 py-3">
                                @if (User.HasPermission(AppPermissions.UserManage))
                                {
                                    <a href="/Users/Edit/@u.UserId" class="icon-btn icon-btn-primary" title="تعديل الحساب"><span class="material-symbols-rounded">edit</span></a>
                                    <a href="/Users/Permissions/@u.UserId" class="icon-btn icon-btn-success" title="الاستثناءات والصلاحيات الفردية"><span class="material-symbols-rounded">admin_panel_settings</span></a>
                                    <form method="post" action="/Users/ToggleStatus/@u.UserId" class="inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="icon-btn @(u.IsActive ? "icon-btn-warning" : "icon-btn-success")" title="@(u.IsActive ? "تعطيل" : "تفعيل")">
                                            <span class="material-symbols-rounded">@(u.IsActive ? "block" : "check_circle")</span>
                                        </button>
                                    </form>
                                    <form method="post" action="/Users/Delete/@u.UserId" class="inline" data-confirm="هل أنت متأكد من حذف المستخدم «@u.FullName»؟">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="icon-btn icon-btn-danger"><span class="material-symbols-rounded">delete</span></button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
