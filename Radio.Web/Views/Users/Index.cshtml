@model List<UserDto>
@{ ViewData["Title"] = "المستخدمون"; }

<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
    <div>
        <div class="breadcrumbs text-sm text-base-content/60">
            <ul>
                <li><a href="/" class="inline-flex items-center gap-1"><span class="material-symbols-rounded text-lg">home</span>الرئيسية</a></li>
                <li><span class="inline-flex items-center gap-1"><span class="material-symbols-rounded text-lg">admin_panel_settings</span>المستخدمون</span></li>
            </ul>
        </div>
        <h1 class="text-2xl font-extrabold text-base-content mt-1 flex items-center gap-2">
            <span class="material-symbols-rounded text-primary">admin_panel_settings</span>
            المستخدمون
        </h1>
        <p class="text-sm text-base-content/60 mt-0.5">إدارة حسابات المستخدمين وأدوارهم وصلاحياتهم في النظام</p>
    </div>
    <div class="flex items-center gap-2">
        @if (User.HasPermission(AppPermissions.UserManage))
        {
            <a href="/Users/Create" class="btn btn-primary">
                <span class="material-symbols-rounded">add</span>
                مستخدم جديد
            </a>
        }
    </div>
</div>

<div class="card bg-base-100 shadow-md mb-6">
    <div class="card-body">
        <form method="get" class="flex gap-3">
            <div class="relative flex-1">
                <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-base-content/40">search</span>
                <input type="text" name="search" value="@ViewBag.Search" placeholder="بحث باسم المستخدم أو البريد…" class="input input-bordered w-full pr-10" />
            </div>
            <button type="submit" class="btn btn-primary">
                <span class="material-symbols-rounded">search</span>
                بحث
            </button>
            <a href="/Users" class="btn btn-ghost" title="إعادة ضبط">
                <span class="material-symbols-rounded">refresh</span>
            </a>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card bg-base-100 shadow-md">
        <div class="card-body text-center py-12">
            <span class="material-symbols-rounded text-4xl text-base-content/30 mb-2">admin_panel_settings</span>
            <h3 class="font-bold text-base-content text-lg mb-2">لا مستخدمين</h3>
            <p class="text-base-content/60 text-sm mb-4">لم يتم العثور على أي مستخدمين تطابق البحث.</p>
            @if (User.HasPermission(AppPermissions.UserManage))
            {
                <a href="/Users/Create" class="btn btn-primary">
                    <span class="material-symbols-rounded">add</span>
                    إضافة مستخدم جديد
                </a>
            }
        </div>
    </div>
}
else
{
    <div class="card bg-base-100 shadow-md overflow-hidden">
    <div class="overflow-x-auto">
        <table class="table table-zebra w-full text-sm">
            <thead>
                <tr>
                    <th class="text-right font-semibold">الاسم</th>
                    <th class="text-right font-semibold">اسم الدخول</th>
                    <th class="text-right font-semibold">البريد</th>
                    <th class="text-right font-semibold">الدور</th>
                    <th class="text-right font-semibold">الحالة</th>
                    <th class="text-right font-semibold">إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td class="font-semibold text-base-content">
                            <a href="/Users/Details/@u.UserId" class="hover:text-primary hover:underline transition-colors flex items-center gap-1.5">
                                <span class="material-symbols-rounded text-base text-base-content/60 group-hover:text-primary">account_box</span>
                                @u.FullName
                            </a>
                        </td>
                        <td class="text-base-content/60">@u.Username</td>
                        <td class="text-base-content/60">@u.EmailAddress</td>
                        <td><span class="badge badge-info">@u.RoleName</span></td>
                        <td>
                            <span class="badge @(u.IsActive ? "badge-success" : "badge-error")">
                                @(u.IsActive ? "نشط" : "معطّل")
                            </span>
                        </td>
                        <td>
                            @if (User.HasPermission(AppPermissions.UserManage))
                            {
                                <div class="flex items-center justify-center gap-1 whitespace-nowrap">
                                    <a href="/Users/Edit/@u.UserId" class="btn btn-ghost btn-square btn-sm text-primary" title="تعديل الحساب" aria-label="تعديل الحساب"><span class="material-symbols-rounded text-lg">edit</span></a>
                                    <a href="/Users/Permissions/@u.UserId" class="btn btn-ghost btn-square btn-sm text-success" title="الاستثناءات والصلاحيات الفردية" aria-label="الاستثناءات والصلاحيات الفردية"><span class="material-symbols-rounded text-lg">admin_panel_settings</span></a>
                                    <form method="post" action="/Users/ToggleStatus/@u.UserId" class="inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-ghost btn-square btn-sm @(u.IsActive ? "text-base-content/40" : "text-success")" title="@(u.IsActive ? "تعطيل" : "تفعيل")" aria-label="@(u.IsActive ? "تعطيل" : "تفعيل")">
                                            <span class="material-symbols-rounded text-lg">@(u.IsActive ? "block" : "check_circle")</span>
                                        </button>
                                    </form>
                                    <form method="post" action="/Users/Delete/@u.UserId" class="inline" data-confirm="هل أنت متأكد من حذف المستخدم «@u.FullName»؟">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-ghost btn-square btn-sm text-error" title="حذف" aria-label="حذف"><span class="material-symbols-rounded text-lg">delete</span></button>
                                    </form>
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    </div>
}
