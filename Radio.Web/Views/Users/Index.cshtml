@model List<UserDto>
@{
    ViewData["Title"] = "المستخدمون";
    ViewData["HeaderIcon"] = "admin_panel_settings";
    ViewData["HeaderDescription"] = "إدارة حسابات المستخدمين وأدوارهم وصلاحياتهم في النظام";
    ViewBag.EntityName = "المستخدمون";

    if (User.HasPermission(AppPermissions.UserManage))
    {
        ViewData["HeaderActions"] = "<a href='/Users/Create' class='btn btn-primary rounded-xl gap-2'><span class='material-symbols-rounded'>add</span>مستخدم جديد</a>";
    }
}

<partial name="_PageHeader" />

@{ ViewBag.SearchValue = ViewBag.Search; ViewBag.SearchPlaceholder = "بحث باسم المستخدم أو البريد…"; ViewBag.SearchAction = "/Users"; }
<partial name="_SearchBar" />

@if (!Model.Any())
{
    ViewBag.EmptyIcon = "admin_panel_settings";
    ViewBag.EmptyTitle = "لا مستخدمين";
    ViewBag.EmptyDesc = "لم يتم العثور على أي مستخدمين تطابق البحث.";
    ViewBag.EmptyActionUrl = User.HasPermission(AppPermissions.UserManage) ? "/Users/Create" : null;
    ViewBag.EmptyActionText = "إضافة مستخدم جديد";
    ViewBag.EmptyActionIcon = "add";
    <partial name="_EmptyState" />
}
else
{
    <div class="wf-card overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="text-xs font-semibold"
                        style="color: var(--color-text-muted); background: var(--color-bg); border-bottom: 1px solid var(--color-border);">
                        <th class="text-right py-3 px-4">الاسم</th>
                        <th class="text-right py-3 px-4 hidden md:table-cell">اسم الدخول</th>
                        <th class="text-right py-3 px-4 hidden md:table-cell">البريد</th>
                        <th class="text-right py-3 px-4">الدور</th>
                        <th class="text-right py-3 px-4">الحالة</th>
                        <th class="text-center py-3 px-4">إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr class="transition-colors"
                            style="border-bottom: 1px solid var(--color-border);">
                            <td class="py-3 px-4">
                                <a href="/Users/Details/@u.UserId" class="font-semibold inline-flex items-center gap-1.5 transition-colors"
                                   style="color: var(--color-text);">
                                    <span class="material-symbols-rounded text-base" style="color: var(--color-text-muted);">account_box</span>
                                    <span class="hover:underline" style="color: var(--color-primary);">@u.FullName</span>
                                </a>
                            </td>
                            <td class="py-3 px-4 hidden md:table-cell" style="color: var(--color-text-secondary);">@u.Username</td>
                            <td class="py-3 px-4 hidden md:table-cell" style="color: var(--color-text-secondary);">@u.EmailAddress</td>
                            <td class="py-3 px-4">
                                <span class="text-[10px] font-bold px-2 py-0.5 rounded-lg"
                                      style="background: var(--color-info-container); color: var(--color-info);">@u.RoleName</span>
                            </td>
                            <td class="py-3 px-4">
                                <span class="text-[10px] font-bold px-2 py-0.5 rounded-lg"
                                      style="background: @(u.IsActive ? "var(--color-success-container)" : "var(--color-danger-container)"); color: @(u.IsActive ? "var(--color-success)" : "var(--color-danger)");">
                                    @(u.IsActive ? "نشط" : "معطّل")
                                </span>
                            </td>
                            <td class="py-3 px-4">
                                @if (User.HasPermission(AppPermissions.UserManage))
                                {
                                    <div class="flex items-center justify-center gap-1">
                                        <a href="/Users/Edit/@u.UserId" class="inline-flex items-center justify-center w-9 h-9 rounded-lg transition-colors hover:bg-primary-subtle"
                                           style="color: var(--color-primary);" title="تعديل الحساب">
                                            <span class="material-symbols-rounded text-lg">edit</span>
                                        </a>
                                        <a href="/Users/Permissions/@u.UserId" class="hidden md:inline-flex items-center justify-center w-9 h-9 rounded-lg transition-colors hover:bg-success-subtle"
                                           style="color: var(--color-success);" title="الاستثناءات والصلاحيات الفردية">
                                            <span class="material-symbols-rounded text-lg">admin_panel_settings</span>
                                        </a>
                                        <form method="post" action="/Users/ToggleStatus/@u.UserId" class="hidden md:inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="inline-flex items-center justify-center w-9 h-9 rounded-lg transition-colors hover:bg-bg-hover"
                                                    style="color: @(u.IsActive ? "var(--color-text-muted)" : "var(--color-success)");" title="@(u.IsActive ? "تعطيل" : "تفعيل")">
                                                <span class="material-symbols-rounded text-lg">@(u.IsActive ? "block" : "check_circle")</span>
                                            </button>
                                        </form>
                                        <form method="post" action="/Users/Delete/@u.UserId" class="inline" data-confirm="هل أنت متأكد من حذف المستخدم «@u.FullName»؟">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="inline-flex items-center justify-center w-9 h-9 rounded-lg transition-colors hover:bg-danger-subtle"
                                                    style="color: var(--color-danger);" title="حذف">
                                                <span class="material-symbols-rounded text-lg">delete</span>
                                            </button>
                                        </form>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
