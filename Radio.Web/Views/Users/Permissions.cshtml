@model List<DataAccess.DTOs.UserPermissionOverrideViewModel>
@{
    ViewData["Title"] = "استثناءات صلاحيات المستخدم";
    var user = (UserDto)ViewBag.User;
    var permissionsByModule = Model.GroupBy(p => p.Module);
    ViewBag.IsEdit = true;
    ViewBag.Icon = "admin_panel_settings";
    ViewBag.Title = "استثناءات صلاحيات المستخدم";
    ViewBag.Description = $"تخصيص صلاحيات فردية استثنائية للمستخدم {user.FullName} لتتجاوز صلاحيات دوره الافتراضي ({user.RoleName})";
    ViewBag.EntityName = "المستخدمون";
    ViewBag.EntityUrl = "/Users";
    ViewBag.BackUrl = "/Users";
    ViewBag.BackText = "الرجوع للمستخدمين";
}

<partial name="_PageHeader" />

<div class="card p-6 mb-8">
    <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-2xl bg-primary-subtle text-primary flex items-center justify-center font-bold text-2xl shrink-0">
            <span class="material-symbols-rounded">account_circle</span>
        </div>
        <div>
            <h3 class="font-bold text-base text-text">حساب المستخدم: <span class="text-primary font-black">@user.FullName</span></h3>
            <p class="text-caption mt-1 text-text-secondary">اسم الدخول: @user.Username | الدور الأساسي الحالي: <span class="badge badge-primary">@user.RoleName</span></p>
        </div>
    </div>
</div>

<form method="post" action="/Users/UpdatePermissions/@user.UserId">
    @Html.AntiForgeryToken()

    <div class="card overflow-hidden">
        <div class="p-6 border-b border-border bg-surface flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
                <h3 class="font-bold text-base text-text">استثناءات الصلاحيات الفردية</h3>
                <p class="text-xs mt-1 text-text-secondary">اختر "موروث" للاستعانة بصلاحيات الدور الافتراضي، أو قم بـ "فرض السماح" أو "فرض الحظر" للمستخدم بشكل فردي</p>
            </div>
            
            <div class="flex items-center gap-2">
                <button type="button" class="btn btn-ghost btn-sm font-bold text-text hover:text-primary" onclick="resetAllOverrides()">
                    إعادة ضبط الاستثناءات (موروث للكل)
                </button>
            </div>
        </div>

        <!-- Matrix Body -->
        <div class="p-6 space-y-8 bg-surface">
            @foreach (var module in permissionsByModule)
            {
                <div class="module-section space-y-4">
                    <div class="flex items-center justify-between border-b border-border pb-2">
                        <h4 class="font-bold text-sm flex items-center gap-2 text-text">
                            <span class="w-1.5 h-3.5 bg-primary rounded-full"></span>
                            @module.Key
                        </h4>
                    </div>

                    <div class="grid grid-cols-1 xl:grid-cols-2 gap-4">
                        @foreach (var p in module)
                        {
                            <div class="perm-card card p-4 hover:border-primary/40 transition-all duration-200"
                                 data-inherited-access="@(p.InheritedAccess ? "true" : "false")">
                                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                                    
                                    <!-- Permission Info -->
                                    <div class="flex flex-col gap-1 pr-2 max-w-sm">
                                        <div class="flex items-center gap-2">
                                            <span class="text-xs font-bold text-text">@p.DisplayName</span>
                                            <span class="text-[9px] font-mono text-text-muted">@p.SystemName</span>
                                        </div>
                                        <div class="flex items-center gap-2 mt-1">
                                            <span class="text-[10px] text-text-secondary">الحالة الموروثة:</span>
                                            <span class="badge @(p.InheritedAccess ? "badge-success" : "badge-danger") text-[9px]">
                                                @(p.InheritedAccess ? "ممنوحة للدور" : "محظورة عن الدور")
                                            </span>
                                        </div>
                                    </div>

                                    <!-- Override Type Selection (Radio Buttons) -->
                                    <div class="flex items-center gap-2 p-1.5 rounded-xl border border-border bg-bg self-end sm:self-auto">
                                        
                                        <!-- None / Inherited -->
                                        <label class="cursor-pointer flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-bold transition-all text-text-secondary hover:text-text">
                                            <input type="radio" name="override_@p.SystemName" value="None" 
                                                   checked="@(p.OverrideType == "None")"
                                                   class="sr-only" onchange="onOverrideChanged('@p.SystemName')" />
                                            <span class="select-none text-[10px]">موروث</span>
                                        </label>

                                        <!-- Direct Grant -->
                                        <label class="cursor-pointer flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-bold transition-all text-text-secondary hover:text-success">
                                            <input type="radio" name="override_@p.SystemName" value="Grant" 
                                                   checked="@(p.OverrideType == "Grant")"
                                                   class="sr-only" onchange="onOverrideChanged('@p.SystemName')" />
                                            <span class="select-none text-[10px]">سماح فردي</span>
                                        </label>

                                        <!-- Direct Deny -->
                                        <label class="cursor-pointer flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-bold transition-all text-text-secondary hover:text-danger">
                                            <input type="radio" name="override_@p.SystemName" value="Deny" 
                                                   checked="@(p.OverrideType == "Deny")"
                                                   class="sr-only" onchange="onOverrideChanged('@p.SystemName')" />
                                            <span class="select-none text-[10px]">حظر فردي</span>
                                        </label>

                                    </div>

                                    <!-- Resulting Effective Access Badge -->
                                    <div class="flex flex-col items-center justify-center shrink-0 pr-4 border-r border-border self-end sm:self-auto">
                                        <span class="text-[9px] mb-0.5 text-text-muted">الصلاحية النهائية</span>
                                        <span id="effective_@p.SystemName" class="badge text-xs font-black py-1 px-3 rounded-full transition-all duration-300">
                                            جاري التقييم...
                                        </span>
                                    </div>

                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Hidden lists for POST submission -->
        <div id="hidden-inputs-container"></div>

        <div class="px-6 py-5 border-t border-border bg-surface-hover/50 flex justify-end">
            <button type="submit" onclick="prepareSubmit(event)" class="btn btn-primary font-bold gap-2">
                <span class="material-symbols-rounded">save</span>
                حفظ استثناءات الصلاحيات فورياً
            </button>
        </div>
    </div>
</form>

<script>
    function updateEffectiveAccess(permissionName) {
        const radios = document.getElementsByName('override_' + permissionName);
        let selectedValue = "None";
        for (const radio of radios) {
            if (radio.checked) {
                selectedValue = radio.value;
                break;
            }
        }

        const card = radios[0].closest('.perm-card');
        const inherited = card.getAttribute('data-inherited-access') === "true";
        const badge = document.getElementById('effective_' + permissionName);

        let finalAccess = inherited;
        if (selectedValue === "Grant") finalAccess = true;
        else if (selectedValue === "Deny") finalAccess = false;

        if (badge) {
            if (finalAccess) {
                badge.className = "badge badge-success py-1 px-3 text-xs font-black rounded-full bg-success/10 text-success border border-success/30";
                badge.textContent = "مـصـرّح";
            } else {
                badge.className = "badge badge-error py-1 px-3 text-xs font-black rounded-full bg-error/10 text-error border border-error/30";
                badge.textContent = "مـحـظـور";
            }
        }
    }

    function onOverrideChanged(permissionName) {
        updateEffectiveAccess(permissionName);
    }

    function resetAllOverrides() {
        const radios = document.querySelectorAll('input[type="radio"][value="None"]');
        radios.forEach(r => {
            r.checked = true;
            const event = new Event('change');
            r.dispatchEvent(event);
        });
    }

    function prepareSubmit(e) {
        const container = document.getElementById('hidden-inputs-container');
        container.innerHTML = ''; // تفريغ المدخلات المخفية السابقة

        // العثور على جميع مجموعات الراديو في الصفحة
        const allPermissionNames = [];
        document.querySelectorAll('input[type="radio"]').forEach(r => {
            const name = r.name.replace('override_', '');
            if (!allPermissionNames.includes(name)) {
                allPermissionNames.push(name);
            }
        });

        allPermissionNames.forEach(name => {
            const radios = document.getElementsByName('override_' + name);
            let selectedValue = "None";
            for (const r of radios) {
                if (r.checked) {
                    selectedValue = r.value;
                    break;
                }
            }

            if (selectedValue === "Grant") {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'grantedPermissions';
                input.value = name;
                container.appendChild(input);
            } else if (selectedValue === "Deny") {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'deniedPermissions';
                input.value = name;
                container.appendChild(input);
            }
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
        // تقييم حالة الصلاحية الفعلية الأولية للجميع عند تحميل الصفحة
        const allPermissionNames = [];
        document.querySelectorAll('input[type="radio"]').forEach(r => {
            const name = r.name.replace('override_', '');
            if (!allPermissionNames.includes(name)) {
                allPermissionNames.push(name);
            }
        });

        allPermissionNames.forEach(name => {
            updateEffectiveAccess(name);
        });
    });
</script>
