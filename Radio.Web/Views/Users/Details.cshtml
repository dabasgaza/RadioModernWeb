@model List<DataAccess.DTOs.UserPermissionOverrideViewModel>
@{
    ViewData["Title"] = "تفاصيل وصلاحيات المستخدم الفعالة";
    var user = (UserDto)ViewBag.User;
    var permissionsByModule = Model.GroupBy(p => p.Module);
    ViewBag.IsEdit = false;
    ViewBag.Icon = "badge";
    ViewBag.Title = "تفاصيل وصلاحيات المستخدم الفعالة";
    ViewBag.Description = $"استعراض الملف التعريفي التفصيلي وجدول الصلاحيات الفعالة ومصدر كل منها للمستخدم {user.FullName}";
    ViewBag.EntityName = "المستخدمون";
    ViewBag.EntityUrl = "/Users";
    ViewBag.BackUrl = "/Users";
    ViewBag.BackText = "الرجوع للمستخدمين";
}

<partial name="_PageHeader" />

<!-- User Profile Card -->
<div class="card p-6 mb-8 grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="flex items-center gap-4 col-span-2">
        <div class="w-16 h-16 rounded-2xl bg-primary-subtle text-primary flex items-center justify-center font-bold text-2xl shrink-0">
            @user.FullName.Substring(0, Math.Min(2, user.FullName.Length)).ToUpper()
        </div>
        <div>
            <h3 class="font-bold text-lg text-text">@user.FullName</h3>
            <p class="text-caption mt-1 text-text-secondary">اسم الدخول: <span class="font-mono">@user.Username</span> | البريد: @(string.IsNullOrWhiteSpace(user.EmailAddress) ? "غير محدد" : user.EmailAddress)</p>
            <p class="text-caption mt-0.5 text-text-secondary">الهاتف: @(string.IsNullOrWhiteSpace(user.PhoneNumber) ? "غير محدد" : user.PhoneNumber)</p>
        </div>
    </div>
    
    <div class="flex flex-col justify-center items-start md:items-end gap-2 border-t md:border-t-0 md:border-r border-border pt-4 md:pt-0 pr-0 md:pr-6">
        <div>
            <span class="text-xs text-text-secondary">الدور الوظيفي:</span>
            <span class="badge badge-primary">@user.RoleName</span>
        </div>
        <div>
            <span class="text-xs text-text-secondary">حالة الحساب:</span>
            <span class="badge @(user.IsActive ? "badge-success" : "badge-danger")">
                @(user.IsActive ? "نشط ومفعل" : "معطّل")
            </span>
        </div>
    </div>
</div>

<!-- Effective Permissions Matrix Card -->
<div class="card overflow-hidden">
    <div>
        <div class="p-6 border-b border-border bg-surface flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
                <h3 class="font-bold text-base text-text">الصلاحيات الفعالة (Effective Permissions)</h3>
                <p class="text-xs mt-1 text-text-secondary">جدول يوضح الصلاحيات الفعلية الممنوحة والمحجوبة بناءً على دمج صلاحيات الدور الافتراضي والاستثناءات الفردية</p>
            </div>
            
            <div class="flex items-center gap-2">
                @if (User.HasPermission(AppPermissions.UserManage))
                {
                    <a href="/Users/Permissions/@user.UserId" class="btn btn-primary btn-sm gap-1.5">
                        <span class="material-symbols-rounded text-sm">admin_panel_settings</span>
                        تعديل الاستثناءات الفردية
                    </a>
                    <a href="/Users/Edit/@user.UserId" class="btn btn-ghost btn-sm text-text-secondary">
                        <span class="material-symbols-rounded text-sm">edit</span>
                        تعديل الحساب
                    </a>
                }
            </div>
        </div>

    <!-- Quick Search -->
    <div class="p-4 border-b border-border bg-bg">
        <div class="relative w-full">
            <span class="material-symbols-rounded absolute right-4 top-1/2 -translate-y-1/2 text-sm text-text-muted">search</span>
            <input type="text" id="permSearch" placeholder="بحث سريع في الصلاحيات الفعالة..." 
                   class="w-full rounded-xl pr-11 pl-4 py-2 text-xs bg-surface border border-border text-text focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all" />
        </div>
    </div>

    <div class="p-6 space-y-8 bg-surface">
        @foreach (var module in permissionsByModule)
        {
            <div class="module-section space-y-4" data-module="@module.Key.ToLower()">
                <div class="flex items-center border-b border-border pb-2">
                    <h4 class="font-bold text-sm flex items-center gap-2 text-text">
                        <span class="w-1.5 h-3.5 bg-primary rounded-full"></span>
                        @module.Key
                    </h4>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    @foreach (var p in module)
                    {
                        <div class="perm-item card p-4 hover:border-primary/40 transition-all duration-200"
                             data-text="@p.DisplayName.ToLower() @p.SystemName.ToLower()">
                            
                            <div class="flex flex-col gap-1 pr-2">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <span class="text-xs font-bold text-text">@p.DisplayName</span>
                                    <span class="text-[9px] font-mono text-text-muted select-all">@p.SystemName</span>
                                </div>
                                <div class="flex items-center gap-2 mt-1">
                                    <!-- Source Indicator -->
                                    <span class="text-[9px]" style="color: var(--color-text-secondary);">المصدر:</span>
                                    @if (p.OverrideType == "Grant")
                                    {
                                        <span style="display: inline-flex; align-items: center; gap: 0.125rem; background: color-mix(in srgb, var(--color-success) 10%, transparent); color: var(--color-success); padding: 0.125rem 0.5rem; font-size: 0.5rem; font-weight: 700; border-radius: 9999px; border: 1px solid color-mix(in srgb, var(--color-success) 20%, transparent);">
                                            <span class="material-symbols-rounded text-[9px]">add_circle</span>
                                            استثناء (سماح فردي)
                                        </span>
                                    }
                                    else if (p.OverrideType == "Deny")
                                    {
                                        <span style="display: inline-flex; align-items: center; gap: 0.125rem; background: color-mix(in srgb, var(--color-error) 10%, transparent); color: var(--color-error); padding: 0.125rem 0.5rem; font-size: 0.5rem; font-weight: 700; border-radius: 9999px; border: 1px solid color-mix(in srgb, var(--color-error) 20%, transparent);">
                                            <span class="material-symbols-rounded text-[9px]">cancel</span>
                                            استثناء (حظر فردي)
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="display: inline-flex; align-items: center; gap: 0.125rem; background: var(--color-bg-alt); color: var(--color-text-secondary); padding: 0.125rem 0.5rem; font-size: 0.5rem; font-weight: 700; border-radius: 9999px; border: 1px solid var(--color-border);">
                                            <span class="material-symbols-rounded text-[9px]">group</span>
                                            موروث من الدور الافتراضي
                                        </span>
                                    }
                                </div>
                            </div>

                            <!-- Final Access Status -->
                            <div class="flex flex-col items-center shrink-0 pr-4 border-r" style="border-color: var(--color-border);">
                                <span style="@(p.EffectiveAccess ? "display: inline-flex; align-items: center; gap: 0.125rem; background: color-mix(in srgb, var(--color-success) 15%, transparent); color: var(--color-success); padding: 0.25rem 0.875rem; font-size: 0.625rem; font-weight: 900; border-radius: 9999px; border: 1px solid color-mix(in srgb, var(--color-success) 30%, transparent); box-shadow: 0 1px 2px rgba(0,0,0,0.05);" : "display: inline-flex; align-items: center; gap: 0.125rem; background: color-mix(in srgb, var(--color-error) 15%, transparent); color: var(--color-error); padding: 0.25rem 0.875rem; font-size: 0.625rem; font-weight: 900; border-radius: 9999px; border: 1px solid color-mix(in srgb, var(--color-error) 30%, transparent); box-shadow: 0 1px 2px rgba(0,0,0,0.05);")">
                                    @(p.EffectiveAccess ? "مـصـرّح" : "مـحـظـور")
                                </span>
                            </div>

                        </div>
                    }
                </div>
            </div>
        }
    </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const searchInput = document.getElementById('permSearch');
        if (searchInput) {
            searchInput.addEventListener('input', function () {
                const query = this.value.toLowerCase().trim();
                const items = document.querySelectorAll('.perm-item');

                items.forEach(item => {
                    const text = item.getAttribute('data-text');
                    if (text.includes(query)) {
                        item.style.display = '';
                    } else {
                        item.style.display = 'none';
                    }
                });

                // إخفاء الأقسام الفارغة
                document.querySelectorAll('.module-section').forEach(section => {
                    const visibleItems = section.querySelectorAll('.perm-item:not([style*="display: none"])');
                    if (visibleItems.length === 0) {
                        section.style.display = 'none';
                    } else {
                        section.style.display = '';
                    }
                });
            });
        }
    });
</script>
