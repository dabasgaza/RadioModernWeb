@model RoleDto
@{
    ViewData["Title"] = "استنساخ الدور الوظيفي";
    ViewData["HeaderIcon"] = "content_copy";
    ViewData["HeaderDescription"] = "إنشاء دور وظيفي جديد بناءً على صلاحيات دور حالي لتسهيل التهيئة";
    ViewBag.EntityName = "الأدوار الوظيفية";
    ViewBag.EntityUrl = "/Roles";
    ViewBag.BackUrl = "/Roles";
    ViewBag.BackText = "الرجوع للأدوار";
}

<partial name="_PageHeader" />

<div class="rounded-2xl border max-w-2xl bg-surface" style="border-color: var(--color-border)">
    <form method="post" action="/Roles/Clone/@ViewBag.SourceRoleId">
        @Html.AntiForgeryToken()

        <div class="p-6 space-y-6">
            @{
                ViewBag.SectionIcon = "content_copy"; ViewBag.SectionTitle = "استنساخ وتكرار الدور";
                ViewBag.SectionSubtitle = "سيتم توريد الصلاحيات تلقائياً للدور الجديد";
            }
            <partial name="_SectionHeader" />

            <div class="rounded-2xl p-5 flex items-start gap-4 bg-primary-subtle border border-primary-subtle">
                <span class="material-symbols-rounded p-1 rounded-lg shrink-0 text-primary" style="background: color-mix(in srgb, var(--color-primary) 15%, transparent)">info</span>
                <div class="text-xs leading-relaxed text-text-secondary">
                    سيتم إنشاء دور وظيفي جديد بنسخة مطابقة تماماً من صلاحيات دور <strong class="text-primary">@ViewBag.SourceRoleName</strong>. بعد إتمام الاستنساخ، يمكنك التعديل والتحكم بالصلاحيات بحرية تامة من مصفوفة الصلاحيات.
                </div>
            </div>

            @if (ViewContext.ModelState.ErrorCount > 0)
            {
                <div asp-validation-summary="All" class="rounded-xl p-4 font-semibold text-sm bg-danger-subtle text-danger border border-danger-subtle"></div>
            }

            @{
                ViewBag.FieldLabel = "اسم الدور الجديد"; ViewBag.FieldName = "newRoleName";
                ViewBag.FieldIcon = "badge"; ViewBag.FieldRequired = true;
                ViewBag.FieldPlaceholder = "مثال: محرر أول"; ViewBag.FieldAttrs = "maxlength=\"100\"";
            }
            <partial name="_FormField" />

            @{
                ViewBag.FieldLabel = "الوصف للدور الجديد"; ViewBag.FieldName = "newDescription";
                ViewBag.FieldValue = Model.RoleDescription; ViewBag.FieldType = "textarea";
                ViewBag.FieldRows = "4"; ViewBag.FieldAttrs = "maxlength=\"500\"";
                ViewBag.FieldPlaceholder = "وصف مختصر للمهام والمسؤوليات الموكلة لهذا الدور الجديد…";
            }
            <partial name="_FormField" />

            <div class="flex items-center justify-between gap-3 pt-4" style="border-top: 1px solid var(--color-border)">
                <a href="/Roles" class="btn btn-ghost rounded-xl gap-2">
                    <span class="material-symbols-rounded">cancel</span>إلغاء
                </a>
                <button type="submit" class="btn btn-primary rounded-xl gap-2">
                    <span class="material-symbols-rounded">content_copy</span>تأكيد واستنساخ الدور
                </button>
            </div>
        </div>
    </form>
</div>
