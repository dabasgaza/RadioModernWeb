@model RoleDto
@{
    ViewData["Title"] = "استنساخ الدور الوظيفي";
    ViewData["HeaderIcon"] = "content_copy";
    ViewData["HeaderDescription"] = "إنشاء دور وظيفي جديد بناءً على صلاحيات دور حالي لتسهيل التهيئة";
    ViewBag.EntityName = "الأدوار الوظيفية";
    ViewBag.EntityUrl = "/Roles";
    ViewBag.BackUrl = "/Roles";
    ViewBag.BackText = "الرجوع للأدوار";
}

<partial name="_PageHeader" />

<div class="rounded-2xl border max-w-2xl mx-auto" style="background: var(--color-surface); border-color: var(--color-border)">
    <form method="post" action="/Roles/Clone/@ViewBag.SourceRoleId">
        @Html.AntiForgeryToken()
        
        <div class="p-6 space-y-6">
            <div class="flex items-center gap-3" style="color: var(--color-text)">
                <span class="material-symbols-rounded p-2 rounded-xl" style="background: color-mix(in srgb, var(--color-primary) 10%, transparent); color: var(--color-primary)">content_copy</span>
                <div>
                    <h3 class="font-extrabold" style="color: var(--color-text)">استنساخ وتكرار الدور</h3>
                    <p class="text-xs mt-1" style="color: var(--color-text-tertiary)">سيتم توريد الصلاحيات تلقائياً للدور الجديد</p>
                </div>
            </div>
            <div class="rounded-2xl p-5 flex items-start gap-4" style="background: color-mix(in srgb, var(--color-primary) 5%, transparent); border: 1px solid color-mix(in srgb, var(--color-primary) 10%, transparent)">
                <span class="material-symbols-rounded p-1 rounded-lg shrink-0" style="background: color-mix(in srgb, var(--color-primary) 10%, transparent); color: var(--color-primary)">info</span>
                <div class="text-xs leading-relaxed" style="color: var(--color-text-tertiary)">
                    سيتم إنشاء دور وظيفي جديد بنسخة مطابقة تماماً من صلاحيات دور <strong style="color: var(--color-primary)">@ViewBag.SourceRoleName</strong>. بعد إتمام الاستنساخ، يمكنك التعديل والتحكم بالصلاحيات بحرية تامة من مصفوفة الصلاحيات.
                </div>
            </div>

            @if (ViewContext.ModelState.ErrorCount > 0)
            {
                <div asp-validation-summary="All" class="rounded-2xl p-4 text-xs font-semibold flex items-start gap-3"
                     style="background: color-mix(in srgb, var(--color-error) 5%, transparent); border: 1px solid color-mix(in srgb, var(--color-error) 20%, transparent); color: var(--color-error)">
                    <span class="material-symbols-rounded shrink-0 text-sm">error</span>
                    <div class="flex-1 space-y-1">
                        <span class="block font-bold">يرجى تصحيح الأخطاء التالية:</span>
                    </div>
                </div>
            }

            <div>
                <label class="text-sm font-bold mb-2 block" style="color: var(--color-text)">اسم الدور الجديد <span style="color: var(--color-error)">*</span></label>
                <div class="relative">
                    <span class="material-symbols-rounded absolute right-4 top-1/2 -translate-y-1/2" style="color: var(--color-text-tertiary)">badge</span>
                    <input type="text" name="newRoleName"
                           class="w-full rounded-xl py-3 pr-12 pl-4 text-sm font-bold focus:outline-none focus:ring-4 transition-all"
                           style="background: var(--color-bg-alt); border: 1px solid var(--color-border); color: var(--color-text); --tw-ring-color: color-mix(in srgb, var(--color-primary) 10%, transparent)"
                           placeholder="مثال: محرر أول" required maxlength="100" />
                </div>
            </div>

            <div>
                <label class="text-sm font-bold mb-2 block" style="color: var(--color-text)">الوصف للدور الجديد</label>
                <textarea name="newDescription"
                          class="w-full rounded-xl p-4 text-sm focus:outline-none focus:ring-4 transition-all"
                          style="background: var(--color-bg-alt); border: 1px solid var(--color-border); color: var(--color-text); --tw-ring-color: color-mix(in srgb, var(--color-primary) 10%, transparent)"
                          rows="4" placeholder="وصف مختصر للمهام والمسؤوليات الموكلة لهذا الدور الجديد…" maxlength="500">@Model.RoleDescription</textarea>
            </div>
        
        <div class="flex items-center justify-between gap-3 pt-4" style="border-top: 1px solid var(--color-border)">
            <a href="/Roles" class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-xl font-bold text-sm transition-all"
               style="color: var(--color-text-secondary)">
                <span class="material-symbols-rounded">cancel</span>
                إلغاء
            </a>
            <button type="submit" class="inline-flex items-center gap-1.5 px-6 py-2.5 rounded-xl font-bold text-sm shadow-sm transition-all"
                    style="background: var(--color-primary); color: white">
                <span class="material-symbols-rounded">content_copy</span>
                تأكيد واستنساخ الدور
            </button>
        </div>
        </div>
    </form>
</div>
