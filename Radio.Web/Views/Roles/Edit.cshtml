@model RoleDto
@{
    ViewData["Title"] = Model.RoleId == 0 ? "إضافة دور جديد" : "تعديل بيانات الدور";
    var isEdit = Model.RoleId != 0;
    ViewBag.IsEdit = isEdit;
    ViewBag.Icon = isEdit ? "edit" : "add";
    ViewBag.Title = isEdit ? "تعديل بيانات الدور" : "إضافة دور جديد";
    ViewBag.Description = "إدخال وتحديث البيانات الأساسية للدور الوظيفي";
    ViewBag.EntityName = "الأدوار الوظيفية";
    ViewBag.EntityUrl = "/Roles";
    ViewBag.BackUrl = "/Roles";
    ViewBag.BackText = "الرجوع للأدوار";
}

<partial name="_CreateEditHeader" />

<form method="post" action="@(isEdit ? $"/Roles/Edit/{Model.RoleId}" : "/Roles/Create")" class="max-w-2xl mx-auto">
    @Html.AntiForgeryToken()
    @if (isEdit) { <input type="hidden" name="RoleId" value="@Model.RoleId" /> }

    @if (ViewContext.ModelState.ErrorCount > 0)
    {
        <div asp-validation-summary="All" class="bg-red-50 border border-red-200 text-danger rounded-xl p-4 mb-6 font-semibold text-sm"></div>
    }

    <div class="card-premium">
        <div class="card-header">
            <div class="flex items-center gap-2">
                <span class="material-symbols-rounded text-primary">badge</span>
                <h3 class="font-bold text-ink text-base">البيانات الأساسية للدور</h3>
            </div>
        </div>
        <div class="card-body space-y-4">
            <div>
                <label class="form-label">اسم الدور الوظيفي *</label>
                <div class="input-wrapper">
                    <span class="material-symbols-rounded input-icon">badge</span>
                    <input type="text" name="RoleName" value="@Model.RoleName" class="form-input" required placeholder="مثال: منسق برامج" />
                </div>
            </div>
            <div>
                <label class="form-label">الوصف الوظيفي</label>
                <div class="input-wrapper">
                    <span class="material-symbols-rounded input-icon" style="top:1rem;transform:none">description</span>
                    <textarea name="RoleDescription" rows="5" class="form-input" placeholder="اكتب هنا وصفاً لمهام هذا الدور لتوضيح وظيفته للإدارة والموظفين…">@Model.RoleDescription</textarea>
                </div>
            </div>
        </div>
    </div>

    <div class="flex items-center justify-end gap-2 mt-6">
        <a href="/Roles" class="btn-secondary">
            <span class="material-symbols-rounded">cancel</span>
            إلغاء الأمر
        </a>
        <button type="submit" class="btn-primary">
            <span class="material-symbols-rounded">save</span>
            حفظ البيانات
        </button>
    </div>
</form>
