@model RoleDto
@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = Model.RoleId == 0 ? "إضافة دور جديد" : "تعديل بيانات الدور";
    var isEdit = Model.RoleId != 0;
    ViewBag.IsEdit = isEdit;
    ViewBag.Icon = isEdit ? "edit" : "add";
    ViewBag.Title = isEdit ? "تعديل بيانات الدور" : "إضافة دور جديد";
    ViewBag.Description = "إدخال وتحديث البيانات الأساسية للدور الوظيفي";
    ViewBag.EntityName = "الأدوار الوظيفية";
    ViewBag.EntityUrl = "/Roles";
    ViewBag.BackUrl = "/Roles";
    ViewBag.BackText = "الرجوع للأدوار";
}

<partial name="_PageHeader" />

<form method="post" action="@(isEdit ? $"/Roles/Edit/{Model.RoleId}" : "/Roles/Create")" class="max-w-2xl">
    @Html.AntiForgeryToken()
    @if (isEdit) { <input type="hidden" name="RoleId" value="@Model.RoleId" /> }

    @if (ViewContext.ModelState.ErrorCount > 0)
    {
        <div asp-validation-summary="All" class="rounded-xl p-4 mb-6 font-semibold text-sm bg-danger-subtle text-danger border border-danger-subtle"></div>
    }

    <div class="bg-surface border border-border rounded-2xl p-6" style="border-color:var(--color-border)">
        @{
            ViewBag.SectionIcon = "badge"; ViewBag.SectionTitle = "البيانات الأساسية للدور";
        }
        <partial name="_SectionHeader" />

        <div class="space-y-4">
            @{
                ViewBag.FieldLabel = "اسم الدور الوظيفي"; ViewBag.FieldName = "RoleName";
                ViewBag.FieldIcon = "badge"; ViewBag.FieldValue = Model.RoleName;
                ViewBag.FieldRequired = true; ViewBag.FieldPlaceholder = "مثال: منسق برامج";
            }
            <partial name="_FormField" />

            @{
                ViewBag.FieldLabel = "الوصف الوظيفي"; ViewBag.FieldName = "RoleDescription";
                ViewBag.FieldIcon = "description"; ViewBag.FieldValue = Model.RoleDescription;
                ViewBag.FieldType = "textarea"; ViewBag.FieldRows = "5";
                ViewBag.FieldPlaceholder = "اكتب هنا وصفاً لمهام هذا الدور لتوضيح وظيفته للإدارة والموظفين…";
            }
            <partial name="_FormField" />
        </div>
    </div>

    <div class="flex items-center justify-end gap-2 mt-6">
        <a href="/Roles" class="btn btn-ghost rounded-xl gap-2">
            <span class="material-symbols-rounded">cancel</span>إلغاء الأمر
        </a>
        <button type="submit" class="btn btn-primary rounded-xl gap-2">
            <span class="material-symbols-rounded">save</span>حفظ البيانات
        </button>
    </div>
</form>
