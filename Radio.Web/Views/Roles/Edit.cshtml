@model RoleDto
@{
    ViewData["Title"] = Model.RoleId == 0 ? "إضافة دور جديد" : "تعديل بيانات الدور";
    var isEdit = Model.RoleId != 0;
    ViewBag.IsEdit = isEdit;
    ViewBag.Icon = isEdit ? "edit" : "add";
    ViewBag.Title = isEdit ? "تعديل بيانات الدور" : "إضافة دور جديد";
    ViewBag.Description = "إدخال وتحديث البيانات الأساسية للدور الوظيفي";
    ViewBag.EntityName = "الأدوار الوظيفية";
    ViewBag.EntityUrl = "/Roles";
    ViewBag.BackUrl = "/Roles";
    ViewBag.BackText = "الرجوع للأدوار";
}

<partial name="_CreateEditHeader" />

<form method="post" action="@(isEdit ? $"/Roles/Edit/{Model.RoleId}" : "/Roles/Create")" class="max-w-2xl mx-auto">
    @Html.AntiForgeryToken()
    @if (isEdit) { <input type="hidden" name="RoleId" value="@Model.RoleId" /> }

    @if (ViewContext.ModelState.ErrorCount > 0)
    {
        <div asp-validation-summary="All" class="bg-error/10 border border-error/20 text-error rounded-xl p-4 mb-6 font-semibold text-sm"></div>
    }

    <div class="card bg-base-100 shadow-md">
        <div class="card-body space-y-4">
            <div class="flex items-center gap-2">
                <span class="material-symbols-rounded text-primary">badge</span>
                <h3 class="font-bold text-base-content text-base">البيانات الأساسية للدور</h3>
            </div>
            <div>
                <label class="label">اسم الدور الوظيفي *</label>
                <div class="relative">
                    <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-base-content/40 pointer-events-none text-lg">badge</span>
                    <input type="text" name="RoleName" value="@Model.RoleName" class="input input-bordered w-full pr-10 required placeholder="مثال: منسق برامج" />
                </div>
            </div>
            <div>
                <label class="label">الوصف الوظيفي</label>
                <div class="relative">
                    <span class="material-symbols-rounded absolute right-3 text-base-content/40 pointer-events-none text-lg" style="top:1rem;transform:none">description</span>
                    <textarea name="RoleDescription" rows="5" class="textarea textarea-bordered w-full pr-10" placeholder="اكتب هنا وصفاً لمهام هذا الدور لتوضيح وظيفته للإدارة والموظفين…">@Model.RoleDescription</textarea>
                </div>
            </div>
        </div>
    </div>

    <div class="flex items-center justify-end gap-2 mt-6">
        <a href="/Roles" class="btn btn-ghost">
            <span class="material-symbols-rounded">cancel</span>
            إلغاء الأمر
        </a>
        <button type="submit" class="btn btn-primary">
            <span class="material-symbols-rounded">save</span>
            حفظ البيانات
        </button>
    </div>
</form>
