@model RoleDto
@{
    ViewData["Title"] = Model.RoleId == 0 ? "دور جديد" : "تعديل دور";
    var isEdit = Model.RoleId != 0;
}

<div class="page-header">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 relative z-10">
        <div>
            <nav class="breadcrumb">
                <span class="material-symbols-rounded">home</span>
                <a href="/">الرئيسية</a>
                <span class="material-symbols-rounded">chevron_left</span>
                <a href="/Roles">الأدوار</a>
                <span class="material-symbols-rounded">chevron_left</span>
                <span>@(isEdit ? "تعديل دور" : "دور جديد")</span>
            </nav>
            <h1>
                <span class="material-symbols-rounded text-primary">@(isEdit ? "edit" : "add")</span>
                @(isEdit ? "تعديل دور" : "دور جديد")
            </h1>
            <p>إدخال وتحديث بيانات الدور الوظيفي والصلاحيات المرتبطة به</p>
        </div>
        <div class="flex items-center gap-2">
            <a href="/Roles" class="btn-secondary">
                <span class="material-symbols-rounded">arrow_forward</span>
                الرجوع للأدوار
            </a>
        </div>
    </div>
</div>

<form method="post" action="@(isEdit ? $"/Roles/Edit/{Model.RoleId}" : "/Roles/Create")" class="max-w-2xl">
    @Html.AntiForgeryToken()
    @if (isEdit) { <input type="hidden" name="RoleId" value="@Model.RoleId" /> }
    @if (ViewContext.ModelState.ErrorCount > 0)
    {
        <div asp-validation-summary="All" class="bg-red-50 border border-red-200 text-danger rounded-xl p-4 mb-6 font-semibold text-sm"></div>
    }

    <div class="card-premium">
        <div class="card-header">
            <div class="flex items-center gap-2">
                <span class="material-symbols-rounded text-primary">badge</span>
                <h3 class="font-bold text-ink text-base">بيانات الدور</h3>
            </div>
        </div>
        <div class="card-body space-y-4">
            <div>
                <label class="form-label">اسم الدور *</label>
                <div class="input-wrapper">
                    <span class="material-symbols-rounded input-icon">badge</span>
                    <input type="text" name="RoleName" value="@Model.RoleName" class="form-input" required placeholder="مثال: محرر محتوى" />
                </div>
            </div>
            <div>
                <label class="form-label">الوصف</label>
                <textarea name="RoleDescription" rows="4" class="form-input" placeholder="وصف مختصر لمهام وصلاحيات هذا الدور…">@Model.RoleDescription</textarea>
            </div>
        </div>
    </div>

    <div class="flex items-center justify-end gap-2 mt-6">
        <a href="/Roles" class="btn-secondary">
            <span class="material-symbols-rounded">cancel</span>
            إلغاء
        </a>
        <button type="submit" class="btn-primary">
            <span class="material-symbols-rounded">save</span>
            حفظ
        </button>
    </div>
</form>
