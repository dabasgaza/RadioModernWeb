@model List<RoleDto>
@{
    ViewData["Title"] = "إدارة الأدوار الوظيفية";
}

<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
    <div>
        <div class="breadcrumbs text-sm text-base-content/60">
            <ul>
                <li><a href="/" class="inline-flex items-center gap-1"><span class="material-symbols-rounded text-lg">home</span>الرئيسية</a></li>
                <li><span class="inline-flex items-center gap-1"><span class="material-symbols-rounded text-lg">group_work</span>الأدوار الوظيفية</span></li>
            </ul>
        </div>
        <h1 class="text-2xl font-extrabold text-base-content mt-1 flex items-center gap-2">
            <span class="material-symbols-rounded text-primary">group_work</span>
            الأدوار الوظيفية
        </h1>
        <p class="text-sm text-base-content/60 mt-0.5">إدارة مجموعات صلاحيات المستخدمين والتحكم في مستويات الوصول للنظام</p>
    </div>
    <div class="flex items-center gap-3">
        @if (User.HasPermission(AppPermissions.UserManage))
        {
            <a href="/Roles/Create" class="btn btn-primary py-3 px-5 rounded-2xl font-bold flex items-center gap-2 transition-all duration-300 hover:-translate-y-0.5">
                <span class="material-symbols-rounded">add</span>
                إضافة دور جديد
            </a>
        }
    </div>
</div>

<div class="card bg-base-100 shadow-md mb-6">
    <div class="card-body">
        <div class="flex flex-col md:flex-row gap-4 items-center">
            <div class="relative w-full">
                <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-base-content/40">search</span>
                <input type="text" id="roleSearch" placeholder="بحث باسم الدور أو الوصف..." class="input input-bordered w-full pr-10" />
            </div>
            <div class="text-xs font-bold text-base-content/60 whitespace-nowrap shrink-0">
                إجمالي الأدوار: <span class="text-primary" id="roleCount">@Model.Count</span>
            </div>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card bg-base-100 shadow-md"><div class="card-body text-center py-16">
        <span class="material-symbols-rounded text-4xl text-base-content/30 mb-2">group_work</span>
        <h3 class="font-bold text-lg mb-2">لا توجد أدوار وظيفية</h3>
        <p class="text-sm text-base-content/60 max-w-sm mx-auto">لم يتم إنشاء أي أدوار وظيفية في النظام بعد. ابدأ بإضافة أول دور لتخصيص الصلاحيات.</p>
        @if (User.HasPermission(AppPermissions.UserManage))
        {
            <div class="mt-6">
                <a href="/Roles/Create" class="btn btn-primary py-3 px-6 rounded-2xl inline-flex items-center gap-2">
                    <span class="material-symbols-rounded">add</span>
                    إضافة دور جديد
                </a>
            </div>
        }
    </div></div>
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="rolesGrid">
        @foreach (var r in Model)
        {
            var isAdmin = string.Equals(r.RoleName, "Admin", StringComparison.OrdinalIgnoreCase);
            <div class="role-card card bg-base-100 shadow-md hover:border-primary/30 rounded-3xl hover:shadow-2xl hover:shadow-primary/5 transition-all duration-300 group flex flex-col justify-between" 
                 data-name="@r.RoleName" data-desc="@r.RoleDescription">
                
                <div class="p-6">
                    <div class="flex items-start justify-between mb-4">
                        <div class="flex items-center gap-3">
                            <div class="w-12 h-12 rounded-2xl bg-primary/5 text-primary flex items-center justify-center font-bold text-lg shadow-inner group-hover:bg-primary group-hover:text-white transition-all duration-300">
                                @r.RoleName.Substring(0, Math.Min(2, r.RoleName.Length)).ToUpper()
                            </div>
                            <div>
                                <h3 class="font-extrabold text-base-content text-base group-hover:text-primary transition-colors">@r.RoleName</h3>
                                <span class="text-[10px] uppercase tracking-wider font-bold text-base-content/60">معرف الدور: #@r.RoleId</span>
                            </div>
                        </div>
                        @if (isAdmin)
                        {
                            <span class="bg-primary/10 text-primary py-1 px-3 rounded-full text-xs font-bold border border-primary/20 flex items-center gap-1">
                                <span class="material-symbols-rounded text-sm">security</span>
                                مدير النظام
                            </span>
                        }
                    </div>

                    <p class="text-xs text-base-content/60 leading-relaxed line-clamp-3 mb-6 min-h-[4rem]">
                        @(r.RoleDescription ?? "لا يوجد وصف مخصص لهذا الدور الوظيفي بعد. يمكنك إضافة وصف لتعريف مهام الدور بشكل أوضح.")
                    </p>

                    <div class="border-t border-base-200/40 pt-4 mt-4">
                        <div class="flex items-center justify-between text-xs">
                            <span class="text-base-content/60 flex items-center gap-1">
                                <span class="material-symbols-rounded text-sm">key</span>
                                التحكم:
                            </span>
                            <a href="/Permissions?roleId=@r.RoleId" class="text-primary font-bold hover:underline flex items-center gap-1 transition-all">
                                <span class="material-symbols-rounded text-xs">settings</span>
                                إدارة الصلاحيات المخصصة
                            </a>
                        </div>
                    </div>
                </div>

                <div class="px-6 py-4 bg-base-200 border-t border-base-200/40 flex items-center justify-between gap-2">
                    <div class="flex items-center gap-1">
                        @if (User.HasPermission(AppPermissions.UserManage))
                        {
                            <a href="/Roles/Clone/@r.RoleId" class="inline-flex items-center justify-center w-9 h-9 rounded-lg border-0 bg-transparent transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-1 text-ink-muted hover:bg-surface-3 hover:text-ink focus-visible:ring-ink-soft" title="نسخ الدور وصلاحياته" aria-label="نسخ الدور وصلاحياته">
                                <span class="material-symbols-rounded text-xl leading-none">content_copy</span>
                            </a>
                            @if (!isAdmin)
                            {
                                <a href="/Roles/Edit/@r.RoleId" class="inline-flex items-center justify-center w-9 h-9 rounded-lg border-0 bg-transparent transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-1 text-primary hover:bg-primary/10" title="تعديل بيانات الدور" aria-label="تعديل بيانات الدور">
                                    <span class="material-symbols-rounded text-xl leading-none">edit</span>
                                </a>
                            }
                        }
                    </div>
                    @if (User.HasPermission(AppPermissions.UserManage) && !isAdmin)
                    {
                        <form method="post" action="/Roles/Delete/@r.RoleId" class="inline" data-confirm="هل أنت متأكد من حذف هذا الدور «@r.RoleName» نهائياً؟ لا يمكن التراجع عن هذا الإجراء وسيتم سحب صلاحيات جميع الموظفين المرتبطين به.">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="inline-flex items-center justify-center w-9 h-9 rounded-lg border-0 bg-transparent transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-1 text-danger hover:bg-danger/10 hover:text-danger focus-visible:ring-danger" title="حذف الدور" aria-label="حذف الدور">
                                <span class="material-symbols-rounded text-xl leading-none">delete</span>
                            </button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
}

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const searchInput = document.getElementById('roleSearch');
        if (searchInput) {
            searchInput.addEventListener('input', function () {
                const query = this.value.toLowerCase().trim();
                const cards = document.querySelectorAll('.role-card');
                let visibleCount = 0;

                cards.forEach(card => {
                    const name = card.getAttribute('data-name').toLowerCase();
                    const desc = card.getAttribute('data-desc').toLowerCase();
                    if (name.includes(query) || desc.includes(query)) {
                        card.style.display = '';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                    }
                });

                document.getElementById('roleCount').textContent = visibleCount;
            });
        }
    });
</script>
