@model List<RoleDto>
@{
    ViewData["Title"] = "إدارة الأدوار الوظيفية";
    ViewData["HeaderIcon"] = "shield";
    ViewData["HeaderDescription"] = "إدارة مجموعات صلاحيات المستخدمين والتحكم في مستويات الوصول للنظام";
    ViewBag.EntityName = "الأدوار الوظيفية";

    if (User.HasPermission(AppPermissions.UserManage))
    {
        ViewData["HeaderActions"] = "<a href='/Roles/Create' class='btn btn-primary rounded-xl gap-2'><span class='material-symbols-rounded'>add</span>إضافة دور جديد</a>";
    }
}

<partial name="_PageHeader" />

<div class="card p-4 mb-8">
    <div class="flex flex-col md:flex-row gap-4 items-center justify-between">
        <div class="w-full md:w-auto flex-1">
            @{
                ViewBag.SearchValue = "";
                ViewBag.SearchPlaceholder = "ابحث عن دور...";
                ViewBag.SearchHideCard = true;
            }
            <partial name="_SearchBar" />
        </div>
        <div class="text-xs font-semibold text-text-secondary whitespace-nowrap shrink-0">
            إجمالي الأدوار: <span class="font-bold text-primary" id="roleCount">@Model.Count</span>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    ViewBag.EmptyIcon = "group_work";
    ViewBag.EmptyTitle = "لا توجد أدوار وظيفية";
    ViewBag.EmptyDesc = "لم يتم إنشاء أي أدوار وظيفية في النظام بعد. ابدأ بإضافة أول دور لتخصيص الصلاحيات.";
    ViewBag.EmptyActionUrl = User.HasPermission(AppPermissions.UserManage) ? "/Roles/Create" : null;
    ViewBag.EmptyActionText = "إضافة دور جديد";
    ViewBag.EmptyActionIcon = "add";
    <partial name="_EmptyState" />
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="rolesGrid">
        @foreach (var r in Model)
        {
            var isAdmin = string.Equals(r.RoleName, "Admin", StringComparison.OrdinalIgnoreCase);
            <div class="card card-interactive flex flex-col justify-between overflow-hidden"
                 data-name="@r.RoleName" data-desc="@r.RoleDescription">

                <div class="p-6">
                    <div class="flex items-start justify-between mb-4">
                        <div class="flex items-center gap-3">
                            <div class="w-11 h-11 rounded-xl bg-primary-subtle text-primary flex items-center justify-center font-bold text-sm shrink-0">
                                @r.RoleName.Substring(0, Math.Min(2, r.RoleName.Length)).ToUpper()
                            </div>
                            <div>
                                <h3 class="font-bold text-body text-text">@r.RoleName</h3>
                                <span class="text-caption text-text-muted">معرف الدور: #@r.RoleId</span>
                            </div>
                        </div>
                        @if (isAdmin)
                        {
                            <span class="badge badge-primary gap-1">
                                <span class="material-symbols-rounded text-sm">security</span>
                                مدير النظام
                            </span>
                        }
                    </div>

                    <p class="text-caption text-text-secondary leading-relaxed line-clamp-3 mb-5 min-h-[4rem]">
                        @(r.RoleDescription ?? "لا يوجد وصف مخصص لهذا الدور الوظيفي بعد. يمكنك إضافة وصف لتعريف مهام الدور بشكل أوضح.")
                    </p>

                    <div class="pt-4 border-t border-border-light">
                        <div class="flex items-center justify-between text-caption">
                            <span class="flex items-center gap-1 text-text-muted">
                                <span class="material-symbols-rounded text-sm">key</span>
                                التحكم:
                            </span>
                            <a href="/Permissions?roleId=@r.RoleId" class="font-semibold text-primary hover:underline flex items-center gap-1">
                                <span class="material-symbols-rounded text-sm">settings</span>
                                إدارة الصلاحيات المخصصة
                            </a>
                        </div>
                    </div>
                </div>

                <div class="px-6 py-3.5 flex items-center justify-between gap-2 border-t border-border-light bg-surface-hover/50">
                    <div class="flex items-center gap-1">
                        @if (User.HasPermission(AppPermissions.UserManage))
                        {
                            <a href="/Roles/Clone/@r.RoleId" class="btn btn-icon btn-sm btn-ghost text-text-secondary hover:text-text" title="نسخ الدور وصلاحياته" aria-label="نسخ الدور وصلاحياته">
                                <span class="material-symbols-rounded text-lg">content_copy</span>
                            </a>
                            @if (!isAdmin)
                            {
                                <a href="/Roles/Edit/@r.RoleId" class="btn btn-icon btn-sm btn-ghost text-primary" title="تعديل بيانات الدور" aria-label="تعديل بيانات الدور">
                                    <span class="material-symbols-rounded text-lg">edit</span>
                                </a>
                            }
                        }
                    </div>
                    @if (User.HasPermission(AppPermissions.UserManage) && !isAdmin)
                    {
                        <form method="post" action="/Roles/Delete/@r.RoleId" class="inline" data-confirm="هل أنت متأكد من حذف هذا الدور «@r.RoleName» نهائياً؟ لا يمكن التراجع عن هذا الإجراء وسيتم سحب صلاحيات جميع الموظفين المرتبطين به.">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-icon btn-sm btn-ghost text-danger" title="حذف الدور" aria-label="حذف الدور">
                                <span class="material-symbols-rounded text-lg">delete</span>
                            </button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
}

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const searchInput = document.querySelector('input[name="search"]');
        if (searchInput) {
            const searchForm = searchInput.closest('form');
            if (searchForm) {
                searchForm.addEventListener('submit', function (e) {
                    e.preventDefault();
                });
            }
            searchInput.addEventListener('input', function () {
                const query = this.value.toLowerCase().trim();
                const cards = document.querySelectorAll('[data-name]');
                let visibleCount = 0;

                cards.forEach(card => {
                    const name = card.getAttribute('data-name')?.toLowerCase() || '';
                    const desc = card.getAttribute('data-desc')?.toLowerCase() || '';
                    if (name.includes(query) || desc.includes(query)) {
                        card.style.display = '';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                    }
                });

                document.getElementById('roleCount').textContent = visibleCount;
            });
        }
    });
</script>
