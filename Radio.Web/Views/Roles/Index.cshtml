@model List<RoleDto>
@{
    ViewData["Title"] = "إدارة الأدوار الوظيفية";
    ViewData["HeaderIcon"] = "shield";
    ViewData["HeaderDescription"] = "إدارة مجموعات صلاحيات المستخدمين والتحكم في مستويات الوصول للنظام";
    ViewBag.EntityName = "الأدوار الوظيفية";

    if (User.HasPermission(AppPermissions.UserManage))
    {
        ViewData["HeaderActions"] = "<a href='/Roles/Create' class='btn btn-primary rounded-xl gap-2'><span class='material-symbols-rounded'>add</span>إضافة دور جديد</a>";
    }
}

<partial name="_PageHeader" />

<div class="wf-card p-4 mb-8">
    <div class="flex flex-col md:flex-row gap-4 items-center">
        <div class="relative w-full">
            <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-lg" style="color: var(--color-text-tertiary);">search</span>
            <input type="text" id="roleSearch" placeholder="بحث باسم الدور أو الوصف..."
                   class="w-full h-10 rounded-lg pr-10 pl-3 text-sm font-medium focus:outline-none focus:border-[var(--color-primary)] focus:ring-2 transition-all"
                   style="background: var(--color-surface-3); border: 1px solid var(--color-border); color: var(--color-text);" />
        </div>
        <div class="text-xs font-medium whitespace-nowrap shrink-0" style="color: var(--color-text-tertiary);">
            إجمالي الأدوار: <span class="font-bold" style="color: var(--color-primary);" id="roleCount">@Model.Count</span>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <partial name="_EmptyState" model='new { Icon = "group_work", Title = "لا توجد أدوار وظيفية", Description = "لم يتم إنشاء أي أدوار وظيفية في النظام بعد. ابدأ بإضافة أول دور لتخصيص الصلاحيات.", ActionUrl = User.HasPermission(AppPermissions.UserManage) ? "/Roles/Create" : null, ActionText = "إضافة دور جديد", ActionIcon = "add" }' />
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="rolesGrid">
        @foreach (var r in Model)
        {
            var isAdmin = string.Equals(r.RoleName, "Admin", StringComparison.OrdinalIgnoreCase);
            <div class="wf-card hover:shadow-md transition-all group flex flex-col justify-between"
                 data-name="@r.RoleName" data-desc="@r.RoleDescription"
                 style="--hover-border: var(--color-primary);">

                <div class="p-5">
                    <div class="flex items-start justify-between mb-4">
                        <div class="flex items-center gap-3">
                            <div class="w-11 h-11 rounded-xl flex items-center justify-center font-bold text-sm shrink-0 transition-all"
                                 style="background: var(--color-primary-light); color: var(--color-primary);">
                                @r.RoleName.Substring(0, Math.Min(2, r.RoleName.Length)).ToUpper()
                            </div>
                            <div>
                                <h3 class="font-bold text-sm transition-colors" style="color: var(--color-text);">@r.RoleName</h3>
                                <span class="text-[10px] font-medium" style="color: var(--color-text-tertiary);">معرف الدور: #@r.RoleId</span>
                            </div>
                        </div>
                        @if (isAdmin)
                        {
                            <span class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-semibold rounded-full"
                                  style="background: var(--color-primary-light); color: var(--color-primary); border: 1px solid var(--color-primary);">
                                <span class="material-symbols-rounded text-sm">security</span>
                                مدير النظام
                            </span>
                        }
                    </div>

                    <p class="text-xs leading-relaxed line-clamp-3 mb-5 min-h-[4rem]" style="color: var(--color-text-tertiary);">
                        @(r.RoleDescription ?? "لا يوجد وصف مخصص لهذا الدور الوظيفي بعد. يمكنك إضافة وصف لتعريف مهام الدور بشكل أوضح.")
                    </p>

                    <div class="pt-4" style="border-top: 1px solid var(--color-border);">
                        <div class="flex items-center justify-between text-xs">
                            <span class="flex items-center gap-1" style="color: var(--color-text-tertiary);">
                                <span class="material-symbols-rounded text-sm">key</span>
                                التحكم:
                            </span>
                            <a href="/Permissions?roleId=@r.RoleId" class="font-semibold hover:underline flex items-center gap-1 transition-colors"
                               style="color: var(--color-primary);">
                                <span class="material-symbols-rounded text-sm">settings</span>
                                إدارة الصلاحيات المخصصة
                            </a>
                        </div>
                    </div>
                </div>

                <div class="px-5 py-3 flex items-center justify-between gap-2" style="border-top: 1px solid var(--color-border); background: var(--color-bg);">
                    <div class="flex items-center gap-1">
                        @if (User.HasPermission(AppPermissions.UserManage))
                        {
                            <a href="/Roles/Clone/@r.RoleId" class="p-2 rounded-lg transition-colors" style="color: var(--color-text-3);" title="نسخ الدور وصلاحياته" aria-label="نسخ الدور وصلاحياته"
                               onmouseover="this.style.background='var(--color-surface-3)'; this.style.color='var(--color-text)'" onmouseout="this.style.background='transparent'; this.style.color='var(--color-text-3)'">
                                <span class="material-symbols-rounded text-lg">content_copy</span>
                            </a>
                            @if (!isAdmin)
                            {
                                <a href="/Roles/Edit/@r.RoleId" class="p-2 rounded-lg transition-colors" style="color: var(--color-text-3);" title="تعديل بيانات الدور" aria-label="تعديل بيانات الدور"
                                   onmouseover="this.style.background='var(--color-primary-light)'; this.style.color='var(--color-primary)'" onmouseout="this.style.background='transparent'; this.style.color='var(--color-text-3)'">
                                    <span class="material-symbols-rounded text-lg">edit</span>
                                </a>
                            }
                        }
                    </div>
                    @if (User.HasPermission(AppPermissions.UserManage) && !isAdmin)
                    {
                        <form method="post" action="/Roles/Delete/@r.RoleId" class="inline" data-confirm="هل أنت متأكد من حذف هذا الدور «@r.RoleName» نهائياً؟ لا يمكن التراجع عن هذا الإجراء وسيتم سحب صلاحيات جميع الموظفين المرتبطين به.">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="p-2 rounded-lg transition-colors" style="color: var(--color-text-3);" title="حذف الدور" aria-label="حذف الدور"
                                    onmouseover="this.style.background='var(--color-danger-container)'; this.style.color='var(--color-danger)'" onmouseout="this.style.background='transparent'; this.style.color='var(--color-text-3)'">
                                <span class="material-symbols-rounded text-lg">delete</span>
                            </button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
}

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const searchInput = document.getElementById('roleSearch');
        if (searchInput) {
            searchInput.addEventListener('input', function () {
                const query = this.value.toLowerCase().trim();
                const cards = document.querySelectorAll('.role-card, [data-name]');
                let visibleCount = 0;

                cards.forEach(card => {
                    const name = card.getAttribute('data-name')?.toLowerCase() || '';
                    const desc = card.getAttribute('data-desc')?.toLowerCase() || '';
                    if (name.includes(query) || desc.includes(query)) {
                        card.style.display = '';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                    }
                });

                document.getElementById('roleCount').textContent = visibleCount;
            });
        }
    });
</script>
