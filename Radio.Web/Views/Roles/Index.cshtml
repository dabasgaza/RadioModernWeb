@model List<RoleDto>
@{ ViewData["Title"] = "الأدوار"; }

<div class="page-header">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 relative z-10">
        <div>
            <nav class="breadcrumb">
                <a href="/">الرئيسية</a>
                <span class="material-icons">chevron_left</span>
                <span>الأدوار</span>
            </nav>
            <h1>
                <span class="material-icons">group_work</span>
                الأدوار
            </h1>
            <p>إدارة أدوار المستخدمين وصلاحياتهم</p>
        </div>
        @if (User.HasPermission(AppPermissions.UserManage))
        {
            <a href="/Roles/Create" class="btn-primary"><span class="material-icons">add</span> دور جديد</a>
        }
    </div>
</div>

<div class="table-premium">
    <div class="overflow-x-auto">
        <table>
            <thead>
                <tr>
                    <th>الدور</th>
                    <th>الوصف</th>
                    <th>الصلاحيات</th>
                    <th>إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr class="hover:bg-surface-2 transition duration-200">
                        <td class="font-bold text-ink">@r.RoleName</td>
                        <td class="text-ink-muted">@(r.RoleDescription ?? "—")</td>
                        <td>
                            <a href="/Permissions?roleId=@r.RoleId" class="text-primary font-bold text-sm hover:underline inline-flex items-center gap-1">
                                <span class="material-icons text-sm">security</span>
                                إدارة الصلاحيات
                            </a>
                        </td>
                        <td>
                            @if (User.HasPermission(AppPermissions.UserManage) && !string.Equals(r.RoleName, "Admin", StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="flex items-center gap-1">
                                    <a href="/Roles/Edit/@r.RoleId" class="icon-btn icon-btn-primary"><span class="material-icons">edit</span></a>
                                    <form method="post" action="/Roles/Delete/@r.RoleId" class="inline" onsubmit="return confirm('حذف الدور «@r.RoleName»؟');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="icon-btn icon-btn-danger"><span class="material-icons">delete</span></button>
                                    </form>
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
