@model List<RoleDto>
@{
    ViewData["Title"] = "إدارة الأدوار الوظيفية";
}

<div class="page-header relative overflow-hidden rounded-3xl bg-gradient-to-r from-primary/10 via-primary/5 to-transparent p-8 mb-8 border border-primary/10">
    <div class="absolute inset-0 bg-grid-slate-900/[0.04] bg-[size:20px_20px] pointer-events-none"></div>
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6 relative z-10">
        <div>
            <nav class="breadcrumb flex items-center gap-1.5 text-xs text-ink-muted mb-3">
                <span class="material-symbols-rounded text-sm">home</span>
                <a href="/" class="hover:text-primary transition-colors">الرئيسية</a>
                <span class="material-symbols-rounded text-xs select-none">chevron_left</span>
                <span class="text-ink">الأدوار الوظيفية</span>
            </nav>
            <h1 class="text-3xl font-black text-ink flex items-center gap-3 tracking-tight">
                <span class="material-symbols-rounded p-2.5 bg-primary/10 text-primary rounded-2xl shadow-inner-sm">group_work</span>
                الأدوار الوظيفية
            </h1>
            <p class="text-sm text-ink-muted mt-2">إدارة مجموعات صلاحيات المستخدمين والتحكم في مستويات الوصول للنظام</p>
        </div>
        <div class="flex items-center gap-3">
            @if (User.HasPermission(AppPermissions.UserManage))
            {
                <a href="/Roles/Create" class="btn-primary py-3 px-5 rounded-2xl font-bold flex items-center gap-2 shadow-lg shadow-primary/20 hover:shadow-xl hover:shadow-primary/30 transition-all duration-300 hover:-translate-y-0.5">
                    <span class="material-symbols-rounded">add</span>
                    إضافة دور جديد
                </a>
            }
        </div>
    </div>
</div>

<div class="mb-6 flex flex-col md:flex-row gap-4 items-center justify-between">
    <div class="relative w-full md:w-96">
        <span class="material-symbols-rounded absolute right-4 top-1/2 -translate-y-1/2 text-ink-muted">search</span>
        <input type="text" id="roleSearch" placeholder="بحث باسم الدور أو الوصف..." 
               class="form-input pr-12 pl-4 py-3 rounded-2xl w-full border border-border/80 focus:border-primary/50 focus:ring-4 focus:ring-primary/10 transition-all" />
    </div>
    <div class="text-xs font-bold text-ink-muted bg-surface-2 py-2 px-4 rounded-xl border border-border/60">
        إجمالي الأدوار: <span class="text-primary text-sm font-black" id="roleCount">@Model.Count</span>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card-premium p-16 text-center border-dashed rounded-3xl">
        <div class="w-20 h-20 bg-primary/5 text-primary rounded-full flex items-center justify-center mx-auto mb-6 shadow-inner">
            <span class="material-symbols-rounded text-4xl">group_work</span>
        </div>
        <h3 class="text-xl font-bold text-ink mb-2">لا توجد أدوار وظيفية</h3>
        <p class="text-sm text-ink-muted max-w-sm mx-auto mb-6">لم يتم إنشاء أي أدوار وظيفية في النظام بعد. ابدأ بإضافة أول دور لتخصيص الصلاحيات.</p>
        @if (User.HasPermission(AppPermissions.UserManage))
        {
            <a href="/Roles/Create" class="btn-primary py-3 px-6 rounded-2xl inline-flex items-center gap-2">
                <span class="material-symbols-rounded">add</span>
                إضافة دور جديد
            </a>
        }
    </div>
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="rolesGrid">
        @foreach (var r in Model)
        {
            var isAdmin = string.Equals(r.RoleName, "Admin", StringComparison.OrdinalIgnoreCase);
            <div class="role-card card-premium overflow-hidden border border-border/60 hover:border-primary/30 rounded-3xl hover:shadow-2xl hover:shadow-primary/5 transition-all duration-300 group flex flex-col justify-between" 
                 data-name="@r.RoleName" data-desc="@r.RoleDescription">
                
                <div class="p-6">
                    <div class="flex items-start justify-between mb-4">
                        <div class="flex items-center gap-3">
                            <div class="w-12 h-12 rounded-2xl bg-primary/5 text-primary flex items-center justify-center font-bold text-lg shadow-inner group-hover:bg-primary group-hover:text-white transition-all duration-300">
                                @r.RoleName.Substring(0, Math.Min(2, r.RoleName.Length)).ToUpper()
                            </div>
                            <div>
                                <h3 class="font-extrabold text-ink text-base group-hover:text-primary transition-colors">@r.RoleName</h3>
                                <span class="text-[10px] uppercase tracking-wider font-bold text-ink-muted">معرف الدور: #@r.RoleId</span>
                            </div>
                        </div>
                        @if (isAdmin)
                        {
                            <span class="badge bg-primary/10 text-primary py-1 px-3 rounded-full text-xs font-bold border border-primary/20 flex items-center gap-1">
                                <span class="material-symbols-rounded text-sm">security</span>
                                مدير النظام
                            </span>
                        }
                    </div>

                    <p class="text-xs text-ink-muted leading-relaxed line-clamp-3 mb-6 min-h-[4rem]">
                        @(r.RoleDescription ?? "لا يوجد وصف مخصص لهذا الدور الوظيفي بعد. يمكنك إضافة وصف لتعريف مهام الدور بشكل أوضح.")
                    </p>

                    <div class="border-t border-border/40 pt-4 mt-4">
                        <div class="flex items-center justify-between text-xs">
                            <span class="text-ink-muted flex items-center gap-1">
                                <span class="material-symbols-rounded text-sm">key</span>
                                التحكم:
                            </span>
                            <a href="/Permissions?roleId=@r.RoleId" class="text-primary font-bold hover:underline flex items-center gap-1 transition-all">
                                <span class="material-symbols-rounded text-xs">settings</span>
                                إدارة الصلاحيات المخصصة
                            </a>
                        </div>
                    </div>
                </div>

                <div class="px-6 py-4 bg-surface-2 border-t border-border/40 flex items-center justify-between gap-2">
                    <div class="flex items-center gap-1.5">
                        @if (User.HasPermission(AppPermissions.UserManage))
                        {
                            <a href="/Roles/Clone/@r.RoleId" class="icon-btn bg-white dark:bg-slate-800 text-ink border border-border/80 hover:bg-primary/5 hover:text-primary rounded-xl" title="نسخ الدور وصلاحياته">
                                <span class="material-symbols-rounded text-base">content_copy</span>
                            </a>
                            @if (!isAdmin)
                            {
                                <a href="/Roles/Edit/@r.RoleId" class="icon-btn bg-white dark:bg-slate-800 text-ink border border-border/80 hover:bg-primary/5 hover:text-primary rounded-xl" title="تعديل بيانات الدور">
                                    <span class="material-symbols-rounded text-base">edit</span>
                                </a>
                            }
                        }
                    </div>
                    @if (User.HasPermission(AppPermissions.UserManage) && !isAdmin)
                    {
                        <form method="post" action="/Roles/Delete/@r.RoleId" class="inline" data-confirm="هل أنت متأكد من حذف هذا الدور «@r.RoleName» نهائياً؟ لا يمكن التراجع عن هذا الإجراء وسيتم سحب صلاحيات جميع الموظفين المرتبطين به.">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="icon-btn bg-white dark:bg-slate-800 text-danger border border-border/80 hover:bg-danger/5 hover:border-danger/20 rounded-xl" title="حذف الدور">
                                <span class="material-symbols-rounded text-base">delete</span>
                            </button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
}

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const searchInput = document.getElementById('roleSearch');
        if (searchInput) {
            searchInput.addEventListener('input', function () {
                const query = this.value.toLowerCase().trim();
                const cards = document.querySelectorAll('.role-card');
                let visibleCount = 0;

                cards.forEach(card => {
                    const name = card.getAttribute('data-name').toLowerCase();
                    const desc = card.getAttribute('data-desc').toLowerCase();
                    if (name.includes(query) || desc.includes(query)) {
                        card.style.display = '';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                    }
                });

                document.getElementById('roleCount').textContent = visibleCount;
            });
        }
    });
</script>
