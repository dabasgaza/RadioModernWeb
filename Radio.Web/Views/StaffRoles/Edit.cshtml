@model StaffRoleDto
@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = Model.StaffRoleId == 0 ? "دور جديد" : "تعديل دور";
    var isEdit = Model.StaffRoleId != 0;
    ViewBag.IsEdit = isEdit;
    ViewBag.Icon = isEdit ? "edit" : "add";
    ViewBag.Title = isEdit ? "تعديل بيانات الدور" : "إضافة دور وظيفي جديد";
    ViewBag.Description = "إدخال وتحديث بيانات المسمى الوظيفي لطاقم العمل";
    ViewBag.EntityName = "المسميات الوظيفية";
    ViewBag.EntityUrl = "/StaffRoles";
    ViewBag.BackUrl = "/StaffRoles";
    ViewBag.BackText = "الرجوع للمسميات";
}

<partial name="_PageHeader" />

<form method="post" action="@(isEdit ? $"/StaffRoles/Edit/{Model.StaffRoleId}" : "/StaffRoles/Create")" class="max-w-lg">
    @Html.AntiForgeryToken()
    @if (isEdit) { <input type="hidden" name="StaffRoleId" value="@Model.StaffRoleId" /> }

    @if (ViewContext.ModelState.ErrorCount > 0)
    {
        <div asp-validation-summary="All" class="rounded-xl p-4 mb-6 font-semibold text-sm bg-danger-subtle text-danger border border-danger-subtle"></div>
    }

    <div class="bg-surface border border-border rounded-2xl p-6" style="border-color:var(--color-border)">
        @{
            ViewBag.SectionIcon = "badge"; ViewBag.SectionTitle = "بيانات الدور";
        }
        <partial name="_SectionHeader" />

        @{
            ViewBag.FieldLabel = "اسم الدور"; ViewBag.FieldName = "RoleName";
            ViewBag.FieldIcon = "badge"; ViewBag.FieldValue = Model.RoleName;
            ViewBag.FieldRequired = true; ViewBag.FieldPlaceholder = "مثال: مخرج";
        }
        <partial name="_FormField" />
    </div>

    <div class="flex items-center justify-center gap-2 mt-6">
        <a href="/StaffRoles" class="btn btn-ghost rounded-xl gap-2">
            <span class="material-symbols-rounded">cancel</span>إلغاء
        </a>
        <button type="submit" class="btn btn-primary rounded-xl gap-2">
            <span class="material-symbols-rounded">save</span>حفظ
        </button>
    </div>
</form>
