@model StaffRoleDto
@{
    ViewData["Title"] = Model.StaffRoleId == 0 ? "دور جديد" : "تعديل دور";
    var isEdit = Model.StaffRoleId != 0;
}

<div class="mb-6">
    <nav class="text-sm text-ink-muted mb-2">
        <a href="/StaffRoles" class="hover:text-primary">المسميات الوظيفية</a>
        <span class="mx-1">/</span>
        <span class="text-ink">@(isEdit ? "تعديل" : "جديد")</span>
    </nav>
    <h1 class="text-2xl font-bold text-ink flex items-center gap-2">
        <span class="material-symbols-rounded text-primary">@(isEdit ? "edit" : "add")</span>
        @(isEdit ? "تعديل دور" : "دور جديد")
    </h1>
</div>

<form method="post" action="@(isEdit ? $"/StaffRoles/Edit/{Model.StaffRoleId}" : "/StaffRoles/Create")" class="max-w-md">
    @Html.AntiForgeryToken()
    @if (isEdit) { <input type="hidden" name="StaffRoleId" value="@Model.StaffRoleId" /> }
    @if (ViewContext.ModelState.ErrorCount > 0)
    {
        <div asp-validation-summary="All" class="bg-red-50 border border-red-200 text-danger rounded-lg p-3 mb-4"></div>
    }

    <div class="bg-surface rounded-xl border border-border p-5">
        <label class="form-label">اسم الدور *</label>
        <input type="text" name="RoleName" value="@Model.RoleName" class="form-input" required />
    </div>

    <div class="flex items-center justify-end gap-2 mt-4">
        <a href="/StaffRoles" class="btn-secondary"><span class="material-symbols-rounded">cancel</span> إلغاء</a>
        <button type="submit" class="btn-primary"><span class="material-symbols-rounded">save</span> حفظ</button>
    </div>
</form>
