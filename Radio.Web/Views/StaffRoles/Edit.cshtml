@model StaffRoleDto
@{
    ViewData["Title"] = Model.StaffRoleId == 0 ? "دور جديد" : "تعديل دور";
    var isEdit = Model.StaffRoleId != 0;
    ViewBag.IsEdit = isEdit;
    ViewBag.Icon = isEdit ? "edit" : "add";
    ViewBag.Title = isEdit ? "تعديل بيانات الدور" : "إضافة دور وظيفي جديد";
    ViewBag.Description = "إدخال وتحديث بيانات المسمى الوظيفي لطاقم العمل";
    ViewBag.EntityName = "المسميات الوظيفية";
    ViewBag.EntityUrl = "/StaffRoles";
    ViewBag.BackUrl = "/StaffRoles";
    ViewBag.BackText = "الرجوع للمسميات";
}

<partial name="_CreateEditHeader" />

<form method="post" action="@(isEdit ? $"/StaffRoles/Edit/{Model.StaffRoleId}" : "/StaffRoles/Create")" class="max-w-lg mx-auto">
    @Html.AntiForgeryToken()
    @if (isEdit) { <input type="hidden" name="StaffRoleId" value="@Model.StaffRoleId" /> }

    @if (ViewContext.ModelState.ErrorCount > 0)
    {
        <div asp-validation-summary="All" class="bg-error/10 border border-error/20 text-error rounded-xl p-4 mb-6 font-semibold text-sm"></div>
    }

    <div class="card bg-base-100 shadow-md">
        <div class="card-body">
            <div class="flex items-center gap-2 mb-4">
                <span class="material-symbols-rounded text-primary">badge</span>
                <h3 class="font-bold text-base-content text-base">بيانات الدور</h3>
            </div>
            <div>
                <label class="label">اسم الدور *</label>
                <div class="relative">
                    <span class="material-symbols-rounded absolute right-3 top-1/2 -translate-y-1/2 text-base-content/40 pointer-events-none text-lg">badge</span>
                    <input type="text" name="RoleName" value="@Model.RoleName" class="input input-bordered w-full pr-10" required placeholder="مثال: مخرج" />
                </div>
            </div>
        </div>
    </div>

    <div class="flex items-center justify-center gap-2 mt-6">
        <a href="/StaffRoles" class="btn btn-ghost">
            <span class="material-symbols-rounded">cancel</span>
            إلغاء
        </a>
        <button type="submit" class="btn btn-primary">
            <span class="material-symbols-rounded">save</span>
            حفظ
        </button>
    </div>
</form>
