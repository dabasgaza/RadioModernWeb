@model List<StaffRoleDto>
@{
    ViewData["Title"] = "المسميات الوظيفية";
    ViewData["HeaderIcon"] = "work";
    ViewData["HeaderDescription"] = "إدارة أدوار ومسؤوليات طاقم العمل في النظام";
    ViewBag.EntityName = "المسميات الوظيفية";

    if (User.HasPermission(AppPermissions.StaffManage))
    {
        ViewData["HeaderActions"] = "<a href='/StaffRoles/Create' class='btn btn-primary rounded-xl gap-2'><span class='material-symbols-rounded text-lg'>add</span>دور جديد</a>";
    }
}

<partial name="_PageHeader" />

@if (!Model.Any())
{
    ViewBag.EmptyIcon = "work";
    ViewBag.EmptyTitle = "لا أدوار";
    ViewBag.EmptyDesc = "لم تتم إضافة أي مسميات وظيفية بعد.";
    ViewBag.EmptyActionUrl = User.HasPermission(AppPermissions.StaffManage) ? "/StaffRoles/Create" : null;
    ViewBag.EmptyActionText = "دور جديد";
    ViewBag.EmptyActionIcon = "add";
    <partial name="_EmptyState" />
}
else
{
    <div class="rounded-2xl border overflow-hidden" style="background: var(--color-surface); border-color: var(--color-border)">
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="text-xs font-semibold"
                        style="color: var(--color-text-tertiary); background: var(--color-bg-alt); border-bottom: 1px solid var(--color-border)">
                        <th class="text-right py-3 px-4 font-semibold">الدور</th>
                        <th class="text-center py-3 px-4 font-semibold">إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr style="border-bottom: 1px solid var(--color-border)">
                            <td class="py-3 px-4 font-semibold" style="color: var(--color-text)">@r.RoleName</td>
                            <td class="py-3 px-4">
                                @if (User.HasPermission(AppPermissions.StaffManage))
                                {
                                    <div class="flex items-center justify-center gap-1 whitespace-nowrap">
                                        <a href="/StaffRoles/Edit/@r.StaffRoleId" class="inline-flex items-center justify-center w-9 h-9 rounded-xl transition-all"
                                           style="color: var(--color-primary);" title="تعديل" aria-label="تعديل">
                                            <span class="material-symbols-rounded text-xl leading-none">edit</span>
                                        </a>
                                        <form method="post" action="/StaffRoles/Delete/@r.StaffRoleId" class="inline" data-confirm="هل أنت متأكد من حذف الدور «@r.RoleName»؟">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="inline-flex items-center justify-center w-9 h-9 rounded-xl transition-all"
                                                    style="color: var(--color-error);" title="حذف" aria-label="حذف">
                                                <span class="material-symbols-rounded text-xl leading-none">delete</span>
                                            </button>
                                        </form>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
