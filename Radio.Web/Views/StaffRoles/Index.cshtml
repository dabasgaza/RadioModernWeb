@model List<StaffRoleDto>
@{
    ViewData["Title"] = "المسميات الوظيفية";
    ViewData["HeaderIcon"] = "work";
    ViewData["HeaderDescription"] = "إدارة أدوار ومسؤوليات طاقم العمل في النظام";
    ViewBag.EntityName = "المسميات الوظيفية";

    if (User.HasPermission(AppPermissions.StaffManage))
    {
        ViewData["HeaderActions"] = "<a href='/StaffRoles/Create' class='btn btn-primary rounded-xl gap-2'><span class='material-symbols-rounded text-lg'>add</span>دور جديد</a>";
    }
}

<partial name="_PageHeader" />

@if (!Model.Any())
{
    ViewBag.EmptyIcon = "work";
    ViewBag.EmptyTitle = "لا أدوار";
    ViewBag.EmptyDesc = "لم تتم إضافة أي مسميات وظيفية بعد.";
    ViewBag.EmptyActionUrl = User.HasPermission(AppPermissions.StaffManage) ? "/StaffRoles/Create" : null;
    ViewBag.EmptyActionText = "دور جديد";
    ViewBag.EmptyActionIcon = "add";
    <partial name="_EmptyState" />
}
else
{
    <div class="card overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm" aria-label="قائمة المسميات الوظيفية">
                <thead>
                    <tr class="text-xs font-semibold text-text-secondary bg-surface-hover border-b border-border">
                        <th class="px-6 py-4 text-right">الدور</th>
                        <th class="px-6 py-4 text-center"><span class="sr-only">إجراءات</span></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border">
                    @foreach (var r in Model)
                    {
                        <tr class="hover:bg-surface-hover/50 transition-colors">
                            <td class="px-6 py-4 font-semibold text-text">@r.RoleName</td>
                            <td class="px-6 py-4">
                                @if (User.HasPermission(AppPermissions.StaffManage))
                                {
                                    <div class="flex items-center justify-center gap-1 whitespace-nowrap">
                                        <a href="/StaffRoles/Edit/@r.StaffRoleId" class="btn btn-icon btn-sm btn-ghost text-primary" title="تعديل" aria-label="تعديل @r.RoleName">
                                            <span class="material-symbols-rounded text-lg">edit</span>
                                        </a>
                                        <form method="post" action="/StaffRoles/Delete/@r.StaffRoleId" class="inline" data-confirm="هل أنت متأكد من حذف الدور «@r.RoleName»؟">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-icon btn-sm btn-ghost text-danger" title="حذف" aria-label="حذف @r.RoleName">
                                                <span class="material-symbols-rounded text-lg">delete</span>
                                            </button>
                                        </form>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
